{
  "name": "Starr Proxy",
  "repo": "ghcr.io/notifiarr/starrproxy:main",
  "category": [
    "Network",
    "Utilities",
    "Productivity",
    "Misc"
  ],
  "registry": "ghcr.io/notifiarr/starrproxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/Notifiarr/starrproxy/main/root/app/www/public/images/logo-64.png",
  "project": "https://github.com/Notifiarr/starrproxy",
  "support": "https://github.com/Notifiarr/starrproxy/issues",
  "description": "Provide access scoped API keys and stop letting every 3rd party app and script have full access to your starr instance(s)!",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/starr_proxy/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9090",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
