{
  "name": "restic",
  "repo": "restic/restic:latest",
  "category": [
    "Backup",
    "Hosting",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/restic/restic",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--hostname unraid",
  "post_parameters": "--password-file /pass backup /data",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/restic-icon.png",
  "project": "https://restic.net/",
  "support": "https://github.com/restic/restic/issues",
  "description": "A backup program that is fast, efficient and secure.",
  "requires": "Runs as a utility container (triggers a command-line tool, has no web UI). See documentation for more details: https://restic.readthedocs.io\r\n        [br]\n        Expects a password file to be mounted at /pass.",
  "paths": [
    {
      "name": "Password file",
      "host": null,
      "container": "/pass",
      "mode": "rw",
      "description": "Path to password file",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Backup path",
      "host": null,
      "container": "/data",
      "mode": "rw",
      "description": "Path to files to back up",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Restic Repository",
      "key": "RESTIC_REPOSITORY",
      "value": "rest:https://user:pass@hostname/",
      "description": "Restic repository path.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
