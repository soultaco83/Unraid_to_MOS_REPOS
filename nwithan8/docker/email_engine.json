{
  "name": "EmailEngine",
  "repo": "postalsys/emailengine:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/postalsys/emailengine",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/email-engine-icon.png",
  "project": "https://emailengine.app/",
  "support": "https://emailengine.app/support",
  "description": "Headless email client application that makes IMAP and SMTP resources available over REST. Integrate email accounts with your service with ease!",
  "requires": "Requires a separate Redis container. \r\n        [br]\n        May require additional configuration. See documentation: https://emailengine.app/configuration",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Redis Connection",
      "key": "EENGINE_REDIS",
      "value": "redis://localhost:6379/7",
      "description": "Connection string for Redis instance",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
