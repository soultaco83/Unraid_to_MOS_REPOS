{
  "name": "Chevereto",
  "repo": "ghcr.io/chevereto/chevereto",
  "category": [
    "Media",
    "Utilities",
    "Productivity",
    "Misc"
  ],
  "registry": "https://github.com/chevereto/chevereto/pkgs/container/chevereto",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/chevereto-icon.png",
  "project": "https://chevereto.com",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "Self-hosted Image and Video Hosting solution, your own Flickr/imgur media sharing alternative with your rules.",
  "requires": "Requires a separate MariaDB server. \r\n        If the container reports permission errors, please adjust the permissions of the images path accordingly: https://github.com/Haxxnet/Compose-Examples/blob/main/examples/chevereto/README.md",
  "paths": [
    {
      "name": "Images path",
      "host": "/mnt/user/appdata/chevereto/images",
      "container": "/var/www/html/images",
      "mode": "rw",
      "description": "Images path",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8999",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "MariaDB Host",
      "key": "CHEVERETO_DB_HOST",
      "value": "mariadb",
      "description": "MariaDB Hostname",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MariaDB Port",
      "key": "CHEVERETO_DB_PORT",
      "value": "3306",
      "description": "MariaDB Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MariaDB User",
      "key": "CHEVERETO_DB_USER",
      "value": "chevereto",
      "description": "MariaDB Database Username",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MariaDB Password",
      "key": "CHEVERETO_DB_PASS",
      "value": "chevereto",
      "description": "MariaDB Database Password",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "MariaDB Database",
      "key": "CHEVERETO_DB_NAME",
      "value": "chevereto",
      "description": "MariaDB Database Name",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Asset storage type",
      "key": "CHEVERETO_ASSET_STORAGE_TYPE",
      "value": "local",
      "description": "Asset storage type",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Asset storage path",
      "key": "CHEVERETO_ASSET_STORAGE_URL",
      "value": "/images/_assets",
      "description": "Asset storage path",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Asset storage bucket",
      "key": "CHEVERETO_ASSET_STORAGE_BUCKET",
      "value": "/var/www/html/images/_assets",
      "description": "Asset storage bucket",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
