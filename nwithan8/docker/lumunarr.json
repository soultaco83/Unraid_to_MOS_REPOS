{
  "name": "Lumunarr",
  "repo": "chadwpalm/lumunarr:latest",
  "category": [
    "Home Automation",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/chadwpalm/lumunarr",
  "network": "host",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3939]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/lumunarr-icon.png",
  "project": "https://github.com/chadwpalm/Lumunarr",
  "support": "https://github.com/chadwpalm/Lumunarr/wiki",
  "description": "A connector application for controlling Philips Hue lighting using Plex webhooks. Actions like play, pause, stop, and resume will trigger lighting scenes through a Hue bridge.",
  "requires": "Running in host network mode allows Lumunarr to discover Philips Hue bridges on the local network via mDNS. Using bridge mode will require pulling the bridge IP from Hue Cloud.",
  "paths": [
    {
      "name": "Config File Path",
      "host": "/mnt/user/appdata/lumunarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to application config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Application Port",
      "host": "3939",
      "container": "3939",
      "protocol": "tcp",
      "description": "Container Port: 3939",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
