{
  "name": "IPTV Proxy",
  "repo": "ghcr.io/pierre-emmanuelj/iptv-proxy/iptv-proxy",
  "category": [
    "Media",
    "Utilities",
    "Misc"
  ],
  "registry": "https://github.com/pierre-emmanuelJ/iptv-proxy/pkgs/container/iptv-proxy%2Fiptv-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/iptv-proxy-icon.png",
  "project": "https://github.com/pierre-emmanuelJ/iptv-proxy",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "A reverse proxy for M3U and XtreamCodes IPTV streams",
  "paths": [
    {
      "name": "M3U Storage Path",
      "host": "/mnt/user/appdata/iptv-proxy/m3u",
      "container": "/root/iptv",
      "mode": "rw",
      "description": "Path to M3U files",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Stream Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "M3U URL",
      "key": "M3U_URL",
      "value": "/root/iptv/iptv.m3u",
      "description": "Path to M3U file (local in M3U Storage Path or remote URL). Remove if using XtreamCodes.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "XtreamCodes Username",
      "key": "XTREAM_USER",
      "value": null,
      "description": "Username for XtreamCodes. Remove if using M3U.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "XtreamCodes Password",
      "key": "XTREAM_PASSWORD",
      "value": null,
      "description": "Password for XtreamCodes. Remove if using M3U.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "XtreamCodes URL",
      "key": "XTREAM_BASE_URL",
      "value": null,
      "description": "URL and port for XtreamCodes. Remove if using M3U.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Username",
      "key": "USER",
      "value": null,
      "description": "Username for basic authentication",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": null,
      "description": "Password for basic authentication",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "8080",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Hostname",
      "key": "HOSTNAME",
      "value": "0.0.0.0",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal GIN Mode",
      "key": "GIN_MODE",
      "value": "release",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
