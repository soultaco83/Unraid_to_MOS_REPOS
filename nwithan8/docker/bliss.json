{
  "name": "bliss",
  "repo": "elstensoftware/bliss",
  "category": [
    "Media",
    "Misc",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/elstensoftware/bliss",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3220]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/bliss-icon.png",
  "project": "https://www.blisshq.com/",
  "support": "https://www.blisshq.com/get-help.html",
  "description": "bliss is an automated music library organizer for self-hosters and music hoarders.",
  "requires": "Due to a permissions issue, you must create the Configuration Data path before starting the container. Open a terminal and run the following command: \"mkdir -p /mnt/user/appdata/bliss/config\"",
  "paths": [
    {
      "name": "Music Files",
      "host": null,
      "container": "/music",
      "mode": "rw",
      "description": "Path to music files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Configuration Data",
      "host": "/mnt/user/appdata/bliss/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3220",
      "container": "3220",
      "protocol": "tcp",
      "description": "Container Port: 3220",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Services Port",
      "host": "3221",
      "container": "3221",
      "protocol": "tcp",
      "description": "Container Port: 3221",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
