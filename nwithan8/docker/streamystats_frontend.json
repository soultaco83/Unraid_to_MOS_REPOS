  "support": "https://github.com/fredrikburmester/streamystats/issues",
  "description": "Streamystats is a statistics service for Jellyfin, providing analytics and data visualization. \r\n        [br]\n        This is the frontend container.",
  "requires": "Requires separate Streamystats - Backend and Postgres containers.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
