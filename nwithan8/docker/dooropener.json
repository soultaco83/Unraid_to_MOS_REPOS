{
  "name": "DoorOpener",
  "repo": "ghcr.io/sloth-on-meth/dooropener:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/sloth-on-meth/dooropener",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6532]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/door-opener-icon.png",
  "project": "https://github.com/Sloth-on-meth/DoorOpener",
  "support": "https://github.com/Sloth-on-meth/DoorOpener/issues",
  "description": "A sleek, single-button web portal for triggering any Home Assistant action (like opening a building door), protected by secure PIN authentication. Perfect for apartment buildings, offices, or any scenario where you want easy, controlled access for multiple users.",
  "requires": "Requires a `config.ini` and `users.json` file to be mounted at the Config File and Users File paths before starting the container. See configuration details: https://github.com/Sloth-on-meth/DoorOpener#configuration \r\n        [br]\n        Requires a separate Home Assistant instance with Long-Lived Access Token for API access.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/door_opener/config.ini",
      "container": "/app/config.ini",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Users File",
      "host": "/mnt/user/appdata/door_opener/users.json",
      "container": "/app/users.json",
      "mode": "rw",
      "description": "Path to the users file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/user/appdata/door_opener/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to the logs folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6532",
      "container": "6532",
      "protocol": "tcp",
      "description": "Container Port: 6532",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Internal Web UI Port",
      "key": "DOOROPENER_PORT",
      "value": "6532",
      "description": "Internal port for the web UI. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
