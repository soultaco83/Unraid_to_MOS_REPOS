{
  "name": "ebook2audiobook",
  "repo": "athomasson2/ebook2audiobook:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/athomasson2/ebook2audiobook",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--platform=linux/amd64",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7860]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ebook-2-audiobook-icon.png",
  "project": "https://github.com/DrewThomasson/ebook2audiobook",
  "support": "https://github.com/DrewThomasson/ebook2audiobook/issues",
  "description": "CPU/GPU Converter from eBooks to audiobooks with chapters and metadata using Calibre, ffmpeg, XTTSv2, Fairseq and more. Supports voice cloning and 1124 languages! \r\n        \r\n        For Nvidia GPU support, add \"--runtime=nvidia --gpus all\" to the Extra Parameters field under Advanced.",
  "paths": [
    {
      "name": "Temp Path",
      "host": null,
      "container": "/home/user/app/tmp",
      "mode": "rw",
      "description": "Path to temporary files.",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Audiobooks Path",
      "host": null,
      "container": "/home/user/app/audiobooks",
      "mode": "rw",
      "description": "Path to audiobooks.",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Models Path",
      "host": null,
      "container": "/home/user/app/models",
      "mode": "rw",
      "description": "Path to models. Warning, this can consume a large amount of space.",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7860",
      "container": "7860",
      "protocol": "tcp",
      "description": "Container Port: 7860",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
