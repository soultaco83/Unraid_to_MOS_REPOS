{
  "name": "WsgiDAV",
  "repo": "mar10/wsgidav:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/mar10/wsgidav",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/mar10/wsgidav/master/docs/source/logo.png",
  "project": "https://github.com/mar10/wsgidav",
  "support": "https://github.com/mar10/wsgidav/issues",
  "description": "A generic and extendable WebDAV server written in Python and based on WSGI.",
  "paths": [
    {
      "name": "Storage",
      "host": "/mnt/user/appdata/wsgidav/storage",
      "container": "/var/wsgidav-root",
      "mode": "rw",
      "description": "Path to the storage directory",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
