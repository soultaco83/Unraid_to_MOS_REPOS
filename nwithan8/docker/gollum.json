{
  "name": "Gollum",
  "repo": "gollumwiki/gollum:master",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/gollumwiki/gollum",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4567]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/gollum-icon.png",
  "project": "https://github.com/gollum/gollum",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "A simple wiki system built on top of Git.",
  "paths": [
    {
      "name": "Data storage",
      "host": "/mnt/user/appdata/gollum",
      "container": "/wiki",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4567",
      "container": "4567",
      "protocol": "tcp",
      "description": "Container Port: 4567",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "99",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
