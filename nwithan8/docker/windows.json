{
  "name": "Windows",
  "repo": "dockurr/windows:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/dockurr/windows",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8006]/",
  "icon": "https://raw.githubusercontent.com/dockur/windows/master/.github/logo.png",
  "project": "https://github.com/dockur/windows",
  "support": "https://github.com/dockur/windows/issues",
  "description": "Windows inside a Docker container.",
  "requires": "See documentation for setup instructions: https://github.com/dockur/windows#faq-",
  "paths": [
    {
      "name": "Storage",
      "host": null,
      "container": "/storage",
      "mode": "rw",
      "description": "Path to storage directory. This may be large.",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Shared Folder",
      "host": null,
      "container": "/shared",
      "mode": "rw",
      "description": "Path to shared folder between host and container.",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "KVM Device",
      "host": "/dev/kvm",
      "container": "/dev/kvm",
      "mode": "rw",
      "description": "Path to KVM device.",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Network Tunnel Device",
      "host": "/dev/net/tun",
      "container": "/dev/net/tun",
      "mode": "rw",
      "description": "Path to network tunnel device.",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8006",
      "container": "8006",
      "protocol": "tcp",
      "description": "Container Port: 8006",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Server Port - TCP",
      "host": "3389",
      "container": "3389",
      "protocol": "tcp",
      "description": "Container Port: 3389",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Server Port - UDP",
      "host": "3389",
      "container": "3389",
      "protocol": "udp",
      "description": "Container Port: 3389",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Windows Version",
      "key": "VERSION",
      "value": "11|11l|11e|10|10l|10e|8e|7u|vu|xp|2k|2025|2022|2019|2016|2012|2008|2003",
      "description": "Windows version to run. Note that not all versions may work on all hardware.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Disk Size",
      "key": "DISK_SIZE",
      "value": "64G",
      "description": "Size of the virtual disk.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "RAM Size",
      "key": "RAM_SIZE",
      "value": "4G",
      "description": "Amount of RAM to allocate to the VM.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "CPU Cores",
      "key": "CPU_CORES",
      "value": "2",
      "description": "Number of CPU cores to allocate to the VM.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
