{
  "name": "Tater",
  "repo": "ghcr.io/tatertotterson/tater:latest",
  "category": [
    "AI",
    "Home Automation",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://github.com/TaterTotterson/Tater/pkgs/container/tater",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8501]/",
  "icon": "https://raw.githubusercontent.com/tatertotterson/Tater/refs/heads/main/images/tater.png",
  "project": "https://github.com/TaterTotterson/Tater",
  "support": "https://github.com/TaterTotterson/Tater/issues",
  "description": "A Local AI LLM Assistant With Tools and Integrations for Home Assistant, HomeKit, XBMC, Discord, Matrix, IRC, and Automations",
  "requires": "Requires a separate OpenAI-compatible LLM instance and Redis instance.",
  "paths": [
    {
      "name": "Agent Lab Config",
      "host": "/mnt/user/appdata/tater/agent_lab",
      "container": "/app/agent_lab",
      "mode": "rw",
      "description": "Path to the Agent Lab config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Runtime",
      "host": "/mnt/user/appdata/tater/runtime",
      "container": "/app/.runtime",
      "mode": "rw",
      "description": "Path to the runtime data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
