{
  "name": "Jellystat",
  "repo": "cyfershepard/jellystat:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/cyfershepard/jellystat",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/jellystat-icon.png",
  "project": "https://github.com/CyferShepard/Jellystat",
  "support": "https://github.com/CyferShepard/Jellystat/issues",
  "description": "Jellystat is a free and open source Statistics App for Jellyfin.",
  "requires": "Requires a separate Postgres database.",
  "paths": [
    {
      "name": "Backup Path",
      "host": "/mnt/user/appdata/jellystat/backup-data",
      "container": "/app/backend/backup-data",
      "mode": "rw",
      "description": "Path to backup data",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database - User",
      "key": "POSTGRES_USER",
      "value": null,
      "description": "Database user",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Password",
      "key": "POSTGRES_PASSWORD",
      "value": null,
      "description": "Database password",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Host",
      "key": "POSTGRES_IP",
      "value": null,
      "description": "Database host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Port",
      "key": "POSTGRES_PORT",
      "value": "5432",
      "description": "Database port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Name",
      "key": "POSTGRES_DB",
      "value": null,
      "description": "Database name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Secret Token",
      "key": "JWT_SECRET",
      "value": null,
      "description": "JWT Key to be used to encrypt JWT tokens for authentication",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Geolite - Account ID",
      "key": "JS_GEOLITE_ACCOUNT_ID",
      "value": null,
      "description": "maxmind.com user id to be used for Geolocating IP Addresses",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Geolite - License Key",
      "key": "JS_GEOLITE_LICENSE_KEY",
      "value": null,
      "description": "maxmind.com license key to be used for Geolocating IP Addresses",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Minimum Seconds for Playback",
      "key": "MINIMUM_SECONDS_TO_INCLUDE_PLAYBACK",
      "value": "1",
      "description": "The minimum time (in seconds) to include a playback record, which can be used to exclude short playbacks",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Use Emby",
      "key": "IS_EMBY_API",
      "value": "false|true",
      "description": "Connect to an Emby server instead of Jellyfin",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Listen IP",
      "key": "JS_LISTEN_IP",
      "value": "0.0.0.0",
      "description": "Internal listening IP",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Base URL",
      "key": "JS_BASE_URL",
      "value": "/",
      "description": "Base URL for the app",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Override User",
      "key": "JS_USER",
      "value": null,
      "description": "Master Override User in case username or password used during setup is forgotten.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Override Password",
      "key": "JS_PASSWORD",
      "value": null,
      "description": "Master Override Password in case username or password used during setup is forgotten",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Reject Self-Signed Certs",
      "key": "REJECT_SELF_SIGNED_CERTIFICATES",
      "value": "true|false",
      "description": "Deny self signed SSL certificates",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
