{
  "name": "Wishlist",
  "repo": "charmcli/wishlist:latest",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/charmcli/wishlist",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/wishlist-icon.png",
  "project": "https://github.com/charmbracelet/charm",
  "support": "https://github.com/charmbracelet/wishlist/issues",
  "description": "The SSH directory from Charm Bracelet",
  "requires": "Expects a `config.yaml` file in the Data Path. See documentation: https://github.com/charmbracelet/wishlist/blob/main/_example/config.yaml",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/wishlist",
      "container": "/.wishlist",
      "mode": "rw",
      "description": "Storage for app files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "SSH Port",
      "host": "2222",
      "container": "22",
      "protocol": "tcp",
      "description": "Container Port: 22",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
