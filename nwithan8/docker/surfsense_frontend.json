{
  "name": "SurfSense - Frontend",
  "repo": "ghcr.io/modsetter/surfsense_ui:latest",
  "category": [
    "AI",
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/modsetter/surfsense_ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/surfsense-icon.png",
  "project": "https://www.surfsense.net/",
  "support": "https://www.surfsense.net/docs",
  "description": "Open Source Alternative to NotebookLM / Perplexity / Glean, connected to external sources such as search engines (Tavily, Linkup), Slack, Linear, Notion, YouTube, GitHub, Discord and more. \r\n        [br]\n        This is the frontend container.",
  "requires": "Requires separate SurfSense - Backend, SurfSense - Worker, pgAdmin4, pgvector, electric and Redis containers. See documentation: https://github.com/MODSetter/SurfSense/blob/main/DOCKER_SETUP.md#deployment-options",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/surfsense/frontend/data",
      "container": "/app",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "App Node Modules",
      "host": "/mnt/user/appdata/surfsense/frontend/node_modules",
      "container": "/app/node_modules",
      "mode": "rw",
      "description": "Path to node modules",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Backend - URL",
      "key": "NEXT_PUBLIC_API_URL",
      "value": "http://MY_IP_ADDRESS:3001",
      "description": "URL of the backend service, including port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Backend - URL",
      "key": "NEXT_PUBLIC_FASTAPI_BACKEND_URL",
      "value": "http://MY_IP_ADDRESS:3001",
      "description": "URL of the FastAPI backend service, including port. Should match other Backend URL.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Backend - Authentication Type",
      "key": "NEXT_PUBLIC_FASTAPI_BACKEND_AUTH_TYPE",
      "value": "LOCAL|GOOGLE",
      "description": "Authentication type used by the backend.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Backend - ETL Service",
      "key": "NEXT_PUBLIC_ETL_SERVICE",
      "value": "UNSTRUCTURED|LLAMACLOUD|DOCLING",
      "description": "Document parsing service used by the backend.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Postgres URL",
      "key": "DATABASE_URL",
      "value": "postgresql://postgres:MY_PASSWORD@db.sdsf.supabase.co:5432/postgres",
      "description": "PostgreSQL database connection URL",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Electric - URL",
      "key": "NEXT_PUBLIC_ELECTRIC_URL",
      "value": "http://MY_IP_ADDRESS:5133",
      "description": "URL of the Electric service, including port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Electric - Auth Mode",
      "key": "NEXT_PUBLIC_ELECTRIC_AUTH_MODE",
      "value": "insecure",
      "description": "Authentication mode for Electric service",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
