{
  "name": "Koito",
  "repo": "gabehf/koito:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/gabehf/koito",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4110]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/koito-icon.png",
  "project": "https://koito.io/",
  "support": "https://koito.io/guides/installation/",
  "description": "Koito is a modern, themeable ListenBrainz-compatible scrobbler for self-hosters who want control over their data and insights into their listening habits. It supports relaying to other compatible scrobblers, so you can try it safely without replacing your current setup.",
  "requires": "Requires a separate PostgreSQL database.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/koito/data",
      "container": "/etc/koito",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4110",
      "container": "4110",
      "protocol": "tcp",
      "description": "Container Port: 4110",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "KOITO_DATABASE_URL",
      "value": "postgresql://user:password@host:port/database",
      "description": "Postgres database connection URL",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Allowed Hosts",
      "key": "KOITO_ALLOWED_HOSTS",
      "value": "koito.example.com",
      "description": "Comma-separated list of allowed hosts (e.g., koito.example.com,localhost)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
