{
  "name": "Operational",
  "repo": "ghcr.io/operational-co/operational.co:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/operational-co/operational.co",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/operational-icon.png",
  "project": "https://operational.co/",
  "support": "https://operational.co/selfhosted/docker",
  "description": "Operational is a open-source Event tracking tool. Monitor signups, webhooks, cronjobs and more.",
  "requires": "Requires separate Coolify frontend and MySQL instances.",
  "paths": [],
  "ports": [
    {
      "name": "Frontend Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "API Port",
      "host": "4337",
      "container": "4337",
      "protocol": "tcp",
      "description": "Container Port: 4337",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "mysql://USERNAME:PASSWORD@MYSQL_IP:3306/operational",
      "description": "Connection string to the MySQL database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Frontend URL",
      "key": "APP_URL",
      "value": "http://localhost:8080",
      "description": "URL of the frontend",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "SECRET",
      "value": null,
      "description": "A long randomized string used for hashing passwords and sessions.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Vapid - Email",
      "key": "VAPID_EMAIL",
      "value": null,
      "description": "Vapid credentials for push notifications",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Vapid - Public Key",
      "key": "VAPID_PUBLIC_KEY",
      "value": null,
      "description": "Vapid credentials for push notifications",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Vapid - Private Key",
      "key": "VAPID_PRIVATE_KEY",
      "value": null,
      "description": "Vapid credentials for push notifications",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Resend - Key",
      "key": "RESEND",
      "value": null,
      "description": "Resend credentials for email notifications",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Admin Email",
      "key": "ADMIN_EMAIL",
      "value": null,
      "description": "Email address to send emails as",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP - Host",
      "key": "SMTP_HOST",
      "value": null,
      "description": "SMTP host for sending emails",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP - Port",
      "key": "SMTP_PORT",
      "value": "587",
      "description": "SMTP port for sending emails",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP - Username",
      "key": "SMTP_USERNAME",
      "value": null,
      "description": "SMTP username for sending emails",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP - Password",
      "key": "SMTP_PASSWORD",
      "value": null,
      "description": "SMTP password for sending emails",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Remove Test Events After Days",
      "key": "REMOVE_TEST_EVENTS_AFTER",
      "value": "7",
      "description": "Number of days to keep test events in the database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "CORS",
      "key": "CORS",
      "value": "*",
      "description": "CORS settings for the API",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Node.js Port",
      "key": "PORT",
      "value": "2000",
      "description": "Port for the Node.js backend. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Vite API URL",
      "key": "VITE_API_URL",
      "value": "http://localhost:4337",
      "description": "URL of the backend. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
