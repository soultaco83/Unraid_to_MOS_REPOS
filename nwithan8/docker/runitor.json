{
  "name": "Runitor",
  "repo": "runitor/runitor:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/runitor/runitor",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/runitor-icon.png",
  "project": "https://github.com/bdd/runitor",
  "support": "https://github.com/bdd/runitor/issues",
  "description": "Runitor runs the supplied command, captures its output, and based on its exit code reports successful or failed execution to https://healthchecks.io or your private instance. \r\n        [br]\n        This is a CLI tool. Please edit the **Post Arguments** accordingly. See documentation: https://pkg.go.dev/bdd.fi/x/runitor#readme-usage",
  "requires": "This is a CLI tool; edit **Post Arguments** accordingly. See documentation: https://pkg.go.dev/bdd.fi/x/runitor#readme-usage \r\n        [br]\n        Requires a healthchecks.io account or private instance.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "HealthChecks - API URL",
      "key": "HC_API_URL",
      "value": "https://healthchecks.io/ping",
      "description": "URL of the healthchecks.io instance API",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "HealthChecks - Ping Key",
      "key": "HC_PING_KEY",
      "value": null,
      "description": "See documentation: https://github.com/bdd/runitor?tab=readme-ov-file#repository-maintenance",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Check UUID",
      "key": "CHECK_UUID",
      "value": "See documentation: https://github.com/bdd/runitor?tab=readme-ov-file#certificate-renewal",
      "description": "Check UUID",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Check Slug",
      "key": "CHECK_SLUG",
      "value": null,
      "description": "Check slug",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
