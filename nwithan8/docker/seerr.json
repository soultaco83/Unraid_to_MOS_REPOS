{
  "name": "Seerr",
  "repo": "ghcr.io/seerr-team/seerr:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/seerr-team/seerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--init --user 99:100",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5055]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/seerr-icon.png",
  "project": "https://seerr.dev/",
  "support": "https://docs.seerr.dev/",
  "description": "Seerr is a request management and media discovery tool built to work with your existing Plex/Jellyfin ecosystem.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/user/appdata/seerr",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Logs Storage",
      "host": "/mnt/user/appdata/seerr/logs",
      "container": "/app/config/logs",
      "mode": "rw",
      "description": "Path to store log files.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5055",
      "container": "5055",
      "protocol": "tcp",
      "description": "Container Port: 5055",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "debug|info|warn|error",
      "description": "Set the log level for the application.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal UI Port",
      "key": "PORT",
      "value": "5055",
      "description": "Internal UI port. Not recommended to change.",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
