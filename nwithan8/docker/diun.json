{
  "name": "Diun",
  "repo": "crazymax/diun:latest",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/crazymax/diun",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/crazy-max/diun/master/.res/diun.png",
  "project": "https://crazymax.dev/diun",
  "support": "https://crazymax.dev/diun/install/docker",
  "description": "Diun is a CLI application to receive notifications when a Docker image is updated on a Docker registry. \r\n        [br]\n        Requires a configuration file at the Config File path: https://crazymax.dev/diun/config/#configuration-file",
  "requires": "A `diun.yml` configuration file must be present at the Config File path BEFORE starting the container: https://crazymax.dev/diun/config/#configuration-file",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/diun/diun.yml",
      "container": "/diun.yml",
      "mode": "ro",
      "description": "Path to the Diun configuration file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/diun/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path where Diun should store its data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "info|error|debug",
      "description": "Log level",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Log JSON",
      "key": "LOG_JSON",
      "value": "false|true",
      "description": "Enable JSON logging",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
