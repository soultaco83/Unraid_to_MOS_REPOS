{
  "name": "Episodes",
  "repo": "bryangerlach/episodes:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/bryangerlach/episodes",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/episodes-icon.png",
  "project": "https://github.com/bryangerlach/Episodes",
  "support": "https://github.com/bryangerlach/Episodes/issues",
  "description": "Self-hosted TV show episode tracker allowing you to keep track of your favourite TV shows either continuing or ending.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/episodes/db",
      "container": "/app/db",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "Generate with Python command: python3 -c 'import secrets; print(secrets.token_hex(100))'",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "CSRF Trusted Domains",
      "key": "CSRF_TRUSTED_ORIGINS",
      "value": "http://localhost:3000 https://example.com",
      "description": "Space-separated list of trusted domains for CSRF protection",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "False|True",
      "description": "Enable debug mode",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
