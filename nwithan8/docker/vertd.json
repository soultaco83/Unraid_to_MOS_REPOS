{
  "name": "VERTd",
  "repo": "ghcr.io/vert-sh/vertd:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/vert-sh/vertd",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/vert-icon.png",
  "project": "https://github.com/VERT-sh/vertd",
  "support": "https://vert.sh/about/",
  "description": "VERT's solution to crappy video conversion services. \r\n        \r\n        For Nvidia GPU support, add \"--gpus all\" to the Extra Parameters field under Advanced. \r\n        For Intel iGPU support, add \"/dev/dri\" as a Device and add \"--device=/dev/dri\" to the Extra Parameters field under Advanced.",
  "requires": "Requires a separate VERT instance.",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "24153",
      "container": "24153",
      "protocol": "tcp",
      "description": "Container Port: 24153",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Encoder",
      "key": "VERTD_FORCE_GPU",
      "value": "cpu|nvidia|amd|intel|apple",
      "description": "Force specific hardware encoder",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Webhook URL",
      "key": "WEBHOOK_URL",
      "value": null,
      "description": "Optional Discord webhook URL to notify of failed conversions",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Webhook Pings",
      "key": "WEBHOOK_PINGS",
      "value": null,
      "description": "Optional user or role ID to ping in Discord webhook notifications",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": null,
      "description": "Admin password for kept videos.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Public URL",
      "key": "PUBLIC_URL",
      "value": "https://vertd.example.com",
      "description": "Public URL for kept video access.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
