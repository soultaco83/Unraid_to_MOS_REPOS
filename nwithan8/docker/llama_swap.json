{
  "name": "llama-swap",
  "repo": "ghcr.io/mostlygeek/llama-swap:unified-cuda",
  "category": [
    "AI",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/mostlygeek/llama-swap",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--runtime=nvidia --gpus all",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/llama-swap-icon.png",
  "project": "https://github.com/mostlygeek/llama-swap",
  "support": "https://github.com/mostlygeek/llama-swap/issues",
  "description": "Run multiple generative AI models on your machine and hot-swap between them on demand. llama-swap works with any OpenAI and Anthropic API compatible server and is used by thousands of people to power their local AI workflows.",
  "requires": "Expects a `config.yaml` file at the Config File path BEFORE starting the container.",
  "paths": [
    {
      "name": "Models Storage",
      "host": "/mnt/user/appdata/llama_swap/models",
      "container": "/models",
      "mode": "rw",
      "description": "Path to models",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9292",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [
    {
      "driver": "nvidia",
      "count": "all",
      "capabilities": [
        "gpu"
      ],
      "description": "NVIDIA GPU pass-through. Requires the NVIDIA driver / container toolkit on the host (Unraid: install the Nvidia-Driver plugin)."
    }
  ]
}
