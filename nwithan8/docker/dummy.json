{
  "name": "AppTitle",
  "repo": "author/container:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/author/container",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dummy-icon.png",
  "project": "https://github.com/author/app",
  "support": "https://github.com/author/app/issues",
  "description": "A description of the app.",
  "paths": [
    {
      "name": "App Data Path",
      "host": "/mnt/user/appdata/dummy/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Path",
      "host": "/mnt/user/appdata/dummy/path",
      "container": "/internal/path",
      "mode": "rw",
      "description": "Path to internal app data",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Port",
      "host": "1000",
      "container": "1000",
      "protocol": "tcp",
      "description": "Container Port: 1000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Environmental Variable",
      "key": "ENV_VAR",
      "value": "default_value",
      "description": "An example environmental variable",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Environment Variable 2",
      "key": "ENV_VAR_2",
      "value": "true|false",
      "description": "Another example environmental variable",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
