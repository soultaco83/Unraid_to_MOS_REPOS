{
  "name": "WebDAV",
  "repo": "bytemark/webdav:latest",
  "category": [
    "Media",
    "Misc",
    "Network",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/bytemark/webdav",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://debrid-link.com/screen/webdav_logo.png",
  "project": "https://github.com/BytemarkHosting/docker-webdav",
  "support": "https://github.com/BytemarkHosting/docker-webdav/issues",
  "description": "An easily configurable WebDAV server with Apache.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/webdav/data",
      "container": "/var/lib/dav",
      "mode": "rw",
      "description": "Path to files to serve",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Authentication Type",
      "key": "AUTH_TYPE",
      "value": "Basic|Digest",
      "description": "Authentication type for WebDAV",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Username",
      "key": "USERNAME",
      "value": null,
      "description": "Username for WebDAV authentication",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": null,
      "description": "Password for WebDAV authentication",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
