{
  "name": "Tidaloader",
  "repo": "ghcr.io/rayz3r0/tidaloader:latest",
  "category": [
    "Downloader",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/rayz3r0/tidaloader",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8001]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tidaloader-icon.png",
  "project": "https://github.com/RayZ3R0/tidaloader",
  "support": "https://github.com/RayZ3R0/tidaloader/issues",
  "description": "A full-stack web application for downloading high-quality music from Tidal with intelligent playlist generation via ListenBrainz/Troi integration. Features automatic metadata tagging, lyrics fetching, and organized file management.",
  "paths": [
    {
      "name": "Music Folder",
      "host": null,
      "container": "/music",
      "mode": "rw",
      "description": "Path to the music folder",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "Container Port: 8001",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Authentication - Username",
      "key": "AUTH_USERNAME",
      "value": null,
      "description": "Username for accessing the web interface",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Authentication - Password",
      "key": "AUTH_PASSWORD",
      "value": null,
      "description": "Password for accessing the web interface",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Max Concurrent Downloads",
      "key": "MAX_CONCURRENT_DOWNLOADS",
      "value": "3",
      "description": "Maximum number of concurrent downloads",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Auto-Process Queue",
      "key": "QUEUE_AUTO_PROCESS",
      "value": "true|false",
      "description": "Auto-process downloads when added to queue",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Music Folder",
      "key": "MUSIC_DIR",
      "value": "/music",
      "description": "Internal path to the music folder inside the container. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "USER_UID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "USER_GID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
