{
  "name": "GiftManager",
  "repo": "icbest/giftmanager:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/icbest/giftmanager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/gift-manager-icon.png",
  "project": "https://giftmanagerdemo.pages.dev/",
  "support": "https://gift.icbest.ca/",
  "description": "Gift ideas manager for families",
  "requires": "Optionally provide the Docker Socket to enable settings reload within the container.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Optional, path to the Docker socket. Provide to enable settings reload inside application.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/gift_manager/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
