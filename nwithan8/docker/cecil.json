{
  "name": "Cecil",
  "repo": "madeofpendletonwool/cecil:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/madeofpendletonwool/cecil",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:38355]/",
  "icon": "https://raw.githubusercontent.com/madeofpendletonwool/cecil/main/images/Cecil-logos.jpeg",
  "project": "https://github.com/madeofpendletonwool/cecil",
  "support": "https://github.com/madeofpendletonwool/cecil/issues",
  "description": "An ever-growing notification platform that can be used for all notification needs. It pairs perfectly with ntfy.",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/user/appdata/cecil/config",
      "container": "/opt/cecil",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "38355",
      "container": "38355",
      "protocol": "tcp",
      "description": "Container Port: 38355",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "GitHub - Client ID",
      "key": "CLIENT_ID",
      "value": null,
      "description": "GitHub Client ID",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "GitHub - Client Secret",
      "key": "CLIENT_SECRET",
      "value": null,
      "description": "GitHub Client Secret",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "GitHub - Oauth URL",
      "key": "AUTH_URL",
      "value": "http://localhost:38355/api/oauth/redirect",
      "description": "The auth URL is the url that you are using to connect to the app.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
