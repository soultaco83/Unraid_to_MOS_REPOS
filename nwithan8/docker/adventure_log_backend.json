{
  "name": "AdventureLog - Backend",
  "repo": "ghcr.io/seanmorley15/adventurelog-backend:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://github.com/seanmorley15/AdventureLog/pkgs/container/adventurelog-backend",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/adventure-log-icon.png",
  "project": "https://adventurelog.app/",
  "support": "https://adventurelog.app/docs/install/getting_started.html",
  "description": "Discover new places, track your adventures, and share your experiences with friends and family.",
  "requires": "Requires a separate PostGIS database container.",
  "paths": [
    {
      "name": "Media Path",
      "host": "/mnt/user/appdata/adventurelog/media",
      "container": "/code/media",
      "mode": "rw",
      "description": "Path to the media folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8016",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database - Host",
      "key": "PGHOST",
      "value": null,
      "description": "PostGIS Host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Name",
      "key": "PGDATABASE",
      "value": null,
      "description": "PostGIS Database Name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - User",
      "key": "PGUSER",
      "value": null,
      "description": "PostGIS User",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Password",
      "key": "PGPASSWORD",
      "value": null,
      "description": "PostGIS Password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin Username",
      "key": "DJANGO_ADMIN_USERNAME",
      "value": "admin",
      "description": "Admin Username",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin Email",
      "key": "DJANGO_ADMIN_EMAIL",
      "value": null,
      "description": "Admin Email",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin Password",
      "key": "DJANGO_ADMIN_PASSWORD",
      "value": null,
      "description": "Admin Password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Public URL",
      "key": "PUBLIC_URL",
      "value": "http://IP_ADDRESS:8016",
      "description": "Used for the creation of image URLs. Must match API Port.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Frontend URL",
      "key": "FRONTEND_URL",
      "value": "http://IP_ADDRESS:8015",
      "description": "Used for email generation. Must match the frontend URL.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "CSRF Trusted Origins",
      "key": "CSRF_TRUSTED_ORIGINS",
      "value": "http://IP_ADDRESS:8016,http://IP_ADDRESS:8015",
      "description": "Comma separated list of backend and frontend URLs",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "False|True",
      "description": "Enable Debug Mode",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
