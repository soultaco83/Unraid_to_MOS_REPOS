{
  "name": "romm",
  "repo": "rommapp/romm:latest",
  "category": [
    "Media",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/rommapp/romm",
  "network": "romm_net",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/rommapp/romm/master/.github/resources/isotipo.png",
  "project": "https://github.com/rommapp/romm",
  "support": "https://github.com/rommapp/romm/issues",
  "description": "A beautiful, powerful, self-hosted rom manager\n\n   RomM (ROM Manager) allows you to scan, enrich, and browse your game collection with a clean and resonsive interface. With support for multiple platforms, various naming schemes, and custom tags, RomM is a must-have for anyone who plays on emulators.\n\n   Features:\n   • Scans your existing games library and enhances it with metadata from IGDB and MobyGames\n   • Supports a large number of platforms\n   • Play games directly from the browser using EmulatorJS\n   • Share your library with friends while limiting access and permissions\n   • View, upload, update, and delete games from any modern web browser\n\n   Before starting, generate your IGDB and Mobygames API keys: https://github.com/rommapp/romm/wiki/Generate-API-Keys\n\n   Instructions for setting up RomM can be found at https://github.com/rommapp/romm/wiki/Unraid-Setup",
  "donate": "https://opencollective.com/romm",
  "requires": "MariaDB",
  "paths": [
    {
      "name": "Library",
      "host": "/romm/library",
      "container": "/romm/library/",
      "mode": "rw",
      "description": "Game files",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Resources",
      "host": "/mnt/user/appdata/romm/resources",
      "container": "/romm/resources/",
      "mode": "rw",
      "description": "Metadata storage (covers, screenshots, etc.)",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Assets",
      "host": "/mnt/user/appdata/romm/assets",
      "container": "/romm/assets/",
      "mode": "rw",
      "description": "Uploaded saves, states, etc.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config",
      "host": "/mnt/user/appdata/romm/config",
      "container": "/romm/config/",
      "mode": "rw",
      "description": "Folder for config.yml",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": "mariadb",
      "description": "Database host",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Database port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": "romm",
      "description": "Database user",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "romm",
      "description": "Database name",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PASSWD",
      "key": "DB_PASSWD",
      "value": null,
      "description": "Database password for DB_USER",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "ROMM_AUTH_SECRET_KEY",
      "key": "ROMM_AUTH_SECRET_KEY",
      "value": null,
      "description": "Generate a key with `openssl rand -hex 32`",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "IGDB_CLIENT_ID",
      "key": "IGDB_CLIENT_ID",
      "value": null,
      "description": "IGDB Client ID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "IGDB_CLIENT_SECRET",
      "key": "IGDB_CLIENT_SECRET",
      "value": null,
      "description": "IGDB Client Secret",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "STEAMGRIDDB_API_KEY",
      "key": "STEAMGRIDDB_API_KEY",
      "value": null,
      "description": "SteamGridDB API Key",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "MOBYGAMES_API_KEY",
      "key": "MOBYGAMES_API_KEY",
      "value": null,
      "description": "MobyGames API Key",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "ENABLE_RESCAN_ON_FILESYSTEM_CHANGE",
      "key": "ENABLE_RESCAN_ON_FILESYSTEM_CHANGE",
      "value": "false",
      "description": "Run a scan when the filesystem changes",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "RESCAN_ON_FILESYSTEM_CHANGE_DELAY",
      "key": "RESCAN_ON_FILESYSTEM_CHANGE_DELAY",
      "value": "5",
      "description": "Delay in seconds before running a scan",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "ENABLE_SCHEDULED_RESCAN",
      "key": "ENABLE_SCHEDULED_RESCAN",
      "value": "false",
      "description": "Run a scan on a schedule",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "SCHEDULED_RESCAN_CRON",
      "key": "SCHEDULED_RESCAN_CRON",
      "value": "0 3 * * *",
      "description": "Cron expression for scheduled scan",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "ENABLE_SCHEDULED_UPDATE_SWITCH_TITLEDB",
      "key": "ENABLE_SCHEDULED_UPDATE_SWITCH_TITLEDB",
      "value": "false",
      "description": "Update Switch TitleDB on a schedule",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "SCHEDULED_UPDATE_SWITCH_TITLEDB_CRON",
      "key": "SCHEDULED_UPDATE_SWITCH_TITLEDB_CRON",
      "value": "0 4 * * *",
      "description": "Cron expression for scheduled Switch TitleDB update",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "SCAN_TIMEOUT",
      "key": "SCAN_TIMEOUT",
      "value": "14400",
      "description": "Timeout in seconds for background scans",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "GUNICORN_WORKERS",
      "key": "GUNICORN_WORKERS",
      "value": "2",
      "description": "Number of Gunicorn workers",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "DISABLE_CSRF_PROTECTION",
      "key": "DISABLE_CSRF_PROTECTION",
      "value": "false",
      "description": "[EXPERTS ONLY] Disable CSRF protection",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "DISABLE_DOWNLOAD_ENDPOINT_AUTH",
      "key": "DISABLE_DOWNLOAD_ENDPOINT_AUTH",
      "value": "false",
      "description": "[EXPERTS ONLY] Disable authentication for the download endpoint",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
