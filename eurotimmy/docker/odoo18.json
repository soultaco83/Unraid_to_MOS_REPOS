{
  "name": "Odoo18",
  "repo": "odoo:18",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/_/odoo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--user=100:101",
  "post_parameters": "-i base",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8069]",
  "readme_url": "https://github.com/Eurotimmy/unraid-templates/blob/main/Odoo18/README.md",
  "icon": "https://github.com/Eurotimmy/unraid-templates/blob/main/Odoo18/odoo.png",
  "project": "https://github.com/odoo/docker",
  "support": "https://forums.unraid.net/topic/150914-support-eurotimmy-odoo17-odoo18/",
  "description": "Odoo is an open-source suite of integrated business applications that includes various modules for different business functions such as accounting, project management, inventory management, human resources, and more. It provides a comprehensive and modular solution for businesses to manage and streamline their processes.\r\n\r\nOdoo is the world's easiest all-in-one management software.\r\n\r\nIt includes hundreds of business apps:\r\nCRM | e-Commerce | Accounting | Inventory | PoS | Project management | MRP\r\n\r\n:: IMPORTANT NOTES ::\r\nSee the README.md file at https://github.com/Eurotimmy/unraid-templates/blob/main/Odoo18/README.md",
  "requires": "PostgreSQL (postgresql v12 or later) from Community Applications",
  "paths": [
    {
      "name": "Data Location",
      "host": "/mnt/user/appdata/odoo18/data",
      "container": "/var/lib/odoo",
      "mode": "rw",
      "description": "Odoo filestore (attachments, sessions, etc.)",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Location",
      "host": "/mnt/user/appdata/odoo18/config",
      "container": "/etc/odoo",
      "mode": "rw",
      "description": "Directory containing odoo.conf",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Addons Location",
      "host": "/mnt/user/appdata/odoo18/extra-addons",
      "container": "/mnt/extra-addons",
      "mode": "rw",
      "description": "Custom/community addons",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8069",
      "container": "8069",
      "protocol": "tcp",
      "description": "Port to access Odoo",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
