{
  "name": "bitbucket-pipelines-runner",
  "repo": "docker-public.packages.atlassian.com/sox/atlassian/bitbucket-pipelines-runner:latest",
  "category": [
    "Misc"
  ],
  "registry": null,
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "/bin/bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/Eurotimmy/unraid-templates/blob/main/Bitbucket-Pipelines-Runner/README.md",
  "icon": "https://github.com/Eurotimmy/unraid-templates/blob/main/Bitbucket-Pipelines-Runner/bitbucket-pipelines-runner.png",
  "project": "https://bitbucket.org/product/features/pipelines",
  "support": "https://forums.unraid.net/topic/193905-support-eurotimmy-bitbucket-pipelines-runner/",
  "description": "Bitbucket Pipelines self-hosted runner (Linux Docker) for Unraid. Outbound-only connection; launches pipeline step containers on the host via Docker socket.",
  "paths": [
    {
      "name": "Appdata (runner dir)",
      "host": "/mnt/user/appdata/bitbucket-runner",
      "container": "/runner",
      "mode": "rw",
      "description": "Persistent runner state and logs.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Allows the runner to launch step containers on the host.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Docker Containers (optional logs)",
      "host": "/var/lib/docker/containers",
      "container": "/var/lib/docker/containers",
      "mode": "ro",
      "description": "Optional: read-only access to step container logs.",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Account UUID",
      "key": "ACCOUNT_UUID",
      "value": null,
      "description": "Workspace UUID (include braces), from Bitbucket 'Add runner'.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Repository UUID (optional)",
      "key": "REPOSITORY_UUID",
      "value": null,
      "description": "Only for repo-scoped runners; leave blank for workspace-scoped.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Runner UUID",
      "key": "RUNNER_UUID",
      "value": null,
      "description": "Unique runner ID from Bitbucket 'Add runner'.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Runner Name",
      "key": "RUNNER_NAME",
      "value": "unraid-runner-1",
      "description": "Friendly display name shown in Bitbucket.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Runner Labels",
      "key": "RUNNER_LABELS",
      "value": "unraid,linux.docker",
      "description": "Comma-separated labels you will target in bitbucket-pipelines.yml.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "OAuth Client ID",
      "key": "OAUTH_CLIENT_ID",
      "value": null,
      "description": "From Bitbucket 'Add runner'.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "OAuth Client Secret",
      "key": "OAUTH_CLIENT_SECRET",
      "value": null,
      "description": "From Bitbucket 'Add runner'.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Working Directory",
      "key": "WORKING_DIRECTORY",
      "value": "/runner",
      "description": "Runner working directory (leave default).",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
