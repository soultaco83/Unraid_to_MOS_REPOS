{
  "name": "Lumen",
  "repo": "ghcr.io/checksumdev/lumen:nightly",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/checksumdev/lumen",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/lumen-icon.png",
  "project": "https://lumen.checksum.space",
  "support": "https://github.com/ChecksumDev/lumen/issues",
  "description": "Lumen is an astronomically fast ShareX uploader written in Rust using the Actix Web framework \r\n        [br]\n        See documentation: https://github.com/ChecksumDev/lumen#usage-",
  "paths": [
    {
      "name": "App Data Path",
      "host": "/mnt/cache/appdata/lumen/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to app data files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Public URL",
      "key": "PUBLIC_URL",
      "value": "https://mydomain.com",
      "description": "Public URL for the app",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Bind",
      "key": "BIND",
      "value": "localhost:8080",
      "description": "Internal web server bind address",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
