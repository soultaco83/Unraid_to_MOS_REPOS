{
  "name": "Paperless-AI",
  "repo": "clusterzx/paperless-ai:latest",
  "category": [
    "AI",
    "Hosting",
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/clusterzx/paperless-ai",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/paperless-ai-icon.png",
  "project": "https://github.com/clusterzx/paperless-ai",
  "support": "https://github.com/clusterzx/paperless-ai/issues",
  "description": "An automated document analyzer for Paperless-ngx using OpenAI API and Ollama (Mistral, llama, phi 3, gemma 2) to automatically analyze and tag your documents.",
  "requires": "Requires a separate Paperless-ngx instance (and optional Ollama) to function.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/paperless-ai",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
