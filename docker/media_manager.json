{
  "name": "MediaManager",
  "repo": "ghcr.io/maxdorninger/mediamanager/mediamanager:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/maxdorninger/mediamanager/mediamanager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/maxdorninger/MediaManager/refs/heads/master/Writerside/images/logo.svg",
  "project": "hhttps://maxdorninger.github.io/MediaManager/introduction.html",
  "support": "https://maxdorninger.github.io/MediaManager/troubleshooting.html",
  "description": "Manage your TV and movie library. Designed to be a replacement for Sonarr, Radarr, Overseer, and Jellyseer. It supports TVDB and TMDB for metadata, supports OIDC and OAuth 2.0 for authentication and supports Prowlarr and Jackett. It also provides an API to interact with the software programmatically, allowing for automation and integration with other services.",
  "requires": "Expects a `config.toml` file to be mounted inside the Config Path before starting the container. See configuration details: https://maxdorninger.github.io/MediaManager/configuration.html \r\n        Requires a separate Postgres database.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/media_manager/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data directory",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Images Path",
      "host": "/mnt/cache/appdata/media_manager/data/images",
      "container": "/data/images",
      "mode": "rw",
      "description": "Path to the images directory",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/media_manager/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to the config directory",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Internal Config File Path",
      "key": "CONFIG_DIR",
      "value": "/app/config",
      "description": "Internal path to the config directory. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
