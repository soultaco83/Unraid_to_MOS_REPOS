{
  "name": "RTSPtoWeb",
  "repo": "ghcr.io/deepch/rtsptoweb:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/deepch/rtsptoweb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8083]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/rtsp-to-web-icon.png",
  "project": "https://github.com/deepch/RTSPtoWeb",
  "support": "https://github.com/deepch/RTSPtoWeb/issues",
  "description": "RTSPtoWeb converts your RTSP streams to formats consumable in a web browser like MSE (Media Source Extensions), WebRTC, or HLS.",
  "requires": "This application expects a `config.json` file to be mounted at the Config Data path. See example: https://github.com/deepch/RTSPtoWeb?tab=readme-ov-file#example-configjson",
  "paths": [
    {
      "name": "Config data",
      "host": "/mnt/user/appdata/rtsp_to_web/config.json",
      "container": "/config/config.json",
      "mode": "rw",
      "description": "Config data for application",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8083",
      "container": "8083",
      "protocol": "tcp",
      "description": "Container Port: 8083",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
