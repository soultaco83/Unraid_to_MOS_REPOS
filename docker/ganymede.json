{
  "name": "Ganymede",
  "repo": "ghcr.io/zibbp/ganymede:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/zibbp/ganymede",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4000]/",
  "icon": "https://raw.githubusercontent.com/Zibbp/ganymede/main/.github/ganymede-logo.png",
  "project": "https://github.com/Zibbp/ganymede",
  "support": "https://github.com/Zibbp/ganymede/wiki",
  "description": "A Twitch VOD and Live Stream archiving platform with a real-time chat experience. Every archive includes a rendered chat for viewing outside of Ganymede. Files are saved in a friendly format allowing for use without Ganymede.",
  "requires": "Requires a separate Postgres database.",
  "paths": [
    {
      "name": "Video Path",
      "host": null,
      "container": "/data/videos",
      "mode": "rw",
      "description": "Mount for video storage",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/ganymede/config",
      "container": "/data/config",
      "mode": "rw",
      "description": "Mount for config storage",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/ganymede/logs",
      "container": "/data/logs",
      "mode": "rw",
      "description": "Mount for log storage",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Temp Data Path",
      "host": "/mnt/cache/appdata/ganymede/temp",
      "container": "/data/temp",
      "mode": "rw",
      "description": "Mount to store temporary files during the archive process.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": "Container Port: 4000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Twitch - Client ID",
      "key": "TWITCH_CLIENT_ID",
      "value": null,
      "description": "Twitch Client ID",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Twitch - Client Secret",
      "key": "TWITCH_CLIENT_SECRET",
      "value": null,
      "description": "Twitch Client Secret",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Host",
      "key": "DB_HOST",
      "value": null,
      "description": "Postgres host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Port",
      "key": "DB_PORT",
      "value": "5432",
      "description": "Postgres port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Database",
      "key": "DB_NAME",
      "value": "ganymede",
      "description": "Postgres database name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - User",
      "key": "DB_USER",
      "value": null,
      "description": "Postgres user",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Password",
      "key": "DB_PASS",
      "value": null,
      "description": "Postgres password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Use SSL",
      "key": "DB_SSL",
      "value": "disable|enable",
      "description": "Use SSL for Postgres connection. Details: https://github.com/Zibbp/ganymede/wiki/DB-SSL",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - SSL Root Cert",
      "key": "DB_SSL_ROOT_CERT",
      "value": null,
      "description": "Postgres SSL root certificate. Remove if not needed. Details: https://github.com/Zibbp/ganymede/wiki/DB-SSL",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Require Login",
      "key": "REQUIRE_LOGIN",
      "value": "false|true",
      "description": "Require users to be logged in to view videos.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "OAuth - Enable",
      "key": "OAUTH_ENABLED",
      "value": "false|true",
      "description": "Enable OAuth",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "OAuth - Provider",
      "key": "OAUTH_PROVIDER_URL",
      "value": null,
      "description": "URL for OAuth provider. Details: https://github.com/Zibbp/ganymede/wiki/SSO---OpenID-Connect",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "OAuth - Client ID",
      "key": "OAUTH_CLIENT_ID",
      "value": null,
      "description": "OAuth client ID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "OAuth - Client Secret",
      "key": "OAUTH_CLIENT_SECRET",
      "value": null,
      "description": "OAuth client secret",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "OAuth - Redirect URL",
      "key": "OAUTH_REDIRECT_URL",
      "value": null,
      "description": "OAuth redirect URL. Details: https://github.com/Zibbp/ganymede/wiki/SSO---OpenID-Connect",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "OAuth - Enable Sign-in Button",
      "key": "SHOW_SSO_LOGIN_BUTTON",
      "value": "false|true",
      "description": "Show a 'login via sso' button on the login page.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "OAuth - Force SSO",
      "key": "FORCE_SSO_AUTH",
      "value": "false|true",
      "description": "Force users to login via SSO by bypassing the login page.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Limits - Chat Downloads",
      "key": "MAX_CHAT_DOWNLOAD_EXECUTIONS",
      "value": "1",
      "description": "Maximum number of chat downloads that can be running at once. Live streams bypass this limit.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Limits - Chat Renders",
      "key": "MAX_CHAT_RENDER_EXECUTIONS",
      "value": "1",
      "description": "Maximum number of chat renders that can be running at once.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Limits - Video Downloads",
      "key": "MAX_VIDEO_DOWNLOAD_EXECUTIONS",
      "value": "1",
      "description": "Maximum number of video downloads that can be running at once. Live streams bypass this limit.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Limits - Video Conversions",
      "key": "MAX_VIDEO_CONVERT_EXECUTIONS",
      "value": "1",
      "description": "Maximum number of video conversions that can be running at once.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "false|true",
      "description": "Enable debug logging",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Videos Path",
      "key": "VIDEOS_DIR",
      "value": "/data/videos",
      "description": "Internal path to videos. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Temporary Data Path",
      "key": "TEMP_DIR",
      "value": "/data/temp",
      "description": "Internal path to temporary data. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Logs Path",
      "key": "LOGS_DIR",
      "value": "/data/logs",
      "description": "Internal path to logs. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Config Path",
      "key": "CONFIG_DIR",
      "value": "/data/config",
      "description": "Internal path to config. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Path Migration at Startup",
      "key": "PATH_MIGRATION_ENABLED",
      "value": "true|false",
      "description": "Enable path migration at startup",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
