{
  "name": "proxmox-datacenter-manager",
  "repo": "devzwf/proxmox-datacenter-manager:latest",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/devzwf/proxmox-datacenter-manager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped  --cgroupns=host --mount type=tmpfs,destination=/run --mount type=tmpfs,destination=/run/lock",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:8443]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/pdm-logo.jpg",
  "project": "https://github.com/proxmox/proxmox-datacenter-manager",
  "support": "https://forums.unraid.net/topic/183027-support-devzwf-proxmox-datacenter-manager/",
  "description": "Proxmox Datacenter Manager\r\nA stand-alone API + GUI product with the following main features for multiple instances of Proxmox VE, Proxmox Backup Server and potentially also Proxmox Mail Gateway in one central place:\r\n\r\n     * - Status and Health overview for the core resources. E.g., for PVE/PBS/PMG hosts, PVE guests or PBS backups\r\n     * - Basic Management of the core resources.\r\n     * - Connect those separate instances. E.g., cross-cluster VM live-migration.\r\n\r\nThe Datacenter Manager project has been developed with the objective of providing a centralized overview of all your individual nodes and clusters. It also enables basic management like migrations of virtual guests without any cluster network requirements.\r\n\r\ndefault login  : root:pdmpdm   (please change)\r\n\r\nMore info : https://forum.proxmox.com/threads/proxmox-datacenter-manager-1-0-stable.177321/\r\nDocumentation: https://www.proxmox.com/en/products/proxmox-datacenter-manager/overviewn",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/user/appdata/proxmox-datacenter-manager/config",
      "container": "/etc/proxmox-datacenter-manager",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Data",
      "host": "/mnt/user/appdata/proxmox-datacenter-manager/data",
      "container": "/var/lib/proxmox-datacenter-manager",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Logs",
      "host": "/mnt/user/appdata/proxmox-datacenter-manager/logs",
      "container": "/var/log/proxmox-datacenter-manager",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Root",
      "host": "/mnt/user/appdata/proxmox-datacenter-manager/root",
      "container": "/root",
      "mode": "rw",
      "description": "Root home (optional, for shell history etc)",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Cgroup",
      "host": "/sys/fs/cgroup",
      "container": "/sys/fs/cgroup",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PDM_TIMEZONE",
      "key": "PDM_TIMEZONE",
      "value": "America/Toronto",
      "description": "Timezone",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
