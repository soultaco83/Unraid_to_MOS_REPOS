{
  "name": "Rollerblades",
  "repo": "ghcr.io/jcostom/rollerblades:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/jcostom/rollerblades",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--user 099:100",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/rollerblades-icon.png",
  "project": "https://github.com/jcostom/rollerblades",
  "support": "https://github.com/jcostom/rollerblades/issues",
  "description": "A tool to automate Plex prerolls based on schedules.",
  "requires": "Expects a `prerolls.json` file in the Config Path. See documentation: https://github.com/jcostom/rollerblades#create-your-config-file",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/rollerblades/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Plex - Host",
      "key": "HOST",
      "value": null,
      "description": "Plex server host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Plex - Token",
      "key": "TOKEN",
      "value": null,
      "description": "Plex server token",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
