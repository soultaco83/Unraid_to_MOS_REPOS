{
  "name": "KMS UI",
  "repo": "11notes/kms-gui:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/11notes/kms-gui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/kms-icon.png",
  "project": "https://github.com/11notes/docker-kms-gui",
  "support": "https://github.com/11notes/docker-kms-gui/issues",
  "description": "A KMS server for Windows and Office activation. This is a web UI for the KMS server.",
  "paths": [
    {
      "name": "Temp Data Path",
      "host": "/mnt/user/appdata/kms/data",
      "container": "/kms/var",
      "mode": "rw",
      "description": "Path to temp data path",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "false|true",
      "description": "Enable debug mode",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
