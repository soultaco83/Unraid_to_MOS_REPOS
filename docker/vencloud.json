{
  "name": "Vencloud",
  "repo": "ghcr.io/vencord/vencloud:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/vencord/vencloud",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://vencord.dev/assets/logo-nav.avif",
  "project": "https://vencord.dev/",
  "support": "https://vencord.dev/cloud/",
  "description": "Self-hosted cloud for syncing Vencord settings.",
  "requires": "Requires a separate Redis instance.",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Redis - URI",
      "key": "REDIS_URI",
      "value": null,
      "description": "Connection URL to Redis database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Discord - Client ID",
      "key": "DISCORD_CLIENT_ID",
      "value": null,
      "description": "Client ID for Discord authentication",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Discord - Client Secret",
      "key": "DISCORD_CLIENT_SECRET",
      "value": null,
      "description": "Client secret for Discord authentication",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Discord - Redirect URI",
      "key": "DISCORD_REDIRECT_URI",
      "value": null,
      "description": "Redirect URI for Discord authentication",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Pepper - Secrets",
      "key": "PEPPER_SECRETS",
      "value": null,
      "description": "Used to generate secret key for each user's API secret. Generate with 'openssl rand -hex 64'",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Pepper - Settings",
      "key": "PEPPER_SETTINGS",
      "value": null,
      "description": "Used to generate secret key for each user's settings. Generate with 'openssl rand -hex 64'",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Allowed Users",
      "key": "ALLOWED_USERS",
      "value": null,
      "description": "Comma-separated whitelist for users to use this service. If empty, all users allowed.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Root Redirect",
      "key": "ROOT_REDIRECT",
      "value": "https://github.com/Vencord/Vencloud",
      "description": "URL that the root of the API will redirect to.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Expose Prometheus Metrics",
      "key": "PROMETHEUS",
      "value": "false|true",
      "description": "Enable to offer metrics at /metrics",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Proxy Header",
      "key": "PROXY_HEADER",
      "value": null,
      "description": "Leave empty if not using reverse proxy.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Size Limits",
      "key": "SIZE_LIMIT",
      "value": "32000000",
      "description": "The maximum settings backup size, in bytes",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Host",
      "key": "HOST",
      "value": "0.0.0.0",
      "description": "Internal host. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "8080",
      "description": "Internal port. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Data Path",
      "key": "APP_DATA_DIR",
      "value": "/data",
      "description": "Internal data path. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
