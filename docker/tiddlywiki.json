{
  "name": "tiddlywiki",
  "repo": "elasticdog/tiddlywiki",
  "category": [
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/elasticdog/tiddlywiki/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": null,
  "project": "https://github.com/Jermolene/TiddlyWiki5",
  "support": "https://hub.docker.com/r/elasticdog/tiddlywiki/",
  "description": "TiddlyWiki is a self-contained JavaScript wiki, configured here to run as a Node.js application.\r\n\r\nConverted By Community Applications   Always verify this template (and values)  against the support page for the container",
  "paths": [
    {
      "name": "AppData Location",
      "host": "/mnt/cache/appdata/tiddlywiki",
      "container": "/tiddlywiki",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
