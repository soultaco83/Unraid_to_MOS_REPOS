{
  "name": "Answer",
  "repo": "apache/answer:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/apache/answer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/install",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/answer-icon.png",
  "project": "https://answer.apache.org",
  "support": "https://answer.apache.org/docs",
  "description": "Apache Answer helps you to build a community between your users and your team. It's a place where you can share your knowledge and help your users to solve their problems.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/answer/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
