{
  "name": "Aliyundrive-Webdav",
  "repo": "messense/aliyundrive-webdav",
  "category": [
    "Hosting"
  ],
  "registry": "https://hub.docker.com/r/messense/aliyundrive-webdav/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2412]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Alidrive_A.png",
  "project": "https://github.com/messense/aliyundrive-webdav",
  "support": "https://github.com/messense/aliyundrive-webdav",
  "description": "阿里云盘 WebDAV\r\n\r\nYouTube: https://www.youtube.com/channel/UCPj4GP1FxDt0I23GhctHRFA\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/Aliyundrive-Webdav",
      "container": "/etc/aliyundrive-webdav/",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "2412",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Refresh Token",
      "key": "REFRESH_TOKEN",
      "value": "Your Refresh Token",
      "description": "Refresh Token",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Username",
      "key": "WEBDAV_AUTH_USER",
      "value": "Your Username",
      "description": "Username",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Password",
      "key": "WEBDAV_AUTH_PASSWORD",
      "value": "Your Password",
      "description": "Password",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
