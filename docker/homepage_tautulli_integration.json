{
  "name": "Homepage Tautulli Integration",
  "repo": "ghcr.io/10mfox/gethomepage-tautulli-custom-api:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/10mfox/gethomepage-tautulli-custom-api",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3008]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/homepage-tautulli-integration-icon.png",
  "project": "https://github.com/10mfox/Gethomepage-Tautulli-Custom-Api",
  "support": "https://github.com/10mfox/Gethomepage-Tautulli-Custom-Api/issues",
  "description": "A custom API proxy service designed to work with Homepage to display recent media from Tautulli in a formatted way. This service provides endpoints for recently added TV shows and movies from your Plex server via Tautulli.",
  "requires": "Meant to work with the Homepage application.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/homepage_tautulli/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3008",
      "container": "3008",
      "protocol": "tcp",
      "description": "Container Port: 3008",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Tautulli - Base URL",
      "key": "TAUTULLI_BASE_URL",
      "value": "http://IP_ADDRESS:8181/api/v2",
      "description": "Base URL for Tautulli API",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Tautulli - API Key",
      "key": "TAUTULLI_API_KEY",
      "value": null,
      "description": "API Key for Tautulli",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Web Port",
      "key": "TAUTULLI_API_PORT",
      "value": "3008",
      "description": "Internal port for web server. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
