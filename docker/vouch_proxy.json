{
  "name": "Vouch Proxy",
  "repo": "quay.io/vouch/vouch-proxy:latest",
  "category": [
    "Network",
    "Utilities",
    "Productivity",
    "Misc"
  ],
  "registry": "quay.io/vouch/vouch-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--user 500:500",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9090]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/vouch-proxy-icon.png",
  "project": "https://github.com/vouch/vouch-proxy",
  "support": "https://github.com/vouch/vouch-proxy/issues",
  "description": "An SSO solution for Nginx using the auth_request module. Vouch Proxy can protect all of your websites at once.",
  "requires": "Expects a `config.yml` file at the Config File path before starting the container. See documentation: https://github.com/vouch/vouch-proxy/blob/master/config/config.yml_example_scopes_and_claims",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/vouch-proxy/config/config.yml",
      "container": "/config/config.yml",
      "mode": "rw",
      "description": "Path to config.yml file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Container Port: 9090",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
