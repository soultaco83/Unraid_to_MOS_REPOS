{
  "name": "Chrome-ich777",
  "repo": "ich777/chrome:latest",
  "category": [
    "Utilities",
    "Network"
  ],
  "registry": "https://hub.docker.com/r/ich777/chrome/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3812]/vnc.html?autoconnect=true",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Chrome_A.png",
  "project": "https://hub.docker.com/r/ich777/chrome/",
  "support": "https://hub.docker.com/r/ich777/chrome/",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/Chrome",
      "container": "/chrome",
      "mode": "rw",
      "description": "Data Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "3812",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "VNC Display Width",
      "key": "CUSTOM_RES_W",
      "value": "1366",
      "description": "VNC Display Width",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VNC Display Height",
      "key": "CUSTOM_RES_H",
      "value": "768",
      "description": "VNC Display Height",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "UID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "GID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": "UMASK",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Data Permission",
      "key": "DATA_PERM",
      "value": "770",
      "description": "Data Permission",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
