{
  "name": "mealiev1 (selfhosters)",
  "repo": "ghcr.io/mealie-recipes/mealie:nightly",
  "category": [
    "Productivity"
  ],
  "registry": "ghcr.io/mealie-recipes/mealie:nightly",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/mealiev1.png",
  "project": "https://mealie.io/",
  "support": "https://forums.unraid.net/topic/138058-support-catduck-templates/",
  "description": "Mealie is a self-hosted recipe manager and meal planner with a RestAPI backend and a reactive frontend application built in Vue for a pleasant user experience for the whole family.\r\n\r\nThis is the NEW NIGHTLY for Version. As soon as there is an official stable image tag, this template will be updated to allow for either. \r\n\r\nPlease note, there is only one port now, previously the web port was 3000 and API was 9000. Now there is just 9000. To avoid breaking changes I have by default made the port 3000 with this template. You can of course change to anything you would like, and update your reverse proxies accordingly.\r\n\r\nPlease read https://hay-kot.github.io/mealie/documentation/getting-started/updating/  before updating from earlier (Pre 1.X versions!)\r\n\r\nLastly, Postgres is available and if you want to use mealie with postgres the variables have been added under advanced\r\n\r\nDefault Password: MyPassword",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/mealiev1",
      "container": "/app/data",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3000",
      "container": "9000",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "ALLOW_SIGNUP",
      "key": "ALLOW_SIGNUP",
      "value": "false",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DEFAULT_EMAIL",
      "key": "DEFAULT_EMAIL",
      "value": "changeme@email.com",
      "description": "This email will be your username",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP_FROM_EMAIL",
      "key": "SMTP_FROM_EMAIL",
      "value": "changeme@gmail.com",
      "description": "This is required to send emails and reset initial passowrd",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP_HOST",
      "key": "SMTP_HOST",
      "value": "smtp.gmail.com",
      "description": "Change to suit your SMTP Host",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP_USER",
      "key": "SMTP_USER",
      "value": "changeme@email.com",
      "description": "Put the SMTP user here. \r\nUsually your email",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP_PASSWORD",
      "key": "SMTP_PASSWORD",
      "value": "******",
      "description": "Put your SMTP Password:\r\nLikely you will need a specific app password",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP_PORT",
      "key": "SMTP_PORT",
      "value": "587",
      "description": "Put the SMTP Port here",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "BASE_URL",
      "key": "BASE_URL",
      "value": "https://mealie.mydomain.net",
      "description": "Enter your domain, such as reseverse proxy here",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DEFAULT_GROUP",
      "key": "DEFAULT_GROUP",
      "value": "home",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
