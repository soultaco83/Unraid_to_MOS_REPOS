{
  "name": "Speech-To-Phrase",
  "repo": "rhasspy/wyoming-speech-to-phrase:latest",
  "category": [
    "AI",
    "Home Automation",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/rhasspy/wyoming-speech-to-phrase",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--hass-websocket-uri 'ws://homeassistant.local:8123/api/websocket' --hass-token 'YOUR_LONG_LIVED_ACCESS_TOKEN' --retrain-on-start",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/OHF-Voice/speech-to-phrase/main/icon.png",
  "project": "https://github.com/OHF-voice/speech-to-phrase",
  "support": "https://github.com/OHF-voice/speech-to-phrase/issues",
  "description": "A fast and local speech-to-text system that is personalized with your Home Assistant device and area names.",
  "requires": "Requires a Home Assistant instance. Edit \"Post Arguments\" to include the URL of your Home Assistant instance.",
  "paths": [
    {
      "name": "Models Path",
      "host": null,
      "container": "/models",
      "mode": "rw",
      "description": "Path to the models directory",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Training Path",
      "host": null,
      "container": "/train",
      "mode": "rw",
      "description": "Path to the training directory",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "10300",
      "container": "10300",
      "protocol": "tcp",
      "description": "Container Port: 10300",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
