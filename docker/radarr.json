{
  "name": "radarr",
  "repo": "lscr.io/linuxserver/radarr",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/radarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7878]/system/status",
  "readme_url": "https://github.com/linuxserver/docker-radarr#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/radarr-logo.png",
  "project": "https://github.com/Radarr/Radarr",
  "support": "https://github.com/linuxserver/docker-radarr/issues/new/choose",
  "description": "Radarr(https://github.com/Radarr/Radarr) - A fork of Sonarr to work with movies à la Couchpotato.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Database and Radarr configs",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/movies",
      "host": null,
      "container": "/movies",
      "mode": "rw",
      "description": "Location of Movie library on disk (See note in Application setup)",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "/downloads",
      "host": null,
      "container": "/downloads",
      "mode": "rw",
      "description": "Location of download managers output directory (See note in Application setup)",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "7878",
      "container": "7878",
      "protocol": "tcp",
      "description": "The port for the Radarr Web UI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
