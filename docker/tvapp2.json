{
  "name": "TVApp2 (selfhosters)",
  "repo": "ghcr.io/thebinaryninja/tvapp2:latest",
  "category": [
    "Media",
    "Misc"
  ],
  "registry": "ghcr.io/thebinaryninja/tvapp2",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4124]",
  "icon": "https://raw.githubusercontent.com/TheBinaryNinja/unraid-templates/refs/heads/main/assets/tvapp2-vector.ico",
  "project": "https://github.com/TheBinaryNinja/tvapp2",
  "support": "https://discord.com/channels/1340814107124830229/1342562117651529838",
  "description": "Automatic M3U playlist and XML guide updater for TheTvApp, TVPass, and MoveOnJoy utilized within your IPTV client.\r\n        \r\n        GitHub Project: https://github.com/TheBinaryNinja/tvapp2",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/tvapp2/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to store configuration files.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Build Path",
      "host": "/mnt/cache/appdata/tvapp2/build",
      "container": "/usr/bin/app",
      "mode": "rw",
      "description": "Path to store build files.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4124",
      "container": "4124",
      "protocol": "tcp",
      "description": "Container Port: 4124",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Internal Server IP",
      "key": "WEB_IP",
      "value": "0.0.0.0",
      "description": "IP to use for webserver. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Server Port",
      "key": "WEB_PORT",
      "value": "4124",
      "description": "Port to use for webserver. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Data Files Source",
      "key": "URL_REPO",
      "value": "https://git.binaryninja.net/BinaryNinja/",
      "description": "Determines where the data files will be downloaded from. Do not change this or you will be unable to get M3U and EPG data.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Build Directory",
      "key": "DIR_BUILD",
      "value": "/usr/src/app",
      "description": "Directory to build the app in. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Run Directory",
      "key": "DIR_RUN",
      "value": "/usr/bin/app",
      "description": "Directory to run the app in. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
