{
  "name": "Loggifly",
  "repo": "ghcr.io/clemcer/loggifly:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/clemcer/loggifly",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/clemcer/loggifly/main/images/icon.png",
  "project": "https://github.com/clemcer/loggifly",
  "support": "https://github.com/clemcer/loggifly/issues",
  "description": "Monitor Docker logs and send notifications",
  "requires": "Expects a `config.yaml` file at the Config File path before starting. See documentation: https://github.com/clemcer/loggifly#-Configuration-Deep-Dive",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/loggifly",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
