{
  "name": "Castopod",
  "repo": "castopod/castopod:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/castopod/castopod",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/castopod-icon.png",
  "project": "https://castopod.org/",
  "support": "https://docs.castopod.org",
  "description": "Castopod is a free and open-source hosting platform made for podcasters who want to engage and interact with their audience. \r\n        [br]\n        See documentation for all available configuration options: https://docs.castopod.org/main/en/getting-started/docker/",
  "requires": "Requires separate MariaDB and Redis databases.",
  "paths": [
    {
      "name": "Media Path",
      "host": "/mnt/user/appdata/castopod/media",
      "container": "/var/www/castopod/public/media",
      "mode": "rw",
      "description": "Path to media storage",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "App URL",
      "key": "CP_BASEURL",
      "value": "http://localhost:8000",
      "description": "URL of Castopod. Change to IP or domain.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Analytics Salt",
      "key": "CP_ANALYTICS_SALT",
      "value": null,
      "description": "Salt for analytics",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "MariaDB - Host",
      "key": "CP_DATABASE_HOSTNAME",
      "value": null,
      "description": "Hostname of MariaDB",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "MariaDB - Username",
      "key": "CP_DATABASE_USERNAME",
      "value": null,
      "description": "Username for MariaDB",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "MariaDB - Password",
      "key": "CP_DATABASE_PASSWORD",
      "value": null,
      "description": "Password for MariaDB",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "MariaDB - Database",
      "key": "CP_DATABASE_NAME",
      "value": null,
      "description": "Name of MariaDB database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Host",
      "key": "CP_REDIS_HOST",
      "value": null,
      "description": "Hostname of Redis",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Port",
      "key": "CP_REDIS_PORT",
      "value": "6379",
      "description": "Port of Redis",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Password",
      "key": "CP_REDIS_PASSWORD",
      "value": null,
      "description": "Password for Redis",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Database",
      "key": "CP_REDIS_DATABASE",
      "value": "0",
      "description": "Database number for Redis",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Cache Handler",
      "key": "CP_CACHE_HANDLER",
      "value": "redis|file",
      "description": "Cache handler to use",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
