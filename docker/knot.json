{
  "name": "Knot",
  "repo": "atcr.io/tangled.org/knot:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://atcr.io/r/tangled.org/knot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5555]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/knot-icon.png",
  "project": "https://tangled.org/",
  "support": "https://tangled.org/tangled.org/knot-docker/issues",
  "description": "The next-generation social coding platform, built on the AT Protocol.",
  "requires": "May require a reverse proxy to the web UI.",
  "paths": [
    {
      "name": "Keys Path",
      "host": "/mnt/cache/appdata/knot/keys",
      "container": "/etc/ssh/keys",
      "mode": "rw",
      "description": "Path to server keys",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Repositories Path",
      "host": "/mnt/cache/appdata/knot/repositories",
      "container": "/home/git/repositories",
      "mode": "rw",
      "description": "Path to repositories",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/knot/data",
      "container": "/app",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5555",
      "container": "5555",
      "protocol": "tcp",
      "description": "Container Port: 5555",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SSH Port",
      "host": "2222",
      "container": "22",
      "protocol": "tcp",
      "description": "Container Port: 22",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Server Hostname",
      "key": "KNOT_SERVER_HOSTNAME",
      "value": null,
      "description": "Hostname/domain for instance (e.g. knot.example.com)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Server Owner",
      "key": "KNOT_SERVER_OWNER",
      "value": "did:plc:yourdidgoeshere",
      "description": "Owner string",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "KNOT_SERVER_DB_PATH",
      "value": "/app/knotserver.db",
      "description": "Internal path to database. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Repositories Path",
      "key": "KNOT_REPO_SCAN_PATH",
      "value": "/home/git/repositories",
      "description": "Internal path to repositories. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Listen Address",
      "key": "KNOT_SERVER_INTERNAL_LISTEN_ADDR",
      "value": "localhost:5444",
      "description": "Internal listen address. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
