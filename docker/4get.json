{
  "name": "4get",
  "repo": "luuul/4get:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/luuul/4get/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/SpaceinvaderOne/Docker-Templates-Unraid/master/spaceinvaderone/docker_icons/4get.png",
  "project": "https://git.lolcat.ca/lolcat/4get",
  "support": "https://git.lolcat.ca/lolcat/4get/issues",
  "description": "4get is a lightweight, open-source proxy search engine designed to provide a private, ad-free search experience. It allows users to query popular search engines like Google, DuckDuckGo, and others without tracking or displaying sponsored ads. Beyond web searches, 4get supports media-specific queries for videos, images, music, and more, making it a versatile tool for privacy-conscious users.\r\nFor enhanced privacy, it can be combined with Tailscale (Unraid 7 and above) for secure remote access and routed through a VPN exit point for IP anonymisation.\r\n\r\nFeatures\r\n\t•\tProxy-based search for privacy and simplicity.\r\n\t•\tSupport for multiple search engines and media-specific queries (web, video, images, music, etc.).\r\n\t•\tNo ads or sponsored results.\r\n\r\nSetup Recommendations\r\n\t•\tCombine with Tailscale for secure, remote access.\r\n\t•\tUse with a VPN exit point (e.g., Gluetun VPN) to anonymise outgoing queries.",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/user/appdata/4get/",
      "container": "/config",
      "mode": "rw",
      "description": "appdata root",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "certs",
      "host": "/mnt/user/appdata/4get/certs/",
      "container": "/etc/4get/certs",
      "mode": "rw",
      "description": "Not usually needed",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "captcha",
      "host": "/mnt/user/appdata/4get/captcha/",
      "container": "/var/www/html/4get/data/captcha",
      "mode": "rw",
      "description": "captcha",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "banners",
      "host": "/mnt/user/appdata/4get/banner/",
      "container": "/var/www/html/4get/banner",
      "mode": "rw",
      "description": "custom banner location",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Webui",
      "host": "280",
      "container": "80",
      "protocol": "tcp",
      "description": "Webui port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Server name",
      "key": "FOURGET_SERVER_NAME",
      "value": null,
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "http/https",
      "key": "FOURGET_PROTO",
      "value": "http",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Bot protection",
      "key": "FOURGET_BOT_PROTECTION",
      "value": "0",
      "description": "bot protection only need if on open interent",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
