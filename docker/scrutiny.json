{
  "name": "scrutiny",
  "repo": "ghcr.io/analogj/scrutiny:master-omnibus",
  "category": [
    "Home Automation",
    "Utilities"
  ],
  "registry": "https://github.com/AnalogJ/scrutiny/pkgs/container/scrutiny",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/scrutiny.png",
  "project": "https://github.com/AnalogJ/scrutiny",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Hard Drive S.M.A.R.T Monitoring, Historical Trends and Real World Failure Thresholds",
  "paths": [
    {
      "name": "Host Path 1",
      "host": "/run/udev",
      "container": "/run/udev",
      "mode": "ro",
      "description": "Container Path: /run/udev",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Host Path 2",
      "host": "/dev/disk",
      "container": "/dev/disk",
      "mode": "ro",
      "description": "Container Path: /dev/disk",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config",
      "host": null,
      "container": "/opt/scrutiny/config",
      "mode": "rw",
      "description": "Container Path: /opt/scrutiny/config",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database",
      "host": null,
      "container": "/opt/scrutiny/influxdb",
      "mode": "rw",
      "description": "Container Path: /opt/scrutiny/influxdb",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
