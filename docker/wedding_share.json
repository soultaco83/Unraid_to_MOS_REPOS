{
  "name": "WeddingShare",
  "repo": "cirx08/wedding_share:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/cirx08/wedding_share",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://docs.wedding-share.org/img/logo.png",
  "project": "https://github.com/cirx08/WeddingShare",
  "support": "https://docs.wedding-share.org/",
  "description": "A place for guests to view and drop pictures of the big day.",
  "paths": [
    {
      "name": "Uploads Path",
      "host": "/mnt/user/appdata/wedding_share/uploads",
      "container": "/app/wwwroot/uploads",
      "mode": "rw",
      "description": "Path to uploaded files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Thumbnails Path",
      "host": "/mnt/user/appdata/wedding_share/thumbnails",
      "container": "/app/wwwroot/thumbnails",
      "mode": "rw",
      "description": "Path to thumbnail images",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/wedding_share/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Custom Resources Path",
      "host": "/mnt/user/appdata/wedding_share/custom_resources",
      "container": "/app/wwwroot/custom_resources",
      "mode": "rw",
      "description": "Path to custom resources (CSS, JS, etc.)",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "App Title",
      "key": "TITLE",
      "value": "Wedding Share",
      "description": "Title of the app",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Logo",
      "key": "LOGO",
      "value": "/images/logo.png",
      "description": "Relative path to the logo image",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Single Gallery Mode",
      "key": "SINGLE_GALLERY_MODE",
      "value": "false|true",
      "description": "Should this instance host a single gallery instance?",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Owner Username",
      "key": "ACCOUNT_OWNER_USERNAME",
      "value": "admin",
      "description": "The username of the primary owner account",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Owner Password",
      "key": "ACCOUNT_OWNER_PASSWORD",
      "value": null,
      "description": "The password of the primary owner account",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
