{
  "name": "Trakt Tools",
  "repo": "xbgmsharp/docker-trakt-tools:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/xbgmsharp/docker-trakt-tools",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/trakt-tools-icon.png",
  "project": "https://github.com/xbgmsharp/trakt",
  "support": "https://github.com/xbgmsharp/trakt/issues",
  "description": "A CLI tool to import and export Trakt.tv, Kodi and CouchPotato data to/from CSV files.",
  "requires": "This is a CLI tool. Open a Console in the container and run `python export_trakt.py` or `python import_trakt.py` to use it. \r\n        [br]\n        User will need to create a `config.ini` file in the Config Path: https://github.com/xbgmsharp/trakt?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/trakt_tools/config",
      "container": "/trakt/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Export path",
      "host": "/mnt/cache/appdata/trakt_tools/export",
      "container": "/trakt/export",
      "mode": "rw",
      "description": "Path to export files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
