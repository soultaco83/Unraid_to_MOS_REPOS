{
  "name": "Openbooks",
  "repo": "evanbuss/openbooks:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/evanbuss/openbooks",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--name $NAME --server irc.irchighway.net:6697 --searchbot search --persist true --dir /books",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/openbooks-icon.png",
  "project": "https://evan-buss.github.io/openbooks/",
  "support": "https://evan-buss.github.io/openbooks/configuration/",
  "description": "Provides a convenient user interface over IRC Highway's #ebook channel. It streamlines the process of connecting, searching for, and downloading books.",
  "requires": "In **Post Arguments**, replace $NAME with your IRC username. Optionally, change the server and searchbot.",
  "paths": [
    {
      "name": "Books Storage Path",
      "host": null,
      "container": "/books",
      "mode": "rw",
      "description": "Directory where search results and eBooks are saved.",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
