{
  "name": "pairdrop (linuxserver)",
  "repo": "lscr.io/linuxserver/pairdrop",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/pairdrop",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "readme_url": "https://github.com/linuxserver/docker-pairdrop#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://github.com/schlagmichdoch/PairDrop",
  "support": "https://github.com/linuxserver/docker-pairdrop/issues/new/choose",
  "description": "PairDrop(https://github.com/schlagmichdoch/PairDrop) is a sublime alternative to AirDrop that works on all platforms. Send images, documents or text via peer to peer connection to devices in the same local network/Wi-Fi or to paired devices.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "http gui",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "RATE_LIMIT",
      "key": "RATE_LIMIT",
      "value": "false",
      "description": "Set to `true` to limit clients to 100 requests per 5 min",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WS_FALLBACK",
      "key": "WS_FALLBACK",
      "value": "false",
      "description": "Set to `true` to enable websocket fallback if the peer to peer WebRTC connection is not available to the client (see App Setup notes).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "RTC_CONFIG",
      "key": "RTC_CONFIG",
      "value": null,
      "description": "Path to a json file containing custom STUN/TURN config (see App Setup notes)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DEBUG_MODE",
      "key": "DEBUG_MODE",
      "value": "false",
      "description": "Set to `true` to debug the http server configuration by logging clients IP addresses used by PairDrop to STDOUT. See here for more info(https://github.com/schlagmichdoch/PairDrop/blob/master/docs/host-your-own.md#debug-mode). Do not use in production!",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
