{
  "name": "GPU Hot",
  "repo": "ghcr.io/psalias2006/gpu-hot:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/psalias2006/gpu-hot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1312]/",
  "icon": "https://raw.githubusercontent.com/psalias2006/gpu-hot/main/static/favicon.svg",
  "project": "https://github.com/psalias2006/gpu-hot",
  "support": "https://github.com/psalias2006/gpu-hot/issues",
  "description": "Real-time NVIDIA GPU Monitoring Dashboard",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "1312",
      "container": "1312",
      "protocol": "tcp",
      "description": "Container Port: 1312",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Nvidia SMI Mode",
      "key": "NVIDIA_SMI",
      "value": "false|true",
      "description": "Force nvidia-smi mode (for older GPUs)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
