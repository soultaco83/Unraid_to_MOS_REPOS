{
  "name": "TV Rename",
  "repo": "jasongdove/tvrename:develop",
  "category": [
    "Media",
    "Misc",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/jasongdove/tvrename",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tv-rename-icon.png",
  "project": "https://github.com/jasongdove/tvrename",
  "support": "https://github.com/jasongdove/tvrename/issues",
  "description": "Identify and rename television episode files.",
  "requires": "This is a CLI tool. Please edit the **Post Arguments** accordingly. See documentation: https://github.com/jasongdove/tvrename",
  "paths": [
    {
      "name": "Temp Path",
      "host": "/mnt/cache/appdata/tv_rename/tmp",
      "container": "/tmp/tv",
      "mode": "rw",
      "description": "Path to temp files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/tv_rename/cache",
      "container": "/cache",
      "mode": "rw",
      "description": "Path to cache files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
