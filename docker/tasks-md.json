{
  "name": "tasks.md",
  "repo": "baldissaramatheus/tasks.md",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/baldissaramatheus/tasks.md",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/tasks_md_logo.png",
  "project": "https://github.com/BaldissaraMatheus/Tasks.md",
  "support": "https://forums.unraid.net/topic/152354-support-devzwf-tasksmd/",
  "description": "A self-hosted, Markdown file based task management board.",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Config Dir",
      "host": "/mnt/user/appdata/tasks-md/config",
      "container": "/config",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Tasks Directory",
      "host": "/mnt/user/appdata/tasks-md/tasks",
      "container": "/tasks",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "1000",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "1000",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
