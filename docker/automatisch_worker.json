{
  "name": "Automatisch - Worker",
  "repo": "automatischio/automatisch:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/automatischio/automatisch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/automatisch-icon.png",
  "project": "https://automatisch.io",
  "support": "https://automatisch.io/docs",
  "description": "Automatisch is a business automation tool that lets you connect different services like Twitter, Slack, and more to automate your business processes.",
  "requires": "This application requires separate Postgres and Redis databases. See documentation: https://automatisch.io/docs/advanced/configuration \r\n        [br]\n        This is the worker for Automatisch. A separate web interface container is required to run the application.",
  "paths": [
    {
      "name": "Storage path",
      "host": "/mnt/user/appdata/automatisch/storage",
      "container": "/automatisch/storage",
      "mode": "rw",
      "description": "Data storage path for application",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Redis - Host",
      "key": "REDIS_HOST",
      "value": "localhost",
      "description": "Host for Redis server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Port",
      "key": "REDIS_PORT",
      "value": "6379",
      "description": "Port for Redis server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Username",
      "key": "REDIS_USERNAME",
      "value": null,
      "description": "Username for Redis server",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Password",
      "key": "REDIS_PASSWORD",
      "value": null,
      "description": "Password for Redis server",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Host",
      "key": "POSTGRES_HOST",
      "value": "localhost",
      "description": "Host for Postgres server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Port",
      "key": "POSTGRES_PORT",
      "value": "5432",
      "description": "Port for Postgres server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Database Name",
      "key": "POSTGRES_DATABASE",
      "value": "automatisch",
      "description": "Database name for Postgres server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Username",
      "key": "POSTGRES_USERNAME",
      "value": null,
      "description": "Username for Postgres server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Password",
      "key": "POSTGRES_PASSWORD",
      "value": null,
      "description": "Password for Postgres server",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Encryption Key",
      "key": "ENCRYPTION_KEY",
      "value": null,
      "description": "Encryption Key to store credentials",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Webhook Secret Key",
      "key": "WEBHOOK_SECRET_KEY",
      "value": null,
      "description": "Webhook Secret Key to verify webhook requests",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Secret Key",
      "key": "APP_SECRET_KEY",
      "value": null,
      "description": "Secret Key to authenticate the user",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Environment",
      "key": "APP_ENV",
      "value": "production",
      "description": "Environment for the application. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Is Worker",
      "key": "WORKER",
      "value": "true",
      "description": "Enable worker mode. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
