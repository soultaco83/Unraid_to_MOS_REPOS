{
  "name": "conduwuit",
  "repo": "girlbossceo/conduwuit:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/girlbossceo/conduwuit",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6167]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/conduwuit-icon.png",
  "project": "https://conduwuit.puppyirl.gay/",
  "support": "https://github.com/girlbossceo/conduwuit/issues",
  "description": "A very cool, featureful fork of conduit (Rust matrix homeserver)",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/conduwuit/database",
      "container": "/var/lib/conduwuit",
      "mode": "rw",
      "description": "Path to database files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6167",
      "container": "6167",
      "protocol": "tcp",
      "description": "Container Port: 6167",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Server Name",
      "key": "CONDUWUIT_SERVER_NAME",
      "value": "your.server.name",
      "description": "The server name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Allow Registration",
      "key": "CONDUWUIT_ALLOW_REGISTRATION",
      "value": "false|true",
      "description": "Allow registration of new users",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Are You Sure You Want to Allow Registrations?",
      "key": "CONDUWUIT_YES_I_AM_VERY_VERY_SURE_I_WANT_AN_OPEN_REGISTRATION_SERVER_PRONE_TO_ABUSE",
      "value": "false|true",
      "description": "Registration is prone to abuse.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Registration Token",
      "key": "CONDUWUIT_REGISTRATION_TOKEN",
      "value": null,
      "description": "Token for registration. Required if registration is enabled. Delete if disabled.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Allow Federation",
      "key": "CONDUWUIT_ALLOW_FEDERATION",
      "value": "false|true",
      "description": "Allow federation with other matrix servers",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Allow Update Checks",
      "key": "CONDUWUIT_ALLOW_CHECK_FOR_UPDATES",
      "value": "false|true",
      "description": "Allow the server to check for updates",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Trusted Servers",
      "key": "CONDUWUIT_TRUSTED_SERVERS",
      "value": "['matrix.org']",
      "description": "List of trusted servers.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "CONDUWUIT_DATABASE_PATH",
      "value": "/var/lib/conduwuit",
      "description": "Path to database files inside the container. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "CONDUWUIT_PORT",
      "value": "6167",
      "description": "Port inside the container. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Max Request Size",
      "key": "CONDUWUIT_MAX_REQUEST_SIZE",
      "value": "20000000",
      "description": "Size, in bytes, of the maximum request size. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Server Address",
      "key": "CONDUWUIT_ADDRESS",
      "value": "0.0.0.0",
      "description": "Internal address of the server. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
