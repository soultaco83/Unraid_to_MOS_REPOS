{
  "name": "Sosse",
  "repo": "biolds/sosse:latest",
  "category": [
    "Backup",
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/biolds/sosse",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/sosse-icon.png",
  "project": "https://sosse.io",
  "support": "https://sosse.readthedocs.io/en/stable/install/docker.html",
  "description": "Sosse (Selenium Open Source Search Engine) is a web archiving software, crawler, and search engine",
  "paths": [
    {
      "name": "Storage Path",
      "host": null,
      "container": "/var/lib/sosse",
      "mode": "rw",
      "description": "Path to store downloaded files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/sosse/config",
      "container": "/etc/sosse",
      "mode": "rw",
      "description": "Path to store the configuration",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/user/appdata/sosse/logs",
      "container": "/var/log/sosse",
      "mode": "rw",
      "description": "Path to store the logs",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8005",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
