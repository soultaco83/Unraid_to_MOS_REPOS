{
  "name": "Plauna",
  "repo": "ozangulle/plauna:dev",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/ozangulle/plauna",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/plauna-icon.png",
  "project": "https://github.com/ozangulle/plauna",
  "support": "https://github.com/ozangulle/plauna/issues",
  "description": "Plauna is a privacy focused service that helps you categorize your e-mails. All of its data is stored only on your computer. You can parse your e-mails from mbox files or directly by connecting to your IMAP servers. Plauna helps you categorize your e-mails and automates the process so that incoming e-mails are moved to their respective folders on your IMAP server.",
  "requires": "Requires a `plauna.edn` file in the Config Path folder. See documentation: https://github.com/ozangulle/plauna?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/plauna/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/plauna/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Server Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Run Args",
      "key": "PLAUNA_ARGS",
      "value": "--config-file=/config/plauna.edn",
      "description": "Args to use when the app in the container",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
