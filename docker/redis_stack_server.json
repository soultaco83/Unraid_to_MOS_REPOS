{
  "name": "redis-stack-server",
  "repo": "redis/redis-stack-server:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/redis/redis-stack-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://www.gravatar.com/avatar/d97b18081fdbcb9838acfeaa4335e3d3",
  "project": "https://redis.io",
  "support": "https://redis.io/about/redis-stack/",
  "description": "redis-stack installs a Redis server with additional database capabilities.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/redis_stack_server/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Redis Port",
      "host": "6379",
      "container": "6379",
      "protocol": "tcp",
      "description": "Redis Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
