{
  "name": "Lufi",
  "repo": "ghcr.io/megalis-bretagne/lufi:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/megalis-bretagne/lufi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://framagit.org/uploads/-/system/project/avatar/1998/lufi.png",
  "project": "https://framagit.org/fiat-tux/hat-softwares/lufi",
  "support": "https://framagit.org/fiat-tux/hat-softwares/lufi",
  "description": "Let's Upload that FIle - An E2E encrypted file sharing software.",
  "requires": "Requires a `lufi.conf` file to be mounted at the Config File path before starting the container. See configuration details: https://github.com/megalis-bretagne/lufi-docker/blob/main/lufi.conf",
  "paths": [
    {
      "name": "File Storage",
      "host": "/mnt/user/appdata/lufi/files",
      "container": "/lufi/files",
      "mode": "rw",
      "description": "Path to file storage",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/lufi/lufi.conf",
      "container": "/home/nonroot/lufi/lufi.conf",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
