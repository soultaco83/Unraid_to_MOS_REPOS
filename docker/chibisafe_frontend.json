{
  "name": "Chibisafe - Frontend",
  "repo": "chibisafe/chibisafe-server:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/chibisafe/chibisafe-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8001]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/chibisafe-icon.png",
  "project": "https://chibisafe.app/",
  "support": "https://chibisafe.app/docs/installation/running-with-docker",
  "description": "A modern and self-hosted take on file uploading services that can handle anything you throw at it thanks to its robust and fast API, chunked uploads support and more. \r\n        [br]\n        This is the backend server. You will need to install Chibisafe - Backend as well.",
  "requires": "Requires a separate installation of Chibisafe - Backend and Caddy.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "Container Port: 8001",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Backend URL",
      "key": "BASE_API_URL",
      "value": "http://chibisafe_server:8000",
      "description": "URL of the backend server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
