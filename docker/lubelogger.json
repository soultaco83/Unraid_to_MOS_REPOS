{
  "name": "LubeLogger",
  "repo": "ghcr.io/hargata/lubelogger:latest",
  "category": [
    "Utilities",
    "Misc"
  ],
  "registry": "https://github.com/hargata/lubelog/pkgs/container/lubelogger",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/lubelogger_logo.png",
  "project": "https://github.com/hargata/lubelog",
  "support": "https://forums.unraid.net/topic/151070-support-devzwf-lubelogger/",
  "description": "A self-hosted, open-source vehicle service records and maintainence tracker.",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Config Directory",
      "host": "/mnt/user/appdata/lubelogger/config",
      "container": "/App/config",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Data Directory",
      "host": "/mnt/user/appdata/lubelogger/data",
      "container": "/App/data",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Documents directory",
      "host": "/mnt/user/appdata/lubelogger/documents",
      "container": "/App/data/documents",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Images directory",
      "host": "/mnt/user/appdata/lubelogger/images",
      "container": "/App/data/images",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Logs Directory",
      "host": "/mnt/user/appdata/lubelogger/log",
      "container": "/App/log",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Keys Directory",
      "host": "/mnt/user/appdata/lubelogger/keys",
      "container": "/root/.aspnet/DataProtection-Keys",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "LC_ALL",
      "key": "LC_ALL",
      "value": "en_US.UTF-8",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "LANG",
      "key": "LANG",
      "value": "en_US.UTF-8",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
