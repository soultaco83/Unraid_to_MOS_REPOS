{
  "name": "DD Bot",
  "repo": "assaro/ddbot:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/assaro/ddbot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dd-bot-icon.png",
  "project": "https://github.com/Assaro/DD_Bot",
  "support": "https://github.com/Assaro/DD_Bot/issues",
  "description": "Discord bot to control Docker services via the Docker socket",
  "requires": "After installing the container, you will need to configure the bot via the `settings.json` file in the Config path: https://github.com/Assaro/DD_Bot/blob/master/sites/settings.md",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/user/appdata/dd_bot/config",
      "container": "/app/settings",
      "mode": "rw",
      "description": "Storage for config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Gives DDBot the ability to restart, stop, start, refresh and remove containers.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
