{
  "name": "DocuWiki",
  "repo": "dokuwiki/dokuwiki:stable",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/dokuwiki/dokuwiki",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/docuwiki-icon.png",
  "project": "https://www.dokuwiki.org/dokuwiki",
  "support": "https://www.dokuwiki.org/install",
  "description": "A simple to use and highly versatile Open Source wiki software that doesn't require a database. It is loved by users for its clean and readable syntax. The ease of maintenance, backup and integration makes it an administrator's favorite. Built in access controls and authentication connectors make DokuWiki especially useful in the enterprise context and the large number of plugins contributed by its vibrant community allow for a broad range of use cases beyond a traditional wiki.",
  "paths": [
    {
      "name": "Storage path",
      "host": "/mnt/user/appdata/docuwiki/storage",
      "container": "/storage",
      "mode": "rw",
      "description": "Path to stored files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PHP Timezone",
      "key": "PHP_TIMEZONE",
      "value": "UTC",
      "description": "Timezone used by PHP.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PHP Memory Limit",
      "key": "PHP_MEMORYLIMIT",
      "value": "256M",
      "description": "Maximum amount of memory a script may consume.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PHP Upload Limit",
      "key": "PHP_UPLOADLIMIT",
      "value": "128M",
      "description": "Maximum size of an uploaded file.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
