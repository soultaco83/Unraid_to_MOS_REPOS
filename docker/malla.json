{
  "name": "Malla",
  "repo": "ghcr.io/zenitram/malla:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/zenitram/malla",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "/app/.venv/bin/malla-web-gunicorn",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5008]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/malla-icon.png",
  "project": "https://github.com/zenitraM/malla",
  "support": "https://github.com/zenitraM/malla/issues",
  "description": "Malla is a web analyzer for Meshtastic networks based on MQTT data. \r\n        \r\n        This is the web component.",
  "requires": "Requires a separate Malla - Capture instance. \r\n        \r\n        Requires a `config.yaml` file to be mounted at `/app/config.yaml` before starting the container. See configuration details: https://github.com/zenitraM/malla/blob/main/config.sample.yaml",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/malla/config.yaml",
      "container": "/app/config.yaml",
      "mode": "ro",
      "description": "Path to the Malla config file.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/malla/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to store Malla data.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5008",
      "container": "5008",
      "protocol": "tcp",
      "description": "Container Port: 5008",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "App Name",
      "key": "MALLA_NAME",
      "value": "Malla",
      "description": "Name of the Malla instance.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "MALLA_SECRET_KEY",
      "value": null,
      "description": "Secret key.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Debug Mode",
      "key": "MALLA_DEBUG",
      "value": "false|true",
      "description": "Enable debug mode.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Host",
      "key": "MALLA_HOST",
      "value": "0.0.0.0",
      "description": "Internal host address for Malla web server. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "MALLA_PORT",
      "value": "5008",
      "description": "Internal port for Malla web server. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "MALLA_DATABASE_FILE",
      "value": "/app/data/meshtastic_history.db",
      "description": "Path to the internal database file inside the container. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
