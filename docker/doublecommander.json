{
  "name": "doublecommander (linuxserver)",
  "repo": "lscr.io/linuxserver/doublecommander",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/doublecommander",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "readme_url": "https://github.com/linuxserver/docker-doublecommander#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/doublecommander-logo.png",
  "project": "https://doublecmd.sourceforge.io/",
  "support": "https://github.com/linuxserver/docker-doublecommander/issues/new/choose",
  "description": "Double Commander(https://doublecmd.sourceforge.io/) is a free cross platform open source file manager with two panels side by side. It is inspired by Total Commander and features some new ideas.",
  "donate": "https://www.linuxserver.io/donate",
  "requires": "This image is unprotected by default __**do not**__ expose it to the internet.\n        Please read https://github.com/linuxserver/docker-doublecommander#security for more information.",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores program settings.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/data",
      "host": null,
      "container": "/data",
      "mode": "rw",
      "description": "Host data directories, mount as many as needed.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Double Commander desktop gui HTTP, must be proxied.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Double Commander desktop gui HTTPS.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
