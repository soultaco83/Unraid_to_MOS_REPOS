{
  "name": "Tara Assistant",
  "repo": "ghcr.io/tarahome/taraassistant:latest",
  "category": [
    "AI",
    "Home Automation",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/tarahome/taraassistant",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tara-assistant-icon.png",
  "project": "https://github.com/TaraHome/taraassistant-public",
  "support": "https://github.com/TaraHome/taraassistant-public/issues",
  "description": "A system that watches how you live, finds the patterns you forgot to articulate, and turns those into Home Assistant automations you can actually inspect, edit, and own.",
  "requires": "Requires a separate Home Assistant instance and an LLM connection.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/tara_assistant/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the app data folder",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
