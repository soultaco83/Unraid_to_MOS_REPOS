{
  "name": "Dasharr",
  "repo": "ghcr.io/frenchgithubuser/dasharr:latest",
  "category": [
    "Downloader",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/frenchgithubuser/dasharr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dasharr-icon.png",
  "project": "https://github.com/FrenchGithubUser/Dasharr",
  "support": "https://github.com/FrenchGithubUser/Dasharr/issues",
  "description": "Dashboard of your indexers' usage",
  "requires": "Requires a `config.json` file to be in the Config Files path before starting the container. See configuration details: https://github.com/FrenchGithubUser/Dasharr/blob/main/backend/config_sample/config_sample.json \r\n        \r\n        Requires a separate Prowlarr instance.",
  "paths": [
    {
      "name": "Prowlarr Database Path",
      "host": null,
      "container": "/backend/prowlarr/prowlarr.db",
      "mode": "ro",
      "description": "Path to the Prowlarr database file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Files",
      "host": "/mnt/user/appdata/dasharr/config",
      "container": "/backend/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "API Key",
      "key": "API_KEY",
      "value": null,
      "description": "API Key for accessing the Dasharr API",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
