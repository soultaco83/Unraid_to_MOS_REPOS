{
  "name": "proxmox-backup-server",
  "repo": "ayufan/proxmox-backup-server:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/ayufan/proxmox-backup-server",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped --memory=2g --mount type=tmpfs,destination=/run",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:8007]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/pbs-logo.jpg",
  "project": "https://github.com/ayufan/pve-backup-server-dockerfiles",
  "support": "https://forums.unraid.net/topic/133141-support-devzwf-proxmox-backup-server-dockerfiles/",
  "description": "Proxmox Backup Server in a Container\r\nThis is an unofficial compilation of Proxmox Backup Server to run it in a container for AMD64 and ARM64.\r\n\r\nRunning in a container might result in some functions not working properly. Feel free to create an issue to debug those.\r\n\r\n login to https://:8007/ with admin / pbspbs. After that change a password.\r\n\r\nNote:\r\nThe core features should work, but there are ones do not work due to container architecture:\r\n       ZFS: it is not installed in a container\r\n       Shell: since the PVE (not PAM) authentication is being used, and since the shell access does not make sense in an ephemeral container environment\r\n       PAM authentication: since containers are by definition ephemeral and no /etc/ configs are being persisted",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "pbs_etc",
      "host": "/mnt/user/appdata/pbs/etc",
      "container": "/etc/proxmox-backup",
      "mode": "rw",
      "description": "ETC",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "pbs_logs",
      "host": "/mnt/user/appdata/pbs/logs",
      "container": "/var/log/proxmox-backup",
      "mode": "rw",
      "description": "Logs Directory",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "pbs_lib",
      "host": "/mnt/user/appdata/pbs/lib",
      "container": "/var/lib/proxmox-backup",
      "mode": "rw",
      "description": "Lib Directory",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Backup Dir",
      "host": "/mnt/user/pbs_backup/",
      "container": "/backups",
      "mode": "rw",
      "description": "Backup Directory (Datastore)",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "America/Toronto",
      "description": "TZ",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
