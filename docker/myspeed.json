{
  "name": "MySpeed",
  "repo": "germannewsmaker/myspeed",
  "category": [
    "Utilities",
    "Network",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/germannewsmaker/myspeed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5216]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/myspeed_logo.png",
  "project": "https://myspeed.dev/",
  "support": "https://forums.unraid.net/topic/168514-support-devzwf-myspeeddev/",
  "description": "MySpeed is a Software that helps you keeping track of your network speed.\r\n\r\nIt automatically creates speedtests based on your schedule and displays them in a list.",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/user/appdata/myspeed",
      "container": "/myspeed/data",
      "mode": "rw",
      "description": "Data Directory",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5216",
      "container": "5216",
      "protocol": "tcp",
      "description": "Web UI port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
