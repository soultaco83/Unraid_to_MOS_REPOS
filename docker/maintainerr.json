{
  "name": "maintainerr",
  "repo": "jorenn92/maintainerr:latest",
  "category": [
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/jorenn92/maintainerr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://github.com/jorenn92/Maintainerr/blob/main/ui/public/logo.png?raw=true",
  "project": "https://github.com/jorenn92/Maintainerr/tree/main",
  "support": "https://github.com/jorenn92/Maintainerr/issues",
  "description": "Maintainerr makes managing your media easy. Create custom rules with parameters across different services, show matching media on the Plex home screen for a given amount of days and handle the deletion.",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/maintainerr",
      "container": "/opt/data",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8154",
      "container": "80",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Chicago",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
