{
  "name": "deluge (linuxserver)",
  "repo": "lscr.io/linuxserver/deluge",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/deluge",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8112]",
  "readme_url": "https://github.com/linuxserver/docker-deluge#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/deluge-logo.png",
  "project": "http://deluge-torrent.org/",
  "support": "https://github.com/linuxserver/docker-deluge/issues/new/choose",
  "description": "Deluge(http://deluge-torrent.org/) is a lightweight, Free Software, cross-platform BitTorrent client.\n\n* Full Encryption\n* WebUI\n* Plugin System\n* Much more...",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "deluge configs",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/downloads",
      "host": null,
      "container": "/downloads",
      "mode": "rw",
      "description": "torrent download directory",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8112",
      "container": "8112",
      "protocol": "tcp",
      "description": "Port for webui",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "6881",
      "host": "6881",
      "container": "6881",
      "protocol": "tcp",
      "description": "Inbound torrent traffic (See App Setup)",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "6881",
      "host": "6881",
      "container": "6881",
      "protocol": "udp",
      "description": "Inbound torrent traffic (See App Setup)",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "58846",
      "host": "58846",
      "container": "58846",
      "protocol": "tcp",
      "description": "Default deluged port for thin client connectivity",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "DELUGE_LOGLEVEL",
      "key": "DELUGE_LOGLEVEL",
      "value": "error",
      "description": "set the loglevel output when running Deluge, default is info for deluged and warning for delgued-web",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
