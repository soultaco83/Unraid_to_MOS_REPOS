      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HTTPS",
      "key": "HTTPS_SERVER_NAME",
      "value": "link.EXAMPLE.COM",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
