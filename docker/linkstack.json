      "value": "America/Chicago",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PHP Mmory",
      "key": "PHP_MEMORY_LIMIT",
      "value": "512M",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
