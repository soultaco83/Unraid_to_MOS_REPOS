{
  "name": "Syncthing",
  "repo": "linuxserver/syncthing:latest",
  "category": [
    "Backup",
    "Hosting",
    "Network",
    "Misc",
    "Utilities"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/syncthing",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8384]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Syncthing_A.png",
  "project": "https://syncthing.net",
  "support": "https://github.com/linuxserver/docker-syncthing/issues/new/choose",
  "description": "Syncthing(https://syncthing.net) replaces proprietary sync and cloud services with something open, trustworthy and decentralized. Your data is your data alone and you deserve to choose where it is stored, if it is shared with some third party and how it's transmitted over the Internet.\r\n\r\nYouTube: https://youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/Array/Sync",
      "container": "/data1",
      "mode": "rw",
      "description": "Data1",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/Syncthing",
      "container": "/config",
      "mode": "rw",
      "description": "Configuration files.",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "9384",
      "container": "8384",
      "protocol": "tcp",
      "description": "Application WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Listen Port TCP",
      "host": "22002",
      "container": "22000",
      "protocol": "tcp",
      "description": "Listening port (TCP)",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Listen Port UDP",
      "host": "22002",
      "container": "22000",
      "protocol": "udp",
      "description": "Listening port (UDP)",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Discovery Port",
      "host": "21228",
      "container": "21027",
      "protocol": "udp",
      "description": "Protocol discovery",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
