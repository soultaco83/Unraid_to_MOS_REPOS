{
  "name": "jackett",
  "repo": "lscr.io/linuxserver/jackett",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/jackett",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9117]",
  "readme_url": "https://github.com/linuxserver/docker-jackett#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/jackett-logo.png",
  "project": "https://github.com/Jackett/Jackett",
  "support": "https://github.com/linuxserver/docker-jackett/issues/new/choose",
  "description": "Jackett(https://github.com/Jackett/Jackett) works as a proxy server: it translates queries from apps (Sonarr, SickRage, CouchPotato, Mylar, etc) into tracker-site-specific http queries, parses the html response, then sends results back to the requesting software. This allows for getting recent uploads (like RSS) and performing searches. Jackett is a single repository of maintained indexer scraping and translation logic - removing the burden from other apps.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Where Jackett should store its config file.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/downloads",
      "host": null,
      "container": "/downloads",
      "mode": "rw",
      "description": "Path to torrent blackhole.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9117",
      "container": "9117",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "AUTO_UPDATE",
      "key": "AUTO_UPDATE",
      "value": "true",
      "description": "Allow Jackett to update inside of the container.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "RUN_OPTS",
      "key": "RUN_OPTS",
      "value": null,
      "description": "Optionally specify additional arguments to be passed.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
