{
  "name": "your_spotify (linuxserver)",
  "repo": "lscr.io/linuxserver/your_spotify",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/your_spotify",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/linuxserver/docker-your_spotify#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/your_spotify-logo.png",
  "project": "https://github.com/Yooooomi/your_spotify",
  "support": "https://github.com/linuxserver/docker-your_spotify/issues/new/choose",
  "description": "Your_spotify(https://github.com/Yooooomi/your_spotify) is a self-hosted application that tracks what you listen and offers you a dashboard to explore statistics about it! It's composed of a web server which polls the Spotify API every now and then and a web application on which you can explore your statistics.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "your_spotify HTTP webui",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "443",
      "host": "443",
      "container": "443",
      "protocol": "tcp",
      "description": "your_spotify HTTPS webui",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "http://localhost",
      "description": "The protocol and hostname where the app will be accessed.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SPOTIFY_PUBLIC",
      "key": "SPOTIFY_PUBLIC",
      "value": null,
      "description": "Your Spotify application client ID.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SPOTIFY_SECRET",
      "key": "SPOTIFY_SECRET",
      "value": null,
      "description": "Your Spotify application secret.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SPOTIFY_API_DELAY_MS",
      "key": "SPOTIFY_API_DELAY_MS",
      "value": "2000",
      "description": "Minimum delay in milliseconds between each spotify request. Can help with hitting 429 when importing data.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "CORS",
      "key": "CORS",
      "value": "http://localhost:80,https://localhost:443",
      "description": "Allowed CORS sources, set to `all` to allow any source.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MONGO_ENDPOINT",
      "key": "MONGO_ENDPOINT",
      "value": "mongodb://mongo:27017/your_spotify",
      "description": "Set mongodb endpoint address/port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
