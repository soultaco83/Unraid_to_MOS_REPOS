{
  "name": "Authelia Admin Control Panel",
  "repo": "ghcr.io/asalimonov/authelia-admin:latest",
  "category": [
    "Network",
    "Security",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/asalimonov/authelia-admin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9093]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/authelia-admin-icon.png",
  "project": "https://github.com/asalimonov/authelia-admin",
  "support": "https://github.com/asalimonov/authelia-admin/issues",
  "description": "A web-based administration interface for managing Authelia authentication server with LLDAP.",
  "requires": "Requires a `config.yaml` file to be present in the Config Path. See documentation: https://github.com/asalimonov/authelia-admin#yaml-configuration",
  "paths": [
    {
      "name": "Authelia Config File",
      "host": null,
      "container": "/opt/authelia-admin/config.yml",
      "mode": "ro",
      "description": "Path to the Authelia config.yaml file",
      "required": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/authelia_admin/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "App Data Path",
      "host": "/mnt/cache/appdata/authelia_admin/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the app data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9093",
      "container": "9093",
      "protocol": "tcp",
      "description": "Container Port: 9093",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Trusted Origins",
      "key": "TRUSTED_ORIGINS",
      "value": "https://auth.yourdomain.com",
      "description": "Set the trusted origins for Authelia",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "AAD_LOGLEVEL",
      "value": "DEBUG|INFO|WARNING|ERROR|CRITICAL",
      "description": "Set the log level",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
