{
  "name": "Cloudreve",
  "repo": "cloudreve/cloudreve:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/cloudreve/cloudreve",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5212]/",
  "icon": "https://raw.githubusercontent.com/cloudreve/frontend/master/public/static/img/logo192.png",
  "project": "https://cloudreve.org/",
  "support": "https://docs.cloudreve.org",
  "description": "Self-hosted file management and sharing system, supports multiple storage providers",
  "requires": "Requires separate Postgres and Redis instances.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/cloudreve/data",
      "container": "/cloudreve/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5212",
      "container": "5212",
      "protocol": "tcp",
      "description": "Container Port: 5212",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Download Port",
      "host": "6888",
      "container": "6888",
      "protocol": "tcp",
      "description": "Container Port: 6888",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Download Port (UDP)",
      "host": "6888",
      "container": "6888",
      "protocol": "udp",
      "description": "Container Port: 6888",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Postgres - Host",
      "key": "CR_CONF_Database.Host",
      "value": null,
      "description": "Postgres database host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Port",
      "key": "CR_CONF_Database.Port",
      "value": "5432",
      "description": "Postgres database port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Database Name",
      "key": "CR_CONF_Database.Name",
      "value": "cloudreve",
      "description": "Postgres database name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Username",
      "key": "CR_CONF_Database.User",
      "value": null,
      "description": "Postgres database username",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Password",
      "key": "CR_CONF_Database.Password",
      "value": null,
      "description": "Postgres database password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Address",
      "key": "CR_CONF_Redis.Server",
      "value": "localhost:6379",
      "description": "Redis server address",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Password",
      "key": "CR_CONF_Redis.Password",
      "value": null,
      "description": "Redis server password",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Database",
      "key": "CR_CONF_Redis.DB",
      "value": "0",
      "description": "Redis database number",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Postgres - Database Type",
      "key": "CR_CONF_Database.Type",
      "value": "postgres",
      "description": "Database type. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
