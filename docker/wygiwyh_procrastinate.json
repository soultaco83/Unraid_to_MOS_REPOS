{
  "name": "WYGIWYH - Procrastinate",
  "repo": "eitchtee/wygiwyh:latest",
  "category": [
    "Crypto",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/eitchtee/wygiwyh",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "/start-procrastinate",
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/eitchtee/WYGIWYH/main/.github/img/logo.png",
  "project": "https://github.com/eitchtee/WYGIWYH",
  "support": "https://github.com/eitchtee/WYGIWYH/issues",
  "description": "WYGIWYH (What You Get Is What You Have) is a powerful, principles-first finance tracker designed for people who prefer a no-budget, straightforward approach to managing their money. With features like multi-currency support, customizable transactions, and a built-in dollar-cost averaging tracker, WYGIWYH helps you take control of your finances with simplicity and flexibility.",
  "requires": "Requires a separate WYGIWYH container.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Domain",
      "key": "URL",
      "value": "https://IP_ADDRESS:9000",
      "description": "URL to connect to the app. Must match Web UI Port.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Engine",
      "key": "SQL_ENGINE",
      "value": "django.db.backends.postgresql|django.db.backends.sqlite3",
      "description": "Database engine",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Host",
      "key": "SQL_HOST",
      "value": "localhost",
      "description": "Database host. Remove if using SQLite3",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database - Port",
      "key": "SQL_PORT",
      "value": "5432",
      "description": "Database port. Remove if using SQLite3",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database - Name",
      "key": "SQL_DATABASE",
      "value": "wygiwyh",
      "description": "Database name. Remove if using SQLite3",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - User",
      "key": "SQL_USER",
      "value": "wygiwyh",
      "description": "Database user.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Password",
      "key": "SQL_PASSWORD",
      "value": "wygiwyh",
      "description": "Database password.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "Secure secret key",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "false|true",
      "description": "Enable debug mode",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "HTTPS Enabled",
      "key": "HTTPS_ENABLED",
      "value": "true|false",
      "description": "Enable HTTPS",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Django Allowed Hosts",
      "key": "DJANGO_ALLOWED_HOSTS",
      "value": "localhost 127.0.0.1 [::1]",
      "description": "Django allowed hosts",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Web Concurrency",
      "key": "WEB_CONCURRENCY",
      "value": "4",
      "description": "Number of web server workers",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
