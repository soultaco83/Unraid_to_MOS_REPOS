{
  "name": "youtube-dl material",
  "repo": "voc0der/ytdl-material:nightly",
  "category": [
    "Downloader",
    "Media"
  ],
  "registry": "https://hub.docker.com/r/voc0der/ytdl-material",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:17442]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/youtubedl-material.png",
  "project": "https://github.com/voc0der/ytdl-material",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "ytdl-material is a full suite UI for yt-dlp. It's coded using Angular 21 for the frontend, and Node.js on the backend. See a list of features here.",
  "paths": [
    {
      "name": "Audio Downloads",
      "host": null,
      "container": "/app/audio/",
      "mode": "rw",
      "description": "Audio Downloads",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Video Downloads",
      "host": null,
      "container": "/app/video/",
      "mode": "rw",
      "description": "Video Downloads",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Subscription Downloads",
      "host": null,
      "container": "/app/subscriptions/",
      "mode": "rw",
      "description": "Subscription Downloads",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/youtubedl-material",
      "container": "/app/appdata",
      "mode": "rw",
      "description": "Container Path: /app/appdata",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "17442",
      "container": "17442",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "WebUI Title",
      "key": "ytdl_title_top",
      "value": "YoutubeDL Material",
      "description": "Container Variable: ytdl_title_top",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "User ID",
      "key": "UID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Group ID",
      "key": "GID",
      "value": "500",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Advanced Configuration Mode",
      "key": "ytdl_allow_advanced_download",
      "value": "true|false",
      "description": "Allow advanced configuration (true/false)",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
