{
  "name": "Avatar",
  "repo": "frncsdrk/avatar:stable",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/frncsdrk/avatar",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9000]/avatar",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/avatar-icon.png",
  "project": "https://frncsdrk.github.io/avatar",
  "support": "https://github.com/frncsdrk/avatar/issues",
  "description": "Self-hosted service for creating random avatars.",
  "requires": "Expects a `default.json` file in the \"Config Path\": https://raw.githubusercontent.com/nwithan8/unraid_templates/master/ref/avatar/default.json",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/avatar/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to store configuration files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port: 9000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
