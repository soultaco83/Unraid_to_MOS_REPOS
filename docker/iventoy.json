{
  "name": "iventoy",
  "repo": "devzwf/iventoy:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Network",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/devzwf/iventoy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:26000]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/iventoy.png",
  "project": "https://www.iventoy.com/en/index.html",
  "support": "https://forums.unraid.net/topic/148096-support-devzwf-iventoy",
  "description": "iVentoy is an enhanced version of the PXE server.\r\nWith iVentoy you can boot and install OS on multiple machines at the same time through the network.\r\niVentoy is extremely easy to use, without complicated configuration, just put the ISO file in the specified location and select PXE boot in the client machine.\r\niVentoy supports x86 Legacy BIOS, IA32 UEFI, x86_64 UEFI and ARM64 UEFI mode at the same time.\r\niVentoy support 110+ common types of OS (Windows/WinPE/Linux/VMware)",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Config dir",
      "host": "/mnt/cache/appdata/iventoy/config",
      "container": "/app/data",
      "mode": "rw",
      "description": "Config Dir",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Isos dir",
      "host": "/mnt/Array/isos/",
      "container": "/app/iso",
      "mode": "rw",
      "description": "Isos Directory",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Log dir",
      "host": "/mnt/cache/appdata/iventoy/log",
      "container": "/app/log",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "User dir",
      "host": "/mnt/cache/appdata/iventoy/user",
      "container": "/app/user",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "TFTP Server Port",
      "host": "69",
      "container": "69",
      "protocol": "udp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WEB UI",
      "host": "26000",
      "container": "26000",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PXE HTTP port",
      "host": "16000",
      "container": "16000",
      "protocol": "tcp",
      "description": "iVentoy PXE Service HTTP Server Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
