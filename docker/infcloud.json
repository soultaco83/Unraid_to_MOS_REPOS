{
  "name": "Infcloud",
  "repo": "ckulka/infcloud:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/ckulka/infcloud",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/infcloud-icon.png",
  "project": "https://inf-it.com/open-source/clients/infcloud",
  "support": "https://github.com/ckulka/infcloud-docker/issues",
  "description": "An open-source CalDAV/CardDAV web client implementation.",
  "requires": "Expects a separate PHP server to be running on the host machine with the same \"PHP Path\" as the container. \r\n        [br]\n        Expects a `config.js` file at the \"Config File\" path before starting the container.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/infcloud/config.js",
      "container": "/usr/share/nginx/infcloud/config.js",
      "mode": "ro",
      "description": "Config file path",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PHP Path",
      "host": "/mnt/cache/appdata/infcloud/php",
      "container": "/usr/share/nginx/infcloud",
      "mode": "rw",
      "description": "Data path",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "1080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
