{
  "name": "Spotify-Connect-EQ (ssouza)",
  "repo": "giof71/librespot:latest",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/giof71/librespot",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://open.spotify.com/",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/spotify.png",
  "project": "https://github.com/GioF71/librespot-docker",
  "support": "https://github.com/ssouza00/backyard-eq/issues",
  "description": "Spotify Connect receiver for Unraid configured to stream high-quality audio through the companion CamillaDSP EQ container.",
  "requires": "Install CamillaDSP EQ and configure both containers with the same shared audio directory.",
  "paths": [
    {
      "name": "Shared DSP Audio",
      "host": "/mnt/cache/appdata/spotify-dsp/audio",
      "container": "/audio",
      "mode": "rw",
      "description": "Shared pipe folder",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "System Cache",
      "host": "/mnt/cache/appdata/spotify-connect/system-cache",
      "container": "/data/system-cache",
      "mode": "rw",
      "description": "Spotify cache",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Spotify Device Name",
      "key": "DEVICE_NAME",
      "value": "Spotify Connect",
      "description": "Spotify Connect device name",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Audio Backend",
      "key": "BACKEND",
      "value": "pipe",
      "description": "Pipe audio into CamillaDSP EQ",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Audio Pipe",
      "key": "DEVICE",
      "value": "/audio/spotify.pipe",
      "description": "Shared DSP audio pipe",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Bitrate",
      "key": "BITRATE",
      "value": "320",
      "description": "Spotify bitrate in kbps",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Initial Volume",
      "key": "INITIAL_VOLUME",
      "value": "75",
      "description": "Startup volume",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Discovery Backend",
      "key": "ZEROCONF_BACKEND",
      "value": "libmdns",
      "description": "mDNS backend",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Discovery Port",
      "key": "ZEROCONF_PORT",
      "value": "24879",
      "description": "Discovery port",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "ssouza"
}
