{
  "name": "bookstack",
  "repo": "lscr.io/linuxserver/bookstack",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/bookstack",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/linuxserver/docker-bookstack#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/bookstack-logo.png",
  "project": "https://codeberg.org/bookstack/bookstack",
  "support": "https://github.com/linuxserver/docker-bookstack/issues/new/choose",
  "description": "Bookstack(https://codeberg.org/bookstack/bookstack) is a free and open source Wiki designed for creating beautiful documentation. Featuring a simple, but powerful WYSIWYG editor it allows for teams to create detailed and useful documentation with ease.\n\nPowered by SQL and including a Markdown editor for those who prefer it, BookStack is geared towards making documentation more of a pleasure than a chore.\n\nFor more information on BookStack visit their website and check it out: https://www.bookstackapp.com",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6875",
      "container": "80",
      "protocol": "tcp",
      "description": "http/s web interface.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": null,
      "description": "The protocol, IP/URL, and port that your application will be accessed on (ie. `http://192.168.1.1:6875` or `https://bookstack.mydomain.com`",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": null,
      "description": "Session encryption key. You will need to generate this with `docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:latest appkey`",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": null,
      "description": "The database instance hostname",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Database port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": null,
      "description": "Database user",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": null,
      "description": "Database password (minimum 4 characters and non-alphanumeric passwords must be properly escaped.)",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_DATABASE",
      "key": "DB_DATABASE",
      "value": null,
      "description": "Database name",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "QUEUE_CONNECTION",
      "key": "QUEUE_CONNECTION",
      "value": null,
      "description": "Set to `database` to enable async actions like sending email or triggering webhooks. See documentation(https://www.bookstackapp.com/docs/admin/email-webhooks/#async-action-handling).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
