{
  "name": "Transmission-CB",
  "repo": "chisbread/transmission:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/chisbread/transmission",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2211]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Transmission_A.png",
  "project": "https://transmissionbt.com",
  "support": "https://github.com/ChisBread/transmission_skip_patch",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Transmission-CB/config",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Download Path",
      "host": "Your Download Path",
      "container": "/downloads",
      "mode": "rw",
      "description": "Download Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Watch Path",
      "host": "/mnt/user/appdata/Transmission-CB/watch",
      "container": "/watch",
      "mode": "rw",
      "description": "Watch Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Theme Path",
      "host": "/mnt/user/appdata/Transmission-CB/transmission-web-control",
      "container": "/transmission-web-control",
      "mode": "rw",
      "description": "Theme Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "2211",
      "container": "2211",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TCP Port",
      "host": "51413",
      "container": "51413",
      "protocol": "tcp",
      "description": "TCP Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "UDP Port",
      "host": "51413",
      "container": "51413",
      "protocol": "udp",
      "description": "UDP Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "0",
      "description": "PUID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "0",
      "description": "PGID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Asia/Shanghai",
      "description": "Timezone",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Theme",
      "key": "TRANSMISSION_WEB_HOME",
      "value": "/transmission-web-control",
      "description": "Theme",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Listen Web Port",
      "key": "RPCPORT",
      "value": "2211",
      "description": "Listen Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Listen BT Port",
      "key": "PEERPORT",
      "value": "51413",
      "description": "Listen BT Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Username",
      "key": "USER",
      "value": "Your Username",
      "description": "Username",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Password",
      "key": "PASS",
      "value": "Your Password",
      "description": "Password",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
