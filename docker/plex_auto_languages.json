{
  "name": "Plex Auto Languages",
  "repo": "remirigal/plex-auto-languages:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/remirigal/plex-auto-languages",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/plex-auto-languages-icon.png",
  "project": "https://github.com/RemiRigal/Plex-Auto-Languages",
  "support": "https://github.com/RemiRigal/Plex-Auto-Languages/issues",
  "description": "Automated language selection for Plex TV shows. Lets you have a Netflix-like experience by auto-updating the language of your Plex TV Show episodes based on the current language you are using without messing with your existing language preferences.",
  "requires": "Expects a config.yaml file in the Config Path: https://github.com/RemiRigal/Plex-Auto-Languages?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/plex_auto_languages/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Plex - URL",
      "key": "PLEX_URL",
      "value": "http://IP_ADDRESS:32400",
      "description": "URL of your Plex server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Plex - Token",
      "key": "PLEX_TOKEN",
      "value": null,
      "description": "Token of your Plex server",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
