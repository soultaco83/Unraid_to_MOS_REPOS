{
  "name": "CamViewerPlus",
  "repo": "fanman03/camviewerplus:0.0.6",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/fanman03/camviewerplus/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6980]/",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/camviewerplus.png",
  "project": "https://github.com/Fanman03/CamViewerPlus",
  "support": "https://forums.unraid.net/topic/72033-support-digiblurs-docker-template-repository/",
  "description": "A customizable browser-based RTSP viewer with multiple grid views\r\n\r\nEdit the JSON config in the config folder after the container is started once.  https://github.com/Fanman03/CamViewerPlus",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/user/appdata/camviewerplus",
      "container": "/usr/src/camviewerplus/conf",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Client6900",
      "host": "6900",
      "container": "6900",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Client6900udp",
      "host": "6900",
      "container": "6900",
      "protocol": "udp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WebUI",
      "host": "6980",
      "container": "6980",
      "protocol": "tcp",
      "description": "Container WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "digiblur"
}
