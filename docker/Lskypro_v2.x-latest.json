{
  "name": "Lskypro",
  "repo": "coldpig/lskypro-docker:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/coldpig/lskypro-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--hostname=lskypro --restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5611]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Lskypro_A.png",
  "project": "https://www.lsky.pro",
  "support": "https://github.com/lsky-org/lsky-pro",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/Lskypro",
      "container": "/var/www/html",
      "mode": "rw",
      "description": "Data Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "5611",
      "container": "80",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
