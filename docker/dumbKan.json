{
  "name": "DumbKan",
  "repo": "dumbwareio/dumbkan:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dumbwareio/dumbkan",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/dumbkan-logo.png",
  "project": "https://github.com/DumbWareio/DumbKan",
  "support": "https://forums.unraid.net/topic/185964-support-devzwf-dumbwareio-suite/",
  "description": "A lightweight, mobile-friendly Kanban board application for managing tasks and projects. Built with vanilla JavaScript and Node.js.",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/dumbkan",
      "container": "/app/data",
      "mode": "rw",
      "description": "Data Dir",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port on which the application will run.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PIN",
      "key": "DUMBKAN_PIN",
      "value": "123456",
      "description": "PIN protection (4-10 digits)",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
