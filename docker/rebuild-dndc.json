{
  "name": "Rebuild-DNDC",
  "repo": "eafxx/rebuild-dndc:unraid-m",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/eafxx/rebuild-dndc",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/rdndc.png",
  "project": "https://github.com/elmerfdz/unRAIDscripts",
  "support": "https://hub.docker.com/r/eafxx/rebuild-dndc",
  "description": "- Rebuild Docker Network Dependent Containers, e.g. Monitor a VPN or any container and rebuild dependent containers using the VPN container network stack --net=container:vpn_cotnainer_name. [br]\n  - RDNDC will monitor the master/vpn container during updates, restarts and after server boot. [br]\n  - Please refer to the readme before deploying this container: https://github.com/elmerfdz/unRAIDscripts",
  "paths": [
    {
      "name": "Docker Sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Container Path: /var/run/docker.sock",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker Template Location",
      "host": "/boot/config/plugins/dockerMan/templates-user",
      "container": "/config/docker-templates",
      "mode": "ro",
      "description": "Container Path: /config/docker-templates",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/rebuild-dndc",
      "container": "/config/rebuild-dndc",
      "mode": "rw",
      "description": "Container Path: /config/rebuild-dndc",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Master Container Name",
      "key": "mastercontname",
      "value": null,
      "description": "Container Variable: mastercontname",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Master Container Connection Check",
      "key": "mastercontconcheck",
      "value": "yes",
      "description": "Container Variable: mastercontconcheck (yes/no)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Ping IP",
      "key": "ping_ip",
      "value": "1.1.1.1",
      "description": "Container Variable: ping_ip",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Ping IP Alt",
      "key": "ping_ip_alt",
      "value": "8.8.8.8",
      "description": "Container Variable: ping_ip_alt",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Ping Count",
      "key": "ping_count",
      "value": "4",
      "description": "Container Variable: ping_count",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Sleep Secs",
      "key": "sleep_secs",
      "value": "10",
      "description": "Container Variable: sleep_secs",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Run on Startup",
      "key": "run_startup",
      "value": "yes|no",
      "description": "Container Variable: run_startup (yes/no)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Enable Discord Notifications",
      "key": "discord_notifications",
      "value": "no",
      "description": "Container Variable: discord_notifications (yes/no)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Discord Webhook URL",
      "key": "discord_url",
      "value": null,
      "description": "Container Variable: discord_url",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "CRON Schedule",
      "key": "cron",
      "value": "*/5 * * * *",
      "description": "Container Variable: cron",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
