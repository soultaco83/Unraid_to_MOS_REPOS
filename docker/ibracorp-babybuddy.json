{
  "name": "BabyBuddy",
  "repo": "linuxserver/babybuddy",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/linuxserver/babybuddy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/babybuddy-logo.png",
  "project": "https://github.com/linuxserver/docker-babybuddy",
  "support": "https://github.com/linuxserver/docker-babybuddy/issues/new/choose",
  "description": "BabyBuddy is a buddy for babies! Helps caregivers track sleep, feedings, diaper changes, tummy time and more to learn about and predict babys needs without (as much) guess work.\r\n\r\nThe default user/pass are admin:admin\r\n\r\nFull credit to the developers and LSIO for the container. I just wanted to get it out to people who need it, please support their work using the donation link in the template.",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/babybuddy",
      "container": "/config",
      "mode": "rw",
      "description": "Contains all relevant configuration and data",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port for the WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
