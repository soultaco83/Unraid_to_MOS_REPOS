{
  "name": "wps-office",
  "repo": "lscr.io/linuxserver/wps-office",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/wps-office",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "readme_url": "https://github.com/linuxserver/docker-wps-office#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/wps-office-icon.png",
  "project": "https://www.wps.com/",
  "support": "https://github.com/linuxserver/docker-wps-office/issues/new/choose",
  "description": "WPS Office(https://www.wps.com/) is a lightweight, feature-rich comprehensive office suite with high compatibility. As a handy and professional office software, WPS Office allows you to edit files in Writer, Presentation, Spreadsheet, and PDF to improve your work efficiency.",
  "donate": "https://www.linuxserver.io/donate",
  "requires": "This image is unprotected by default __**do not**__ expose it to the internet.\n        Please read https://github.com/linuxserver/docker-wps-office#security for more information.",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores program settings and documents",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "WPS Office desktop gui, must be proxied.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "WPS Office desktop gui HTTPS.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
