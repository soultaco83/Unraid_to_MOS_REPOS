{
  "name": "Scraperr - API",
  "repo": "jpyles0524/scraperr_api:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/jpyles0524/scraperr_api",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/scraperr-icon.png",
  "project": "https://github.com/jaypyles/Scraperr",
  "support": "https://scraperr-docs.pages.dev",
  "description": "A self-hosted web application that allows users to scrape data from web pages by specifying elements via XPath. Users can submit URLs and the corresponding elements to be scraped, and the results will be displayed in a table.",
  "paths": [
    {
      "name": "Media Path",
      "host": "/mnt/cache/appdata/scraperr/media",
      "container": "/project/app/media",
      "mode": "rw",
      "description": "Path to store media files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/scraperr/api_data",
      "container": "/project/app/data",
      "mode": "rw",
      "description": "Path to store application data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "Used to encode authentication tokens, can be a random string",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "OpenAI API Key",
      "key": "OPENAI_KEY",
      "value": null,
      "description": "API key for OpenAI, used for chat functionality",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO|DEBUG|ERROR",
      "description": "Log level for the application",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Auth Token Algorithm",
      "key": "ALGORITHM",
      "value": "HS256",
      "description": "Algorithm used to encode authentication tokens",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Access Token Expiry Time",
      "key": "ACCESS_TOKEN_EXPIRE_MINUTES",
      "value": "600",
      "description": "Time in minutes before access tokens expire",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
