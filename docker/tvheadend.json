{
  "name": "tvheadend",
  "repo": "lscr.io/linuxserver/tvheadend",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/tvheadend",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9981]",
  "readme_url": "https://github.com/linuxserver/docker-tvheadend#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/tvheadend-logo.png",
  "project": "https://www.tvheadend.org/",
  "support": "https://github.com/linuxserver/docker-tvheadend/issues/new/choose",
  "description": "Tvheadend(https://www.tvheadend.org/) works as a proxy server: is a TV streaming server and recorder for Linux, FreeBSD and Android supporting DVB-S, DVB-S2, DVB-C, DVB-T, ATSC, ISDB-T, IPTV, SATIP and HDHomeRun as input sources.\nTvheadend offers the HTTP (VLC, MPlayer), HTSP (Kodi, Movian) and SATIP streaming.\nMultiple EPG sources are supported (over-the-air DVB and ATSC including OpenTV DVB extensions, XMLTV, PyXML).",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Where TVHeadend show store it's config files.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/recordings",
      "host": null,
      "container": "/recordings",
      "mode": "rw",
      "description": "Where you want the PVR to store recordings.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9981",
      "container": "9981",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "9982",
      "host": "9982",
      "container": "9982",
      "protocol": "tcp",
      "description": "HTSP server port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "RUN_OPTS",
      "key": "RUN_OPTS",
      "value": null,
      "description": "Optionally specify additional arguments to be passed. See Additional runtime parameters.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "/dev/dri",
      "host": "/dev/dri",
      "container": "/dev/dri",
      "description": "Only needed if you want to use your AMD/Intel GPU for hardware accelerated video encoding (vaapi).",
      "required": false,
      "display": "always"
    },
    {
      "name": "/dev/dvb",
      "host": "/dev/dvb",
      "container": "/dev/dvb",
      "description": "Only needed if you want to pass through a DVB card to the container. If you use IPTV or HDHomeRun you can leave it out.",
      "required": false,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
