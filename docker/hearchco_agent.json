{
  "name": "Hearchco - Agent",
  "repo": "ghcr.io/hearchco/agent:latest",
  "category": [
    "Network",
    "Security",
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/hearchco/agent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/hearchco-icon.png",
  "project": "https://hearch.co",
  "support": "https://github.com/hearchco/agent/issues",
  "description": "Hearchco is a distributed and fast metasearch engine that respects your privacy.",
  "requires": "This is the agent/backend for the Hearchco metasearch engine. It requires a frontend to also be running. \r\n        [br]\n        This application requires a separate Redis database.",
  "paths": [],
  "ports": [
    {
      "name": "Application Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Port over which the frontend will communicate with this backend",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Frontend URLs",
      "key": "HEARCHCO_SERVER_FRONTENDURLS",
      "value": "http://localhost:3000",
      "description": "Comma-separated list of frontend URLs that are allowed to communicate with this backend. Replace with IP:PORT or domain of your frontend",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis Host",
      "key": "HEARCHCO_SERVER_CACHE_REDIS_HOST",
      "value": null,
      "description": "Host of the Redis database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis Port",
      "key": "HEARCHCO_SERVER_CACHE_REDIS_PORT",
      "value": "6379",
      "description": "Port of the Redis database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis Password",
      "key": "HEARCHCO_SERVER_CACHE_REDIS_PASSWORD",
      "value": null,
      "description": "Password of the Redis database",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Image Proxy Secret Key",
      "key": "HEARCHCO_SERVER_IMAGEPROXY_SECRETKEY",
      "value": null,
      "description": "Secret key used for hashing image URLs in the image proxy. Should be at least 32 characters long.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Cache Type",
      "key": "HEARCHCO_SERVER_CACHE_TYPE",
      "value": "redis|dynamodb|none",
      "description": "Type of cache to use. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
