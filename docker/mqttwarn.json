{
  "name": "mqttwarn",
  "repo": "ghcr.io/mqtt-tools/mqttwarn-full:latest",
  "category": [
    "Home Automation",
    "Network",
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/mqtt-tools/mqttwarn-full",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://mqttwarn.readthedocs.io/en/latest/_static/mqttwarn-logo.png",
  "project": "https://github.com/mqtt-tools/mqttwarn",
  "support": "https://mqttwarn.readthedocs.io",
  "description": "Subscribe to MQTT topics and notify pluggable services.",
  "requires": "Expects a `mqttwarn.ini` and a `funcs.py` file in the Config Path. See documentation: https://mqttwarn.readthedocs.io/en/latest/configure/index.html",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/mqttwarn/config",
      "container": "/etc/mqttwarn",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Localtime path",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "Localtime path",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Internal INI Path",
      "key": "MQTTWARNINI",
      "value": "/etc/mqttwarn/mqttwarn.ini",
      "description": "Internal path to the INI file. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
