{
  "name": "syslog-ng (linuxserver)",
  "repo": "lscr.io/linuxserver/syslog-ng",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/syslog-ng",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/linuxserver/docker-syslog-ng#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/syslog-ng-logo.png",
  "project": "https://www.syslog-ng.com/products/open-source-log-management/",
  "support": "https://github.com/linuxserver/docker-syslog-ng/issues/new/choose",
  "description": "syslog-ng(https://www.syslog-ng.com/products/open-source-log-management/) allows you to flexibly collect, parse, classify, rewrite and correlate logs from across your infrastructure and store or route them to log analysis tools.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Stores config and application files",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/var/log",
      "host": null,
      "container": "/var/log",
      "mode": "rw",
      "description": "Stores logs collected by the syslog-ng service",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "514",
      "container": "5514",
      "protocol": "udp",
      "description": "Syslog UDP",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "6601",
      "host": "601",
      "container": "6601",
      "protocol": "tcp",
      "description": "Syslog TCP",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "6514",
      "host": "6514",
      "container": "6514",
      "protocol": "tcp",
      "description": "Syslog TLS",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "LOG_TO_STDOUT",
      "key": "LOG_TO_STDOUT",
      "value": null,
      "description": "If set to `true` container will log to stdout, otherwise will log to `/config/log/`.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
