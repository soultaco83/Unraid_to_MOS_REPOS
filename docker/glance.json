{
  "name": "Glance",
  "repo": "glanceapp/glance",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/glanceapp/glance",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/glance_logo.png",
  "project": "https://github.com/glanceapp/glance",
  "support": "https://forums.unraid.net/topic/167893-support-devzwf-glance/",
  "description": "What if you could see everything at a...\r\n\r\n                              Glance",
  "donate": "https://ko-fi.com/devzwf",
  "requires": "Container expect a \"glance.yml\" file to be mounted at /app/glance.yml before running. See https://github.com/glanceapp/glance/blob/main/docs/configuration.md for more information.",
  "paths": [
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Directory",
      "host": "/mnt/cache/appdata/glance/config",
      "container": "/app/config/",
      "mode": "rw",
      "description": "Configuration Directory",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Assets Directory",
      "host": "/mnt/cache/appdata/glance/assets",
      "container": "/app/assets",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
