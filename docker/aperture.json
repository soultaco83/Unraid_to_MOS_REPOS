{
  "name": "Aperture",
  "repo": "ghcr.io/dgruhin-hrizn/aperture:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/dgruhin-hrizn/aperture",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--user 500:500",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3456]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/aperture-icon.png",
  "project": "https://github.com/dgruhin-hrizn/aperture",
  "support": "https://github.com/dgruhin-hrizn/aperture/issues",
  "description": "Aperture creates personalized recommendation libraries for your Emby and Jellyfin media server users using OpenAI embeddings and pgvector similarity search. Recommendations appear as virtual libraries in your media server's home screen, with support for both movies and TV series.",
  "requires": "Requires separate Jellyin/Emby media servers and pgvector database instances.",
  "paths": [
    {
      "name": "Aperture Libraries Path",
      "host": null,
      "container": "/aperture-libraries",
      "mode": "rw",
      "description": "Path where Aperture libraries will be stored. Should be inside your existing media server's library path.",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Media Libraries Path",
      "host": null,
      "container": "/media",
      "mode": "ro",
      "description": "Path to the root of your media library.",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Backups Path",
      "host": "/mnt/cache/appdata/aperture/backups",
      "container": "/backups",
      "mode": "rw",
      "description": "Path where backups will be stored",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3456",
      "container": "3456",
      "protocol": "tcp",
      "description": "Container Port: 3456",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://aperture:password@IP_ADDRESS:5432/aperture",
      "description": "Database connection URL",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Base URL",
      "key": "APP_BASE_URL",
      "value": "http://IP_ADDRESS:3456",
      "description": "Base URL for accessing the application",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Session Secret",
      "key": "SESSION_SECRET",
      "value": null,
      "description": "Secret key, at least 32 characters",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Run Migrations on Start",
      "key": "RUN_MIGRATIONS_ON_START",
      "value": "true|false",
      "description": "Whether to run database migrations on container start",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Node Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Set the Node environment. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "3456",
      "description": "Internal port the application listens on. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
