{
  "name": "Streamystats - Backend",
  "repo": "fredrikburmester/streamystats-phoenix:edge",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/fredrikburmester/streamystats-phoenix",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/streamystats-icon.png",
  "project": "https://github.com/fredrikburmester/streamystats",
  "support": "https://github.com/fredrikburmester/streamystats/issues",
  "description": "Streamystats is a statistics service for Jellyfin, providing analytics and data visualization. \r\n        [br]\n        This is the backend container.",
  "requires": "Requires separate Streamystats - Frontend and Postgres containers.",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "4000",
      "container": "4000",
      "protocol": "tcp",
      "description": "Container Port: 4000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "ecto://postgres:postgres@db/streamystat",
      "description": "URL for the Postgres database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY_BASE",
      "value": null,
      "description": "Secret key for the backend. Run `openssl rand -hex 64` to generate.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
