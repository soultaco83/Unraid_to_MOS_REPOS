{
  "name": "Heimdall",
  "repo": "linuxserver/heimdall:latest",
  "category": [
    "Utilities",
    "Network",
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/heimdall",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8434]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Heimdall_A.png",
  "project": "https://heimdall.site",
  "support": "https://github.com/linuxserver/docker-heimdall/issues/new/choose",
  "description": "Heimdall(https://heimdall.site) is a way to organise all those links to your most used web sites and web applications in a simple way.\r\nSimplicity is the key to Heimdall.\r\nWhy not use it as your browser start page? It even has the ability to include a search bar using either Google, Bing or DuckDuckGo.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/Heimdall",
      "container": "/config",
      "mode": "rw",
      "description": "Contains all relevant configuration files.",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8434",
      "container": "80",
      "protocol": "tcp",
      "description": "Web Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
