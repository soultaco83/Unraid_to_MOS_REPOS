{
  "name": "HubProxy",
  "repo": "ghcr.io/sky22333/hubproxy:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/sky22333/hubproxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/hubproxy-icon.png",
  "project": "https://github.com/sky22333/hubproxy",
  "support": "https://github.com/sky22333/hubproxy/issues",
  "description": "An proxy for accessing GitHub releases and Docker images.",
  "requires": "Expects a config.toml file at the Config File path BEFORE starting the container: https://github.com/sky22333/hubproxy/blob/main/src/config.toml",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/hubproxy/config.toml",
      "container": "/app/config.toml",
      "mode": "ro",
      "description": "Config file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
