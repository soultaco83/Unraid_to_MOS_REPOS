{
  "name": "Bar Assistant - Backend",
  "repo": "barassistant/server:v4",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/barassistant/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/bar-assistant-icon.png",
  "project": "https://barassistant.app/",
  "support": "https://docs.barassistant.app/setup/",
  "description": "An all-in-one solution for managing your home bar. This is the backend component.",
  "requires": "Requires a separate Bar Assistant backend instance.",
  "paths": [
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/bar_assistant/data",
      "container": "/var/www/cocktails/storage/bar-assistant",
      "mode": "rw",
      "description": "Path to data files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "API URL",
      "key": "APP_URL",
      "value": "http://localhost:8080/bar",
      "description": "URL of the API. Must match API Port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Meilisearch Master Key",
      "key": "MEILISEARCH_KEY",
      "value": null,
      "description": "Master key for Meilisearch",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Meilisearch URL",
      "key": "MEILISEARCH_HOST",
      "value": "http://localhost:7700",
      "description": "URL of the Meilisearch instance",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Cache Driver",
      "key": "CACHE_DRIVER",
      "value": "file|redis",
      "description": "Cache driver to use",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Session Driver",
      "key": "SESSION_DRIVER",
      "value": "file|redis",
      "description": "Session driver to use",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis Host",
      "key": "REDIS_HOST",
      "value": "localhost",
      "description": "Host of the Redis instance. Remove if not using Redis.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
