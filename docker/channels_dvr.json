{
  "name": "Channels DVR",
  "repo": "fancybits/channels-dvr:latest",
  "category": [
    "Media",
    "Misc",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/fancybits/channels-dvr",
  "network": "host",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://getchannels.com/assets/img/avatar-120.png",
  "project": "https://getchannels.com/dvr",
  "support": "https://community.getchannels.com/t/unraid-community-app-store/30764",
  "description": "The Channels DVR server",
  "requires": "Container requires a subscription to Channels DVR. To log in, establish an SSH tunnel to the container (e.g. `ssh -L8089:localhost:8089 root@unraid_ip`) and visit http://localhost:8089 in your browser.",
  "paths": [
    {
      "name": "DVR Storage",
      "host": null,
      "container": "/shares/DVR",
      "mode": "rw",
      "description": "Path to DVR recordings storage",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/channels-dvr",
      "container": "/channels-dvr",
      "mode": "rw",
      "description": "Path to config storage",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8089",
      "container": "8089",
      "protocol": "tcp",
      "description": "Container Port: 8089",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
