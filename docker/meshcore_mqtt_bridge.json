{
  "name": "MeshCore MQTT Bridge",
  "repo": "ghcr.io/jinglemansweep/meshcore-mqtt:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/jinglemansweep/meshcore-mqtt",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "python -m meshcore_mqtt.main --config-file /config/config.yaml",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/meshcore-mqtt-bridge-icon.png",
  "project": "https://ipnt.uk/",
  "support": "https://github.com/ipnet-mesh/meshcore-mqtt/issues",
  "description": "A robust bridge service that connects MeshCore devices to MQTT brokers, enabling seamless integration with IoT platforms and message processing systems.",
  "requires": "Requires a separate MQTT instance. \r\n        \r\n        Requires a `config.yaml` file in the Config Path. See documentation: https://github.com/ipnet-mesh/meshcore-mqtt#yaml-configuration-configyaml",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/meshcore_mqtt_bridge/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [
    {
      "name": "USB Device",
      "host": "/dev/ttyUSB0",
      "container": "/dev/ttyUSB0",
      "description": "USB device to use for ingestion.",
      "required": true,
      "display": "always-hide"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
