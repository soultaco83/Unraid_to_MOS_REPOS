{
  "name": "lazylibrarian (linuxserver)",
  "repo": "lscr.io/linuxserver/lazylibrarian",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/lazylibrarian",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5299]",
  "readme_url": "https://github.com/linuxserver/docker-lazylibrarian#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/lazylibrarian-logo.png",
  "project": "https://lazylibrarian.gitlab.io/",
  "support": "https://github.com/linuxserver/docker-lazylibrarian/issues/new/choose",
  "description": "Lazylibrarian(https://lazylibrarian.gitlab.io/) is a program to follow authors and grab metadata for all your digital reading needs. It uses a combination of Goodreads Librarything and optionally GoogleBooks as sources for author info and book info.  This container is based on the DobyTang fork.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "LazyLibrarian config",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/downloads",
      "host": null,
      "container": "/downloads",
      "mode": "rw",
      "description": "Download location",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/books",
      "host": null,
      "container": "/books",
      "mode": "rw",
      "description": "Books location",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5299",
      "container": "5299",
      "protocol": "tcp",
      "description": "The port for the LazyLibrarian webinterface",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "DOCKER_MODS",
      "key": "DOCKER_MODS",
      "value": "linuxserver/mods:universal-calibre|linuxserver/mods:lazylibrarian-ffmpeg",
      "description": "Allows additional functionality to be added, e.g. the Calibredb import program (optional, more info below)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
