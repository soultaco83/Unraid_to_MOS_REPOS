{
  "name": "monica (selfhosters)",
  "repo": "monica",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/_/monica/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/monica.png",
  "project": "https://github.com/monicahq/monica",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository",
  "description": "Monica, the Personal Relationship Manager\n[br][br]\nComplete list of env : https://raw.githubusercontent.com/monicahq/monica/master/.env.example\n[br][br]\nAPP_URL: https://github.com/monicahq/monica/blob/master/docs/installation/ssl.md",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/monica",
      "container": "/var/www/html/storage/",
      "mode": "rw",
      "description": "Container Path: /var/www/html/storage/",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "APP_ENV",
      "key": "APP_ENV",
      "value": "production",
      "description": "Container Variable: APP_ENV",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "APP_DEBUG",
      "key": "APP_DEBUG",
      "value": "false",
      "description": "Container Variable: APP_DEBUG",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "APP_KEY",
      "key": "APP_KEY",
      "value": "ChangeMeBy32KeyLengthOrGenerated",
      "description": "Container Variable: APP_KEY",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HASH_SALT",
      "key": "HASH_SALT",
      "value": "ChangeMeBy20+KeyLength",
      "description": "Container Variable: HASH_SALT",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HASH_LENGTH",
      "key": "HASH_LENGTH",
      "value": "18",
      "description": "Container Variable: HASH_LENGTH",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "APP_URL",
      "key": "APP_URL",
      "value": "https://FQDM.tld",
      "description": "Container Variable: APP_URL\r\nREQUIRES SSL! Read Description!",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Connection",
      "key": "DB_CONNECTION",
      "value": "mysql",
      "description": "Container Variable: DB_CONNECTION",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Host",
      "key": "DB_HOST",
      "value": "192.168.1.2",
      "description": "Container Variable: DB_HOST",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Port",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Container Variable: DB_PORT",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database",
      "key": "DB_DATABASE",
      "value": "monica",
      "description": "Container Variable: DB_DATABASE",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Username",
      "key": "DB_USERNAME",
      "value": "monica",
      "description": "Container Variable: DB_USERNAME",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Password",
      "key": "DB_PASSWORD",
      "value": "monica",
      "description": "Container Variable: DB_PASSWORD",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_USE_UTF8MB4",
      "key": "DB_USE_UTF8MB4",
      "value": "true",
      "description": "# Use utf8mb4 database charset format to support emoji characters\r\n# ⚠ be sure your DBMS supports utf8mb4 format",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MAIL_DRIVER",
      "key": "MAIL_DRIVER",
      "value": "smtp",
      "description": "Container Variable: MAIL_DRIVER",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Mail Host",
      "key": "MAIL_HOST",
      "value": "example.com",
      "description": "Container Variable: MAIL_HOST",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Mail Port",
      "key": "MAIL_PORT",
      "value": "587",
      "description": "Container Variable: MAIL_PORT",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MAIL_ENCRYPTION",
      "key": "MAIL_ENCRYPTION",
      "value": "TLS",
      "description": "Container Variable: MAIL_ENCRYPTION",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Mail Username",
      "key": "MAIL_USERNAME",
      "value": "user@example.com",
      "description": "Container Variable: MAIL_USERNAME",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Mail Password",
      "key": "MAIL_PASSWORD",
      "value": "secretpassword",
      "description": "Container Variable: MAIL_PASSWORD",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MAIL_FROM_ADDRESS",
      "key": "MAIL_FROM_ADDRESS",
      "value": "user@example.com",
      "description": "Container Variable: MAIL_FROM_ADDRESS",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MAIL_FROM_NAME",
      "key": "MAIL_FROM_NAME",
      "value": "Monica instance",
      "description": "Container Variable: MAIL_FROM_NAME",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "APP_EMAIL_NEW_USERS_NOTIFICATION",
      "key": "APP_EMAIL_NEW_USERS_NOTIFICATION",
      "value": null,
      "description": "Container Variable: APP_EMAIL_NEW_USERS_NOTIFICATION",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "APP_DEFAULT_LOCALE",
      "key": "APP_DEFAULT_LOCALE",
      "value": "en",
      "description": "Default locale used in the application.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Disable Signup",
      "key": "APP_DISABLE_SIGNUP",
      "value": "false",
      "description": "Ability to disable signups on your instance.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Email Optin",
      "key": "APP_SIGNUP_DOUBLE_OPTIN",
      "value": "false",
      "description": "Enable user email verification.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "APP_TRUSTED_PROXIES",
      "key": "APP_TRUSTED_PROXIES",
      "value": "*",
      "description": "# Set trusted proxy IP addresses.\r\n# To trust all proxies that connect directly to your server, use a *",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
