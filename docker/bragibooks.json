{
  "name": "Bragibooks",
  "repo": "ghcr.io/djdembeck/bragibooks:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/djdembeck/bragibooks",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/djdembeck/bragibooks/assets/logos/logo.png",
  "project": "https://github.com/djdembeck/bragibooks",
  "support": "https://github.com/djdembeck/bragibooks/issues",
  "description": "An audiobook library cleanup and management tool built with Python and Django. Leveraging m4b-merge for audiobook standardization and editing. Ideal for enhancing audiobook library management.",
  "paths": [
    {
      "name": "Input Folder",
      "host": null,
      "container": "/input",
      "mode": "rw",
      "description": "Path to the input folder containing audiobooks",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Output Folder",
      "host": null,
      "container": "/output",
      "mode": "rw",
      "description": "Path to the output folder for processed audiobooks",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Done Folder",
      "host": null,
      "container": "/done",
      "mode": "rw",
      "description": "Path to the done folder for completed audiobooks",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/bragibooks/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the configuration directory",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Trusted Domains",
      "key": "CSRF_TRUSTED_ORIGINS",
      "value": "http://IP_ADDRESS:8000",
      "description": "Comma-separated list of trusted domains for CSRF protection",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO",
      "description": "Set the logging level",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Debug Mode",
      "key": "DEBUG",
      "value": "false|true",
      "description": "Enable or disable debug mode",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
