{
  "name": "obico (imagegenius)",
  "repo": "ghcr.io/imagegenius/obico",
  "category": [
    "Hosting",
    "Utilities"
  ],
  "registry": "https://github.com/orgs/imagegenius/packages/container/package/obico",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3334]",
  "readme_url": "https://github.com/imagegenius/docker-obico#readme",
  "icon": "https://raw.githubusercontent.com/imagegenius/templates/main/unraid/img/obico.png",
  "project": "https://www.obico.io/",
  "support": "https://github.com/imagegenius/docker-obico/issues/new/choose",
  "description": "Obico is a community-built, open-source smart 3D printing platform used by makers, enthusiasts, and tinkerers around the world.",
  "requires": "Redis",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Contains django database, logs and timelapses",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3334",
      "container": "3334",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "REDIS_URL",
      "key": "REDIS_URL",
      "value": "redis://ip:port",
      "description": "Redis URL, eg. `redis://192.168.1.2:6379`",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HOST_IP",
      "key": "HOST_IP",
      "value": "192.168.0.5:3334/example.com",
      "description": "Domain/IP+Port used to access the frontend, if incorrect you will get an error 500!",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "UID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "GID for permissions. Do not change unless you know what you're doing.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "UMASK for newly created files. Do not change unless you know what you're doing.",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "imagegenius"
}
