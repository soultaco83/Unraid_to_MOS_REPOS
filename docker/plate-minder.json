{
  "name": "plate-minder",
  "repo": "sclaflin/plate-minder",
  "category": [
    "Home Automation",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/sclaflin/plate-minder/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/plate-minder.png",
  "project": "https://github.com/sclaflin/Plate-Minder",
  "support": "https://forums.unraid.net/topic/72033-support-digiblurs-docker-template-repository/",
  "description": "Monitor an RTSP / MJPEG stream for license plates, record them, store them in SQL, send alerts via MQTT with AutoDiscovery into Home Assistant. REQUIRED: open-alpr-http-wrapper docker container and configuration YAML file (example config on the Plate-Minder Github page",
  "paths": [
    {
      "name": "appdata",
      "host": "/mnt/user/appdata/plateminder/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path for data/image storage",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "config_yaml",
      "host": "/mnt/user/appdata/plateminder/config.yaml",
      "container": "/app/config.yaml",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "restapi",
      "host": "2576",
      "container": "2576",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
