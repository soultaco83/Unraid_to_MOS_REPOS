{
  "name": "manyfold (linuxserver)",
  "repo": "lscr.io/linuxserver/manyfold",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/manyfold",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3214]",
  "readme_url": "https://github.com/linuxserver/docker-manyfold#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/manyfold-logo.png",
  "project": "https://github.com/manyfold3d/manyfold/",
  "support": "https://github.com/linuxserver/docker-manyfold/issues/new/choose",
  "description": "Manyfold(https://github.com/manyfold3d/manyfold/)  is an open source, self-hosted web application for managing a collection of 3D models, particularly focused on 3D printing.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Persistent storage for application configuration data.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/libraries",
      "host": null,
      "container": "/libraries",
      "mode": "rw",
      "description": "Location of your 3D model libraries.",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3214",
      "container": "3214",
      "protocol": "tcp",
      "description": "Port for web frontend",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": null,
      "description": "Database connection URL. For sqlite use `sqlite3:/config/manyfold.sqlite3`. For postgres or mariadb use `scheme://username:password@hostname:port/db name` where `scheme` is `postgresql` or `mysql2`. Special characters in username/password must be URL encoded(https://en.wikipedia.org/wiki/Percent-encoding).",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "REDIS_URL",
      "key": "REDIS_URL",
      "value": null,
      "description": "Redis/Valkey database URL in `redis://hostname:port/db number` format.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SECRET_KEY_BASE",
      "key": "SECRET_KEY_BASE",
      "value": null,
      "description": "Browser session and database encryption key. If unset a random one will be generated on init, the database is locked to this key.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
