{
  "name": "minisatip",
  "repo": "lscr.io/linuxserver/minisatip",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/minisatip",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8875]",
  "readme_url": "https://github.com/linuxserver/docker-minisatip#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/minisatip-logo.png",
  "project": "https://github.com/catalinii/minisatip",
  "support": "https://github.com/linuxserver/docker-minisatip/issues/new/choose",
  "description": "Minisatip(https://github.com/catalinii/minisatip) is a multi-threaded satip server version 1.2 that runs under Linux and it was tested with DVB-S, DVB-S2, DVB-T, DVB-T2, DVB-C, DVB-C2, ATSC and ISDB-T cards.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Configuration files and minisatip data",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8875",
      "container": "8875",
      "protocol": "tcp",
      "description": "Status Page WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "554",
      "host": "554",
      "container": "554",
      "protocol": "tcp",
      "description": "RTSP Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "1900",
      "host": "1900",
      "container": "1900",
      "protocol": "udp",
      "description": "App Discovery",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "RUN_OPTS",
      "key": "RUN_OPTS",
      "value": null,
      "description": "Specify specific run params for minisatip",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "/dev/dvb",
      "host": "/dev/dvb",
      "container": "/dev/dvb",
      "description": "For passing through Tv-cards",
      "required": true,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
