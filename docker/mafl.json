{
  "name": "Mafl (selfhosters)",
  "repo": "ghcr.io/hywax/mafl",
  "category": [
    "Utilities",
    "Productivity"
  ],
  "registry": "https://github.com/hywax/mafl/pkgs/container/mafl",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/mafl.png",
  "project": "https://mafl.hywax.space",
  "support": "https://github.com/hywax/mafl/issues/new/choose",
  "description": "Mafl is an intuitive service for organizing your homepage. Customize Mafl to your individual needs and work even more efficiently!",
  "requires": "Container expects a \"config.yaml\" file to be mounted at /app/data/config.yml before running. \r\n        See https://mafl.hywax.space/reference/configuration.html for more information.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/mafl/config.yaml",
      "container": "/app/data/config.yml",
      "mode": "ro",
      "description": "",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Local Icons",
      "host": "/mnt/cache/appdata/mafl/favicons",
      "container": "/app/public/favicons",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Favicon Icons",
      "host": "/mnt/cache/appdata/mafl/icons",
      "container": "/app/public/icons",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
