{
  "name": "GoDoxy",
  "repo": "ghcr.io/yusing/godoxy:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/yusing/godoxy",
  "network": "host",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/go-doxy-icon.png",
  "project": "https://github.com/yusing/godoxy",
  "support": "https://github.com/yusing/godoxy/issues",
  "description": "A lightweight, easy-to-use, and performant reverse proxy.",
  "requires": "Expects a config file in the Config Path directory: https://github.com/yusing/go-proxy/wiki/Configurations#config-file-example",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/go_doxy/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to the config directory",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Error Pages Path",
      "host": "/mnt/user/appdata/go_doxy/error_pages",
      "container": "/app/error_pages",
      "mode": "rw",
      "description": "Path to the error pages directory",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Certs Path",
      "host": "/mnt/user/appdata/go_doxy/certs",
      "container": "/app/certs",
      "mode": "rw",
      "description": "Path to the certs directory",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "API - JWT Secret",
      "key": "GODOXY_API_JWT_SECRET",
      "value": null,
      "description": "Run `openssl rand -base64 32` to generate.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "API - JWT Time To Live",
      "key": "GODOXY_API_JWT_TOKEN_TTL",
      "value": "1h",
      "description": "JWT expiry time",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "API - User",
      "key": "GODOXY_API_USER",
      "value": "admin",
      "description": "API username",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "API - Password",
      "key": "GODOXY_API_PASSWORD",
      "value": null,
      "description": "API password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "API - Address",
      "key": "GODOXY_API_ADDR",
      "value": "127.0.0.1:8888",
      "description": "API address",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "HTTP Port",
      "key": "GODOXY_HTTP_ADDR",
      "value": ":80",
      "description": "HTTP port",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "HTTPS Port",
      "key": "GODOXY_HTTPS_ADDR",
      "value": ":443",
      "description": "HTTPS port",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Block HTTP",
      "key": "GODOXY_API_JWT_SECURE",
      "value": "true",
      "description": "Block HTTP connections",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker Socker Proxy Address",
      "key": "SOCKET_PROXY_LISTEN_ADDR",
      "value": "127.0.0.1:2375",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Debug",
      "key": "GODOXY_DEBUG",
      "value": "false|true",
      "description": "Enable debug mode",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Prometheus Address",
      "key": "GODOXY_PROMETHEUS_ADDR",
      "value": null,
      "description": "Prometheus address",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "GODOXY_UID",
      "value": "99",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PUID",
      "key": "GODOXY_GID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
