{
  "name": "wikijs (selfhosters)",
  "repo": "requarks/wiki",
  "category": [
    "Hosting",
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/requarks/wiki/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/wikijs.png",
  "project": "https://github.com/Requarks/wiki",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "A modern, lightweight and powerful wiki app built on NodeJS, Git and Markdown",
  "donate": "https://opencollective.com/wikijs",
  "paths": [
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/wikijs/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Container Path: /logs",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database Type",
      "key": "DB_TYPE",
      "value": "mariadb",
      "description": "DB_TYPE : Type of database (mysql, postgres, mariadb, mssql or sqlite)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Host",
      "key": "DB_HOST",
      "value": "192.168.1.2",
      "description": "DB_HOST : Hostname or IP of the database",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Port",
      "key": "DB_PORT",
      "value": "3306",
      "description": "DB_PORT : Port of the database",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database User",
      "key": "DB_USER",
      "value": "wikijs",
      "description": "DB_USER : Username to connect to the database",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Password",
      "key": "DB_PASS",
      "value": "secretpassword",
      "description": "DB_PASS : Password to connect to the database",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Name",
      "key": "DB_NAME",
      "value": "wikijs",
      "description": "DB_NAME : Database name",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Optional: Database SSL",
      "key": "DB_SSL",
      "value": "false",
      "description": "DB_SSL : Set to either 1 or true to enable. (optional, off if omitted)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_FILEPATH",
      "key": "DB_FILEPATH",
      "value": "/mnt/cache/appdata/wikijs/db",
      "description": "For SQLite only: DB_FILEPATH : Path to the SQLite file",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
