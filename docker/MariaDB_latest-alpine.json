{
  "name": "MariaDB",
  "repo": "linuxserver/mariadb:alpine",
  "category": [
    "Network",
    "Misc",
    "Media",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/linuxserver/mariadb/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--hostname=mariadb --restart=always",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1111]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Mariadb_A.png",
  "project": "https://mariadb.org/",
  "support": "https://forums.unraid.net/topic/40737-support-linuxserverio-mariadb/",
  "description": "An Enhanced drop in replacement for Mysql.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/MariaDB",
      "container": "/config",
      "mode": "rw",
      "description": "Data Path",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "1111",
      "container": "3306",
      "protocol": "tcp",
      "description": "Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "MYSQL_ROOT_PASSWORD",
      "key": "MYSQL_ROOT_PASSWORD",
      "value": "UnMYSQL_ROOT_PASSWORD",
      "description": "MYSQL_ROOT_PASSWORD",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
