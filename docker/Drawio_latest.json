{
  "name": "Drawio",
  "repo": "jgraph/drawio",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/jgraph/drawio",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3311]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Drawio_A.png",
  "project": "https://github.com/jgraph/drawio",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "A lightweight diagram drawing application.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [],
  "ports": [
    {
      "name": "Web Port",
      "host": "3311",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Web SSL Port",
      "host": "3322",
      "container": "8443",
      "protocol": "tcp",
      "description": "Web SSL Port",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Enable Lets Encrypt",
      "key": "LETS_ENCRYPT_ENABLED",
      "value": "false",
      "description": "Enables Let's Encrypt certificate instead of self-signed certificates",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Public DNS",
      "key": "PUBLIC_DNS",
      "value": null,
      "description": "DNS domain to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Organisation Unit",
      "key": "ORGANISATION_UNIT",
      "value": null,
      "description": "Organisation unit to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Organisation",
      "key": "ORGANISATION",
      "value": null,
      "description": "Organisation name to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "City",
      "key": "CITY",
      "value": null,
      "description": "City name to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "State",
      "key": "STATE",
      "value": null,
      "description": "State name to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Country Code",
      "key": "COUNTRY_CODE",
      "value": null,
      "description": "Country code to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "KetStore Pass",
      "key": "KEYSTORE_PASS",
      "value": null,
      "description": "'.keystore'/.jks' store password",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Key Pass",
      "key": "KEY_PASS",
      "value": null,
      "description": "Private key password",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
