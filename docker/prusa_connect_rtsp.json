    "Productivity",
    "Misc"
  ],
  "registry": "https://github.com/beccazero/prusa-connect-rtsp/pkgs/container/prusa-connect-rtsp",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
