  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "Capture images from a RTSP camera upload them to Prusa Connect.",
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "RTSP URL",
      "key": "PRUSA_CONNECT_RTSP_URL",
      "value": null,
      "description": "URL of the RTSP stream to monitor",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Prusa Connect URL",
      "key": "PRUSA_CONNECT_URL",
      "value": "https://connect.prusa3d.com/c/snapshot",
      "description": "URL of the Prusa Connect to forward images to",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Prusa Connect token",
      "key": "PRUSA_CONNECT_TOKEN",
      "value": null,
      "description": "Token used to connect to Prusa Connect",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Unique camera ID",
      "key": "PRUSA_CONNECT_FINGERPRINT",
      "value": null,
      "description": "ID for the camera. Use a random UUID",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Image interval",
      "key": "PRUSA_CONNECT_UPLOAD_INTERVAL",
      "value": "30",
      "description": "Time in seconds to wait between image uploads",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Log level",
      "key": "LOGURU_LEVEL",
      "value": "INFO|DEBUG",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
