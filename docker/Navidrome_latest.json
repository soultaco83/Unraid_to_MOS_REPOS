{
  "name": "Navidrome",
  "repo": "deluan/navidrome",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/deluan/navidrome/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8032]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Navidrome_B.png",
  "project": "https://github.com/deluan/navidrome",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Modern Music Server and Streamer compatible with Subsonic/Airsonic.\r\n\r\nhttps://www.navidrome.org\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Navidrome",
      "container": "/data",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Music Media Path",
      "host": "Your Music Media Path",
      "container": "/music",
      "mode": "rw",
      "description": "Music Media Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8032",
      "container": "4533",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Log Level",
      "key": "ND_LOGLEVEL",
      "value": "info",
      "description": "Log Level",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Timeout",
      "key": "ND_SESSIONTIMEOUT",
      "value": "24h",
      "description": "Timeout",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Image Cache Size",
      "key": "ND_IMAGECACHESIZE",
      "value": "200MB",
      "description": "Image Cache Size",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Transcode",
      "key": "ND_ENABLETRANSCODINGCONFIG",
      "value": "true",
      "description": "Transcode",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
