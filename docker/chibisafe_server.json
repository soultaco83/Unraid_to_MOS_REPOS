{
  "name": "Chibisafe - Backend",
  "repo": "chibisafe/chibisafe:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/chibisafe/chibisafe",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/chibisafe-icon.png",
  "project": "https://chibisafe.app/",
  "support": "https://chibisafe.app/docs/installation/running-with-docker",
  "description": "A modern and self-hosted take on file uploading services that can handle anything you throw at it thanks to its robust and fast API, chunked uploads support and more. \r\n        [br]\n        This is the backend server. You will need to install Chibisafe - Frontend as well.",
  "requires": "Requires a separate installation of Chibisafe - Frontend and Caddy.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/chibisafe-server/database",
      "container": "/app/database",
      "mode": "rw",
      "description": "Path to the database",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Uploads Path",
      "host": "/mnt/cache/appdata/chibisafe-server/uploads",
      "container": "/app/uploads",
      "mode": "rw",
      "description": "Path to uploaded files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/chibisafe-server/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to log files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Admin Password",
      "key": "ADMIN_PASSWORD",
      "value": null,
      "description": "Admin password for the API",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
