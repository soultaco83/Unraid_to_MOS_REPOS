{
  "name": "Donetick",
  "repo": "donetick/donetick:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/donetick/donetick",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2021]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/donetick-icon.png",
  "project": "https://donetick.com/",
  "support": "https://donetick.com/",
  "description": "An open-source, user-friendly app for managing tasks and chores, featuring customizable options to help you and others stay organized.",
  "requires": "Requires a `selfhosted.yaml` file to be in the \"Config File\" path. See documentation: https://github.com/donetick/donetick/blob/main/config/selfhosted.yaml",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/donetick/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/donetick/database",
      "container": "/usr/src/app/data",
      "mode": "rw",
      "description": "Path to database files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "2021",
      "container": "2021",
      "protocol": "tcp",
      "description": "Container port: 2021",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Internal Database File",
      "key": "DT_SQLITE_PATH",
      "value": "/usr/src/app/data/donetick.db",
      "description": "Internal path to the database file. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
