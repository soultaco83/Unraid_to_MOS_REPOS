{
  "name": "UnraidConfigGuardian",
  "repo": "stephondoestech/unraid-config-guardian:latest",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/stephondoestech/unraid-config-guardian",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7842]",
  "icon": "https://raw.githubusercontent.com/stephondoestech/unraid-config-guardian/main/assets/unraid_guardian_logo_template.png",
  "project": "https://github.com/stephondoestech/unraid-config-guardian",
  "support": "https://forums.unraid.net/topic/193147-support-stephondoestech-unraidconfigguardian/",
  "description": "Automatically generate comprehensive disaster recovery documentation for your Unraid setup. Creates docker-compose files, restoration scripts, and system backups for complete server recreation in under 30 minutes. \n\nUnraid Config Guardian automatically generates comprehensive disaster recovery documentation for your Unraid setup.\n\nFeatures:\n - Complete server recreation in under 30 minutes\n - Docker-compose generation from running containers\n - Automated restoration scripts with security-conscious data masking\n - Web-based interface for easy management\n - Scheduled automated backups\n\n***Install the dockersocket container from the apps page. You will need to add a variable to the container called IMAGES and give it a value of 1. The docker socket proxy will return a 403 without this.***\n \nAccess the web interface at http://your-unraid-ip:7842",
  "requires": "***THIS REQUIRES THE dockersocket APP FROM THE APP STORE TO RUN***",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/user/appdata/unraid-config-guardian",
      "container": "/config",
      "mode": "rw",
      "description": "Application configuration",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Output Directory",
      "host": "/mnt/user/backups/unraid-docs",
      "container": "/output",
      "mode": "rw",
      "description": "Generated backup files location",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Unraid Flash Drive",
      "host": "/boot",
      "container": "/boot",
      "mode": "ro",
      "description": "Unraid flash drive for system configuration",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7842",
      "container": "7842",
      "protocol": "tcp",
      "description": "Port for web interface",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "99",
      "description": "User ID",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "Group ID",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "Timezone for logging",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Backup Schedule",
      "key": "SCHEDULE",
      "value": "0 2 * * 0",
      "description": "Cron schedule for automated backups (Sunday 2 AM)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Mask Passwords",
      "key": "MASK_PASSWORDS",
      "value": "true",
      "description": "Hide sensitive environment variables",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Include System Info",
      "key": "INCLUDE_SYSTEM_INFO",
      "value": "true",
      "description": "Include system information in backup",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DOCKER HOST",
      "key": "DOCKER_HOST",
      "value": "tcp://dockersocket-ip:2375",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
