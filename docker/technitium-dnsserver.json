{
  "name": "dns-server",
  "repo": "technitium/dns-server",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/technitium/dns-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--user 500:500 --sysctl=\"net.ipv4.ip_local_port_range=1024 65000\"",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5380]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/Technitium.png",
  "project": "https://github.com/TechnitiumSoftware/DnsServer",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Technitium DNS Server is an open source tool that can be used for self hosting a local DNS server for privacy and security or, used for experimentation/testing by software developers on their computer. It works out-of-the-box with no or minimal configuration and provides a user friendly web console accessible using any web browser. See github for envirionment variables https://github.com/TechnitiumSoftware/DnsServer/blob/master/docker-compose.yml",
  "paths": [
    {
      "name": "App data",
      "host": "/mnt/cache/appdata/technitium-dnsserver",
      "container": "/etc/dns/",
      "mode": "rw",
      "description": "Container Path: /etc/dns",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5380",
      "container": "5380",
      "protocol": "tcp",
      "description": "Container Port:",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DNS Port",
      "host": "53",
      "container": "53",
      "protocol": "udp",
      "description": "Container Port: 53",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
