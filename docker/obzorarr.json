{
  "name": "Obzorarr",
  "repo": "ghcr.io/engels74/obzorarr-docker:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/engels74/obzorarr-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/engels74/obzorarr/main/src/lib/assets/obzorarr-icon.svg",
  "project": "https://github.com/engels74/obzorarr",
  "support": "https://github.com/engels74/obzorarr/issues",
  "description": "Obzorarr is a \"Wrapped for Plex\" application that syncs viewing history from your Plex Media Server and generates yearly statistics with an animated slideshow presentation - similar to Spotify Wrapped. It doesn't require Tautulli; it only relies on the Plex API.",
  "requires": "Requires a separate Plex instance.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/user/appdata/obzorarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Plex Server URL",
      "key": "PLEX_SERVER_URL",
      "value": null,
      "description": "URL of your Plex Server (e.g., http://localhost:32400)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Plex Token",
      "key": "PLEX_TOKEN",
      "value": null,
      "description": "Plex token",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
