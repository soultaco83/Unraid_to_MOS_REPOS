{
  "name": "Kitana (selfhosters)",
  "repo": "pannal/kitana",
  "category": [
    "Home Automation",
    "Utilities",
    "Media",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/pannal/kitana/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-B 0.0.0.0:31337",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:31337]",
  "icon": "https://raw.githubusercontent.com/pannal/Kitana/master/static/img/android-icon-192x192.png",
  "project": "https://github.com/pannal/Kitana",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Kitana exposes your Plex plugin interfaces \"to the outside world\". It does that by authenticating against Plex.TV, then connecting to the Plex Media Server you tell it to, and essentially proxying the plugin UI. It has full PMS connection awareness and allows you to connect locally, remotely, or even via relay.\r\n\r\n[br][b][span style='color: #E80000;']To set the baseurl for this application, open advanced view, and add [span style='color: #00e814;']-p /kitana -P [/span] to the \"Post Arguments\"  [/span][/b]",
  "donate": "https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&amp;hosted_button_id=G9VKR2B8PMNKG",
  "paths": [
    {
      "name": "Application Data",
      "host": "/mnt/cache/appdata/kitana",
      "container": "/app/data",
      "mode": "rw",
      "description": "Container Path: /app/data",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "31337",
      "container": "31337",
      "protocol": "tcp",
      "description": "Container Port: 31337",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
