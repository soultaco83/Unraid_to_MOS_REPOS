{
  "name": "legit",
  "repo": "ghcr.io/icyphox/legit:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/icyphox/legit",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5555]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/legit-icon.png",
  "project": "https://github.com/icyphox/legit",
  "support": "https://github.com/icyphox/legit/issues",
  "description": "A web frontend for git",
  "requires": "Expects a `config.yaml` file in the Config Path. See documentation: https://github.com/icyphox/legit/blob/master/config.yaml",
  "paths": [
    {
      "name": "Repo Storage",
      "host": null,
      "container": "/var/www/git",
      "mode": "rw",
      "description": "Path to git repository storage",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/legit/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5555",
      "container": "5555",
      "protocol": "tcp",
      "description": "Container Port: 5555",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
