{
  "name": "Sync-in",
  "repo": "syncin/server:1",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/syncin/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/sync-in-icon.png",
  "project": "https://sync-in.com",
  "support": "https://sync-in.com/docs",
  "description": "An open-source platform to store, share, collaborate, and sync your files.",
  "requires": "Requires a `environment.yaml` file to be mounted at the Config File path before starting the container. See configuration details: https://sync-in.com/docs/setup-guide/docker#1-default-secrets \r\n        \r\n        Requires a separate MariaDB database.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/sync_in/environment.yaml",
      "container": "/app/environment/environment.yaml",
      "mode": "rw",
      "description": "Path to the environment file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/sync_in/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Desktop Releases Path",
      "host": "/mnt/cache/appdata/sync_in/releases",
      "container": "/app/static/releases",
      "mode": "ro",
      "description": "Path to desktop releases",
      "required": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Initialize Admin",
      "key": "INIT_ADMIN",
      "value": "true|false",
      "description": "Initialize the admin user on first run",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
