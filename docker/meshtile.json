{
  "name": "Meshtile",
  "repo": "stevenlafl/meshtile:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/stevenlafl/meshtile",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--region pnw",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/meshtile-icon.png",
  "project": "https://github.com/stevenlafl/meshtile",
  "support": "https://github.com/stevenlafl/meshtile/issues",
  "description": "RF coverage tile server for MeshCore networks",
  "requires": "Requires editing Post Arguments for region settings. See documentation: https://github.com/stevenlafl/meshtile#usage",
  "paths": [
    {
      "name": "Cache",
      "host": "/mnt/user/appdata/meshtile/cache",
      "container": "/data/.cache",
      "mode": "rw",
      "description": "Path to the data cache",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
