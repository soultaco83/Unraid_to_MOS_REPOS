{
  "name": "audiosilo (linuxserver)",
  "repo": "lscr.io/linuxserver/audiosilo",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/audiosilo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:8080]",
  "readme_url": "https://github.com/linuxserver/docker-audiosilo#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/audiosilo-logo.png",
  "project": "https://audiosilo.app",
  "support": "https://github.com/linuxserver/docker-audiosilo/issues/new/choose",
  "description": "AudioSilo(https://audiosilo.app) is a self-hosted audiobook server. Point it at your audiobook folders and listen from the built-in web player or the AudioSilo app for iOS, with listening progress synced across devices.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files, database, backups and TLS certificates.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Audiobooks",
      "host": null,
      "container": "/audiobooks",
      "mode": "ro",
      "description": "Audiobooks location, read-only (the server never writes to your books). Add it as a library in the admin console.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web player, admin console and the API the apps connect to.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
