{
  "name": "Subs",
  "repo": "ghcr.io/ajnart/subs:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://github.com/ajnart/subs/pkgs/container/subs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/subs-icon.jpg",
  "project": "https://subs.ajnart.fr",
  "support": "https://github.com/ajnart/subs/issues",
  "description": "A simplistic open-source subscription cost tracker",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/subs/database",
      "container": "/database",
      "mode": "rw",
      "description": "Database directory",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "file:/database/db.sqlite",
      "description": "Internal database URL",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Use KV Database",
      "key": "NEXT_PUBLIC_USE_SQLITE",
      "value": "false|true",
      "description": "Use KV database instead of localStorage",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
