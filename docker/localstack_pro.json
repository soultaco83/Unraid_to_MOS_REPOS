{
  "name": "LocalStack Pro",
  "repo": "localstack/localstack-pro:latest",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/localstack/localstack-pro",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:443]/",
  "icon": "https://cdn.prod.website-files.com/6539036f80ddc9e9a467134e/681e4d77a183f92570e14555_localstack-logo.svg",
  "project": "https://www.localstack.cloud/",
  "support": "https://docs.localstack.cloud/",
  "description": "LocalStack is a local cloud emulator that lets you build and test cloud applications entirely on your machine. Spin up fully functional local environments that mirror real cloud behavior — including AWS services and Snowflake — without provisioning real cloud infrastructure. Whether you're validating IaC templates, running integration tests, or iterating on data pipelines, LocalStack integrates seamlessly with your tools and CI/CD pipelines to help you ship faster and safer.",
  "requires": "May require additional configuration via environmental variables. See documentation: https://docs.localstack.cloud/references/configuration/",
  "paths": [
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/localstack/data",
      "container": "/var/lib/localstack",
      "mode": "rw",
      "description": "Path to the data directory",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4566",
      "container": "4566",
      "protocol": "tcp",
      "description": "Container Port: 4566",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "HTTPS Port",
      "host": "9443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443 for HTTPS access",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "External Service Ports",
      "host": "4510-4559",
      "container": "4510-4559",
      "protocol": "tcp",
      "description": "Range for external service ports",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Auth Token",
      "key": "LOCALSTACK_AUTH_TOKEN",
      "value": null,
      "description": "Authentication token for LocalStack Pro. See documentation: https://docs.localstack.cloud/getting-started/auth-token/",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Persistence",
      "key": "PERSISTENCE",
      "value": "0|1",
      "description": "Enable persistence for the data directory. Set to 1 to enable.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "0|1",
      "description": "Enable debug mode. Set to 1 to enable.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
