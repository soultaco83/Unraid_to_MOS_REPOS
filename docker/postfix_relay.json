{
  "name": "postfix-relay",
  "repo": "mwader/postfix-relay:latest",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/mwader/postfix-relay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/postfix-relay-icon.png",
  "project": "https://www.postfix.org/",
  "support": "https://github.com/wader/postfix-relay/issues",
  "description": "A relay for sending email without using an external SMTP server. \r\n        [br]\n        See all available configuration options: https://github.com/wader/postfix-relay#postfix-variables",
  "paths": [
    {
      "name": "OpenDKIM Key Storage Path",
      "host": "/mnt/cache/appdata/postfix_relay/opendkim_keys",
      "container": "/etc/opendkim/keys",
      "mode": "rw",
      "description": "Path to store OpenDKIM keys",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "SMTP Port",
      "host": "25",
      "container": "25",
      "protocol": "tcp",
      "description": "Container Port: 25",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Hostname",
      "key": "POSTFIX_myhostname",
      "value": null,
      "description": "Hostname for this SMTP server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
