{
  "name": "wikijs (linuxserver)",
  "repo": "lscr.io/linuxserver/wikijs",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/wikijs",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "readme_url": "https://github.com/linuxserver/docker-wikijs#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/wikijs-logo.png",
  "project": "https://github.com/Requarks/wiki",
  "support": "https://github.com/linuxserver/docker-wikijs/issues/new/choose",
  "description": "Wikijs(https://github.com/Requarks/wiki) A modern, lightweight and powerful wiki app built on NodeJS.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/data",
      "host": null,
      "container": "/data",
      "mode": "rw",
      "description": "Where Wiki.js data is stored.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Port for Wiki.js's web interface.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "DB_TYPE",
      "key": "DB_TYPE",
      "value": "sqlite",
      "description": "Set to sqlite (default) or postgres depending on the database engine you wish to use",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_HOST",
      "key": "DB_HOST",
      "value": null,
      "description": "DB hostname (postgres only)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": null,
      "description": "DB port (postgres only)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": null,
      "description": "DB name (postgres only)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_USER",
      "key": "DB_USER",
      "value": null,
      "description": "DB username (postgres only)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PASS",
      "key": "DB_PASS",
      "value": null,
      "description": "DB password (postgres only)",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
