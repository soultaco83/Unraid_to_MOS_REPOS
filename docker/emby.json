{
  "name": "emby",
  "repo": "lscr.io/linuxserver/emby",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/emby",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8096]",
  "readme_url": "https://github.com/linuxserver/docker-emby#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/emby-logo.png",
  "project": "https://emby.media/",
  "support": "https://github.com/linuxserver/docker-emby/issues/new/choose",
  "description": "Emby(https://emby.media/) organizes video, music, live TV, and photos from personal media libraries and streams them to smart TVs, streaming boxes and mobile devices. This container is packaged as a standalone emby Media Server.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Emby data storage location. *This can grow very large, 50gb+ is likely for a large collection.*",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/data/tvshows",
      "host": null,
      "container": "/data/tvshows",
      "mode": "rw",
      "description": "Media goes here. Add as many as needed e.g. `/data/movies`, `/data/tv`, etc.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/data/movies",
      "host": null,
      "container": "/data/movies",
      "mode": "rw",
      "description": "Media goes here. Add as many as needed e.g. `/data/movies`, `/data/tv`, etc.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/opt/vc/lib",
      "host": null,
      "container": "/opt/vc/lib",
      "mode": "rw",
      "description": "Path for Raspberry Pi OpenMAX libs *optional*.",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8096",
      "container": "8096",
      "protocol": "tcp",
      "description": "Http webUI.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "8920",
      "host": "8920",
      "container": "8920",
      "protocol": "tcp",
      "description": "Https webUI (you need to setup your own certificate).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "/dev/dri",
      "host": "/dev/dri",
      "container": "/dev/dri",
      "description": "Only needed if you want to use your Intel or AMD GPU for hardware accelerated video encoding (vaapi).",
      "required": false,
      "display": "always"
    },
    {
      "name": "/dev/video10",
      "host": "/dev/video10",
      "container": "/dev/video10",
      "description": "Only needed if you want to use your Raspberry Pi V4L2 video encoding.",
      "required": false,
      "display": "always"
    },
    {
      "name": "/dev/video11",
      "host": "/dev/video11",
      "container": "/dev/video11",
      "description": "Only needed if you want to use your Raspberry Pi V4L2 video encoding.",
      "required": false,
      "display": "always"
    },
    {
      "name": "/dev/video12",
      "host": "/dev/video12",
      "container": "/dev/video12",
      "description": "Only needed if you want to use your Raspberry Pi V4L2 video encoding.",
      "required": false,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
