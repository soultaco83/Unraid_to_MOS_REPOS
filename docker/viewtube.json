{
  "name": "viewtube",
  "repo": "mauriceo/viewtube",
  "category": [
    "Utilities",
    "Media"
  ],
  "registry": "https://hub.docker.com/r/mauriceo/viewtube/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8066]",
  "icon": "https://i.imgur.com/lvFTgAe.png",
  "project": "https://viewtube.io",
  "support": "https://hub.docker.com/r/mauriceo/viewtube/",
  "description": "ViewTube is a self-hostable frontend for YouTube.\r\n\r\n\r\nhttps://hub.docker.com/r/mauriceo/viewtube/",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/viewtube",
      "container": "/data",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8066",
      "container": "8066",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Container Variable 4",
      "key": "VIEWTUBE_BASE_DIR",
      "value": "/home/app",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VIEWTUBE_API_URL",
      "key": "VIEWTUBE_API_URL",
      "value": "https://api.viewtube.io/",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VIEWTUBE_DATABASE_HOST",
      "key": "VIEWTUBE_DATABASE_HOST",
      "value": "mongodb",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VIEWTUBE_REDIS_HOST",
      "key": "VIEWTUBE_REDIS_HOST",
      "value": "redis",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VIEWTUBE_CORS_ORIGIN",
      "key": "VIEWTUBE_CORS_ORIGIN",
      "value": null,
      "description": "Domains that are allowed to access the resources served by ViewTube. For example https://app.domain.com",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
