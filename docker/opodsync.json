{
  "name": "oPodSync",
  "repo": "ganeshlab/opodsync:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/ganeshlab/opodsync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/opodsync-icon.png",
  "project": "https://github.com/kd2org/opodsync",
  "support": "https://github.com/kd2org/opodsync/issues",
  "description": "A minimalist podcast synchronization server, for self-hosting your podcast listening / download history. This allows you to keep track of which episodes have been listened to. Previously known as Micro GPodder.",
  "requires": "Expects a `config.local.php` file in the \"Config Data\" path. See documentation: https://github.com/kd2org/opodsync?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/user/appdata/opodsync/config",
      "container": "/var/www/server/data",
      "mode": "rw",
      "description": "Path to config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
