{
  "name": "Monero-GUI",
  "repo": "ghcr.io/ich777/monero-gui",
  "category": [
    "Crypto"
  ],
  "registry": "https://hub.docker.com/r/ich777/monero-gui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/monero.png",
  "project": "https://www.getmonero.org/",
  "support": "https://forums.unraid.net/topic/83786-support-ich777-application-dockers/",
  "description": "Monero-GUI is a simple but yet powerfull Monero Wallet.\r\n\r\n**ATTENTION:** By default your wallet is saved in ../Monero/wallet (please don't store your Wallet in the .../bin directory since it get's deleted after a update is released)\r\nI strongly recommend you to backup your keyfile on a regular basis!\r\n\r\n**NOTE:** If you minimize the window by accident you have to restart the container to see the GUI again.",
  "donate": "https://www.paypal.me/chips777",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/monero-gui",
      "container": "/monero",
      "mode": "rw",
      "description": "Please keep in mind that your wallet is stored there and I strongly recommend you to backup that path (ATTENTION: By default your wallet is saved in ../Monero/wallet - please don't store your Wallet in the .../bin directory since it get's deleted after a update is released).",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebGUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "TCP noVNC WebGUI Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Custom Screen Width",
      "key": "CUSTOM_RES_W",
      "value": "1280",
      "description": "Minimum screen width 1280 pixels",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Screen Height",
      "key": "CUSTOM_RES_H",
      "value": "1024",
      "description": "Minimum screen hight 1024 pixels",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "99",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "DATA_PERM",
      "key": "DATA_PERM",
      "value": "770",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "ich777"
}
