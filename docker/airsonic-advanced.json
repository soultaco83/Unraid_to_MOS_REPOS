{
  "name": "airsonic-advanced",
  "repo": "lscr.io/linuxserver/airsonic-advanced",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/airsonic-advanced",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4040]/login",
  "readme_url": "https://github.com/linuxserver/docker-airsonic-advanced#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/airsonic-advanced-logo.png",
  "project": "https://github.com/kagemomiji/airsonic-advanced",
  "support": "https://github.com/linuxserver/docker-airsonic-advanced/issues/new/choose",
  "description": "Airsonic-advanced(https://github.com/kagemomiji/airsonic-advanced) is a free, web-based media streamer, providing ubiquitious access to your music. Use it to share your music with friends, or to listen to your own music while at work. You can stream to multiple players simultaneously, for instance to one player in your kitchen and another in your living room.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Configuration file location.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/music",
      "host": null,
      "container": "/music",
      "mode": "rw",
      "description": "Location of music.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/playlists",
      "host": null,
      "container": "/playlists",
      "mode": "rw",
      "description": "Location for playlists to be saved to.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/podcasts",
      "host": null,
      "container": "/podcasts",
      "mode": "rw",
      "description": "Location of podcasts.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/media",
      "host": null,
      "container": "/media",
      "mode": "rw",
      "description": "Location of other media.",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4040",
      "container": "4040",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "CONTEXT_PATH",
      "key": "CONTEXT_PATH",
      "value": null,
      "description": "For setting url-base in reverse proxy setups.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "JAVA_OPTS",
      "key": "JAVA_OPTS",
      "value": null,
      "description": "For passing additional java options.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "/dev/snd",
      "host": "/dev/snd",
      "container": "/dev/snd",
      "description": "Only needed to pass your host sound device to Airsonic's Java jukebox player.",
      "required": false,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
