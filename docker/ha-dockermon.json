{
  "name": "ha-dockermon",
  "repo": "philhawthorne/ha-dockermon",
  "category": [
    "Home Automation",
    "Network",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/philhawthorne/ha-dockermon/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/ha-dockermon_icon.png",
  "project": null,
  "support": "https://forums.unraid.net/topic/72033-support-digiblurs-docker-template-repository/",
  "description": "A NodeJS RESTful API which can be used with Home Assistant to report the state of Docker Containers [br][br]Custom Component to automatically add all your docker switches to home assistant.  https://gitlab.com/custom_components/hadockermon [br][br]Additional info including the API can be found here:[br][br]\r\nhttps://github.com/philhawthorne/ha-dockermon",
  "paths": [
    {
      "name": "dockersock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Container Path: /var/run/docker.sock",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "configpath",
      "host": "/mnt/user/appdata/ha-dockermon/",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API port",
      "host": "8126",
      "container": "8126",
      "protocol": "tcp",
      "description": "Container Port: 8126",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
