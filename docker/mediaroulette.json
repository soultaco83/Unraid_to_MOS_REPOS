{
  "name": "MediaRoulette (selfhosters)",
  "repo": "ghcr.io/keltech-services/mediaroulette:latest",
  "category": [
    "Media",
    "Misc"
  ],
  "registry": "https://github.com/KelTech-Services/MediaRoulette/pkgs/container/mediaroulette",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/mediaroulette.png",
  "project": "https://github.com/KelTech-Services/MediaRoulette",
  "support": "https://github.com/KelTech-Services/MediaRoulette/issues",
  "description": "MediaRoulette for Plex — Can't decide what to watch? MediaRoulette randomly picks from your Movies, TV Shows, or both with optional filters (genre, rating, unwatched only, etc.). Great for large libraries where scrolling becomes overwhelming. Connects via Plex OAuth - no credentials stored.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/mediaroulette",
      "container": "/app/data",
      "mode": "rw",
      "description": "Stores config, watchlist, and user data",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "Flask session encryption key. Generate a random 32+ character string for security.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
