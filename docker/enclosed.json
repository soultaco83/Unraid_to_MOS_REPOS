{
  "name": "Enclosed",
  "repo": "corentinth/enclosed:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/corentinth/enclosed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8787]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/enclosed-icon.png",
  "project": "https://enclosed.cc",
  "support": "https://github.com/CorentinTh/enclosed/issues",
  "description": "A minimalistic web application designed for sending private and secure notes with end-to-end encryption.",
  "paths": [
    {
      "name": "Config data",
      "host": "/mnt/cache/appdata/enclosed/data",
      "container": "/app/.data",
      "mode": "rw",
      "description": "Config data for application",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8787",
      "container": "8787",
      "protocol": "tcp",
      "description": "Container Port: 8787",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
