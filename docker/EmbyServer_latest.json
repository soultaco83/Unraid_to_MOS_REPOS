{
  "name": "EmbyServer",
  "repo": "emby/embyserver:latest",
  "category": [
    "Media"
  ],
  "registry": "https://registry.hub.docker.com/r/emby/embyserver/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2111]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Emby_B.png",
  "project": "https://emby.media",
  "support": "https://lime-technology.com/forum/index.php?topic=45444.0",
  "description": "Emby Server is a home media server built on top of other popular open source technologies such as Service Stack, jQuery, jQuery mobile, and Mono. Bringing together movies, music, television and more in one dazzling interface.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Media Path",
      "host": "Your Media Path",
      "container": "/mnt",
      "mode": "rw",
      "description": "Media Path",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/EmbyServer",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "2111",
      "container": "8096",
      "protocol": "tcp",
      "description": "Web Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "UID",
      "key": "UID",
      "value": "0",
      "description": "UID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "0",
      "description": "GID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "GIDLIST",
      "key": "GIDLIST",
      "value": "100",
      "description": "GIDLIST",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TimeZone",
      "key": "TZ",
      "value": "CST-8",
      "description": "TimeZone",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HTTP_PROXY",
      "key": "HTTP_PROXY",
      "value": "http://xxx.xxx.xxx.xxx:7890",
      "description": "HTTP_PROXY",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HTTPS_PROXY",
      "key": "HTTPS_PROXY",
      "value": "http://xxx.xxx.xxx.xxx:7890",
      "description": "HTTPS_PROXY",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "GPU",
      "host": "/dev/dri/",
      "container": "/dev/dri/",
      "description": "GPU",
      "required": false,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
