{
  "name": "RetroReplay",
  "repo": "ghcr.io/d3mystified/retroreplay:main",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/d3mystified/retroreplay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/retro-replay-icon.png",
  "project": "https://github.com/d3mystified/RetroReplay",
  "support": "https://github.com/d3mystified/RetroReplay/issues",
  "description": "Highlight your Plex media that originally aired in the past during the current week or month. Automatically maintain lists on TMDb that can be used with Kometa to create collections on Plex.",
  "requires": "Requires a `config.yml` file in the Config Path folder: https://github.com/d3mystified/RetroReplay?tab=readme-ov-file#how-to-use",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/retro_replay/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Schedule",
      "key": "RUN_AT",
      "value": "0:00",
      "description": "24-hour time to run the script",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Config File",
      "key": "CONFIG_FILE",
      "value": "/config/config.yml",
      "description": "Path to the internal config file",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
