{
  "name": "Cron - Alpine",
  "repo": "ghcr.io/2franix/cron-docker:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/2franix/cron-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/cron-alpine-icon.png",
  "project": "https://github.com/2franix/cron-docker",
  "support": "https://github.com/2franix/cron-docker/issues",
  "description": "Alpine-based images with cron support",
  "requires": "Expects a crontab file mounted to Cron File BEFORE starting the container.",
  "paths": [
    {
      "name": "Cron File",
      "host": "/mnt/cache/appdata/cron_alpine/crontab",
      "container": "/crontab",
      "mode": "rw",
      "description": "Crontab file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Pre-Run Script Directory",
      "host": "/mnt/cache/appdata/cron_alpine/pre-run.d",
      "container": "/entrypoint.pre.d",
      "mode": "rw",
      "description": "Directory for pre-run scripts",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Cron - Mail To",
      "key": "CRON_MAILTO",
      "value": null,
      "description": "Cron emails recipient",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SMTP - Host",
      "key": "SMTP_HOST",
      "value": null,
      "description": "SMTP server hostname",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SMTP - Port",
      "key": "SMTP_PORT",
      "value": null,
      "description": "SMTP server port",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SMTP - TLS",
      "key": "SMTP_TLS",
      "value": "on|off",
      "description": "Use TLS for SMTP connection",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SMTP - From Address",
      "key": "SMTP_FROM",
      "value": null,
      "description": "Sender email address",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SMTP - Username",
      "key": "SMTP_USER",
      "value": null,
      "description": "SMTP username",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SMTP - Password",
      "key": "SMTP_PASSWORD",
      "value": null,
      "description": "SMTP password",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Cron User ID",
      "key": "CRON_USER_UID",
      "value": "500",
      "description": "User ID to run the cron jobs as.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Cron Group ID",
      "key": "CRON_USER_GID",
      "value": "500",
      "description": "Group ID to run the cron jobs as.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Cron Worker",
      "key": "CRON_USER",
      "value": "worker",
      "description": "User to run the cron jobs as. Not modifiable",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Cron Worker Home",
      "key": "CRON_USER_HOME",
      "value": "/worker",
      "description": "Home directory of the cron user.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Pre-Run Script Directory",
      "key": "CRON_ENTRYPOINT_PRE_DIR",
      "value": "/entrypoint.pre.d",
      "description": "Internal directory for pre-run scripts.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Cron File",
      "key": "CRON_SPEC_FILE",
      "value": "/crontab",
      "description": "Internal crontab file.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Cron Verbosity",
      "key": "CRON_VERBOSITY",
      "value": "8|7|6|5|4|3|2|1|0",
      "description": "Cron verbosity level. 0 - max, 8 - min",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
