{
  "name": "orcaslicer (linuxserver)",
  "repo": "lscr.io/linuxserver/orcaslicer",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/orcaslicer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "readme_url": "https://github.com/linuxserver/docker-orcaslicer#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/orcaslicer-logo.png",
  "project": "https://github.com/SoftFever/OrcaSlicer",
  "support": "https://github.com/linuxserver/docker-orcaslicer/issues/new/choose",
  "description": "Orca Slicer(https://github.com/SoftFever/OrcaSlicer) is an open source slicer for FDM printers. OrcaSlicer is fork of Bambu Studio, it was previously known as BambuStudio-SoftFever, Bambu Studio is forked from PrusaSlicer by Prusa Research, which is from Slic3r by Alessandro Ranellucci and the RepRap community",
  "donate": "https://www.linuxserver.io/donate",
  "requires": "This image is unprotected by default __**do not**__ expose it to the internet.\n        Please read https://github.com/linuxserver/docker-orcaslicer#security for more information.",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores program settings and files.",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Orca Slicer desktop gui HTTP, must be proxied.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Orca Slicer desktop gui HTTPS.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
