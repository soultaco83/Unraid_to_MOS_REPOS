{
  "name": "LiveKit",
  "repo": "livekit/livekit-server",
  "category": [
    "Media",
    "Misc",
    "Utilities",
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/livekit/livekit-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--config /config/config.yaml",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/livekit-icon.png",
  "project": "https://livekit.io",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "An open source project that provides scalable, multi-user conferencing based on WebRTC. It's designed to provide everything you need to build real-time video audio data capabilities in your applications.",
  "requires": "Container expects a \"config.yaml\" file to be mounted at /config/config.yaml before running. \r\n        See https://docs.livekit.io/home/self-hosting/deployment/#Configuration for more information.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/livekit",
      "container": "/config",
      "mode": "rw",
      "description": "Parent folder for config.yaml file",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Main Port",
      "host": "7880",
      "container": "7880",
      "protocol": "tcp",
      "description": "Container Port: 7880",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WebRTC UDP Ports",
      "host": "50000-60000",
      "container": "50000-60000",
      "protocol": "udp",
      "description": "UDP ports for client traffic",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "WebRTC TCP Port",
      "host": "7881",
      "container": "7881",
      "protocol": "tcp",
      "description": "TCP port for client traffic when UDP not available",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
