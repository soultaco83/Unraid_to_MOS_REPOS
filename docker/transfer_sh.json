{
  "name": "Transfer.sh",
  "repo": "dutchcoders/transfer.sh:edge",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/dutchcoders/transfer.sh",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--provider local --basedir /tmp/",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/transfer-sh-icon.png",
  "project": "https://transfer.sh",
  "support": "https://github.com/dutchcoders/transfer.sh",
  "description": "Easy and fast file sharing from the command-line. Transfer.sh currently supports the s3 (Amazon S3), gdrive (Google Drive), storj (Storj) providers, and local file system (local).",
  "requires": "This is pre-configured to work with local storage. Please see documentation and edit `Post Arguments` to use a different storage backend.",
  "paths": [
    {
      "name": "Storage",
      "host": null,
      "container": "/tmp",
      "mode": "rw",
      "description": "Path to storage location",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Purge Days",
      "key": "PURGE_DAYS",
      "value": "7",
      "description": "Number of days to keep files",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Purge Interval",
      "key": "PURGE_INTERVAL",
      "value": "6",
      "description": "Interval, in hours, to check for files to purge",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Max File Size",
      "key": "MAX_UPLOAD_SIZE",
      "value": "10485761",
      "description": "Maximum file size, in bytes, to allow for upload",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
