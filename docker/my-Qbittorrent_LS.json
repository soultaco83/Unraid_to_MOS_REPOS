{
  "name": "Qbittorrent_LS",
  "repo": "linuxserver/qbittorrent:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/qbittorrent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1915]",
  "icon": "https://ghproxy.com/raw.githubusercontent.com/xushier/HD-Icons/main/border-radius/Qbittorrent_A.png",
  "project": "https://www.qbittorrent.org/",
  "support": "https://github.com/linuxserver/docker-qbittorrent/issues/new/choose",
  "description": "The Qbittorrent(https://www.qbittorrent.org/) project aims to provide an open-source software alternative to µTorrent. qBittorrent is based on the Qt toolkit and libtorrent-rasterbar library.",
  "paths": [
    {
      "name": "Path: /downloads",
      "host": "/mnt/user/XiaZai",
      "container": "/downloads",
      "mode": "rw",
      "description": "Location of downloads on disk.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Appdata",
      "host": "/mnt/user/appdata/Qbittorrent_LS",
      "container": "/config",
      "mode": "rw",
      "description": "Contains all relevant configuration files.",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "1915",
      "container": "1915",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Port: 6881",
      "host": "56687",
      "container": "56687",
      "protocol": "tcp",
      "description": "tcp connection port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Port: 6881",
      "host": "56687",
      "container": "56687",
      "protocol": "udp",
      "description": "udp connection port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "WEBUI_PORT",
      "key": "WEBUI_PORT",
      "value": "1915",
      "description": "for changing the port of the webui, see below for explanation",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "0",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "0",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
