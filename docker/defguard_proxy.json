{
  "name": "defguard - Proxy",
  "repo": "ghcr.io/defguard/defguard-proxy:latest",
  "category": [
    "Network",
    "Security",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/defguard/defguard-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/defguard-icon.png",
  "project": "https://defguard.net/",
  "support": "https://docs.defguard.net/",
  "description": "defguard is a true Zero-Trust WireGuard® VPN with 2FA/Multi-Factor Authentication, as each connection requires MFA (and not only when logging in into the client application like other solutions). \r\n        [br]\n        This is the proxy component of defguard.",
  "requires": "Requires a defguard - Core container to be running.",
  "paths": [],
  "ports": [
    {
      "name": "Proxy Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "gRPCS Port",
      "key": "DEFGUARD_PROXY_GRPC_PORT",
      "value": "50051",
      "description": "Port for gRPCS server to listen on",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Rust Traceback",
      "key": "RUST_BACKTRACE",
      "value": "1",
      "description": "Enable Rust backtraces",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
