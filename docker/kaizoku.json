{
  "name": "Kaizoku",
  "repo": "ghcr.io/oae/kaizoku:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/oae/kaizoku",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/oae/kaizoku/main/public/kaizoku.png",
  "project": "https://kaizoku.app/",
  "support": "https://github.com/oae/kaizoku/issues",
  "description": "A self-hosted manga downloader.",
  "requires": "Requires a separate PostgreSQL database and Redis instance.",
  "paths": [
    {
      "name": "Library Path",
      "host": null,
      "container": "/data",
      "mode": "rw",
      "description": "Path to store downloaded files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/kaizoku/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to store configuration files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/kaizoku/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Path to store logs",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Postgres - Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://kaizoku:kaizoku@db:5432/kaizoku",
      "description": "Postgres database URL",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Host",
      "key": "REDIS_HOST",
      "value": null,
      "description": "Redis host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - Port",
      "key": "REDIS_PORT",
      "value": "6379",
      "description": "Redis port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "KAIZOKU_PORT",
      "value": "3000",
      "description": "Internal port for Kaizoku. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
