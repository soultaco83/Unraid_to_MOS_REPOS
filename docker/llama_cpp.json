{
  "name": "llama.cpp",
  "repo": "ghcr.io/ggml-org/llama.cpp:full",
  "category": [
    "AI",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/ggml-org/llama.cpp",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-m /models/model.gguf --port 8000 --host 0.0.0.0 --n-gpu-layers 1",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://user-images.githubusercontent.com/1991296/230134379-7181e485-c521-4d23-a0d6-f7b3b61ba524.png",
  "project": "https://github.com/ggml-org/llama.cpp",
  "support": "https://github.com/ggml-org/llama.cpp/issues",
  "description": "Inference of Meta's LLaMA model (and others) in pure C/C++",
  "requires": "The image for this container is several gigabytes. If you receive a \"no space left on device\" warning during installation, please increase the vDisk size in your Docker settings. \r\n        This container expects a \"model.gguf\" file to be present in the model storage path. \r\n        If you are using an Nvidia GPU, add \"--gpus all\" to the Extra Parameters field under Advanced.",
  "paths": [
    {
      "name": "Model Storage Path",
      "host": "/mnt/user/appdata/llama_cpp/model",
      "container": "/models",
      "mode": "rw",
      "description": "Storage for model",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
