{
  "name": "AURA",
  "repo": "mediux/aura:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/mediux/aura",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/aura-icon.png",
  "project": "https://github.com/mediux-team/AURA",
  "support": "https://github.com/mediux-team/AURA/issues",
  "description": "Automated Utility for Retrieval of Assets, a tool designed to use Mediux images for your media server content. It provides a web interface to browse and select image sets for your library.",
  "paths": [
    {
      "name": "Media Path",
      "host": null,
      "container": "/data/media",
      "mode": "rw",
      "description": "Path to the media directory. Edit the Target to match the same path as inside your media server (e.g. Plex) Docker container.",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/aura/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config directory",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "API Port",
      "host": "8888",
      "container": "8888",
      "protocol": "tcp",
      "description": "Container Port: 8888",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
