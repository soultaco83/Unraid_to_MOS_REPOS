{
  "name": "Postfix-Relay",
  "repo": "loganmarchione/docker-postfixrelay:latest",
  "category": [
    "Productivity",
    "Network",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/loganmarchione/docker-postfixrelay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/postfix-logo.gif",
  "project": "https://github.com/loganmarchione/docker-postfixrelay",
  "support": "https://forums.unraid.net/topic/130953-support-devzwf-postfix-relay/",
  "description": "This runs Postfix (as a relay) in Docker.\r\nMost home ISPs block port 25, so outbound emails must be relayed through an external SMTP server (e.g., Gmail).\r\nThis container acts as a single collections point for devices needing to send email.\r\n⚠️ Postfix acts as an open relay. As such, this is not meant to be run on the internet, only on a trusted internal network! ⚠️\r\n\r\nRequirements\r\nYou must already have a account on an external SMTP server (e.g., Gmail, AWS SES, etc...).\r\nYour external SMTP server must be using encryption (i.e., plaintext is not allowed)",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Data Directory",
      "host": null,
      "container": "/var/spool/postfix",
      "mode": "rw",
      "description": "Used to store Postfix's mail spool",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Postfix SMTP server",
      "host": "25",
      "container": "25",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Public SMTP",
      "key": "RELAY_HOST",
      "value": null,
      "description": "Public SMTP server to use\r\nmust be using encryption (i.e., plaintext is not allowed)",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Relay Port",
      "key": "RELAY_PORT",
      "value": null,
      "description": "Public SMTP port to use",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP username",
      "key": "RELAY_USER",
      "value": null,
      "description": "Address to login to $RELAY_HOST",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SMTP password",
      "key": "RELAY_PASS",
      "value": null,
      "description": "Password to login to $RELAY_HOST\r\nIf using Gmail 2FA, you will need to setup an app password",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Test Email address",
      "key": "TEST_EMAIL",
      "value": null,
      "description": "Address to receive test email\r\nIf not set, test email will not be sent",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Domain from address",
      "key": "MYORIGIN",
      "value": null,
      "description": "Domain of the from address",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Networks",
      "key": "MYNETWORKS",
      "value": "0.0.0.0/0",
      "description": "Networks that Postfix will forward mail for",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "From Address",
      "key": "FROMADDRESS",
      "value": null,
      "description": "Changes the email from address",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
