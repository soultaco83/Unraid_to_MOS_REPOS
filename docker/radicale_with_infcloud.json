{
  "name": "Radicale - Infcloud",
  "repo": "parrazam/radicale-with-infcloud",
  "category": [
    "Utilities",
    "Productivity",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/parrazam/radicale-with-infcloud",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5232]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/radicale-icon.png",
  "project": "https://github.com/parrazam/radicale-docker",
  "support": "https://github.com/parrazam/radicale-docker/issues",
  "description": "Docker container for Radicale calendar, to-do list and contact (CalDAV/CardDAV) server + Infcloud web UI pre-installed. \r\n        [br]\n        Add the following to the \"web\" section in the config file to enable Infcloud: \r\n        [br]\n        [code] type = radicale_infcloud [/code]",
  "requires": "See https://radicale.org/master.html#configuration and https://github.com/tomsquest/docker-radicale/blob/master/config for information about making a \"config\" file for Radicale. This config file should be stored in the \"Config path\" folder.",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/radicale/config",
      "container": "/config",
      "mode": "ro",
      "description": "Parent folder storing config file",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Data path",
      "host": "/mnt/cache/appdata/radicale/data",
      "container": "/data",
      "mode": "rw",
      "description": "Data path",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5232",
      "container": "5232",
      "protocol": "tcp",
      "description": "Container Port: 5232",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
