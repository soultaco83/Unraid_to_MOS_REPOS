{
  "name": "RomM-ComM",
  "repo": "idiosync000/romm-comm:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/idiosync000/romm-comm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/romm-comm-icon.png",
  "project": "https://github.com/idio-sync/romm-comm",
  "support": "https://github.com/idio-sync/romm-comm/issues",
  "description": "A Discord bot that integrates with the RomM API to provide information about your ROM collection and control RomM from Discord.",
  "requires": "Expects a `.env` file at the \"Config File\" path before starting. See documentation: https://github.com/idio-sync/romm-comm?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/romm_comm/.env",
      "container": "/app/.env",
      "mode": "rw",
      "description": "A .env config file",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/romm_comm/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Data path, where app data is stored",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
