  "registry": "https://github.com/users/fscorrupt/packages/container/package/docker-arrs2discord",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/arrs2discord-icon.png",
  "project": "https://github.com/fscorrupt/docker-arrs2discord",
  "support": "https://github.com/fscorrupt/docker-arrs2discord/issues",
  "description": "A collection of PowerShell scripts that collect information from *arrs API and sends it off to Discord via webhooks.",
  "requires": "Requires additional configuration of Discord webhooks. See documentation: https://github.com/fscorrupt/docker-arrs2discord?tab=readme-ov-file#howto-discord-webhook\n        [br]\n        Requires a `config.json` file in the \"Config Path\" directory. See example: https://raw.githubusercontent.com/fscorrupt/docker-arrs2discord/refs/heads/main/config/config.json.template",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/arrs2discord/config",
      "container": "/config",
      "mode": "rw",
      "description": "Storage for config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "TERM",
      "key": "TERM",
      "value": "xterm",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
