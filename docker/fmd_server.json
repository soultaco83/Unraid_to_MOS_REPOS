{
  "name": "FMD Server",
  "repo": "registry.gitlab.com/fmd-foss/fmd-server:0",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://gitlab.com/fmd-foss/fmd-server/container_registry/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/fmd-server-icon.png",
  "project": "https://gitlab.com/fmd-foss/fmd-server",
  "support": "https://gitlab.com/fmd-foss/fmd-server/issues",
  "description": "A server to communicate with the FMD Android app, to locate and control your devices.",
  "requires": "Expects a config.yml file at the Config File path before starting the container. See documentation: https://gitlab.com/fmd-foss/fmd-server/-/blob/master/config.example.yml",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/fmd_server/config.yml",
      "container": "/etc/fmd-server/config.yml",
      "mode": "ro",
      "description": "Path to the configuration file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/fmd_server/db",
      "container": "/var/lib/fmd-server/db/",
      "mode": "rw",
      "description": "Path to the database",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
