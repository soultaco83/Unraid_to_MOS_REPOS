{
  "name": "Watchma",
  "repo": "jsonbateman/watchma:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/jsonbateman/watchma",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:58008]/",
  "icon": "https://raw.githubusercontent.com/json-bateman/watchma/main/public/favicon.png",
  "project": "https://github.com/json-bateman/watchma",
  "support": "https://github.com/json-bateman/watchma/issues",
  "description": "A movie voting system for groups on Jellyfin.",
  "requires": "Requires a separate Jellyfin instance.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/watchma/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to app data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "58008",
      "container": "58008",
      "protocol": "tcp",
      "description": "Container Port: 58008",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Jellyfin - URL",
      "key": "JELLYFIN_BASE_URL",
      "value": "http://IP_ADDRESS:8096",
      "description": "The base URL of your Jellyfin server.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Jellyfin - API Key",
      "key": "JELLYFIN_API_KEY",
      "value": null,
      "description": "Your Jellyfin API key.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "OpenAI - API Key",
      "key": "OPENAI_API_KEY",
      "value": null,
      "description": "Optional, OpenAI API key for AI-generated messages.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "WARN|INFO|DEBUG|ERROR",
      "description": "Set the logging level",
      "required": true,
      "mask": false,
      "display": "advanced-show",
      "default": null
    },
    {
      "name": "Development Mode",
      "key": "IS_DEV",
      "value": "false|true",
      "description": "Enable development mode",
      "required": true,
      "mask": false,
      "display": "advanced-show",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "58008",
      "description": "Internal port for the application. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
