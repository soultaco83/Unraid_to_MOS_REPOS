{
  "name": "Taggarr",
  "repo": "basshous3/taggarr:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/basshous3/taggarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/taggarr-icon.png",
  "project": "https://github.com/BassHous3/taggarr",
  "support": "https://github.com/BassHous3/taggarr/issues",
  "description": "Dub analysis and tagging for media files.",
  "paths": [
    {
      "name": "TV Path",
      "host": null,
      "container": "/tv",
      "mode": "rw",
      "description": "Path to your TV media files for analysis (e.g. /mnt/Array/tv)",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/cache/appdata/taggarr/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Path to store logs",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Sonarr - URL",
      "key": "SONARR_URL",
      "value": null,
      "description": "URL to your Sonarr instance (e.g. http://sonarr:8989)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Sonarr - API Key",
      "key": "SONARR_API_KEY",
      "value": null,
      "description": "API key for your Sonarr instance",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Dry Run",
      "key": "DRY_RUN",
      "value": "false|true",
      "description": "Enable dry run mode to see what actions would be taken without making any changes.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Tags - Dub",
      "key": "TAG_DUB",
      "value": "dub",
      "description": "Tag to apply for dubs.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Tags - Semi-Dub",
      "key": "TAG_SEMI",
      "value": "semi-dub",
      "description": "Tag to apply for semi-dubs.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Tags - Wrong Dub",
      "key": "TAG_WRONG_DUB",
      "value": "wrong-dub",
      "description": "Tag to apply for wrong dubs.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Add Tag to Genre",
      "key": "ADD_TAG_TO_GENRE",
      "value": "true|false",
      "description": "Whether to add the tag to the genre.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Target Genre",
      "key": "TARGET_GENRE",
      "value": null,
      "description": "Genre to target for analysis (e.g. anime, movie, show).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Target Languages",
      "key": "TARGET_LANGUAGES",
      "value": "en,fr",
      "description": "Comma-separated list of target languages (e.g. en, fr, ja).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Run Interval",
      "key": "RUN_INTERVAL_SECONDS",
      "value": "7200",
      "description": "Interval, in seconds, between runs (default: 7200 seconds = 2 hours)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Start Running",
      "key": "START_RUNNING",
      "value": "true|false",
      "description": "Whether to start running immediately after container starts.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Quick Mode",
      "key": "QUICK_MODE",
      "value": "false|true",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Write Mode",
      "key": "WRITE_MODE",
      "value": "0|1|2",
      "description": "Write mode for tags: 0 = None, 1 = Rewrite, 2 = Remove.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO|WARNING|ERROR|DEBUG",
      "description": "Logging level for the application.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
