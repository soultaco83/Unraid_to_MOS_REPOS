{
  "name": "zoraxy",
  "repo": "passivelemon/zoraxy-docker:latest",
  "category": [
    "Security",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/passivelemon/zoraxy-docker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "icon": "https://i.imgur.com/JIHBlTd.png",
  "project": "https://github.com/tobychui/zoraxy/tree/main",
  "support": "https://github.com/tobychui/zoraxy/tree/main",
  "description": "General purpose request (reverse) proxy and forwarding tool for low power devices. Now written in Go!",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/user/appdata/zoraxy",
      "container": "/zoraxy/config/",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "HTTP",
      "host": "8801",
      "container": "80",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HTTPS",
      "host": "4431",
      "container": "443",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WebUI",
      "host": "8002",
      "container": "8000",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
