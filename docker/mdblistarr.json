{
  "name": "mdblistarr",
  "repo": "linaspurinis/mdblistarr:latest",
  "category": [
    "Utilities",
    "Media",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/linaspurinis/mdblistarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5353]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mdblistarr-icon.png",
  "project": "https://github.com/linaspurinis/mdblistarr",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "Companion app for mdblist.com for Radarr and Sonarr integration",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/mdblistarr/db",
      "container": "/usr/src/db",
      "mode": "rw",
      "description": "Storage for database",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "5353",
      "container": "5353",
      "protocol": "tcp",
      "description": "Container Port: 5353",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
