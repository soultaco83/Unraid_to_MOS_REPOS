{
  "name": "ADS-B Browser Screenshot",
  "repo": "tedder42/browser-screenshot-service:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/tedder42/browser-screenshot-service",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/adsb-browser-screenshot-icon.png",
  "project": "https://github.com/tedder/browser-screenshot-service",
  "support": "https://github.com/tedder/browser-screenshot-service/issues",
  "description": "web browser screenshot as a service! Designed for the mikenye ADSB decoding world",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "5042",
      "container": "5042",
      "protocol": "tcp",
      "description": "Container Port: 5042",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "https://globe.adsb.fi/",
      "description": "Base URL to use for the map",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Map Arguments",
      "key": "MAP_ARGS",
      "value": "zoom=11&hideSidebar&hideButtons&mapDim=0.3",
      "description": "Arguments to pass to the map",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Page Zoom",
      "key": "PAGE_ZOOM",
      "value": "150",
      "description": "Zoom level for the page",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Window Size",
      "key": "WINDOW_SIZE",
      "value": "1200x1200",
      "description": "Size of the window to take a screenshot of",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Max Time",
      "key": "MAXTIME",
      "value": "30",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Disable SHM",
      "key": "DISABLE_SHM",
      "value": "false|true",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Disable Visibility",
      "key": "DISABLE_VIZ",
      "value": "false|true",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Load Sleep Time",
      "key": "LOAD_SLEEP_TIME",
      "value": "12",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
