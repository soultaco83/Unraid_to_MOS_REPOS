{
  "name": "Borg Web UI",
  "repo": "ainullcode/borg-ui:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ainullcode/borg-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/borg-ui-icon.png",
  "project": "https://karanhudia.github.io/borg-ui/",
  "support": "https://karanhudia.github.io/borg-ui/configuration",
  "description": "Replace complex Borg Backup terminal commands with a beautiful web UI. Create, schedule, and restore backups with just a few clicks.",
  "requires": "Requires a separate Redis instance.",
  "paths": [
    {
      "name": "Data Path",
      "host": null,
      "container": "/local",
      "mode": "rw",
      "description": "Path to data you want to backup",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Cache Path",
      "host": "/mnt/cache/appdata/borg-ui/cache",
      "container": "/home/borg/.cache/borg",
      "mode": "rw",
      "description": "Path to cache folder",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/borg-ui/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to app data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Initial Admin Password",
      "key": "INITIAL_ADMIN_PASSWORD",
      "value": "admin123",
      "description": "Set the initial admin password for the web UI. Default: admin123",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Redis - URL",
      "key": "REDIS_URL",
      "value": "redis://IP_ADDRESS:6379/0",
      "description": "URL of the Redis instance",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Local Mount Points",
      "key": "LOCAL_MOUNT_POINTS",
      "value": "/local",
      "description": "Comma-separated list of local mount points to be used inside the container",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO|DEBUG|WARNING|ERROR",
      "description": "Set the log level",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
