{
  "name": "Wallos",
  "repo": "bellamy/wallos:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/bellamy/wallos",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/wallos.png",
  "project": null,
  "support": "https://forums.unraid.net/topic/147706-support-devzwf-wallos",
  "description": "Wallos is a powerful, open-source, and self-hostable web application designed to empower you in managing your finances with ease. Say goodbye to complicated spreadsheets and expensive financial software – Wallos simplifies the process of tracking expenses and helps you gain better control over your financial life.",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Database Dir",
      "host": "/mnt/user/appdata/wallos/db",
      "container": "/var/www/html/db",
      "mode": "rw",
      "description": "Database Directory",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Logos Dir",
      "host": "/mnt/user/appdata/wallos/logos",
      "container": "/var/www/html/images/uploads/logos",
      "mode": "rw",
      "description": "Logos directory",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8282",
      "container": "80",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "America/Toronto",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
