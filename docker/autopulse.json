{
  "name": "autopulse",
  "repo": "ghcr.io/dan-online/autopulse:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/dan-online/autopulse",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2875]/",
  "icon": "https://raw.githubusercontent.com/dan-online/autopulse/main/assets/logo.webp",
  "project": "https://github.com/dan-online/autopulse",
  "support": "https://github.com/dan-online/autopulse/issues",
  "description": "autopulse is a web server that receives notifications from media organizers like Sonarr, Radarr, and Lidarr and updates the items in media servers like Plex, Jellyfin and Emby. It is designed to be efficient, only updating the items that have changed, reducing the load on media servers.",
  "requires": "Expects a config.yaml file at the Config File Path before starting the container. See documentation: https://github.com/dan-online/autopulse#configuration",
  "paths": [
    {
      "name": "Config File Path",
      "host": "/mnt/cache/appdata/autopulse/config.yaml",
      "container": "/app/config.yaml",
      "mode": "rw",
      "description": "Path to the configuration file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/autopulse/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the app data directory",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "2875",
      "container": "2875",
      "protocol": "tcp",
      "description": "Container Port: 2875",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Internal Database Connection",
      "key": "AUTOPULSE__APP__DATABASE_URL",
      "value": "sqlite://data/autopulse.db",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
