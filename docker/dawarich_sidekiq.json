{
  "name": "Dawarich - Sidekiq",
  "repo": "freikin/dawarich:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/freikin/dawarich",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "sidekiq",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dawarich-icon.png",
  "project": "https://dawarich.app",
  "support": "https://dawarich.app/docs/intro",
  "description": "A self-hosted web app designed to replace Google Timeline (aka Google Location History). Visualize your data on an interactive map, import your location history from Google Maps Timeline and Owntracks, and explore statistics like the number of countries and cities visited, total distance traveled, and more!",
  "requires": "Requires a separate Dawarich container.",
  "paths": [
    {
      "name": "Imports Path",
      "host": "/mnt/user/appdata/dawarich/imports",
      "container": "/var/app/tmp/imports/watched",
      "mode": "rw",
      "description": "Path to watch for imports",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Storage Path",
      "host": "/mnt/user/appdata/dawarich/storage",
      "container": "/var/app/storage",
      "mode": "rw",
      "description": "Path to store application data",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Web Files Path",
      "host": "/mnt/user/appdata/dawarich/wwwroot",
      "container": "/var/app/public",
      "mode": "rw",
      "description": "Path to web files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Redis - URL",
      "key": "REDIS_URL",
      "value": "redis://IP_ADDRESS:6379",
      "description": "URL of the Redis server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Host",
      "key": "DATABASE_HOST",
      "value": null,
      "description": "Host of the PostGIS server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Port",
      "key": "DATABASE_PORT",
      "value": "5432",
      "description": "Port of the PostGIS server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Username",
      "key": "DATABASE_USERNAME",
      "value": null,
      "description": "Username of the PostGIS server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Password",
      "key": "DATABASE_PASSWORD",
      "value": null,
      "description": "Password of the PostGIS server",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Database",
      "key": "DATABASE_NAME",
      "value": null,
      "description": "Name of the PostGIS database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Timezone",
      "key": "TIME_ZONE",
      "value": "UTC",
      "description": "Timezone of the application",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Photon API - Host",
      "key": "PHOTON_API_HOST",
      "value": "photon.komoot.io",
      "description": "Host of the Photon API",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Photon API - Use HTTPS",
      "key": "PHOTON_API_USE_HTTPS",
      "value": "true|false",
      "description": "Use HTTPS for the Photon API",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Prometheus Exporter - Enable",
      "key": "PROMETHEUS_EXPORTER_ENABLED",
      "value": "false|true",
      "description": "Enable the Prometheus exporter",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "2FA - OTP Encryption Primary Key",
      "key": "OTP_ENCRYPTION_PRIMARY_KEY",
      "value": null,
      "description": "Required to enable 2FA.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "2FA - OTP Encryption Deterministic Key",
      "key": "OTP_ENCRYPTION_DETERMINISTIC_KEY",
      "value": null,
      "description": "Required to enable 2FA.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "2FA - OTP Encryption Key Derivation Salt",
      "key": "OTP_ENCRYPTION_KEY_DERIVATION_SALT",
      "value": null,
      "description": "Required to enable 2FA.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Enable Telemetry",
      "key": "ENABLE_TELEMETRY",
      "value": "false|true",
      "description": "Enable telemetry",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Rails Environment",
      "key": "RAILS_ENV",
      "value": "development",
      "description": "Rails environment. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Application Host",
      "key": "APPLICATION_HOST",
      "value": "localhost",
      "description": "Host of the application",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Application Hosts",
      "key": "APPLICATION_HOSTS",
      "value": "localhost",
      "description": "Hosts of the application",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Background Processing Concurrency",
      "key": "BACKGROUND_PROCESSING_CONCURRENCY",
      "value": "3",
      "description": "Number of background processing threads",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Application Protocol",
      "key": "APPLICATION_PROTOCOL",
      "value": "http",
      "description": "Protocol of the application",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Is Self-Hosted",
      "key": "SELF_HOSTED",
      "value": "true|false",
      "description": "Is the application self-hosted?",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
