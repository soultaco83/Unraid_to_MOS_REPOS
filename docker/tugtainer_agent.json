{
  "name": "Tugtainer Agent",
  "repo": "ghcr.io/quenary/tugtainer-agent",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/quenary/tugtainer-agent:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--tmpfs /run",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8001]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tugtainer-icon.png",
  "project": "https://github.com/Quenary/tugtainer",
  "support": "https://github.com/Quenary/tugtainer/issues",
  "description": "Automate updates of your Docker containers. This is the companion agent for Tugtainer.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9413",
      "container": "8001",
      "protocol": "tcp",
      "description": "Container Port: 8001",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Agent Secret",
      "key": "AGENT_SECRET",
      "value": null,
      "description": "Secret key for agent authentication (must match Tugtainer server)",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
