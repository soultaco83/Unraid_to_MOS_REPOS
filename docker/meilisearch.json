{
  "name": "meilisearch (Collectathon)",
  "repo": "getmeili/meilisearch:v1.53",
  "category": [
    "Utilities"
  ],
  "registry": "https://registry.hub.docker.com/r/getmeili/meilisearch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Collectathon/unraid-templates/main/icons/meilisearch.png",
  "project": "https://github.com/meilisearch/meilisearch",
  "support": "https://forums.unraid.net/topic/164847-support-collectathon-meilisearch/",
  "description": "An open-source, fast, and hyper-relevant search engine that fits effortlessly into your projects.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/meilisearch",
      "container": "/meili_data",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "7700",
      "container": "7700",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Master Key",
      "key": "MEILI_MASTER_KEY",
      "value": "masterykeymasterkeymasterkeymasterkey",
      "description": "Password required to query meilisearch",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Disable Analytics",
      "key": "MEILI_NO_ANALYTICS",
      "value": "false",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Environment",
      "key": "MEILI_ENV",
      "value": "production",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "Collectathon"
}
