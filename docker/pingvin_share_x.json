{
  "name": "Pingvin Share X",
  "repo": "smp46/pingvin-share-x:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/smp46/pingvin-share-x",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/pingvin-share-x-icon.png",
  "project": "https://github.com/smp46/pingvin-share-x",
  "support": "https://smp46.github.io/pingvin-share-x/introduction",
  "description": "Pingvin Share X is a fork of Pingvin Share, a self-hosted file sharing platform and an alternative for WeTransfer.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/pingvin_share_x/data",
      "container": "/opt/app/backend/data",
      "mode": "rw",
      "description": "Path to store uploaded files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Images Path",
      "host": "/mnt/user/appdata/pingvin_share_x/images",
      "container": "/opt/app/frontend/public/img",
      "mode": "rw",
      "description": "Path to store image files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Behind Reverse Proxy",
      "key": "TRUST_PROXY",
      "value": "false|true",
      "description": "Set to true if running behind a reverse proxy",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
