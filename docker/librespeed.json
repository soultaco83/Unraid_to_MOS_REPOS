{
  "name": "librespeed (linuxserver)",
  "repo": "lscr.io/linuxserver/librespeed",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/librespeed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "readme_url": "https://github.com/linuxserver/docker-librespeed#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/librespeed-logo.png",
  "project": "https://github.com/librespeed/speedtest",
  "support": "https://github.com/linuxserver/docker-librespeed/issues/new/choose",
  "description": "Librespeed(https://github.com/librespeed/speedtest) is a very lightweight Speedtest implemented in Javascript, using XMLHttpRequest and Web Workers.\n\nNo Flash, No Java, No Websocket, No Bullshit.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "80",
      "container": "80",
      "protocol": "tcp",
      "description": "web gui",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PASSWORD",
      "key": "PASSWORD",
      "value": "PASSWORD",
      "description": "Set the password for the results database.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "CUSTOM_RESULTS",
      "key": "CUSTOM_RESULTS",
      "value": "false",
      "description": "(optional) set to `true` to enable custom results page in `/config/www/results/index.php`.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_TYPE",
      "key": "DB_TYPE",
      "value": "sqlite",
      "description": "Defaults to `sqlite`, can also be set to `mysql` or `postgresql`.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_NAME",
      "key": "DB_NAME",
      "value": "DB_NAME",
      "description": "Database name. Required for mysql and pgsql.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_HOSTNAME",
      "key": "DB_HOSTNAME",
      "value": "DB_HOSTNAME",
      "description": "Database address. Required for mysql and pgsql.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_USERNAME",
      "key": "DB_USERNAME",
      "value": "DB_USERNAME",
      "description": "Database username. Required for mysql and pgsql.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PASSWORD",
      "key": "DB_PASSWORD",
      "value": "DB_PASSWORD",
      "description": "Database password. Required for mysql and pgsql.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "DB_PORT",
      "key": "DB_PORT",
      "value": "DB_PORT",
      "description": "Database port. Required for mysql.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "IPINFO_APIKEY",
      "key": "IPINFO_APIKEY",
      "value": "ACCESS_TOKEN",
      "description": "Access token from ipinfo.io. Required for detailed IP information.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
