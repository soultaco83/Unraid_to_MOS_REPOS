{
  "name": "gpt4all",
  "repo": "ghcr.io/huggingface/text-generation-inference:latest",
  "category": [
    "AI",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://github.com/huggingface/text-generation-inference/pkgs/container/text-generation-inference",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": "--gpus all --shm-size 1g",
  "post_parameters": "--model-id $MODEL --num-shard $NUM_SHARD",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/gpt4all-icon.png",
  "project": "https://www.nomic.ai/gpt4all",
  "support": "https://github.com/nomic-ai/gpt4all/issues",
  "description": "An all-in-one LLM server and chat UI",
  "requires": "Requires an Nvidia GPU.\r\n        [br]\n        In **Post Arguments**, replace `$MODEL` with the model you want to host and `$NUM_SHARD` with the number of shards you want to use (recommended: 1).",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/gpt4all/data",
      "container": "/data",
      "mode": "rw",
      "description": "Data directory",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "HuggingFace Token",
      "key": "HUGGING_FACE_HUB_TOKEN",
      "value": null,
      "description": "The HuggingFace token to use",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Use flash attention",
      "key": "USE_FLASH_ATTENTION",
      "value": "false|true",
      "description": "Use flash attention",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
