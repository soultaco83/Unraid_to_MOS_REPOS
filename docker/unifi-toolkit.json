{
  "name": "unifi-toolkit",
  "repo": "ghcr.io/crosstalk-solutions/unifi-toolkit:latest",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://github.com/Crosstalk-Solutions/unifi-toolkit",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "readme_url": "https://github.com/devzwf/unraid-docker-templates/blob/main/guides/Quick-Start-Guide-Unifi-toolkit.md",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/crosstalk-logo.png",
  "project": "https://github.com/Crosstalk-Solutions/unifi-toolkit",
  "support": "https://forums.unraid.net/topic/197304-support-devzwf-unifi-toolkit/",
  "description": "A comprehensive suite of tools for UniFi network management and monitoring.",
  "donate": "https://ko-fi.com/devzwf",
  "requires": "IMPORTANT: Create this directory on the host first with correct permissions:&amp;#13;&amp;#10;      #   chown 1000:1000 /mnt/user/appdata/unifi-toolkit\"",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/user/appdata/unifi-toolkit",
      "container": "/app/data",
      "mode": "rw",
      "description": "IMPORTANT: Create this directory on the host first with correct permissions:\r\n      #   chown 1000:1000 /mnt/user/appdata/unifi-toolkit",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Webui",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Encryption Key",
      "key": "ENCRYPTION_KEY",
      "value": "test",
      "description": "Encryption key for securing UniFi credentials stored in the database",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "INFO",
      "description": "Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "sqlite+aiosqlite:///./data/unifi_toolkit.db",
      "description": "Database URL (default uses SQLite in data/ directory)",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Type of deployement",
      "key": "DEPLOYMENT_TYPE",
      "value": "local",
      "description": "Deployment type: local or production\r\n- local: No authentication, access via http://localhost:8000\r\n- production: Authentication required, HTTPS via Caddy",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Stalker Refresh Interval",
      "key": "STALKER_REFRESH_INTERVAL",
      "value": "60",
      "description": "Wi-Fi Stalker: Device refresh interval in seconds",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Username",
      "key": "AUTH_USERNAME",
      "value": null,
      "description": "Admin credentials (production only)",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "password hash",
      "key": "AUTH_PASSWORD_HASH",
      "value": null,
      "description": "Admin credentials (production only)\r\nGenerate with ./reset_password.sh",
      "required": false,
      "mask": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
