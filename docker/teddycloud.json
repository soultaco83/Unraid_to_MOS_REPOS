{
  "name": "teddycloud (selfhosters)",
  "repo": "ghcr.io/toniebox-reverse-engineering/teddycloud:latest",
  "category": [
    "Media",
    "Misc"
  ],
  "registry": "ghcr.io/toniebox-reverse-engineering/teddycloud:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/teddycloud.png",
  "project": "https://github.com/toniebox-reverse-engineering/teddycloud",
  "support": "https://forums.unraid.net/topic/138058-support-catduck-templates",
  "description": "teddyCloud is an alternative server for your Toniebox, allowing you to host the cloud services locally. This gives you the control about which data is sent to the original manufacturers cloud and allows you to host your own figurine audio files on e.g. your NAS or any other server.",
  "paths": [
    {
      "name": "content",
      "host": "/mnt/cache/appdata/teddycloud/data/content",
      "container": "/teddycloud/data/content",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "config",
      "host": "/mnt/cache/appdata/teddycloud/config",
      "container": "/teddycloud/config",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "certs",
      "host": "/mnt/cache/appdata/teddycloud/certs",
      "container": "/teddycloud/certs",
      "mode": "rw",
      "description": "Place your certs here after grabbing them off your device. (Yes you need to do this)",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "library",
      "host": "/mnt/cache/appdata/teddycloud/data/library",
      "container": "/teddycloud/data/library",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "firmware",
      "host": "/mnt/cache/appdata/teddycloud/data/firmware",
      "container": "/teddycloud/data/firmware",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WEB UI",
      "host": "7780",
      "container": "80",
      "protocol": "tcp",
      "description": "This an optional port for the webui of teddycloud",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SSL-Certs",
      "host": "7443",
      "container": "443",
      "protocol": "tcp",
      "description": "Required PORT to get certificates",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
