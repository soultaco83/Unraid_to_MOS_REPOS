{
  "name": "Kubek",
  "repo": "ghcr.io/rxflex/kubek-minecraft-dashboard:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://ghcr.io/rxflex/kubek-minecraft-dashboard",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/kubek.png",
  "project": "https://github.com/Rxflex/kubek-minecraft-dashboard",
  "support": "https://github.com/Rxflex/kubek-minecraft-dashboard/issues",
  "description": "Kubek - Web Minecraft servers dashboard",
  "paths": [
    {
      "name": "Servers Directory",
      "host": "/mnt/cache/appdata/kubek/servers",
      "container": "/usr/kubek/servers",
      "mode": "rw",
      "description": "Container Path: /usr/kubek/servers",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Java Directory",
      "host": "/mnt/cache/appdata/kubek/binaries",
      "container": "/usr/kubek/binaries",
      "mode": "rw",
      "description": "Container Path: /usr/kubek/binaries",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Minecraft Server Port",
      "host": "25565",
      "container": "25565",
      "protocol": "tcp",
      "description": "Minecraft Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
