{
  "name": "Classifarr",
  "repo": "ghcr.io/cloudbyday90/classifarr:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/cloudbyday90/classifarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:21324]/",
  "icon": "https://raw.githubusercontent.com/cloudbyday90/Classifarr/refs/heads/main/logo/icon.png",
  "project": "https://github.com/cloudbyday90/Classifarr",
  "support": "https://github.com/cloudbyday90/Classifarr/issues",
  "description": "Classifarr is an intelligent media classification platform that automatically routes incoming requests from Overseerr/Jellyseerr to the correct Radarr/Sonarr library using AI and machine learning.",
  "requires": "Requires a separate Ollama instance. \r\n        \r\n        Requires one-to-one mapping of Radarr/Sonarr paths to Classifarr paths. See documentation for details: https://github.com/cloudbyday90/Classifarr/blob/main/docker-compose.yml",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/user/appdata/classifarr/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to persistent config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "21324",
      "container": "21324",
      "protocol": "tcp",
      "description": "Container Port: 21324",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": "The environment the app is running in",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Node Options",
      "key": "NODE_OPTIONS",
      "value": "--max-old-space-size=1536",
      "description": "Options for Node environment",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Task Queue Retention",
      "key": "TASK_QUEUE_RETENTION_DAYS",
      "value": "7",
      "description": "How long completed tasks are retained before auto-cleanup",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "pgvector Runtime Staging",
      "key": "PGVECTOR_RUNTIME_STAGING",
      "value": "auto",
      "description": "Runtime pgvector staging is opportunistic: use AVX/AVX2 when the PostgreSQL runtime mount permits it, otherwise fall back to generic.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
