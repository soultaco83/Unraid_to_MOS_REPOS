{
  "name": "M.I.M.O.S.A",
  "repo": "devzwf/mimosa:latest",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/devzwf/mimosa",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/mimosa-logo.png",
  "project": "https://github.com/FireMarshmellow/M.I.M.O.S.A",
  "support": "https://forums.unraid.net/topic/170875-support-devzwf-mimosa/",
  "description": "MIMOSA - short for \"Mellow_Labs Inventory Management and Organization System Apparatus\". Just like a refreshing mimosa, this system will make your life brighter and more organized!\r\n\r\nCheck the Videos :\r\nMain Video: youtu.be/7C4i-2IqSS4\r\nStep by step Video: https://youtu.be/QOd1apc0Lpo",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Database Directory",
      "host": "/mnt/user/appdata/mimosa/db",
      "container": "/app/db",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Logs Directory",
      "host": "/mnt/user/appdata/mimosa/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Images directory",
      "host": "/mnt/user/appdata/mimosa/images",
      "container": "/app/images",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
