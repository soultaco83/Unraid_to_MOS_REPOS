{
  "name": "daps-ui",
  "repo": "monster117/daps-ui:develop",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/monster117/daps-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/Drazzilb08/daps/refs/heads/master/daps_logo.png",
  "project": "https://github.com/zarskie/daps-ui",
  "support": "https://github.com/zarskie/daps-ui/issues",
  "description": "A UI for DAPS (Drazzilb's Arr PMM Scripts)",
  "paths": [
    {
      "name": "Posters Path",
      "host": null,
      "container": "/posters",
      "mode": "rw",
      "description": "Path to posters",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Kometa Assets Path",
      "host": null,
      "container": "/assets",
      "mode": "rw",
      "description": "Path to Kometa assets",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/daps-ui/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "App Mode",
      "key": "APP_MODE",
      "value": "web",
      "description": "App mode. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
