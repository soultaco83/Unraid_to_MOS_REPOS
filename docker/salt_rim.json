{
  "name": "Salt Rim",
  "repo": "barassistant/salt-rim:v3",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/barassistant/salt-rim",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/bar-assistant-icon.png",
  "project": "https://barassistant.app/",
  "support": "https://docs.barassistant.app/setup/",
  "description": "An all-in-one solution for managing your home bar. This is the frontend component.",
  "requires": "Requires a separate meilisearch instance, optional Redis instance and optional Bar Assistant frontend instance.",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "API URL",
      "key": "API_URL",
      "value": "http://localhost:8080/bar",
      "description": "URL of the API. Must match API Port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Meilisearch URL",
      "key": "MEILISEARCH_HOST",
      "value": "http://localhost:7700",
      "description": "URL of the Meilisearch instance",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
