{
  "name": "webtrees",
  "repo": "dtjs48jkt/webtrees",
  "category": [
    "Media",
    "Misc",
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/dtjs48jkt/webtrees",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/webtrees-icon.png",
  "project": "https://webtrees.net",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "The web’s leading online collaborative genealogy application",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/user/appdata/webtrees",
      "container": "/var/www/html/data",
      "mode": "rw",
      "description": "Config path",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Localtime path",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "Localtime path",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8079",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database host",
      "key": "DB_HOST",
      "value": "localhost",
      "description": "Database Hostname",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database port",
      "key": "DB_PORT",
      "value": "3306",
      "description": "Database Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database user",
      "key": "DB_USER",
      "value": null,
      "description": "Database Username",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database password",
      "key": "DB_PASSWORD",
      "value": null,
      "description": "Database Password",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Database name",
      "key": "DB_NAME",
      "value": null,
      "description": "Database Name",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "GROUP_ID",
      "value": "100",
      "description": "Group ID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Disable SSL",
      "key": "DISABLE_SSL",
      "value": "TRUE",
      "description": "Disable SSL",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Web Port",
      "key": "PORT",
      "value": "80",
      "description": "Web Port",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
