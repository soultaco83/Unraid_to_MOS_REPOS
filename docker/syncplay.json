{
  "name": "Syncplay",
  "repo": "dnomd343/syncplay:latest",
  "category": [
    "Media",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/nomd343/syncplay",
  "network": "host",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://syncplay.pl/wp-content/uploads/2019/02/new_syncplay_logo.png",
  "project": "https://syncplay.pl/",
  "support": "https://github.com/dnomd343/syncplay-docker/issues",
  "description": "Pausing, unpausing and seeking are synchronized over the Internet, giving everyone playing the same file in the same virtual room a shared viewing experience.",
  "requires": "Expects a `config.yml` file in the App Data directory. See documentation: https://github.com/dnomd343/syncplay-docker?tab=readme-ov-file#configure-file",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/syncplay/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
