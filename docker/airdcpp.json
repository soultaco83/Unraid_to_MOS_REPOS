{
  "name": "airdcpp (selfhosters)",
  "repo": "gangefors/airdcpp-webclient",
  "category": [
    "Hosting"
  ],
  "registry": "https://hub.docker.com/r/gangefors/airdcpp-webclient/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--user 500:500",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5600]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/airdcpp.png",
  "project": "https://github.com/airdcpp-web/airdcpp-webclient",
  "support": "https://github.com/gangefors/docker-airdcpp-webclient",
  "description": "AirDC++ Web Client is a locally installed application, which is designed for frequent sharing of files or directories within groups of people in a local network or over internet. The daemon application can be installed on different types of systems, such as on file servers and NAS devices.\r\n\r\nUsername / password for the default admin account is: admin / password",
  "paths": [
    {
      "name": "Application data",
      "host": null,
      "container": "/.airdcpp",
      "mode": "rw",
      "description": "Container Path: /.airdcpp",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Downloads",
      "host": null,
      "container": "/Downloads",
      "mode": "rw",
      "description": "Container Path: /Downloads",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Share",
      "host": null,
      "container": "/Share",
      "mode": "rw",
      "description": "Container Path: /Share",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI HTTP_PORT",
      "host": "5600",
      "container": "5600",
      "protocol": "tcp",
      "description": "Container Port: 5600",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WebUI HTTPS_PORT",
      "host": "5601",
      "container": "5601",
      "protocol": "tcp",
      "description": "Container Port: 5601",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TCP_PORT",
      "host": "21248",
      "container": "21248",
      "protocol": "tcp",
      "description": "Published TCP port for incoming connections. Defaults to 21248.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "UDP_PORT",
      "host": "21248",
      "container": "21248",
      "protocol": "udp",
      "description": "Published UDP port for incoming connections. Defaults to 21248.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TLS_PORT",
      "host": "21249",
      "container": "21249",
      "protocol": "tcp",
      "description": "Published TLS port for incoming connections. Defaults to 21249.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "0002",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
