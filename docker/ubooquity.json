{
  "name": "ubooquity",
  "repo": "lscr.io/linuxserver/ubooquity",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/ubooquity",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2203]/ubooquity/admin",
  "readme_url": "https://github.com/linuxserver/docker-ubooquity#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/ubooquity-logo.png",
  "project": "https://vaemendis.net/ubooquity/",
  "support": "https://github.com/linuxserver/docker-ubooquity/issues/new/choose",
  "description": "Ubooquity(https://vaemendis.net/ubooquity/) is a free, lightweight and easy-to-use home server for your comics and ebooks. Use it to access your files from anywhere, with a tablet, an e-reader, a phone or a computer.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Config files and database for ubooquity.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/books",
      "host": null,
      "container": "/books",
      "mode": "rw",
      "description": "Location of books.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/comics",
      "host": null,
      "container": "/comics",
      "mode": "rw",
      "description": "Location of comics.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/files",
      "host": null,
      "container": "/files",
      "mode": "rw",
      "description": "Location of raw files.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "2202",
      "container": "2202",
      "protocol": "tcp",
      "description": "The library port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "2203",
      "host": "2203",
      "container": "2203",
      "protocol": "tcp",
      "description": "The admin port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "MAXMEM",
      "key": "MAXMEM",
      "value": null,
      "description": "To set the maximum memory. ( ex: set '1024' for 1GB )",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
