{
  "name": "Pomerium",
  "repo": "pomerium/pomerium",
  "category": [
    "Productivity",
    "Security"
  ],
  "registry": "https://hub.docker.com/r/pomerium/pomerium",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://i.imgur.com/oF39h9B.png",
  "project": "https://github.com/pomerium/pomerium",
  "support": "https://discord.gg/VWAG7rZ",
  "description": "Pomerium is an identity-aware proxy that enables secure access to internal applications. Pomerium provides a standardized interface to add access control to applications regardless of whether the application itself has authorization or authentication baked-in. Pomerium gateways both internal and external requests, and can be used in situations where you'd typically reach for a VPN. Check ports to ensure you do not have conflicts. **NOTE** You MUST: 1.Create a config.yaml file in appdata/pomerium/pomerium. The parameters for the file can be found here: https://www.pomerium.io/reference/ 2. Match your cookie secret in both the file and the variable below.",
  "donate": "https://paypal.me/ramteksolutions",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/cache/appdata/pomerium",
      "container": "/data",
      "mode": "rw",
      "description": "Container Path: /data",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Pomerium",
      "host": "/mnt/cache/appdata/pomerium/pomerium",
      "container": "/pomerium/",
      "mode": "rw",
      "description": "Container Path: /pomerium/",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "HTTPS",
      "host": "1443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HTTP",
      "host": "180",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "5443",
      "host": "5443",
      "container": "5443",
      "protocol": "tcp",
      "description": "Container Port: 5443",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Cookie Secret",
      "key": "COOKIE_SECRET",
      "value": null,
      "description": "Container Variable: COOKIE_SECRET",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
