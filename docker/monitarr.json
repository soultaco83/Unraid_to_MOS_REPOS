{
  "name": "monitarr",
  "repo": "ghcr.io/nickshanks347/monitarr:latest",
  "category": [
    "Downloader",
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/nickshanks347/monitarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/monitarr-icon.png",
  "project": "https://github.com/nickshanks347/monitarr",
  "support": "https://github.com/nickshanks347/monitarr/issues",
  "description": "A very simple tool to monitor downloads from Sonarr and Radarr.",
  "requires": "Requires separate Sonarr and Radarr instances.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Sonarr - URL",
      "key": "SONARR_URL",
      "value": "http://sonarr:8989",
      "description": "URL to Sonarr",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Sonarr - API Key",
      "key": "SONARR_API_KEY",
      "value": null,
      "description": "API Key for Sonarr",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Radarr - URL",
      "key": "RADARR_URL",
      "value": "http://radarr:7878",
      "description": "URL to Radarr",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Radarr - API Key",
      "key": "RADARR_API_KEY",
      "value": null,
      "description": "API Key for Radarr",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
