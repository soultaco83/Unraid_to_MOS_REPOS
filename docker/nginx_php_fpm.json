{
  "name": "NGINX - PHP-FPM",
  "repo": "richarvey/nginx-php-fpm:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/richarvey/nginx-php-fpm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/nginx-php-fpm-icon.png",
  "project": "https://github.com/richarvey/nginx-php-fpm",
  "support": "https://github.com/richarvey/nginx-php-fpm/issues",
  "description": "Nginx + PHP-FPM capable of pulling application code from git.",
  "paths": [],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "1080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "HTTPS Port",
      "host": "1443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Git - Email",
      "key": "GIT_EMAIL",
      "value": null,
      "description": "Git email",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Git - Name",
      "key": "GIT_NAME",
      "value": null,
      "description": "Git name",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Git - Username",
      "key": "GIT_USERNAME",
      "value": null,
      "description": "Git username",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Git - Repository",
      "key": "GIT_REPO",
      "value": null,
      "description": "Git repository",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Git - Personal Token",
      "key": "GIT_PERSONAL_TOKEN",
      "value": null,
      "description": "Git personal token",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
