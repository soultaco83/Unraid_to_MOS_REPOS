{
  "name": "release-bot",
  "repo": "ghcr.io/janisv/release-bot:latest",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/janisv/release-bot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/release-bot-icon.png",
  "project": "https://github.com/JanisV/release-bot",
  "support": "https://github.com/JanisV/release-bot/issues",
  "description": "A Telegram bot that monitors the releases of given repos, sending messages upon a new release.",
  "requires": "Requires creating a Telegram bot and obtaining the token. See documentation: https://github.com/JanisV/release-bot?tab=readme-ov-file#set-the-necessary-env-vars",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/release_bot/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to data (SQLite) storage",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Telegram Bot Token",
      "key": "TELEGRAM_BOT_TOKEN",
      "value": null,
      "description": "Token for the Telegram bot",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Maximum repositories per chat",
      "key": "MAX_REPOS_PER_CHAT",
      "value": "0",
      "description": "Maximum number of repositories a chat can monitor. 0 for unlimited",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "GitHub Token",
      "key": "GITHUB_TOKEN",
      "value": null,
      "description": "Token for the GitHub API. If not provided, restricted by rate limiting",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Site URL",
      "key": "SITE_URL",
      "value": null,
      "description": "URL of the site to listen for incoming requests from Telegram. If not provided, will use polling instead of webhooks",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database URI",
      "key": "DATABASE_URI",
      "value": null,
      "description": "URI for the database. If not provided, will use SQLite database",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
