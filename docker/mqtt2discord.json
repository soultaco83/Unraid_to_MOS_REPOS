{
  "name": "MQTT2Discord",
  "repo": "aukevanderheide/mqtt2discord:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/aukevanderheide/mqtt2discord",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mqtt2discord-icon.png",
  "project": "https://gitlab.com/opensource-auke/mqtt2discord",
  "support": "https://gitlab.com/opensource-auke/mqtt2discord",
  "description": "Send MQTT messages from a broker to Discord via webhooks.",
  "requires": "Requires a `config.json` file to be at the Config File path before starting the container. See documentation: https://gitlab.com/opensource-auke/mqtt2discord/-/blob/develop/src/config.json.sample",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/mqtt2discord/config.json",
      "container": "/usr/src/bot/config.json",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
