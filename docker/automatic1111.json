{
  "name": "AUTOMATIC1111 Stable Diffusion Web UI",
  "repo": "goolashe/automatic1111-sd-webui",
  "category": [
    "AI",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/goolashe/automatic1111-sd-webui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--gpus=all",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7860]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/automatic1111-icon.png",
  "project": "https://github.com/AUTOMATIC1111/stable-diffusion-webui",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "A web interface for Stable Diffusion \r\n        Integrates with Open WebUI: https://docs.openwebui.com/tutorial/images/#configuring-open-webui \r\n        Add custom models: https://github.com/AbdBarho/stable-diffusion-webui-docker/wiki/Usage#custom-models",
  "requires": "This is a web UI for Stable Diffusion and uses a Docker image which is several gigabytes. If you receive a \"no space left on device\" warning during installation, please increase the vDisk size in your Docker settings.",
  "paths": [
    {
      "name": "Configuration data",
      "host": "/mnt/cache/appdata/automatic1111/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to configuration data",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Output directory",
      "host": "/mnt/cache/appdata/automatic1111/output",
      "container": "/output",
      "mode": "rw",
      "description": "Path to output (saved images) directory",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7860",
      "container": "7860",
      "protocol": "tcp",
      "description": "Container Port: 7860",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Nvidia Visible Devices",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": "all",
      "description": "Nvidia Visible Devices",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Extra CLI arguments",
      "key": "CLI_ARGS",
      "value": "--api",
      "description": "Extra CLI arguments",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [
    {
      "driver": "nvidia",
      "count": "all",
      "capabilities": [
        "gpu"
      ],
      "description": "NVIDIA GPU pass-through. Requires the NVIDIA driver / container toolkit on the host (Unraid: install the Nvidia-Driver plugin)."
    }
  ],
  "author": "nwithan8"
}
