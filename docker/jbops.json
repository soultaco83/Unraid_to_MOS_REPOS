{
  "name": "jbops",
  "repo": "ghcr.io/home-operations/jbops:rolling",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/home-operations/jbops",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/jbops-icon.png",
  "project": "https://github.com/blacktwin/JBOPS",
  "support": "https://github.com/home-operations/containers/issues",
  "description": "Just a Bunch Of Plex Scripts",
  "requires": "Requires a Plex config file mounted to the Config File path BEFORE starting the container. See documentation: https://python-plexapi.readthedocs.io/en/latest/configuration.html",
  "paths": [
    {
      "name": "Config File",
      "host": null,
      "container": "/config/config.ini",
      "mode": "rw",
      "description": "Path to Plex config file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Script Name",
      "key": "JBOPS__SCRIPT_PATH",
      "value": "fun/plexapi_haiku.py",
      "description": "Path inside the container to the script to run",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Config Path",
      "key": "PLEXAPI_CONFIG_PATH",
      "value": "/config/config.ini",
      "description": "Internal path to the config file. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
