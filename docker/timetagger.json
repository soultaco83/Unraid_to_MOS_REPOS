{
  "name": "timetagger",
  "repo": "ghcr.io/almarklein/timetagger",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": null,
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": "https://i.imgur.com/kQTshW1.png",
  "project": "https://timetagger.app/",
  "support": "https://github.com/almarklein/timetagger/issues",
  "description": "Tag your time, get the insight - An open source time-tracker with an interactive user experience and powerful reporting.\r\n\r\nUse https://timetagger.app/cred to generate your credentials you will use to log in to timetagger. You can add multiple users this way (separated by commas).",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/timetagger",
      "container": "/root/_timetagger",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8089",
      "container": "80",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "TIMETAGGER_BIND",
      "key": "TIMETAGGER_BIND",
      "value": "0.0.0.0:80",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TIMETAGGER_DATADIR",
      "key": "TIMETAGGER_DATADIR",
      "value": "/root/_timetagger",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TIMETAGGER_LOG_LEVEL",
      "key": "TIMETAGGER_LOG_LEVEL",
      "value": "info",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TIMETAGGER_CREDENTIALS",
      "key": "TIMETAGGER_CREDENTIALS",
      "value": null,
      "description": "Use https://timetagger.app/cred to generate your credentials you will use to log in to timetagger. You can add multiple users this way (separated by commas).",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
