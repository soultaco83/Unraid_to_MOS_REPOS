{
  "name": "Qbittorrent_80x86",
  "repo": "80x86/qbittorrent:4.4.5-37-minimal-amd64-full",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/80x86/qbittorrent",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1911]",
