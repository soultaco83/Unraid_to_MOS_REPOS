  "project": "https://hub.docker.com/r/80x86/qbittorrent",
  "support": "https://hub.docker.com/r/80x86/qbittorrent",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Download Path",
      "host": "Your Download Path",
      "container": "/downloads",
      "mode": "rw",
      "description": "Download Path",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/Qbittorrent_80x86/config",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/Qbittorrent_80x86/data",
      "container": "/data",
      "mode": "rw",
      "description": "Data Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "1911",
      "container": "1911",
      "protocol": "tcp",
      "description": "Web Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TCP Port",
      "host": "56688",
      "container": "56688",
      "protocol": "tcp",
      "description": "TCP Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "UDP Port",
      "host": "56688",
