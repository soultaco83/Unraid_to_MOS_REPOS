{
  "name": "Draw.io (selfhosters)",
  "repo": "jgraph/drawio",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/jgraph/drawio",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/draw-io.png",
  "project": "https://github.com/jgraph/drawio",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "A lightweight diagram drawing application",
  "paths": [],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WebUI SSL Port",
      "host": "3443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Container Port: 8443",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Enable Lets Encrypt",
      "key": "LETS_ENCRYPT_ENABLED",
      "value": "false",
      "description": "Enables Let's Encrypt certificate instead of self-signed certificates",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PUBLIC_DNS",
      "key": "PUBLIC_DNS",
      "value": null,
      "description": "DNS domain to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "ORGANISATION_UNIT",
      "key": "ORGANISATION_UNIT",
      "value": null,
      "description": "Organisation unit to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "ORGANISATION",
      "key": "ORGANISATION",
      "value": null,
      "description": "Organisation name to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "CITY",
      "key": "CITY",
      "value": null,
      "description": "City name to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "STATE",
      "key": "STATE",
      "value": null,
      "description": "State name to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "COUNTRY_CODE",
      "key": "COUNTRY_CODE",
      "value": null,
      "description": "Country code to be used as certificate",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "KEYSTORE_PASS",
      "key": "KEYSTORE_PASS",
      "value": null,
      "description": "'.keystore'/.jks' store password",
      "required": true,
      "mask": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "KEY_PASS",
      "key": "KEY_PASS",
      "value": null,
      "description": "Private key password &lt;ref:KEYSTORE_PASS&gt;",
      "required": true,
      "mask": true,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
