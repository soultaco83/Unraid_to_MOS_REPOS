{
  "name": "podgrab",
  "repo": "akhilrex/podgrab",
  "category": [
    "Downloader",
    "Media",
    "Misc",
    "Productivity"
  ],
  "registry": "http://hub.docker.com/akhilrex/podgrab/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--user 500:500",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": null,
  "project": "https://github.com/akhilrex/podgrab",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "A self-hosted podcast manager to download episodes as soon as they become live",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Assets",
      "host": null,
      "container": "/assets",
      "mode": "rw",
      "description": "Location for the podcasts",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Check Frequency",
      "key": "CHECK_FREQUENCY",
      "value": "240",
      "description": "Container Variable: CHECK_FREQUENCY",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Password",
      "key": "PASSWORD",
      "value": null,
      "description": "When set, the default password is `podgrab`",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
