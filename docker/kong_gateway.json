{
  "name": "Kong Gateway",
  "repo": "kong/kong-gateway:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/kong/kong-gateway",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:28002]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/kong-gateway-icon.png",
  "project": "https://konghq.com/products/kong-gateway",
  "support": "https://docs.konghq.com/gateway/3.10.x/install/docker/",
  "description": "Lightweight, fast, and flexible cloud native API gateway. \r\n        [br]\n        This is a DB-less version of Kong Gateway. Please refer to \"declarative\" variants when configuring.",
  "requires": "Expects a \"config.yml\" file in the Config Path. See documentation: https://docs.konghq.com/gateway/3.10.x/production/deployment-topologies/db-less-and-declarative-config/#declarative-configuration-format",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/kong",
      "container": "/kong/declarative",
      "mode": "rw",
      "description": "Parent folder for the Kong configuration file",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Proxy Port - HTTP",
      "host": "28000",
      "container": "28000",
      "protocol": "tcp",
      "description": "Container Port: 28000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Proxy Port - HTTPS",
      "host": "28443",
      "container": "28443",
      "protocol": "tcp",
      "description": "Container Port: 28443",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin API Port - HTTP",
      "host": "28001",
      "container": "28001",
      "protocol": "tcp",
      "description": "Container Port: 28001",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin API Port - HTTPS",
      "host": "28444",
      "container": "28444",
      "protocol": "tcp",
      "description": "Container Port: 28444",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin GUI Port - HTTP",
      "host": "28002",
      "container": "28002",
      "protocol": "tcp",
      "description": "Container Port: 28002",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin GUI Port - HTTPS",
      "host": "28445",
      "container": "28445",
      "protocol": "tcp",
      "description": "Container Port: 28445",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Additional Port 1",
      "host": "28003",
      "container": "28003",
      "protocol": "tcp",
      "description": "Container Port: 28003",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Additional Port 2",
      "host": "28004",
      "container": "28004",
      "protocol": "tcp",
      "description": "Container Port: 28004",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Admin UI URL",
      "key": "KONG_ADMIN_GUI_URL",
      "value": "http://IP_ADDRESS:28002",
      "description": "URL for the Admin UI",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Config Path",
      "key": "KONG_DECLARATIVE_CONFIG",
      "value": "/kong/declarative/config.yml",
      "description": "Internal path to the Kong configuration file",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Use Database",
      "key": "KONG_DATABASE",
      "value": "off",
      "description": "Disable using a database. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Proxy Listening Interface",
      "key": "KONG_PROXY_LISTEN",
      "value": "0.0.0.0:28000",
      "description": "Internal interface for the Proxy. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Admin API Listening Interface",
      "key": "KONG_ADMIN_LISTEN",
      "value": "0.0.0.0:28001",
      "description": "Internal interface for the Admin API. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Admin UI Listening Interface",
      "key": "KONG_ADMIN_GUI_LISTEN",
      "value": "0.0.0.0:28002",
      "description": "Internal interface for the Admin UI. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Proxy Logs - Access",
      "key": "KONG_PROXY_ACCESS_LOG",
      "value": "/dev/stdout",
      "description": "Where to send access logs. Default: Print to stdout",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Proxy Logs - Error",
      "key": "KONG_PROXY_ERROR_LOG",
      "value": "/dev/stderr",
      "description": "Where to send error logs. Default: Print to stderr",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Admin Logs - Access",
      "key": "KONG_ADMIN_ACCESS_LOG",
      "value": "/dev/stdout",
      "description": "Where to send access logs. Default: Print to stdout",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Admin Logs - Error",
      "key": "KONG_ADMIN_ERROR_LOG",
      "value": "/dev/stderr",
      "description": "Where to send error logs. Default: Print to stderr",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
