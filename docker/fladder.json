{
  "name": "Fladder",
  "repo": "ghcr.io/donutware/fladder:latest",
  "category": [
    "Media",
    "Utilities",
    "Productivity",
    "Misc"
  ],
  "registry": "ghcr.io/donutware/fladder",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/fladder-icon.png",
  "project": "https://donutware.github.io/Fladder/",
  "support": "https://github.com/DonutWare/Fladder/issues",
  "description": "A simple Jellyfin frontend built on top of Flutter.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Lock to Base URL",
      "key": "BASE_URL",
      "value": "https://server-url",
      "description": "Lock the front-end to a specific Jellyfin instance. Optional, remove to disable.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
