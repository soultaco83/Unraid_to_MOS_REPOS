{
  "name": "Wbo",
  "repo": "xushier/wbo:latest",
  "category": [
    "Productivity"
  ],
  "registry": "https://hub.docker.com/r/xushier/wbo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8012]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Wbo_A.png",
  "project": "https://wbo.ophir.dev",
  "support": "https://github.com/lovasoa/whitebophir",
  "description": "WBO is an online collaborative whiteboard that is simple, easy to use and open-source.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/Wbo",
      "container": "/opt/app/server-data",
      "mode": "rw",
      "description": "Data Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8012",
      "container": "80",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
