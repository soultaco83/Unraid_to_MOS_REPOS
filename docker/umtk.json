{
  "name": "UMTK",
  "repo": "netplexflix/umtk:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/netplexflix/umtk",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--init",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2120]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/umtk-icon.png",
  "project": "https://github.com/netplexflix/Upcoming-Movies-TV-Shows-for-Kometa",
  "support": "https://github.com/netplexflix/Upcoming-Movies-TV-Shows-for-Kometa/issues",
  "description": "UMTK (Upcoming Movies and TV Shows for Kometa) creates 'Coming Soon' collections in your Plex server.",
  "requires": "Requires separate Kometa, Sonarr/Radarr and Plex servers.",
  "paths": [
    {
      "name": "Kometa Config Files",
      "host": null,
      "container": "/app/kometa",
      "mode": "rw",
      "description": "Output directory for generated Kometa YAML files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Placeholder Videos",
      "host": null,
      "container": "/video",
      "mode": "rw",
      "description": "Path to folder containing placeholder videos (optional)",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Sonarr Path",
      "host": null,
      "container": "/data/media/tv",
      "mode": "rw",
      "description": "Path to TV shows as seen by Sonarr (optional). Edit Target to match internal Sonarr path exactly.",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Radarr Path",
      "host": null,
      "container": "/data/media/movies",
      "mode": "rw",
      "description": "Path to movies as seen by Radarr (optional). Edit Target to match internal Radarr path exactly.",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "App Config",
      "host": "/mnt/user/appdata/umtk/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "2120",
      "container": "2120",
      "protocol": "tcp",
      "description": "Container Port: 2120",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Cron Schedule",
      "key": "CRON",
      "value": "0 2 * * *",
      "description": "Cron schedule for running the update (default: daily at 2 AM)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Is Docker",
      "key": "DOCKER",
      "value": "true|false",
      "description": "Indicate app is running in Docker. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
