{
  "name": "homepage",
  "repo": "ghcr.io/gethomepage/homepage:latest",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/gethomepage/homepage",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/gethomepage/homepage/main/public/android-chrome-512x512.png",
  "project": "https://github.com/gethomepage/homepage",
  "support": "https://discord.gg/VWAG7rZ",
  "description": "Homepage is a highly customizable homepage (or startpage / application dashboard) with Docker and service API integrations.",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "/app/config",
      "host": "/mnt/user/appdata/homepage",
      "container": "/app/config",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "HOMEPAGE_ALLOWED_HOSTS",
      "key": "HOMEPAGE_ALLOWED_HOSTS",
      "value": null,
      "description": "The value is a comma-separated (no spaces) list of allowed hosts (sometimes with the port) that can host your homepage install. See gethomepage.dev/installation/#homepage_allowed_hosts",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
