{
  "name": "Soulbeet",
  "repo": "docccccc/soulbeet:master",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/docccccc/soulbeet",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9765]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/soulbeet-icon.png",
  "project": "https://github.com/terry90/soulbeet",
  "support": "https://github.com/terry90/soulbeet/issues",
  "description": "Soulbeet is a modern, self-hosted music downloader and manager. It bridges the gap between Soulseek (via slskd) and your music library (managed by beets), providing a seamless flow from search to streaming-ready library.",
  "requires": "Requires a separate Soulseek slskd server to be running and accessible.",
  "paths": [
    {
      "name": "Soulseek - External Download Folder",
      "host": "/mnt/user/downloads/soulseek",
      "container": "/downloads",
      "mode": "rw",
      "description": "Path to the external slskd download folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Beets - Music Folder",
      "host": null,
      "container": "/music",
      "mode": "rw",
      "description": "Path to the music library folder managed by beets",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Data Folder",
      "host": "/mnt/user/appdata/soulbeet/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9765",
      "container": "9765",
      "protocol": "tcp",
      "description": "Container Port: 9765",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "A secret key for Soulbeet (can be any random string)",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Soulseek - URL",
      "key": "SLSKD_URL",
      "value": "http://IP_ADDRESS:5030",
      "description": "URL for the slskd server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Soulseek - API Key",
      "key": "SLSKD_API_KEY",
      "value": null,
      "description": "API key for the slskd server",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Soulseek - Internal Download Folder",
      "key": "DOWNLOAD_PATH",
      "value": "/downloads",
      "description": "Internal path to the slskd download folder. Should match the path in Soulseek",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Beets - Config File",
      "key": "BEETS_CONFIG",
      "value": "/config/config.yaml",
      "description": "Internal path to the beets config file. Optional, remove if not used.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Navidrome URL",
      "key": "NAVIDROME_URL",
      "value": null,
      "description": "Your Navidrome URL",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "sqlite:/data/soulbeet.db",
      "description": "Database connection URL",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
