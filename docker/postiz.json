{
  "name": "Postiz",
  "repo": "ghcr.io/gitroomhq/postiz-app:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/gitroomhq/postiz-app",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/postiz-icon.png",
  "project": "https://postiz.com/",
  "support": "https://github.com/gitroomhq/postiz-app/issues",
  "description": "Everything you need to manage your social media posts, build an audience, capture leads, and grow your business.",
  "requires": "Requires separate Postgres and Redis databases. See documentation for more information: https://docs.postiz.com/installation/docker-compose#example-docker-composeyml-file",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/postiz/config",
      "container": "/config",
      "mode": "rw",
      "description": "Where config data will be stored",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Frontend Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Web UI URL",
      "key": "MAIN_URL",
      "value": "https://SERVER_IP_ADDRESS:5000",
      "description": "The public URL to the Postiz Web UI. Provide server IP address.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Public Frontend URL",
      "key": "FRONTEND_URL",
      "value": "https://SERVER_IP_ADDRESS:5000",
      "description": "The public URL to the Postiz frontend. Same as Web UI URL.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Public Backend URL",
      "key": "NEXT_PUBLIC_BACKEND_URL",
      "value": "https://SERVER_IP_ADDRESS:5000/api",
      "description": "The public URL to the Postiz backend. Provide server IP address.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "JWT Secret",
      "key": "JWT_SECRET",
      "value": null,
      "description": "JWT token used for encryption. Generate with `openssl rand -base64 32`",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Postgres Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://USERNAME:PASSWORD@IP:5432/DATABASE_NAME",
      "description": "Connection URL for Postgres database",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Redis Database URL",
      "key": "REDIS_URL",
      "value": "redis://localhost:6379",
      "description": "Connection URL for Postgres database",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Storage Provider",
      "key": "STORAGE_PROVIDER",
      "value": "local",
      "description": "Storage provider for Postiz",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Upload Directory",
      "key": "Upload Directory",
      "value": "/uploads",
      "description": "Directory for uploads",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Cloudflare Account ID",
      "key": "CLOUDFLARE_ACCOUNT_ID",
