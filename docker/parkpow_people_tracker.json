{
  "name": "ParkPow People Tracker",
  "repo": "platerecognizer/people-tracker:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/platerecognizer/people-tracker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://app.parkpow.com/static/images/Icon_ParkPow_100x100.jpg",
  "project": "https://platerecognizer.com/",
  "support": "https://guides.platerecognizer.com/docs/other-apps/people-tracker/docker-configuration",
  "description": "PeopleTracker is a detection software that processes live camera or pre-recorded video feeds rapidly and effectively. Upon detection of a person, the software triggers a webhook in real-time, thus ensuring swift and efficient people counting metrics.",
  "requires": "Runs offline, but requires a token and license from https://app.platerecognizer.com/products/snapshot-sdk/ \r\n        [br]\n        Requires a `people-config.ini` file in the App Data folder. See documentation: https://guides.platerecognizer.com/docs/other-apps/people-tracker/configuration",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/people_tracker/stream",
      "container": "/people-data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "API Token",
      "key": "TOKEN",
      "value": null,
      "description": "API Token for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "License",
      "key": "LICENSE_KEY",
      "value": null,
      "description": "License Key for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
