      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Immich URL",
      "key": "IMMICH_URL",
      "value": null,
      "description": "The URL to the Immich Server",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Immich API Key",
      "key": "IMMICH_API_KEY",
      "value": null,
      "description": "The API for your Immich server",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
