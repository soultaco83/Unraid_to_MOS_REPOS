{
  "name": "planka (selfhosters)",
  "repo": "ghcr.io/plankanban/planka",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/plankanban/planka/pkgs/container/planka",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1337]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/planka.png",
  "project": "https://planka.app/",
  "support": "https://github.com/plankanban/planka/issues",
  "description": "The realtime kanban board for workgroups built with React and Redux.",
  "requires": "Postgres",
  "paths": [
    {
      "name": "User Avatars",
      "host": "/mnt/cache/appdata/planka/user-avatars",
      "container": "/app/public/user-avatars",
      "mode": "rw",
      "description": "User Avatar Storage Location",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Project Background Images",
      "host": "/mnt/cache/appdata/planka/project-background-images",
      "container": "/app/public/project-background-images",
      "mode": "rw",
      "description": "Background Image Location",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Attachments",
      "host": "/mnt/cache/appdata/planka/attachments",
      "container": "/app/private/attachments",
      "mode": "rw",
      "description": "Attachment Storage Location",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "3000",
      "container": "1337",
      "protocol": "tcp",
      "description": "Web UI Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "description": "Base URL of Planka",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database URL",
      "key": "DATABASE_URL",
      "value": "postgresql://postgres@postgres/planka",
      "description": "Postgres Database Auth",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": "notsecretkey",
      "description": "Secret Key",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
