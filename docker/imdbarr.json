{
  "name": "imdbarr",
  "repo": "ghcr.io/skulltrail/imdbarr:latest",
  "category": [
    "Downloader",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/skulltrail/imdbarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/imdbarr-icon.png",
  "project": "https://github.com/skulltrail/imdbarr",
  "support": "https://github.com/skulltrail/imdbarr/issues",
  "description": "A lightweight API that bridges the gap between IMDB watchlists and Sonarr. Converts your IMDB watchlist or any public IMDB list to the format that Sonarr's Custom List feature expects.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "TMDB API Key",
      "key": "TMDB_API_KEY",
      "value": null,
      "description": "Your TMDB API Key",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "description": "The base URL for accessing the application. Change 'localhost' to your server's IP or domain if accessing remotely.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "3000",
      "description": "Internal application port. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
