{
  "name": "Alexa Subwatch",
  "repo": "simplysublime/alexa-subwatch:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/simplysublime/alexa-subwatch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/alexa-subwatch-icon.png",
  "project": "https://github.com/senpaiSubby/alexa-subwatch",
  "support": "https://github.com/senpaiSubby/alexa-subwatch/issues",
  "description": "Ask Alexa to add movie and shows to Radarr and Sonarr.",
  "requires": "Expects a `config.yaml` file in the Config Path. See documentation: https://github.com/senpaiSubby/alexa-subwatch?tab=readme-ov-file#subwatch-configuration",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/alexa_subwatch/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
