{
  "name": "Wanderer - Database",
  "repo": "flomp/wanderer-db:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/flomp/wanderer-db",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/Flomp/wanderer/refs/heads/main/web/static/favicon.png",
  "project": "https://github.com/Flomp/wanderer",
  "support": "https://github.com/Flomp/wanderer/issues",
  "description": "A self-hosted trail database. You can upload your recorded tracks or create new ones and add various metadata to build an easily searchable catalogue. \r\n        [br]\n        This is the database component.",
  "paths": [
    {
      "name": "Database Storage Path",
      "host": "/mnt/user/appdata/wanderer/db",
      "container": "/pb_data",
      "mode": "rw",
      "description": "Path to store the database",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Connection Port",
      "host": "8090",
      "container": "8090",
      "protocol": "tcp",
      "description": "Container Port: 8090",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Meilisearch - URL",
      "key": "MEILI_URL",
      "value": "http://meilisearch:7700",
      "description": "URL of the Meilisearch instance",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Meilisearch - Master Key",
      "key": "MEILI_MASTER_KEY",
      "value": null,
      "description": "Master key for the Meilisearch instance",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
