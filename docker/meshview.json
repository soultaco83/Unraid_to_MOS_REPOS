{
  "name": "Meshview",
  "repo": "ghcr.io/pablorevilla-meshtastic/meshview:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/pablorevilla-meshtastic/meshview",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/meshview-icon.png",
  "project": "https://github.com/pablorevilla-meshtastic/meshview",
  "support": "https://github.com/pablorevilla-meshtastic/meshview/issues",
  "description": "A real-time monitoring and diagnostic tool for the Meshtastic mesh network. It provides detailed insights into network activity, including message traffic, node positions, and telemetry data.",
  "requires": "Requires a `config.ini` file in the Config Path before starting the container. See configuration details: https://github.com/pablorevilla-meshtastic/meshview/blob/master/README-Docker.md#configuration",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/meshview/config",
      "container": "/etc/meshview",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/meshview/data",
      "container": "/var/lib/meshview",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/user/appdata/meshview/logs",
      "container": "/var/log/meshview",
      "mode": "rw",
      "description": "Path to the logs folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Database Backups Path",
      "host": "/mnt/user/appdata/meshview/backups",
      "container": "/var/lib/meshview/backups",
      "mode": "rw",
      "description": "Path to the database backups folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
