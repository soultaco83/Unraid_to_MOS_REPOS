{
  "name": "wrapperr",
  "repo": "aunefyren/wrapperr",
  "category": [
    "Productivity",
    "Utilities",
    "Media",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/aunefyren/wrapperr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8282]/",
  "icon": "https://github.com/ibracorp/app-logos/blob/main/plex-wrapped/plex_wrapped.png?raw=true?raw=true",
  "project": "https://github.com/aunefyren/wrapperr",
  "support": "https://discord.gg/VWAG7rZ",
  "description": "A website-based platform and API for collecting Plex user stats within a set timeframe using Tautulli. The data is displayed as a stat-summary, sort of like Spotify Wrapped. Yes, you need Tautulli to have been running beforehand and currently for this to work.",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/user/appdata/wrapperr",
      "container": "/app/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8282",
      "container": "8282",
      "protocol": "tcp",
      "description": "Container Port: 8282",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
