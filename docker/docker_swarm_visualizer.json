{
  "name": "Docker Swarm Visualizer",
  "repo": "dockerswarmvisualizer/dockerswarmvisualizer:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/dockerswarmvisualizer/dockerswarmvisualizer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--security-opt no-new-privileges:true --cap-drop ALL",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/docker-swarm-visualizer-icon.png",
  "project": "https://sammonsempes.github.io/DockerSwarmVisualizer/",
  "support": "https://github.com/sammonsempes/DockerSwarmVisualizer/issues",
  "description": "A real-time web visualization tool for Docker Swarm clusters. See your nodes, services, and networks as an interactive graph.",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5000",
      "container": "5000",
      "protocol": "tcp",
      "description": "Container Port: 5000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
