{
  "name": "TextBee - Web",
  "repo": "ghcr.io/vernu/textbee/web:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/vernu/textbee/web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "pnpm start",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/vernu/textbee/refs/heads/main/web/public/images/logo.png",
  "project": "https://textbee.dev",
  "support": "https://textbee.dev",
  "description": "A simple SMS gateway that allows users to send SMS messages from a web interface or from their application via a REST API. It utilizes android phones as SMS gateways.",
  "requires": "Requires a separate TextBee API container (and corresponding MongoDB container) to function.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "API URL",
      "key": "NEXT_PUBLIC_API_BASE_URL",
      "value": null,
      "description": "URL of the TextBee API",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Auth Secret",
      "key": "AUTH_SECRET",
      "value": "changeme",
      "description": "Secret key for NextAuth. Generate at https://generate-secret.vercel.app/32",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "MongoDB URL",
      "key": "DATABASE_URL",
      "value": "mongodb://localhost:27017/textbee",
      "description": "URL of the MongoDB database",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Email - Host",
      "key": "MAIL_HOST",
      "value": null,
      "description": "Email Host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Email - Port",
      "key": "MAIL_PORT",
      "value": null,
      "description": "Email Port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Email - User",
      "key": "MAIL_USER",
      "value": null,
      "description": "Email User",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Email - Password",
      "key": "MAIL_PASS",
      "value": null,
      "description": "Email Password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Email - From",
      "key": "MAIL_FROM",
      "value": null,
      "description": "Email From",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
