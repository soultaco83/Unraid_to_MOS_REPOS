{
  "name": "Peergos UI",
  "repo": "ghcr.io/peergos/web-ui:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/peergos/web-ui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "daemon -listen-host 0.0.0.0 -public-domain YOUR_DOMAIN_NAME -log-to-console true",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/peergos-icon.svg",
  "project": "https://peergos.org",
  "support": "https://peergos.org/features",
  "description": "A p2p, secure file storage, social network and application protocol",
  "requires": "Replace YOUR_DOMAIN_NAME with your domain name in the Post Arguments section.",
  "paths": [
    {
      "name": "Data Path",
      "host": null,
      "container": "/opt/peergos/data",
      "mode": "rw",
      "description": "Path to the Peergos data directory",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
