{
  "name": "DashGate",
  "repo": "khak1s/dashgate:latest",
  "category": [
    "Utilities",
    "Network"
  ],
  "registry": "https://hub.docker.com/r/khak1s/dashgate",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1738]",
  "icon": "https://raw.githubusercontent.com/Kha-kis/dashgate/main/unraid/dashgate-icon.png",
  "project": "https://github.com/Kha-kis/dashgate",
  "support": "https://github.com/Kha-kis/dashgate/issues",
  "description": "DashGate is a self-hosted application gateway and dashboard. Features multi-method authentication (local, LDAP, OIDC/SSO, proxy auth, API keys), group-based access control, automatic app discovery from Docker/Traefik/Nginx/NPM/Caddy, health monitoring, and PWA support.",
  "requires": "For Docker auto-discovery, enable the Docker socket mount below.",
  "paths": [
    {
      "name": "Config Storage",
      "host": "/mnt/cache/appdata/dashgate",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent storage for config.yaml and SQLite database.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Docker socket for auto-discovering containers. Optional.",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "host": "1738",
      "container": "1738",
      "protocol": "tcp",
      "description": "DashGate web interface port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID for file permissions (run 'id' in Unraid terminal to find yours).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID for file permissions (run 'id' in Unraid terminal to find yours).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Port",
      "key": "PORT",
      "value": "1738",
      "description": "Internal port (should match WebUI Port).",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Auth Mode",
      "key": "AUTH_MODE",
      "value": "local|hybrid|authelia",
      "description": "Authentication mode",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Session Duration (Days)",
      "key": "SESSION_DURATION_DAYS",
      "value": "7",
      "description": "How many days a login session stays valid.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Encryption Key",
      "key": "ENCRYPTION_KEY",
      "value": null,
      "description": "64-char hex string for encrypting secrets at rest. Leave empty to auto-generate.",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Docker Discovery",
      "key": "DOCKER_DISCOVERY",
      "value": "true",
      "description": "Enable automatic Docker container discovery.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Traefik Discovery",
      "key": "TRAEFIK_DISCOVERY",
      "value": "false",
      "description": "Enable Traefik router discovery.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Traefik URL",
      "key": "TRAEFIK_URL",
      "value": null,
      "description": "Traefik API URL (e.g., http://traefik:8080).",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "NPM Discovery",
      "key": "NPM_DISCOVERY",
      "value": "false",
      "description": "Enable Nginx Proxy Manager discovery.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "NPM URL",
      "key": "NPM_URL",
      "value": null,
      "description": "NPM API URL (e.g., http://npm:81).",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "NPM Email",
      "key": "NPM_EMAIL",
      "value": null,
      "description": "NPM admin email for API login.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "NPM Password",
      "key": "NPM_PASSWORD",
      "value": null,
      "description": "NPM admin password for API login.",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "LLDAP URL",
      "key": "LLDAP_URL",
      "value": null,
      "description": "LLDAP server URL for user directory (e.g., http://lldap:17170).",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "LLDAP Admin Username",
      "key": "LLDAP_ADMIN_USERNAME",
      "value": null,
      "description": "LLDAP admin username.",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "LLDAP Admin Password",
      "key": "LLDAP_ADMIN_PASSWORD",
      "value": null,
      "description": "LLDAP admin password.",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
