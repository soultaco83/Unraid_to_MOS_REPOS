{
  "name": "CookieCloud",
  "repo": "easychen/cookiecloud:latest",
  "category": [
    "Backup",
    "Hosting"
  ],
  "registry": "https://hub.docker.com/r/easychen/cookiecloud",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8088]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Cookiecloud_A.png",
  "project": "https://github.com/easychen/CookieCloud",
  "support": "https://hub.docker.com/r/easychen/cookiecloud",
  "description": "Cookie同步工具 CookieCloud 自架服务器端镜像 https://github.com/easychen/CookieCloud\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/CookieCloud",
      "container": "/data/api/data",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8088",
      "container": "8088",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "URL Prefix",
      "key": "API_ROOT",
      "value": "/ck",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
