{
  "name": "exercise-dairy",
  "repo": "aceberg/exercisediary",
  "category": [
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/aceberg/exercisediary",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8851]",
  "icon": "https://raw.githubusercontent.com/aceberg/ExerciseDiary/main/assets/logo.png",
  "project": "https://github.com/aceberg/ExerciseDiary",
  "support": null,
  "description": "Workout diary with GitHub-style year visualization",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/exercisediary",
      "container": "/data/ExerciseDiary",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8851",
      "container": "8851",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Chicago",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "HOST",
      "key": "HOST",
      "value": "0.0.0.0",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "THEME",
      "key": "THEME",
      "value": "grass",
      "description": "Any theme name from https://bootswatch.com in lowcase or additional (emerald, grass, sand)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "COLOR",
      "key": "COLOR",
      "value": "dark",
      "description": "Background color: light or dark",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
