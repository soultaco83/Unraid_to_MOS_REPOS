{
  "name": "MedAssist",
  "repo": "ghcr.io/njic/medassist:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/njic/medassist",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3111]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/medassist-icon.png",
  "project": "https://github.com/njic/medassist",
  "support": "https://github.com/njic/medassist/issues",
  "description": "A simple application to makes it easy to keep track of medication inventory and reorder on time by sending reminders.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/medassist/database",
      "container": "/app/medassist",
      "mode": "rw",
      "description": "Data path",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3111",
      "container": "3111",
      "protocol": "tcp",
      "description": "Container Port: 3111",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
