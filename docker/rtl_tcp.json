{
  "name": "RTL-TCP",
  "repo": "kosdk/rtl-tcp:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/kosdk/rtl-tcp",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/rtl-tcp-icon.png",
  "project": "https://github.com/Cossey/docker/tree/master/rtl-tcp",
  "support": "https://github.com/Cossey/docker/blob/master/rtl-tcp/README.md",
  "description": "RTL-SDR TCP server for RTL-SDR dongles.",
  "paths": [],
  "ports": [
    {
      "name": "Listening Port",
      "host": "1234",
      "container": "1234",
      "protocol": "tcp",
      "description": "Container Port: 1234",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Device Index",
      "key": "DEVICE",
      "value": "0",
      "description": "RTL-SDR device index (0 for first device, 1 for second, etc.)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Gain",
      "key": "GAIN",
      "value": "0",
      "description": "Gain setting for the RTL-SDR device. Use 0 for automatic gain.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Buffers",
      "key": "BUFFERS",
      "value": null,
      "description": "Number of buffers to use. Leave empty for default.",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "List Buffers",
      "key": "LIST_BUFFERS",
      "value": "500",
      "description": "Max number of linked list buffers to keep",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PPM Error",
      "key": "PPM_ERROR",
      "value": "0",
      "description": "PPM error correction for the RTL-SDR device",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Frequency",
      "key": "FREQUENCY",
      "value": null,
      "description": "Tuning frequency in Hz",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Sample Rate",
      "key": "SAMPLE_RATE",
      "value": "2048000",
      "description": "Sample rate in samples per second",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Enable bias-T on GPIO PIN 0",
      "key": "BIAS_T",
      "value": "false|true",
      "description": "Enable bias-T on GPIO PIN 0 (required for some devices)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Listening Port",
      "key": "LISTEN_IP",
      "value": "1234",
      "description": "Internal port the interface listens on. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "RTL-SDR Devicr",
      "host": "/dev/bus/usb",
      "container": "/dev/bus/usb",
      "description": "USB device to use for the RTL-SDR device",
      "required": true,
      "display": "always-hide"
    }
  ],
  "labels": [],
  "gpus": []
}
