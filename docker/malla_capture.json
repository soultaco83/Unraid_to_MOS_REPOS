{
  "name": "Malla - Capture",
  "repo": "ghcr.io/zenitram/malla:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/zenitram/malla",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "/app/.venv/bin/malla-capture",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/malla-icon.png",
  "project": "https://github.com/zenitraM/malla",
  "support": "https://github.com/zenitraM/malla/issues",
  "description": "Malla is a web analyzer for Meshtastic networks based on MQTT data. \r\n        \r\n        This is the capture component.",
  "requires": "Requires separate Malla - Web and MQTT instances. \r\n        \r\n        Requires a `config.yaml` file to be mounted at `/app/config.yaml` before starting the container. See configuration details: https://github.com/zenitraM/malla/blob/main/config.sample.yaml",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/malla/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to store Malla data.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "MQTT - Address",
      "key": "MALLA_MQTT_BROKER_ADDRESS",
      "value": null,
      "description": "MQTT broker address (IP or hostname) where Meshtastic devices publish data.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "MQTT - Port",
      "key": "MALLA_MQTT_PORT",
      "value": "1883",
      "description": "MQTT broker port.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "MQTT - Username",
      "key": "MALLA_MQTT_USERNAME",
      "value": null,
      "description": "MQTT broker username (if required).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MQTT - Password",
      "key": "MALLA_MQTT_PASSWORD",
      "value": null,
      "description": "MQTT broker password (if required).",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "MQTT - Topic Prefix",
      "key": "MALLA_MQTT_TOPIC_PREFIX",
      "value": "msh",
      "description": "MQTT topic prefix used by Meshtastic devices.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MQTT - Topic Suffix",
      "key": "MALLA_MQTT_TOPIC_SUFFIX",
      "value": "/+/+/+/#",
      "description": "MQTT topic suffix used by Meshtastic devices.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MQTT - Default Channel Key",
      "key": "MALLA_DEFAULT_CHANNEL_KEY",
      "value": null,
      "description": "Default channel key for decrypting Meshtastic messages (if used).",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "MALLA_DATABASE_FILE",
      "value": "/app/data/meshtastic_history.db",
      "description": "Path to the internal database file inside the container. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
