{
  "name": "newsletterr",
  "repo": "jma1ice/newsletterr:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/jma1ice/newsletterr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6397]/",
  "icon": "https://raw.githubusercontent.com/jma1ice/newsletterr/refs/heads/main/static/img/favicon.ico",
  "project": "https://www.newsletterr.org/",
  "support": "https://github.com/jma1ice/newsletterr/issues",
  "description": "Newsletterr is a lightweight Flask application that talks to Tautulli, crunches your Plex statistics, renders charts with Highcharts, pulls recommendations from conjurr and emails the results to your user base, all without leaving the browser.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/newsletterr/database",
      "container": "/app/database",
      "mode": "rw",
      "description": "Path to store the database",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6397",
      "container": "6397",
      "protocol": "tcp",
      "description": "Container Port: 6397",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Public URL",
      "key": "PUBLIC_BASE_URL",
      "value": "http://IP_ADDRESS:6397",
      "description": "Public URL for accessing Newsletterr",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
