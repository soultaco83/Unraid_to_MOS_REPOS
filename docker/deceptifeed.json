{
  "name": "Deceptifeed",
  "repo": "deceptifeed/server:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/deceptifeed/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--config /data/config.xml",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/deceptifeed-icon.png",
  "project": "https://github.com/r-smith/deceptifeed",
  "support": "https://github.com/r-smith/deceptifeed/issues",
  "description": "Deceptifeed is a honeypot and threat feed server. It runs multiple deceptive network services (honeypots), while the threat feed lists IP addresses that have interacted with the honeypots. Additionally, Deceptifeed provides real-time visibility into honeypot activity, allowing you to monitor logs and interactions as they occur.",
  "requires": "Expects a `config.xml` file in the Config Path. See documentation: https://raw.githubusercontent.com/r-smith/deceptifeed/main/configs/docker-config.xml",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/deceptifeed/config",
      "container": "/data",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9000",
      "container": "9000",
      "protocol": "tcp",
      "description": "Container Port: 9000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "HTTP Honeypot Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "HTTPS Honeypot Port",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "Container Port: 8443",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "SSH Honeyport Port",
      "host": "2222",
      "container": "2222",
      "protocol": "tcp",
      "description": "Container Port: 2222",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
