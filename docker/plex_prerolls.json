{
  "name": "Plex Prerolls",
  "repo": "nwithan8/plex_prerolls:latest",
  "category": [
    "Utilities",
    "Media",
    "Productivity",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/nwithan8/plex_prerolls",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/plex-prerolls/main/documentation/images/logo.png",
  "project": "https://github.com/nwithan8/plex-prerolls",
  "support": "https://github.com/nwithan8/plex-prerolls/issues",
  "description": "Plex Prerolls is a tool to automate preroll scheduling for a Plex Media Server.",
  "paths": [
    {
      "name": "Files Path",
      "host": "/mnt/cache/appdata/plex_prerolls/files",
      "container": "/files",
      "mode": "ro",
      "description": "(Optional) Where preroll files are stored, for local path glob feature",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Auto-Generated Prerolls Path",
      "host": null,
      "container": "/auto_rolls",
      "mode": "rw",
      "description": "(Optional) Where auto-generated prerolls will be stored",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/plex_prerolls/config",
      "container": "/config",
      "mode": "ro",
      "description": "Where config file will be stored",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Log Path",
      "host": "/mnt/cache/appdata/plex_prerolls/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Where debug logs will be stored",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Auto-Generated Prerolls Temp Data",
      "host": "/mnt/cache/appdata/plex_prerolls/renders",
      "container": "/renders",
      "mode": "rw",
      "description": "(Optional) Where temp data for auto-generated prerolls will be stored",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Webhooks Port",
      "host": "8283",
      "container": "8283",
      "protocol": "tcp",
      "description": "Port to listen for webhooks",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "UTC",
      "description": "Timezone to use when calculating schedules",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
