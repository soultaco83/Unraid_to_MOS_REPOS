{
  "name": "Reitti",
  "repo": "dedicatedcode/reitti:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/dedicatedcode/reitti",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/dedicatedcode/reitti/refs/heads/main/src/main/resources/static/img/logo.png",
  "project": "https://www.dedicatedcode.com/projects/reitti/",
  "support": "https://www.dedicatedcode.com/projects/reitti/installation/",
  "description": "Reitti is a comprehensive personal location tracking and analysis application that helps you understand your movement patterns and significant places.",
  "requires": "Requires separate PostGIS, Redis, Photon, RabbitMQ and OSM Tile cache instances.",
  "paths": [
    {
      "name": "Data Storage",
      "host": "/mnt/cache/appdata/reitti/data",
      "container": "/data/",
      "mode": "rw",
      "description": "Path to store Reitti data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Photon - URL",
      "key": "PHOTON_BASE_URL",
      "value": "http://IP_ADDRESS:2322/",
      "description": "Base URL for the Photon instance.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Host",
      "key": "POSTGIS_HOST",
      "value": "IP_ADDRESS",
      "description": "Hostname or IP address of the PostGIS instance.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Database",
      "key": "POSTGIS_DB",
      "value": "reitti",
      "description": "Database name for the PostGIS instance.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - User",
      "key": "POSTGIS_USER",
      "value": "reitti",
      "description": "Username for the PostGIS instance.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PostGIS - Password",
      "key": "POSTGIS_PASSWORD",
      "value": "reitti",
      "description": "Password for the PostGIS instance.",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
