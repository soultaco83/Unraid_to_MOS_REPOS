{
  "name": "Huntarr",
  "repo": "huntarr/huntarr:latest",
  "category": [
    "Downloader",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/huntarr/huntarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9705]/",
  "icon": "https://raw.githubusercontent.com/plexguide/Huntarr.io/main/frontend/static/logo/512.png",
  "project": "https://huntarr.io",
  "support": "https://github.com/plexguide/Huntarr.io/issues",
  "description": "A specialized utility that automates discovering missing and upgrading your media collection!",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/huntarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9705",
      "container": "9705",
      "protocol": "tcp",
      "description": "Container Port: 9705",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Base URL",
      "key": "BASE_URL",
      "value": null,
      "description": "Base URL for Huntarr, leave empty for root path",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
