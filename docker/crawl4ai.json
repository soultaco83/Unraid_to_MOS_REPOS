{
  "name": "Crawl4AI",
  "repo": "unclecode/crawl4ai:latest",
  "category": [
    "AI",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/unclecode/crawl4ai",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:11235]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/crawl4ai-icon.png",
  "project": "https://crawl4ai.com/",
  "support": "https://docs.crawl4ai.com/",
  "description": "Open-source web crawler and scraper tailored for LLMs, AI agents, and data pipelines.",
  "paths": [
    {
      "name": "Temporary Filesystem",
      "host": "/dev/shm",
      "container": "/dev/shm",
      "mode": "rw",
      "description": "Mount a temporary filesystem for faster processing.",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "11235",
      "container": "11235",
      "protocol": "tcp",
      "description": "Container Port: 11235",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "LLM Provider",
      "key": "LLM_PROVIDER",
      "value": "anthropic/claude-3-opus",
      "description": "Override default LLM provider.",
      "required": false,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "OpenAI API Key",
      "key": "OPENAI_API_KEY",
      "value": null,
      "description": "API Key for OpenAI.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "DeepSeek API Key",
      "key": "DEEPSEEK_API_KEY",
      "value": null,
      "description": "API Key for DeepSeek.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Anthropic API Key",
      "key": "ANTHROPIC_API_KEY",
      "value": null,
      "description": "API Key for Anthropic.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Groq API Key",
      "key": "GROQ_API_KEY",
      "value": null,
      "description": "API Key for Groq.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Together AI API Key",
      "key": "TOGETHER_API_KEY",
      "value": null,
      "description": "API Key for Together AI.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Mistral API Key",
      "key": "MISTRAL_API_KEY",
      "value": null,
      "description": "API Key for Mistral.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Gemini API Key",
      "key": "GEMINI_API_TOKEN",
      "value": null,
      "description": "API Key for Gemini.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
