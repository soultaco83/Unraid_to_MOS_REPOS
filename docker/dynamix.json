{
  "name": "DynamiX",
  "repo": "clharrel/dynamix:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/clharrel/dynamix",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1166]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dynamix-icon.png",
  "project": "https://github.com/TheImaginear/dynamiX",
  "support": "https://github.com/TheImaginear/dynamiX/issues",
  "description": "An automation tool for dynamically managing Plex collections. It pins and unpins library collections based on configurable time blocks, ensuring fresh and relevant content is featured.",
  "requires": "Requires a `config.json` file to be mounted at `/app/config.json` before starting the container. See configuration details: https://github.com/TheImaginear/dynamiX/blob/main/config.json \r\n        [br]\n        Requires a number of JSON files to be created on the host system BEFORE the container is started. These files can be created with the `touch` command.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/dynamix/config.json",
      "container": "/app/config.json",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "User Exemptions File",
      "host": "/mnt/user/appdata/dynamix/used_collections.json",
      "container": "/app/used_collections.json",
      "mode": "rw",
      "description": "Path to the user exemptions file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Used Collections File",
      "host": "/mnt/user/appdata/dynamix/used_collections.json",
      "container": "/app/used_collections.json",
      "mode": "rw",
      "description": "Path to the used collections file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Run State File",
      "host": "/mnt/user/appdata/dynamix/run_state.json",
      "container": "/app/run_state.json",
      "mode": "rw",
      "description": "Path to the run state file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Log Folder",
      "host": "/mnt/user/appdata/dynamix/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Path to the log folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "1166",
      "container": "1166",
      "protocol": "tcp",
      "description": "Container Port: 1166",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
