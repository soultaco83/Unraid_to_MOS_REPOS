{
  "name": "Hasheous",
  "repo": "ghcr.io/gaseous-project/hasheous:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/gaseous-project/hasheous",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/gaseous-project/gaseous-server/refs/heads/main/logo.png",
  "project": "https://hasheous.org/",
  "support": "https://github.com/gaseous-project/hasheous",
  "description": "Public server to proxy and cache IGDB queries and provide hash matching and lookups for the Gaseous server and other projects.",
  "requires": "Requires a separate MariaDB server.",
  "paths": [
    {
      "name": "Data Storage",
      "host": "/mnt/user/appdata/hasheous/data",
      "container": "/root/.hasheous-server",
      "mode": "rw",
      "description": "Path to data storage location",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7157",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Database - Host",
      "key": "dbhost",
      "value": null,
      "description": "Database host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Username",
      "key": "dbuser",
      "value": null,
      "description": "Database username",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Password",
      "key": "dbpass",
      "value": null,
      "description": "Database password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "IGDB - Client ID",
      "key": "igdbclientid",
      "value": null,
      "description": "IGDB client ID",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "IGDB - Client Secret",
      "key": "igdbclientsecret",
      "value": null,
      "description": "IGDB client secret",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
