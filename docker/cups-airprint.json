{
  "name": "Cups-Airprint",
  "repo": "chuckcharlie/cups-avahi-airprint:latest",
  "category": [
    "Utilities",
    "Network",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/chuckcharlie/cups-avahi-airprint",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:631]/",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/cups-logo.png",
  "project": "https://github.com/chuckcharlie/cups-avahi-airprint",
  "support": "https://forums.unraid.net/topic/129880-support-devzwf-cups-airprint",
  "description": "CUPS instance that is meant as an AirPrint relay for printers that are already on the network but not AirPrint capable.\r\nCUPS supports printing to:\r\n\r\nAirPrint™ and IPP Everywhere™ printers,\r\nNetwork and local (USB) printers with Printer Applications, and\r\nNetwork and local (USB) printers with (legacy) PPD-based printer drivers.\r\n\r\nTo add printers: visit the WebUI =&gt; Administration =&gt; Printers =&gt; Add Printer\r\nThe default admin credential : admin/admin (please Change when setting up your container)",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Avahi service Configs",
      "host": null,
      "container": "/services",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Printer Configs",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Logs",
      "host": null,
      "container": "/var/log/cups",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "CUPS Admin Username",
      "key": "CUPSADMIN",
      "value": "admin",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "CUPS Admin Password",
      "key": "CUPSPASSWORD",
      "value": "admin",
      "description": "",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
