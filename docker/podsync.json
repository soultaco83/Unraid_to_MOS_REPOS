{
  "name": "Podsync",
  "repo": "ghcr.io/mxpv/podsync",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/mxpv/podsync/pkgs/container/podsync",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": null,
  "project": "https://github.com/mxpv/podsync/",
  "support": "https://github.com/mxpv/podsync/issues/new",
  "description": "Turn YouTube or Vimeo channels, users, or playlists into podcast feeds.\n    \r\n    This container expects a `config.toml` file in the \"Config Location\" path for settings. Refer to the Podsync documentation at https://github.com/mxpv/podsync?tab=readme-ov-file#configuration for details.",
  "paths": [
    {
      "name": "Appdata Location",
      "host": "/mnt/cache/appdata/podsync",
      "container": "/app/data",
      "mode": "rw",
      "description": "AppData Location",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Location",
      "host": "/mnt/cache/appdata/podsync/config.toml",
      "container": "/app/config.toml",
      "mode": "rw",
      "description": "Application Config File",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
