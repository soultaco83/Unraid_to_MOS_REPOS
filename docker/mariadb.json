{
  "name": "mariadb",
  "repo": "lscr.io/linuxserver/mariadb",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/mariadb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/linuxserver/docker-mariadb#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/mariadb-logo.png",
  "project": "https://mariadb.org/",
  "support": "https://github.com/linuxserver/docker-mariadb/issues/new/choose",
  "description": "Mariadb(https://mariadb.org/) is one of the most popular database servers. Made by the original developers of MySQL.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3306",
      "container": "3306",
      "protocol": "tcp",
      "description": "MariaDB listens on this port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "MYSQL_ROOT_PASSWORD",
      "key": "MYSQL_ROOT_PASSWORD",
      "value": "ROOT_ACCESS_PASSWORD",
      "description": "Set this to root password for installation (minimum 4 characters and non-alphanumeric passwords must be properly escaped). (valid only for first run)",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "MYSQL_DATABASE",
      "key": "MYSQL_DATABASE",
      "value": "USER_DB_NAME",
      "description": "Specify the name of a database to be created. (valid only for first run)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MYSQL_USER",
      "key": "MYSQL_USER",
      "value": "MYSQL_USER",
      "description": "This user will have superuser access to the database specified by MYSQL_DATABASE (do not use root here). (valid only for first run)",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MYSQL_PASSWORD",
      "key": "MYSQL_PASSWORD",
      "value": "DATABASE_PASSWORD",
      "description": "Set this to the password you want to use for you MYSQL_USER (minimum 4 characters and non-alphanumeric passwords must be properly escaped). (valid only for first run)",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "REMOTE_SQL",
      "key": "REMOTE_SQL",
      "value": "http://URL1/your.sql,https://URL2/your.sql",
      "description": "Set this to ingest sql files from an http/https endpoint (comma seperated array).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "CLI_OPTS",
      "key": "CLI_OPTS",
      "value": null,
      "description": "Pass CLI options to mariadbd via mariadbd-safe. Use with caution as mariadbd option precedence is complex.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
