{
  "name": "Tinyauth",
  "repo": "ghcr.io/tinyauthapp/tinyauth:latest",
  "category": [
    "Network",
    "Security",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/tinyauthapp/tinyauth",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tinyauth-icon.png",
  "project": "https://tinyauth.doesmycode.work/",
  "support": "https://tinyauth.doesmycode.work/docs/getting-started.html",
  "description": "Tinyauth is an extremely simple Traefik forward auth proxy that adds a login screen to all of your apps that are using the Traefik reverse proxy. Tinyauth is configurable through environment variables and it is only 20MB in size.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/tinyauth/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "App URL",
      "key": "TINYAUTH_APPURL",
      "value": "https://tinyauth.example.com",
      "description": "The URL of the Tinyauth instance.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Users and Passwords",
      "key": "TINYAUTH_AUTH_USERS",
      "value": null,
      "description": "A comma-separated list of users names and their bcrypt hashed passwords, in pattern 'user:hashed_password'",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "TINYAUTH_SERVER_PORT",
      "value": "3000",
      "description": "Internal server port. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Address",
      "key": "TINYAUTH_SERVER_ADDRESS",
      "value": "0.0.0.0",
      "description": "The internal address to bind to. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [
    {
      "name": "Traefik - Enable",
      "key": "traefik.enable",
      "value": "true|false",
      "description": "Enable Traefik proxy",
      "required": true,
      "mask": false
    },
    {
      "name": "Traefik - Rule",
      "key": "traefik.http.routers.tinyauth.rule",
      "value": "Host(`tinyauth.example.com`)",
      "description": "Traefik rule. Change based on your domain.",
      "required": true,
      "mask": false
    },
    {
      "name": "Traefik - Server Port",
      "key": "traefik.http.services.tinyauth.loadbalancer.server.port",
      "value": "3000",
      "description": "Server port for Tinyauth. Change as needed.",
      "required": true,
      "mask": false
    }
  ],
  "gpus": [],
  "author": "nwithan8"
}
