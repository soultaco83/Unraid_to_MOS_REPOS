{
  "name": "FileBrowser",
  "repo": "80x86/filebrowser:2.10.3-amd64",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/80x86/filebrowser/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1611]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Filebrowser_A.png",
  "project": "https://filebrowser.org",
  "support": "https://hub.docker.com/r/80x86/filebrowser/",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "File Path",
      "host": "Your File Path",
      "container": "/myfiles",
      "mode": "rw",
      "description": "File Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/Filebrowser/config",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Custom File Path",
      "host": "Your Custom File Path",
      "container": "/mnt",
      "mode": "rw",
      "description": "Custom File Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "1611",
      "container": "8082",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "UMASK",
      "key": "UMASK_SET",
      "value": "000",
      "description": "UMASK",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "PUID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "PGID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "GPU",
      "host": "/dev/dri/",
      "container": "/dev/dri/",
      "description": "GPU",
      "required": false,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
