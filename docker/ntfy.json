{
  "name": "ntfy",
  "repo": "binwiederhier/ntfy:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Network"
  ],
  "registry": "https://hub.docker.com/r/binwiederhier/ntfy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/binwiederhier/ntfy/main/web/public/static/img/ntfy.png",
  "project": "https://ntfy.sh",
  "support": "https://forums.unraid.net/topic/133764-support-grtgbln-docker-templates",
  "description": "Send push notifications to your phone or desktop using PUT/POST",
  "paths": [
    {
      "name": "Config Path",
      "host": null,
      "container": "/etc/ntfy",
      "mode": "rw",
      "description": "Where advanced configuration files are stored",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Cache Path",
      "host": null,
      "container": "/var/cache/ntfy",
      "mode": "rw",
      "description": "Use persistent message cache",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6839",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
