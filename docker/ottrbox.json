{
  "name": "OttrBox",
  "repo": "ghcr.io/aottr/ottrbox:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/aottr/ottrbox",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/aottr/ottrbox/main/docs/static/img/pingvinshare.svg",
  "project": "https://github.com/aottr/ottrbox",
  "support": "https://stonith404.github.io/pingvin-share/introduction",
  "description": "OttrBox is a self-hosted file sharing platform and an alternative for WeTransfer.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/ottrbox/data",
      "container": "/opt/app/backend/data",
      "mode": "rw",
      "description": "Path to store uploaded files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Images Path",
      "host": "/mnt/user/appdata/ottrbox/images",
      "container": "/opt/app/frontend/public/img",
      "mode": "rw",
      "description": "Path to store image files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Behind Reverse Proxy",
      "key": "TRUST_PROXY",
      "value": "false|true",
      "description": "Set to true if running behind a reverse proxy",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
