{
  "name": "Decluttarr",
  "repo": "ghcr.io/manimatter/decluttarr:latest",
  "category": [
    "Downloader",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/manimatter/decluttarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/decluttarr-icon.png",
  "project": "https://github.com/ManiMatter/decluttarr",
  "support": "https://github.com/ManiMatter/decluttarr/issues",
  "description": "A helper tool that works with the *arr-application suite, and automates the clean-up for their download queues, keeping them free of stalled / redundant downloads. It supports Radarr, Sonarr, Readarr, Lidarr, and Whisparr.",
  "requires": "Requires a `config.yaml` file to be mounted at the Config File path before starting the container. See configuration details: https://github.com/ManiMatter/decluttarr#config-file",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/decluttarr/config.yaml",
      "container": "/app/config/config.yaml",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
