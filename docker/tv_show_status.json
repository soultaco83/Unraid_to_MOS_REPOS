{
  "name": "TV Show Status",
  "repo": "netplexflix/tssk:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/netplexflix/tssk",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tssk-icon.png",
  "project": "https://github.com/netplexflix/TV-show-status-for-Kometa",
  "support": "https://github.com/netplexflix/TV-show-status-for-Kometa/issues",
  "description": "TSSK checks your Sonarr for your TV Shows statuses and creates .yml files which can be used by Kometa to create collections and overlays.",
  "requires": "Requires separate Kometa, Sonarr and Plex servers.",
  "paths": [
    {
      "name": "Kometa Config Files",
      "host": null,
      "container": "/app/kometa",
      "mode": "rw",
      "description": "Output directory for generated Kometa YAML files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Config",
      "host": "/mnt/user/appdata/umtk/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Cron Schedule",
      "key": "CRON",
      "value": "0 2 * * *",
      "description": "Cron schedule for running the update (default: daily at 2 AM)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Is Docker",
      "key": "DOCKER",
      "value": "true|false",
      "description": "Indicate app is running in Docker. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
