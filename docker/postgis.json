{
  "name": "PostGIS",
  "repo": "postgis/postgis",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/postgis/postgis/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://postgis.net/images/postgis-logo.png",
  "project": "http://postgis.net/",
  "support": "http://postgis.net/support/",
  "description": "PostGIS is a spatial database extender for PostgreSQL object-relational database. The postgis/postgis image provides tags for running Postgres with PostGIS extensions installed.",
  "paths": [
    {
      "name": "Data directory",
      "host": "/mnt/cache/appdata/postgis",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": "Container Path: /var/lib/postgresql/data",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Database port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "Container Port: 5432",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Password for postgres role",
      "key": "POSTGRES_PASSWORD",
      "value": "postgres",
      "description": "Container Variable: POSTGRES_PASSWORD",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
