{
  "name": "qbittorrent",
  "repo": "lscr.io/linuxserver/qbittorrent",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/qbittorrent",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "readme_url": "https://github.com/linuxserver/docker-qbittorrent#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/qbittorrent-logo.png",
  "project": "https://www.qbittorrent.org/",
  "support": "https://github.com/linuxserver/docker-qbittorrent/issues/new/choose",
  "description": "The Qbittorrent(https://www.qbittorrent.org/) is a bittorrent client programmed in C++ / Qt that uses libtorrent (sometimes called libtorrent-rasterbar) by Arvid Norberg.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Contains all relevant configuration files.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/downloads",
      "host": null,
      "container": "/downloads",
      "mode": "rw",
      "description": "Location of downloads on disk.",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "6881",
      "host": "6881",
      "container": "6881",
      "protocol": "tcp",
      "description": "tcp connection port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "6881",
      "host": "6881",
      "container": "6881",
      "protocol": "udp",
      "description": "udp connection port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "WEBUI_PORT",
      "key": "WEBUI_PORT",
      "value": "8080",
      "description": "for changing the port of the web UI, see below for explanation",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TORRENTING_PORT",
      "key": "TORRENTING_PORT",
      "value": "6881",
      "description": "for changing the port of tcp/udp connection, see below for explanation",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
