{
  "name": "Container Port Manager",
  "repo": "ghcr.io/smashingtags/container-port-manager:nightly",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/smashingtags/container-port-manager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4173]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/container-port-manager-icon.png",
  "project": "https://github.com/smashingtags/container-port-manager",
  "support": "https://github.com/smashingtags/container-port-manager/issues",
  "description": "Container Port Manager",
  "paths": [
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4173",
      "container": "4173",
      "protocol": "tcp",
      "description": "Container Port: 4173",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Node Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Node environment. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
