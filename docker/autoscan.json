{
  "name": "Autoscan",
  "repo": "cloudb0x/autoscan:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/cloudb0x/autoscan",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/autoscan-icon.png",
  "project": "https://github.com/Cloudbox/autoscan",
  "support": "https://github.com/Cloudbox/autoscan/issues",
  "description": "Autoscan replaces the default Plex and Emby behaviour for picking up file changes on the file system. Autoscan integrates with Sonarr, Radarr, Readarr, Lidarr and Google Drive to fetch changes in near real-time without relying on the file system.",
  "requires": "Requires `config.yaml` file to be available in the Config Path before starting the container. See configuration details: https://github.com/Cloudbox/autoscan#full-config-file",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/autoscan/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Webhooks Port",
      "host": "3030",
      "container": "3030",
      "protocol": "tcp",
      "description": "Container Port: 3030",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Verbosity",
      "key": "AUTOSCAN_VERBOSITY",
      "value": "0|1|2",
      "description": "0=Info, 1=Debug, 2=Trace",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
