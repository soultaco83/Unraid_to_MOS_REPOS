{
  "name": "Sunshine",
  "repo": "lizardbyte/sunshine:latest-debian-bookworm",
  "category": [
    "Hosting",
    "Game Server",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/lizardbyte/sunshine",
  "network": "host",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:47990]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/sunshine-icon.png",
  "project": "https://app.lizardbyte.dev/Sunshine/",
  "support": "https://docs.lizardbyte.dev/projects/sunshine/en/latest/index.html",
  "description": "A self-hosted game stream host for Moonlight. You can connect to Sunshine from any Moonlight client on a variety of devices. \r\n        [br]\n        See documentation for further configuration: https://docs.lizardbyte.dev/projects/sunshine/en/latest/about/docker.html",
  "requires": "Explanation of different tags: https://github.com/orgs/LizardByte/discussions/544#discussioncomment-11106837",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/sunshine/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config storage",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Server Port",
      "host": "48010",
      "container": "48010",
      "protocol": "tcp",
      "description": "Server Port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "TCP Ports",
      "host": "47984-47990",
      "container": "47984-47990",
      "protocol": "tcp",
      "description": "TCP ports for client traffic",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "UDP Ports",
      "host": "47998-48000",
      "container": "47998-48000",
      "protocol": "udp",
      "description": "UDP ports for client traffic",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
