{
  "name": "Immich CLI",
  "repo": "ghcr.io/immich-app/immich-cli:latest",
  "category": [
    "Media",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/immich-app/immich-cli",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://immich.app/img/logomark-light.svg",
  "project": "https://immich.app/",
  "support": "https://immich.app/docs/features/command-line-interface/",
  "description": "A CLI tool to upload images to Immich. \r\n        [br]\n        This is a CLI tool.",
  "requires": "This is a CLI tool. Open a Console in the container and run `immich` to use it.",
  "paths": [
    {
      "name": "Import Path",
      "host": null,
      "container": "/import",
      "mode": "ro",
      "description": "Path to folder with items to upload.",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Server URL",
      "key": "IMMICH_INSTANCE_URL",
      "value": "http://immich/api",
      "description": "The URL to the Immich Server API",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Server API Key",
      "key": "IMMICH_API_KEY",
      "value": null,
      "description": "The API key for your Immich server",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
