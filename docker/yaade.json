{
  "name": "Yaade",
  "repo": "esperotech/yaade:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/esperotech/yaade",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9339]/",
  "icon": "https://raw.githubusercontent.com/EsperoTech/yaade/main/assets/YaadeIcon.png",
  "project": "https://github.com/EsperoTech/yaade",
  "support": "https://docs.yaade.io/",
  "description": "An open-source, self-hosted, collaborative API development environment.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/yaade/config",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9339",
      "container": "9339",
      "protocol": "tcp",
      "description": "Container Port: 9339",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Admin Username",
      "key": "YAADE_ADMIN_USERNAME",
      "value": null,
      "description": "Username for admin login",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Base Path",
      "key": "YAADE_BASE_PATH",
      "value": "/",
      "description": "Base path for the application. Useful if behind reverse proxy.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
