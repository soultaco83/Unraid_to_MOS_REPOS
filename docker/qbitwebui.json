{
  "name": "qbitwebui",
  "repo": "ghcr.io/maciejonos/qbitwebui:latest",
  "category": [
    "Downloader",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/maciejonos/qbitwebui",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/qbitwebui-icon.png",
  "project": "https://github.com/Maciejonos/qbitwebui",
  "support": "https://github.com/Maciejonos/qbitwebui/issues",
  "description": "A modern lightweight web interface for qBittorrent.",
  "requires": "Requires a separate qBittorrent instance.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8081",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "qBittorrent URL",
      "key": "QBITTORRENT_URL",
      "value": "http://IP_ADDRESS:8080",
      "description": "The URL of the qBittorrent instance (e.g., http://IP_ADDRESS:8080)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
