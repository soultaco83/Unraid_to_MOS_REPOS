{
  "name": "wol",
  "repo": "ghcr.io/trugamr/wol:latest",
  "category": [
    "Network",
    "Utilities",
    "Misc",
    "Productivity"
  ],
  "registry": "ghcr.io/trugamr/wol",
  "network": "host",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "serve",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7777]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/wol-icon.png",
  "project": "https://github.com/Trugamr/wol",
  "support": "https://github.com/Trugamr/wol/issues",
  "description": "A CLI tool to send Wake-On-LAN (WOL) magic packets to wake up devices on your network. Features both CLI commands and a web interface. \r\n        [br]\n        Requires a config file at the Config File path BEFORE application is started: https://github.com/Trugamr/wol?tab=readme-ov-file#configuration",
  "requires": "Expects a `config.yaml` file at the Config File path BEFORE application is started: https://github.com/Trugamr/wol?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/wol/config.yaml",
      "container": "/etc/wol/config.yaml",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "7777",
      "container": "7777",
      "protocol": "tcp",
      "description": "Container Port: 7777",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
