{
  "name": "UglyFeed",
  "repo": "fabriziosalmi/uglyfeed:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/fabriziosalmi/uglyfeed",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8501]/",
  "icon": "https://raw.githubusercontent.com/fabriziosalmi/UglyFeed/main/docs/UglyFeed.png",
  "project": "https://github.com/fabriziosalmi/UglyFeed",
  "support": "https://github.com/fabriziosalmi/UglyFeed/issues",
  "description": "Retrieve, aggregate, filter, evaluate, rewrite and serve RSS feeds using Large Language Models for fun, research and learning purposes",
  "requires": "Expects a config.yaml file at the Config File path: https://github.com/fabriziosalmi/UglyFeed/blob/main/docs/README.md#-configuration \r\n        [br]\n        Expects a feeds.txt file in the Input Path.",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/cache/appdata/uglyfeed/config.yaml",
      "container": "/app/config.yaml",
      "mode": "rw",
      "description": "Path to config file",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Input Path",
      "host": "/mnt/cache/appdata/uglyfeed/input",
      "container": "/app/input",
      "mode": "rw",
      "description": "Path to input files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Output Path",
      "host": "/mnt/cache/appdata/uglyfeed/output",
      "container": "/app/output",
      "mode": "rw",
      "description": "Path to output files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Rewritten Path",
      "host": "/mnt/cache/appdata/uglyfeed/rewritten",
      "container": "/app/rewritten",
      "mode": "rw",
      "description": "Path to rewritten files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8501",
      "container": "8501",
      "protocol": "tcp",
      "description": "Container Port: 8501",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "API Port",
      "host": "8001",
      "container": "8001",
      "protocol": "tcp",
      "description": "Container Port: 8001",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
