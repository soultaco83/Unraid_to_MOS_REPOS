{
  "name": "kometa (linuxserver)",
  "repo": "lscr.io/linuxserver/kometa",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/kometa",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/linuxserver/docker-kometa#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/kometa-logo.png",
  "project": "https://github.com/Kometa-Team/Kometa",
  "support": "https://github.com/linuxserver/docker-kometa/issues/new/choose",
  "description": "Kometa(https://github.com/Kometa-Team/Kometa) is a powerful tool designed to give you complete control over your media libraries. With Kometa, you can take your customization to the next level, with granular control over metadata, collections, overlays, and much more.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Persistent config files",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "KOMETA_CONFIG",
      "key": "KOMETA_CONFIG",
      "value": "/config/config.yml",
      "description": "Specify a custom config file to use.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "KOMETA_TIMES",
      "key": "KOMETA_TIMES",
      "value": "03:00",
      "description": "Comma-separated list of times to update each day. Format: `HH:MM`.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "KOMETA_RUN",
      "key": "KOMETA_RUN",
      "value": "False",
      "description": "Set to `True` to run without the scheduler.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "KOMETA_TESTS",
      "key": "KOMETA_TESTS",
      "value": "False",
      "description": "Set to `True` to run in debug mode with only collections that have `test: true`.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "KOMETA_NO_MISSING",
      "key": "KOMETA_NO_MISSING",
      "value": "False",
      "description": "Set to `True` to run without any of the missing movie/show functions.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
