{
  "name": "Auto-M4B",
  "repo": "seanap/auto-m4b:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/seanap/auto-m4b",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/auto-m4b-icon.png",
  "project": "https://github.com/seanap/auto-m4b",
  "support": "https://github.com/seanap/auto-m4b/issues",
  "description": "A tool that will watch a folder for new books, auto convert mp3 books to chapterized m4b, and move all m4b books to a specific output folder.",
  "paths": [
    {
      "name": "Temp Path",
      "host": "/mnt/user/appdata/auto-m4b/temp",
      "container": "/temp",
      "mode": "rw",
      "description": "Path to temporary files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/auto-m4b/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Sleep Time",
      "key": "SLEEPTIME",
      "value": "1m",
      "description": "Time to sleep between scans",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Make Backup",
      "key": "MAKE_BACKUP",
      "value": "Y|N",
      "description": "Make a backup of the original mp3 file",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "CPU Cores",
      "key": "CPU_CORES",
      "value": "2",
      "description": "Number of CPU cores to allocate to the container",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
