{
  "name": "Bark Server",
  "repo": "finab/bark-server:latest",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/finab/bark-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://bark.day.app/_media/Icon.png",
  "project": "https://bark.day.app",
  "support": "https://github.com/Finb/bark-server/issues",
  "description": "Backend for Bark, an iOS app to receive custom push notifications",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/bark/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to data files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
