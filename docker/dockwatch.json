{
  "name": "Dockwatch",
  "repo": "ghcr.io/notifiarr/dockwatch:main",
  "category": [
    "Network",
    "Utilities",
    "Productivity",
    "Misc"
  ],
  "registry": "ghcr.io/notifiarr/dockwatch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/dockwatch-icon.png",
  "project": "https://dockwatch.wiki/",
  "support": "https://github.com/Notifiarr/dockwatch/issues",
  "description": "Simple UI driven way to manage updates and notifications for Docker containers.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/dockwatch/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "9999",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
