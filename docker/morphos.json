{
  "name": "Morphos",
  "repo": "ghcr.io/danvergara/morphos-server:latest",
  "category": [
    "Hosting",
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "ghcr.io/danvergara/morphos-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/danvergara/morphos/main/screenshots/morphos.jpg",
  "project": "https://github.com/danvergara/morphos",
  "support": "https://github.com/danvergara/morphos/issues",
  "description": "Self-hosted file converter server",
  "paths": [
    {
      "name": "Temporary data",
      "host": "/tmp",
      "container": "/tmp",
      "mode": "rw",
      "description": "Path to temporary data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
