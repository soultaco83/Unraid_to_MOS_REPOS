{
  "name": "MeepleStats - Frontend",
  "repo": "ghcr.io/tommythehuman/meeplestats/frontend:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/tommythehuman/meeplestats/frontend",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5173]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/meeplestats-icon.png",
  "project": "https://github.com/TommyTheHuman/MeepleStats",
  "support": "https://github.com/TommyTheHuman/MeepleStats/issues",
  "description": "A self-hosted web application designed to track board game statistics for your group of friends! It allows users to log game sessions, analyze player performance, and manage a wishlist of games. \r\n        \r\n        This is the frontend component.",
  "requires": "Requires separate MongoDB and MeepleStats - Backend containers.",
  "paths": [],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5173",
      "container": "5173",
      "protocol": "tcp",
      "description": "Container Port: 5173",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Backend URL",
      "key": "VITE_API_URL",
      "value": "http://IP_ADDRESS:5000",
      "description": "URL of the MeepleStats backend API",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "JWT Storage",
      "key": "VITE_JWT_STORAGE",
      "value": "localstorage|cookie",
      "description": "Storage method for JWT tokens",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Enable RAG",
      "key": "VITE_ENABLE_RAG",
      "value": "True|False",
      "description": "Enable Rulesbooks Chat (RAG) features in the frontend",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Allowed Hosts",
      "key": "VITE_ALLOWED_HOSTS",
      "value": null,
      "description": "Comma-separated list of allowed hosts for CORS",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
