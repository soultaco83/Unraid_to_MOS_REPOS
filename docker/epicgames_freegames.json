{
  "name": "Epic Games Free Games",
  "repo": "ghcr.io/claabs/epicgames-freegames-node:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/claabs/epicgames-freegames-node",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "-m 2g",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/epicgames-freegames-icon.png",
  "project": "https://github.com/claabs/epicgames-freegames-node",
  "support": "https://claabs.github.io/epicgames-freegames-node/index.html",
  "description": "Automatically login and find available free games the Epic Games Store. Sends you a prepopulated checkout link so you can complete the checkout after logging in. Supports multiple accounts, login sessions, and scheduled runs.",
  "requires": "Expects a `config.json` file to be present in the App Data path before starting the container. See configuration details: https://github.com/claabs/epicgames-freegames-node#json-configuration",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/auto-archiver/config",
      "container": "/usr/app/config",
      "mode": "rw",
      "description": "Path to the configuration folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
