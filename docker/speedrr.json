{
  "name": "speedrr",
  "repo": "itschasa/speedrr:latest",
  "category": [
    "Downloader",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/itschasa/speedrr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/itschasa/speedrr/master/images/speedrr.png",
  "project": "https://github.com/itschasa/speedrr",
  "support": "https://github.com/itschasa/speedrr/issues",
  "description": "Dynamically manage speeds on torrent clients, with Plex/Jellyfin/Emby intergration.",
  "requires": "Expects a \"config.yaml\" file in the Config Folder BEFORE the container starts. See documentation: https://github.com/itschasa/speedrr/blob/main/config.yaml",
  "paths": [
    {
      "name": "Config Folder",
      "host": "/mnt/user/appdata/speedrr/config",
      "container": "/data",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Internal Config File",
      "key": "SPEEDRR_CONFIG",
      "value": "/data/config.yaml",
      "description": "Internal path to config file. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Console Log Level",
      "key": "SPEEDRR_LOG_LEVEL",
      "value": "20",
      "description": "Log level in console",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "File Log Level",
      "key": "SPEEDRR_LOG_FILE_LEVEL",
      "value": "20",
      "description": "Log level in file",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
