{
  "name": "Immaculaterr",
  "repo": "ohmzii/immaculaterr:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/ohmzii/immaculaterr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5454]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/immaculaterr-icon.png",
  "project": "https://github.com/ohmzi/Immaculaterr",
  "support": "https://github.com/ohmzi/Immaculaterr/issues",
  "description": "An automation tool for dynamically managing Plex collections. It pins and unpins library collections based on configurable time blocks, ensuring fresh and relevant content is featured.",
  "requires": "Requires a separate Plex instance.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/cache/appdata/immaculaterr/config",
      "container": "/data",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5454",
      "container": "5454",
      "protocol": "tcp",
      "description": "Container Port: 5454",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "App Master Key",
      "key": "APP_MASTER_KEY",
      "value": null,
      "description": "Master key for the application. Generate a secure random key with `openssl rand -base64 32`",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Update Check",
      "key": "UPDATE_CHECK_ENABLED",
      "value": "true|false",
      "description": "Enable or disable update checks.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Update Check Repo",
      "key": "UPDATE_CHECK_REPO",
      "value": null,
      "description": "Repository to check for updates against.",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Trust Proxy",
      "key": "TRUST_PROXY",
      "value": "1|0",
      "description": "Trust proxy",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "DATABASE_URL",
      "value": "file:/data/tcp.sqlite",
      "description": "Internal database path. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Host",
      "key": "HOST",
      "value": "0.0.0.0",
      "description": "Internal host. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "5454",
      "description": "Internal port. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Data Path",
      "key": "APP_DATA_DIR",
      "value": "/data",
      "description": "Internal data path. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
