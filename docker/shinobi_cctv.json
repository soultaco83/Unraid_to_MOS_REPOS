{
  "name": "shinobi-pro-cctv (selfhosters)",
  "repo": "shinobicctv/shinobi:latest",
  "category": [
    "Home Automation"
  ],
  "registry": "https://hub.docker.com/r/shinobicctv/shinobi",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/shinobi.png",
  "project": "https://gitlab.com/Shinobi-Systems/Shinobi",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Shinobi Docker from official Dockerhub repo. Note to use GPU for hardware encoding or Object detection: 1. add `--runtime=nvidia` in Extra Parameters.  2. Add Nvidia GPU Devices variables ID & Driver capabilities in advanced",
  "paths": [
    {
      "name": "Streams",
      "host": "/dev/shm/Shinobi/streams",
      "container": "/dev/shm/Shinobi/streams",
      "mode": "rw",
      "description": "Streams cache",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/shinobi/config",
      "container": "/config",
      "mode": "rw",
      "description": "Shinobi config working directory",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "customAutoLoad",
      "host": "/mnt/cache/appdata/shinobi/customAutoLoad",
      "container": "/home/Shinobi/libs/customAutoLoad",
      "mode": "rw",
      "description": "customAutoLoad elements",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Database",
      "host": "/mnt/cache/appdata/shinobi/database",
      "container": "/var/lib/mysql",
      "mode": "rw",
      "description": "Shinobi Mysql directory",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Videos",
      "host": "/mnt/cache/appdata/shinobi/videos",
      "container": "/home/Shinobi/videos",
      "mode": "rw",
      "description": "Stored Videos location",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Plugins",
      "host": "/mnt/cache/appdata/shinobi/plugins",
      "container": "/home/Shinobi/plugins",
      "mode": "rw",
      "description": "Container Path: /usr/src/app/store",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": "Container Path: /etc/localtime",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Nvidia GPU Devices",
      "key": "NVIDIA_VISIBLE_DEVICES",
      "value": null,
      "description": "GPU ID - Only if using an Nvidia GPU",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Nvidia GPU Capabilities",
      "key": "NVIDIA_DRIVER_CAPABILITIES",
      "value": null,
      "description": "Should be 'all'",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [
    {
      "driver": "nvidia",
      "count": "all",
      "capabilities": [
        "gpu"
      ],
      "description": "NVIDIA GPU pass-through. Requires the NVIDIA driver / container toolkit on the host (Unraid: install the Nvidia-Driver plugin)."
    }
  ],
  "author": "selfhosters"
}
