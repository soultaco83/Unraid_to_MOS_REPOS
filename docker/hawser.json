{
  "name": "Hawser",
  "repo": "ghcr.io/finsys/hawser:latest",
  "category": [
    "Utilities",
    "Misc",
    "Network"
  ],
  "registry": "https://github.com/Finsys/hawser",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://dockhand.pro/manual/#hawser",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/hawser-logo.png",
  "project": "https://dockhand.pro/",
  "support": "https://forums.unraid.net/topic/197006-support-devzwf-hawser/",
  "description": "Remote Docker agent for (https://dockhand.pro) - manage Docker hosts anywhere.\r\nHawser is a lightweight Go agent that enables Dockhand to manage Docker hosts in various network configurations. It supports two operational modes:\r\n\r\n- **Standard Mode**: Agent listens for incoming connections (ideal for LAN/homelab with static IPs)",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker Socket",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Com port",
      "host": "2376",
      "container": "2376",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "TOKEN",
      "key": "TOKEN",
      "value": null,
      "description": "",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
