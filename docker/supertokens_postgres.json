{
  "name": "SuperTokens - PostgreSQL",
  "repo": "registry.supertokens.io/supertokens/supertokens-postgresql:latest",
  "category": [
    "Productivity",
    "Security",
    "Utilities",
    "Misc"
  ],
  "registry": "registry.supertokens.io/supertokens/supertokens-postgresql",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3567]/hello",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/supertokens-icon.png",
  "project": "https://supertokens.com/",
  "support": "https://supertokens.com/docs/deployment/self-hosting/with-docker",
  "description": "Open source alternative to Auth0 / Firebase Auth / AWS Cognito. Add secure login and session management to your apps.  \r\n        [br]\n        Additional options can be added via environmental variables or a mounted config file: https://github.com/supertokens/supertokens-docker-postgresql/blob/master/README.md",
  "requires": "Requires a separate PostgreSQL server: https://supertokens.com/docs/deployment/self-hosting/database-setup/postgresql",
  "paths": [],
  "ports": [
    {
      "name": "API Port",
      "host": "3567",
      "container": "3567",
      "protocol": "tcp",
      "description": "Container Port: 3567",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PostgreSQL Connection URI",
      "key": "POSTGRESQL_CONNECTION_URI",
      "value": "postgresql://username:pass@IP_ADDRESS/dbName",
      "description": "Connection URL for PostgreSQL",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
