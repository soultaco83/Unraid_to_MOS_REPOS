{
  "name": "Kopia (selfhosters)",
  "repo": "kopia/kopia",
  "category": [
    "Backup",
    "Hosting"
  ],
  "registry": "https://hub.docker.com/r/kopia/kopia/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "server start --insecure --htpasswd-file /app/config/htpasswd --address 0.0.0.0:51515 --server-username=YOUR-USERNAME",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:51515]",
  "icon": "https://raw.githubusercontent.com/kopia/kopia/refs/heads/master/app/assets/icon.ico",
  "project": "https://github.com/kopia/kopia/",
  "support": "https://kopia.io/docs/",
  "description": "Kopia is a simple, cross-platform tool for managing encrypted backups in the cloud. It provides fast, incremental backups, secure, client-side end-to-end encryption, compression and data deduplication.\r\n\r\nTo run this container, you must create a htpasswd file (either via command line or using a tool such as https://hostingcanada.org/htpasswd-generator/) and place it in the /mnt/cache/appdata/kopia/config directory, then adjust the Post Arguments accordingly.",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/cache/appdata/kopia/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Container Path: /app/config",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Cache path",
      "host": "/mnt/cache/appdata/kopia/cache",
      "container": "/app/cache",
      "mode": "rw",
      "description": "Container Path: /app/cache",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Log path",
      "host": "/mnt/cache/appdata/kopia/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Container Path: /app/logs",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Data path",
      "host": "/mnt/Array/media/kopia",
      "container": "/app/data",
      "mode": "rw",
      "description": "Enter the Container Path (/app/data) as the Directory Path if creating a Filesystem repository.",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "51515",
      "container": "51515",
      "protocol": "tcp",
      "description": "Container Port: 51515",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Repository password",
      "key": "KOPIA_PASSWORD",
      "value": null,
      "description": "Container Variable: KOPIA_PASSWORD",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "America/Los_Angeles",
      "description": "Container Variable: TZ",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
