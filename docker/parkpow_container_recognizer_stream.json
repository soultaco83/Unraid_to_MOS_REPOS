{
  "name": "ParkPow Shipping Container Recognizer - Stream",
  "repo": "platerecognizer/container-video:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/platerecognizer/container-video",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://app.parkpow.com/static/images/Icon_ParkPow_100x100.jpg",
  "project": "https://platerecognizer.com/",
  "support": "https://guides.platerecognizer.com/docs/other-apps/shipping-container-live/docker-configuration",
  "description": "Read a shipping container number from a live stream, powered by ParkPow.",
  "requires": "Runs offline, but requires a token and license from https://app.platerecognizer.com/products/snapshot-sdk/",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/shipping_container_recognizer/stream",
      "container": "/container-video-data",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "API Token",
      "key": "TOKEN",
      "value": null,
      "description": "API Token for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "License",
      "key": "LICENSE_KEY",
      "value": null,
      "description": "License Key for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
