{
  "name": "SyncFlaer",
  "repo": "ghcr.io/containeroo/syncflaer:latest",
  "category": [
    "Network",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/containeroo/syncflaer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--config-path /config.yml",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/syncflaer-icon.png",
  "project": "https://github.com/containeroo/SyncFlaer",
  "support": "https://github.com/containeroo/SyncFlaer/issues",
  "description": "Synchronize Traefik host rules and/or Kubernetes Ingresses with Cloudflare®.",
  "requires": "Requires a `config.yml` file to be mounted at the Config File path before starting the container. See configuration details: https://github.com/containeroo/SyncFlaer#config-file",
  "paths": [
    {
      "name": "Config File",
      "host": "/mnt/user/appdata/syncflaer/config.yml",
      "container": "/config.yml",
      "mode": "rw",
      "description": "Path to the config file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
