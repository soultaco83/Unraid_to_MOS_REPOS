{
  "name": "Mesh Bot",
  "repo": "ghcr.io/spudgunman/meshing-around:main",
  "category": [
    "AI",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/spudgunman/meshing-around",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8420]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mesh-bot-icon.png",
  "project": "https://github.com/SpudGunMan/meshing-around",
  "support": "https://github.com/SpudGunMan/meshing-around/issues",
  "description": "Mesh Bot is a feature-rich bot designed to enhance your Meshtastic network experience. It provides powerful tools for network testing, messaging, games, and more—all via text-based message delivery. Whether you want to test your mesh, send messages, or play games, Mesh Bot has you covered.",
  "requires": "Requires a separate Ollama instance.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/meshing_around/data",
      "container": "/app",
      "mode": "rw",
      "description": "Path to app data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8420",
      "container": "8420",
      "protocol": "tcp",
      "description": "Container Port: 8420",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Ollama API URL",
      "key": "OLLAMA_API_URL",
      "value": "http://IP_ADDRESS:11434",
      "description": "Ollama API URL",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
