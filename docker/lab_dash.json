{
  "name": "Lab Dash",
  "repo": "ghcr.io/anthonygress/lab-dash:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/anthonygress/lab-dash",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2022]/",
  "icon": "https://raw.githubusercontent.com/AnthonyGress/lab-dash/refs/heads/main/frontend/src/assets/gradient_logo.png",
  "project": "https://github.com/AnthonyGress/lab-dash",
  "support": "https://github.com/AnthonyGress/lab-dash/issues",
  "description": "An open-source user interface designed to manage your server/homelab applications and services.",
  "requires": "optional: use privileged: true and network_mode: host for monitoring network usage stats.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/lab-dash/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Uploads Path",
      "host": "/mnt/user/appdata/lab-dash/uploads",
      "container": "/app/public/uploads",
      "mode": "rw",
      "description": "Path to the uploads folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "System Path",
      "host": "/sys",
      "container": "/sys",
      "mode": "ro",
      "description": "Path to the system folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "2022",
      "container": "2022",
      "protocol": "tcp",
      "description": "Container Port: 2022",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Secret Key",
      "key": "SECRET",
      "value": null,
      "description": "Generate with 'openssl rand -base64 32'",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "99",
      "description": "User ID (Unraid: 99 = nobody)",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "Group ID (Unraid: 100 = users)",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
