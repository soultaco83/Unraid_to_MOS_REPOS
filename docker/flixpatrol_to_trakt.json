{
  "name": "Flixpatrol Top 10 on Trakt",
  "repo": "ghcr.io/navino16/flixpatrol-top10-on-trakt:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/navino16/flixpatrol-top10-on-trakt",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/flixpatrol-to-trakt-icon.png",
  "project": "https://github.com/Navino16/flixpatrol-top10-on-trakt",
  "support": "https://github.com/Navino16/flixpatrol-top10-on-trakt/issues",
  "description": "This tool get TODAY top 10 from flixpatrol and push the result on trakt list (useful for syncing with Kometa)",
  "requires": "Expects a config file in the Config Path. See documentation: https://github.com/Navino16/flixpatrol-top10-on-trakt#configuration-file",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/flixpatrol_to_trakt/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Log Level",
      "key": "LOG_LEVEL",
      "value": "info|err|warn|debug",
      "description": "Log level for the application",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
