{
  "name": "Obsidian LiveSync CouchDB",
  "repo": "oleduc/docker-obsidian-livesync-couchdb:stable",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/oleduc/docker-obsidian-livesync-couchdb",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5984]/",
  "icon": "https://raw.githubusercontent.com/gotanaccount/unraid-templates/refs/heads/master/obsidian-livesync/favicon-96x96.png",
  "project": "https://github.com/oleduc/docker-obsidian-livesync-couchdb",
  "support": "https://leduccc.medium.com/setup-self-hosted-synchronization-for-obsidian-cba121166d5e",
  "description": "A docker container for the CouchDB instance required by obsidian-livesync",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/obsidian_livesync/data",
      "container": "/opt/couchdb/data",
      "mode": "rw",
      "description": "Path to the app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5984",
      "container": "5984",
      "protocol": "tcp",
      "description": "Container Port: 5984",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Server Domain",
      "key": "SERVER_DOMAIN",
      "value": "http://example.com",
      "description": "Domain of the CouchDB server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - User",
      "key": "COUCHDB_USER",
      "value": "user",
      "description": "CouchDB user",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Password",
      "key": "COUCHDB_PASSWORD",
      "value": "password",
      "description": "CouchDB password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Name",
      "key": "COUCHDB_DATABASE",
      "value": "obsidian",
      "description": "CouchDB database name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
