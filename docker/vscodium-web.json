{
  "name": "vscodium-web",
  "repo": "lscr.io/linuxserver/vscodium-web",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/vscodium-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/?tkn=lsio",
  "readme_url": "https://github.com/linuxserver/docker-vscodium-web#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://vscodium.com/",
  "support": "https://github.com/linuxserver/docker-vscodium-web/issues/new/choose",
  "description": "Vscodium-web(https://vscodium.com/) is a community-driven, freely-licensed binary distribution of the remote host web component of Microsoft's editor VS Code.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Contains all relevant configuration files.",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Web UI port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "CONNECTION_TOKEN",
      "key": "CONNECTION_TOKEN",
      "value": null,
      "description": "Optional security token for accessing the Web UI (ie. `supersecrettoken`).",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "CONNECTION_TOKEN_FILE",
      "key": "CONNECTION_TOKEN_FILE",
      "value": null,
      "description": "Optional path to a file inside the container that contains the security token for accessing the Web UI (ie. `/path/to/file`). Overrides `CONNECTION_TOKEN`.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "SUDO_PASSWORD",
      "key": "SUDO_PASSWORD",
      "value": "password",
      "description": "If this optional variable is set, user will have sudo access in the vscodium-web terminal with the specified password.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "SUDO_PASSWORD_HASH",
      "key": "SUDO_PASSWORD_HASH",
      "value": null,
      "description": "Optionally set sudo password via hash (takes priority over `SUDO_PASSWORD` var). Format is `$type$salt$hashed`.",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "CODE_ARGS",
      "key": "CODE_ARGS",
      "value": null,
      "description": "Optionally add cli parameters to vscodium binary.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
