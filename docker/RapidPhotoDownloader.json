{
  "name": "RapidPhotoDownloader",
  "repo": "ghcr.io/ich777/rapidphotodownloader",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/ich777/rapidphotodownloader/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/rapidphotodownloader.png",
  "project": "https://www.damonlynch.net/rapid/",
  "support": "ttps://forums.unraid.net/topic/83786-support-ich777-application-dockers/",
  "description": "This Docker will download and install Rapid Photo Downloader.\r\n\r\nATTENTION: Please be sure to set the right source and destination folder on the server, otherwise the template creates automaticaly two new folders to your shares if not changed ('rpd-source-folder' &amp; 'rpd-destiantion-folder').\r\n\r\nUpdate Notice: Go to the Rapid Photo Downloader homepage (https://www.damonlynch.net/rapid/) and got to the download selection, rightclick on \"Install script\" and select \"Copy Link Location\" then paste the copied link into the \"Download URL\" variable.",
  "donate": "https://www.paypal.me/chips777",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/cache/appdata/rapidphotodownloader/",
      "container": "/rapidphotodownloader",
      "mode": "rw",
      "description": "Container Path: /rapidphotodownloader",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Source Folder",
      "host": "/mnt/user/rpd-source-folder",
      "container": "/media/source",
      "mode": "rw",
      "description": "Container Path: /media/source",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Destinantion Folder",
      "host": "/mnt/user/rpd-destination-folder",
      "container": "/media/destination",
      "mode": "rw",
      "description": "Container Path: /media/destination",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebGUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Force Update",
      "key": "FORCE_UPDATE",
      "value": null,
      "description": "If you want to force an update of the container set the value to 'true' (without quotes) otherwise leave blank.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "99",
      "description": "Container Variable: UID",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "100",
      "description": "Container Variable: GID",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Download URL",
      "key": "DL_URL",
      "value": "https://launchpad.net/rapid/pyqt/0.9.17/+download/install.py",
      "description": "Container Variable: DL_URL",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Screen Width",
      "key": "CUSTOM_RES_W",
      "value": "1024",
      "description": "Minimum screen width 1000 pixels",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Screen Height",
      "key": "CUSTOM_RES_H",
      "value": "881",
      "description": "Minimum screen hight 880 pixels",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
