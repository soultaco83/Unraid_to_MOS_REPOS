{
  "name": "jellyseerr",
  "repo": "fallenbagel/jellyseerr:latest",
  "category": [
    "Downloader",
    "Media"
  ],
  "registry": "https://hub.docker.com/r/fallenbagel/jellyseerr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5055]/",
  "icon": "https://raw.githubusercontent.com/Fallenbagel/jellyseerr/main/public/android-chrome-512x512.png",
  "project": "https://github.com/Fallenbagel/jellyseerr",
  "support": "https://discord.gg/VWAG7rZ",
  "description": "Jellyseerr is a free and open-source software application for managing requests for your media library. It is a fork of Overseerr built to bring support for Jellyfin &amp; Emby media servers!\r\n\r\nTo enable Emby support please add the variable 'JELLYFIN_TYPE=emby' in the template.\r\n\r\nThis project is constantly updating with new features and bug fixes. See the GitHub page for current and developing features!\r\nhttps://github.com/Fallenbagel/jellyseerr/",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "Appdata",
      "host": "/mnt/user/appdata/jellyseerr",
      "container": "/app/config/",
      "mode": "rw",
      "description": "Appdata directory",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Network",
      "host": "5055",
      "container": "5055",
      "protocol": "tcp",
      "description": "WebUI Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Log",
      "key": "LOG_LEVEL",
      "value": "info",
      "description": "Log verbosity.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Emby Support",
      "key": "JELLYFIN_TYPE",
      "value": "emby",
      "description": "Emby users need to fill 'emby' to enable emby support! Enabling emby support will cause problems with Plex and make Jellyfin unavailable.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "99",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "IBRACORP"
}
