{
  "name": "Pirarara AI",
  "repo": "caiquebrito/pirarara-ai:latest",
  "category": [
    "AI",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/caiquebrito/pirarara-ai",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": null,
  "project": "https://github.com/caiquebrito/PirararaAI",
  "support": "https://github.com/caiquebrito/PirararaAI/issues",
  "description": "Pirarara AI is a self-hosted local AI platform — a lightweight alternative to Open WebUI.",
  "requires": "Requires a separate Ollama instance.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/pirarara/db",
      "container": "/data",
      "mode": "rw",
      "description": "Where the SQLite database file is stored",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Workspace",
      "host": "/mnt/user/appdata/pirarara/workspace",
      "container": "/workspace",
      "mode": "rw",
      "description": "Directory where the agent can read/write files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Ollama URL",
      "key": "OLLAMA_URL",
      "value": "http://localhost:11434",
      "description": "URL of your Ollama instance (replace with your Unraid server IP)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Default Model",
      "key": "OLLAMA_DEFAULT_MODEL",
      "value": "qwen2.5-coder:7b-instruct-q4_K_M",
      "description": "Ollama model to use by default",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "Random secret for JWT signing — generate with: openssl rand -hex 32",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Anthropic API Key",
      "key": "ANTHROPIC_API_KEY",
      "value": null,
      "description": "Optional — for Claude models via Anthropic API",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "OpenAI API Key",
      "key": "OPENAI_API_KEY",
      "value": null,
      "description": "Optional — for OpenAI models",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
