{
  "name": "KoInsight",
  "repo": "ghcr.io/georgesg/koinsight:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/georgesg/koinsight",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/GeorgeSG/KoInsight/refs/heads/master/images/logo.svg",
  "project": "https://github.com/GeorgeSG/KoInsight",
  "support": "https://github.com/GeorgeSG/KoInsight/issues",
  "description": "KoInsight brings your KOReader reading stats to life with a clean, web-based dashboard.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/koinsight/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Max Upload Size (MB)",
      "key": "MAX_FILE_SIZE_MB",
      "value": "100",
      "description": "Maximum upload size in megabytes",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
