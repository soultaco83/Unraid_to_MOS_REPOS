{
  "name": "Nominatim",
  "repo": "mediagis/nominatim:4.5",
  "category": [
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/mediagis/nominatim",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://nominatim.openstreetmap.org/ui/theme/logo.png",
  "project": "https://nominatim.org/",
  "support": "https://nominatim.org/release-docs/latest/",
  "description": "A tool to search OpenStreetMap data by name and address (geocoding) and to generate synthetic addresses of OSM points (reverse geocoding). \r\n        [br]\n        See all available configuration options: https://github.com/mediagis/nominatim-docker/blob/master/4.5/README.md#general-parameters",
  "paths": [
    {
      "name": "Data Storage Path",
      "host": "/mnt/cache/appdata/nominatim/data",
      "container": "/var/lib/postgresql/16/main",
      "mode": "rw",
      "description": "Path to store the app data",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PBF File URL",
      "key": "PBF_URL",
      "value": "https://download.geofabrik.de/north-america/us-latest.osm.pbf",
      "description": "URL of the OpenStreetMaps data extract (.pbf file) to import. See https://github.com/mediagis/nominatim-docker/tree/master/4.5#openstreetmap-data-extracts",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Replication URL",
      "key": "REPLICATION_URL",
      "value": "https://download.geofabrik.de/north-america/us-updates/",
      "description": "URL of where to get updates from",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Password",
      "key": "NOMINATIM_PASSWORD",
      "value": null,
      "description": "Password for the nominatim user",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
