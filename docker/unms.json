{
  "name": "unms",
  "repo": "nico640/docker-unms",
  "category": [
    "Network",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/nico640/docker-unms",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:443]",
  "icon": "https://raw.githubusercontent.com/digiblur/unraid-docker-templates/master/images/unms_icon.png",
  "project": null,
  "support": "https://forums.unraid.net/topic/72033-support-digiblurs-docker-template-repository/",
  "description": "This is an all-in-one Alpine Linux based Docker image for running the Ubiquiti Network Management System. This image contains all the components required to run UNMS in a single container and uses the s6-overlay for process management.\r\n\r\nThe container can be accessed via HTTP with port 6080 or HTTPS 6443.  \r\n\r\nUNMS Setup:\r\nAccess the container and walk through the initial setup wizard of adding the username/passwords and devices to be monitored.",
  "paths": [
    {
      "name": "AppData Config Path",
      "host": "/mnt/cache/appdata/unms",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Host Port 1",
      "host": "6080",
      "container": "80",
      "protocol": "tcp",
      "description": "Container Port: 80",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Host Port 2",
      "host": "6443",
      "container": "443",
      "protocol": "tcp",
      "description": "Container Port: 443",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "digiblur"
}
