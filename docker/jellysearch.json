{
  "name": "JellySearch",
  "repo": "domistyle/jellysearch:latest",
  "category": [
    "Media",
    "Utilities",
    "Productivity",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/domistyle/jellysearch",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/jellysearch-icon.png",
  "project": "https://gitlab.com/DomiStyle/jellysearch",
  "support": "https://gitlab.com/DomiStyle/jellysearch",
  "description": "A fast full-text search proxy for Jellyfin. Integrates seamlessly with most Jellyfin clients.",
  "requires": "Requires a separate Meilisearch instance (available as a separate template) \r\n        [br]\n        Requires configuration of reverse proxy: https://gitlab.com/DomiStyle/jellysearch#setting-up-the-reverse-proxy",
  "paths": [
    {
      "name": "Jellyfin Config Path",
      "host": null,
      "container": "/config",
      "mode": "ro",
      "description": "Path to Jellyfin config folder",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Jellyfin URL",
      "key": "JELLYFIN_URL",
      "value": "http://jellyfin:8096",
      "description": "URL to Jellyfin server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Meilisearch URL",
      "key": "MEILI_URL",
      "value": "http://meilisearch:7700",
      "description": "URL to Meilisearch server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Meilisearch Master Key",
      "key": "MEILI_MASTER_KEY",
      "value": null,
      "description": "Meilisearch master key",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Index Cron Schedule",
      "key": "INDEX_CRON",
      "value": "0 0 0/2 ? * * *",
      "description": "Cron schedule for indexing. Pattern: https://www.quartz-scheduler.net/documentation/quartz-3.x/tutorial/crontrigger.html",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Jellyfin Config Directory",
      "key": "JELLYFIN_CONFIG_DIR",
      "value": "/config",
      "description": "Internal Jellyfin config directory. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
