{
  "name": "library-manager (selfhosters)",
  "repo": "ghcr.io/deucebucket/library-manager:latest",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/deucebucket/library-manager/pkgs/container/library-manager",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5757]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/library-manager.png",
  "project": "https://github.com/deucebucket/library-manager",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Library Manager - Audiobook library management with smart metadata matching, series detection, and organization.\n\n  Scans your audiobook library, matches metadata from multiple sources (Audible, OpenLibrary, etc.), detects series order, and helps organize your collection. Features a modern web UI for browsing and managing your audiobooks.\n\n  Key features:\n  - Automatic metadata matching from multiple sources\n  - Series detection and ordering\n  - Smart organization tools\n  - Modern responsive web interface\n  - Docker-first design for easy deployment",
  "paths": [
    {
      "name": "Audiobook Library",
      "host": "/mnt/Array/media/audiobooks",
      "container": "/audiobooks",
      "mode": "rw",
      "description": "Path to your audiobook library (use /audiobooks in settings)",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Data Directory",
      "host": "/mnt/cache/appdata/library-manager",
      "container": "/data",
      "mode": "rw",
      "description": "Configuration and database storage",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5757",
      "container": "5757",
      "protocol": "tcp",
      "description": "Web interface port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "User ID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Group ID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
