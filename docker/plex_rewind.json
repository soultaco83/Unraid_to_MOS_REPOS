{
  "name": "Plex Rewind",
  "repo": "ghcr.io/raunot/plex-rewind:latest",
  "category": [
    "Utilities",
    "Media",
    "Misc"
  ],
  "registry": "https://github.com/raunot/plex-rewind/pkgs/container/plex-rewind",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8383]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/plex-rewind-icon.png",
  "project": "https://github.com/RaunoT/plex-rewind",
  "support": "https://github.com/RaunoT/plex-rewind/issues",
  "description": "Present Plex user statistics and habits in a beautiful and organized manner à la Spotify Wrapped.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/plex_rewind/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to configuration files",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8383",
      "container": "8383",
      "protocol": "tcp",
      "description": "Container Port: 8383",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Site URL",
      "key": "NEXT_PUBLIC_SITE_URL",
      "value": "http://192.168.1.1:8383",
      "description": "IMPORTANT: Change to your server IP address and port, or domain if app is publicly exposed.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Authentication Secret",
      "key": "NEXTAUTH_SECRET",
      "value": null,
      "description": "Required to encrypt authentication JWT token. Run `openssl rand -base64 32` to generate.",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Authentication URL",
      "key": "NEXTAUTH_URL",
      "value": "http://192.168.1.1:8383",
      "description": "IMPORTANT: Change to your server IP address and port, or domain if app is publicly exposed.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "All-Time Start Date",
      "key": "NEXT_PUBLIC_STATISTICS_START_DATE",
      "value": "2018-01-01",
      "description": "Start date for 'all time' option",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
