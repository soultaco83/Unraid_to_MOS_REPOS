{
  "name": "FastAPI-DLS",
  "repo": "collinwebdesigns/fastapi-dls:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/collinwebdesigns/fastapi-dls",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:443]/",
  "icon": "https://git.collinwebdesigns.de/uploads/-/system/project/avatar/106/png-transparent-nvidia-grid-logo-business-nvidia-electronics-text-trademark.png?width=64",
  "project": "https://git.collinwebdesigns.de/oscar.krause/fastapi-dls",
  "support": "https://git.collinwebdesigns.de/oscar.krause/fastapi-dls/-/issues",
  "description": "Minimal Delegated License Service (DLS)",
  "requires": "Generate certificates before starting the container for the first time. See documentation: https://git.collinwebdesigns.de/oscar.krause/fastapi-dls/-/tree/main/#docker",
  "paths": [
    {
      "name": "App Cert",
      "host": "/mnt/cache/appdata/fastapi-dls/cert",
      "container": "/app/cert",
      "mode": "rw",
      "description": "Read the description above to make this folder. You do not need to change the path.",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "App Database",
      "host": "/mnt/cache/appdata/fastapi-dls/data",
      "container": "/app/database",
      "mode": "rw",
      "description": "Read the description above to make this folder. You do not need to change the path.",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "HTTPS Port",
      "host": "4443",
      "container": "443",
      "protocol": "tcp",
      "description": "Same as DLS Port below.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "DLS Port",
      "key": "DSL_PORT",
      "value": "4443",
      "description": "Choose port you want to use. Make sure to change the HTTPS port above to match it.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "DSL IP",
      "key": "DLS_URL",
      "value": "localhost",
      "description": "Put your container's IP (or your host's IP if it's shared).",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "DATABASE",
      "value": "sqlite:////app/database/db.sqlite",
      "description": "Internal path to database. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Debug",
      "key": "DEBUG",
      "value": "true|false",
      "description": "Enable debugging",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Lease Length",
      "key": "LEASE_EXPIRE_DAYS",
      "value": "90",
      "description": "Lease length, in days. Max 90 days.",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
