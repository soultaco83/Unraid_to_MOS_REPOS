{
  "name": "Ghost",
  "repo": "ghost:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/_/ghost/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2368]/",
  "icon": "https://raw.githubusercontent.com/docker-library/docs/refs/heads/master/ghost/logo.png",
  "project": "https://ghost.org/",
  "support": "https://ghost.org/docs/config/",
  "description": "Ghost is an open-source software that lets you create your website with a blog.",
  "requires": "Requires a separate MySQL database. \r\n        [br]\n        May require additional configuration after initial setup. See documentation: https://ghost.org/docs/config/#configuration-options",
  "paths": [
    {
      "name": "Content Storage Path",
      "host": "/mnt/user/appdata/ghost/content",
      "container": "/var/lib/ghost/content",
      "mode": "rw",
      "description": "Path to the content storage directory",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "2368",
      "container": "2368",
      "protocol": "tcp",
      "description": "Container Port: 2368",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "URL",
      "key": "url",
      "value": "http://localhost:2368",
      "description": "The URL of your Ghost instance",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Host",
      "key": "database__connection__host",
      "value": null,
      "description": "Database host",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Port",
      "key": "database__connection__port",
      "value": "3306",
      "description": "Database port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - User",
      "key": "database__connection__user",
      "value": null,
      "description": "Database user",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Password",
      "key": "database__connection__password",
      "value": null,
      "description": "Database password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database - Name",
      "key": "database__connection__database",
      "value": null,
      "description": "Database name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Environment",
      "key": "NODE_ENV",
      "value": "production|development",
      "description": "Environment to run Ghost in",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Database - Client",
      "key": "database__client",
      "value": "mysql",
      "description": "Database client to use (e.g., mysql, sqlite3)",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
