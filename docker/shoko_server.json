{
  "name": "Shoko",
  "repo": "ghcr.io/shokoanime/server:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/shokoanime/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8111]/",
  "icon": "https://docs.shokoanime.com/images/logo.svg",
  "project": "https://shokoanime.com/",
  "support": "https://docs.shokoanime.com/",
  "description": "An open-source, cross-platform anime collection management system to automate and organize your collection so you can spend more time watching.",
  "paths": [
    {
      "name": "Anime Files",
      "host": null,
      "container": "/mnt/anime",
      "mode": "rw",
      "description": "Path to your anime files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Config Data",
      "host": "/mnt/user/appdata/shoko/config",
      "container": "/home/shoko/.shoko",
      "mode": "rw",
      "description": "Path to the config folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8111",
      "container": "8111",
      "protocol": "tcp",
      "description": "Container Port: 8111",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
