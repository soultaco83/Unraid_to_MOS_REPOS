{
  "name": "ParkPow Plate Recognizer - Snapshot - GPU",
  "repo": "platerecognizer/alpr-gpu:latest",
  "category": [
    "AI",
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/platerecognizer/alpr-gpu",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--gpus all",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://app.parkpow.com/static/images/Icon_ParkPow_100x100.jpg",
  "project": "https://platerecognizer.com/",
  "support": "https://guides.platerecognizer.com/docs/snapshot/manual-install",
  "description": "Read a license plate from a vehicle picture, powered by ParkPow. With Nvidia GPU support.",
  "requires": "Runs offline, but requires a token and license from https://app.platerecognizer.com/products/snapshot-sdk/",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/plate_recognizer/snapshot",
      "container": "/license",
      "mode": "rw",
      "description": "Path to app data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "API Token",
      "key": "TOKEN",
      "value": null,
      "description": "API Token for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "License",
      "key": "LICENSE_KEY",
      "value": null,
      "description": "License Key for Plate Recognizer: https://app.platerecognizer.com/products/snapshot-sdk/",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
