{
  "name": "Profilarr",
  "repo": "santiagosayshey/profilarr:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/santiagosayshey/profilarr",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6868]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/profilarr-icon.png",
  "project": "https://github.com/Dictionarry-Hub/profilarr",
  "support": "https://dictionarry.dev/wiki/profilarr-setup",
  "description": "A custom format / quality profile management tool that acts as a middleman between a configuration database and your Radarr/Sonarr installations",
  "paths": [
    {
      "name": "Config path",
      "host": "/mnt/user/appdata/profilarr/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "6868",
      "container": "6868",
      "protocol": "tcp",
      "description": "Container Port: 6868",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
