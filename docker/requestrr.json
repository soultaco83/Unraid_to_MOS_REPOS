{
  "name": "requestrr (selfhosters)",
  "repo": "thomst08/requestrr:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/thomst08/requestrr/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4545]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/requestrr.png",
  "project": "https://github.com/thomst08/requestrr",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Requestrr is a chatbot used to simplify using services like Sonarr/Radarr/Ombi via the use of chat. Current platform is Discord only, but the bot was built around the ideology of quick adaptation for new features as well as new platforms. [/b] AppSupport: https://discord.gg/atjrUen5fJ",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/requestrr",
      "container": "/root/config/",
      "mode": "rw",
      "description": "Container Path: /root/config/",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "4545",
      "container": "4545",
      "protocol": "tcp",
      "description": "Container Port: 4545",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
