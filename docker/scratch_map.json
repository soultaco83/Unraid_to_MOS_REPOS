{
  "name": "Scratch Map",
  "repo": "ad3m3r5/scratch-map:latest",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/ad3m3r5/scratch-map",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/scratch-map-icon.jpg",
  "project": "https://github.com/ad3m3r5/scratch-map",
  "support": "https://github.com/ad3m3r5/scratch-map/issues",
  "description": "An open-source scratch-off style map to track your travels.",
  "paths": [
    {
      "name": "Database Path",
      "host": "/mnt/cache/appdata/scratch_map/database",
      "container": "/data",
      "mode": "rw",
      "description": "Path to database files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Internal Web Port",
      "key": "PORT",
      "value": "8080",
      "description": "Internal web port. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "DBLOCATION",
      "value": "/data",
      "description": "Internal database path. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
