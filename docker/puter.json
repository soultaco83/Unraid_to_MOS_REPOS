{
  "name": "Puter",
  "repo": "ghcr.io/heyputer/puter:latest",
  "category": [
    "Hosting",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/heyputer/puter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4100]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/puter-icon.png",
  "project": "https://puter.com",
  "support": "https://docs.puter.com/",
  "description": "An advanced, open-source internet operating system designed to be feature-rich, exceptionally fast, and highly extensible.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/puter/config",
      "container": "/etc/puter",
      "mode": "rw",
      "description": "Config path",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/puter/data",
      "container": "/var/puter",
      "mode": "rw",
      "description": "Data path",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4100",
      "container": "4100",
      "protocol": "tcp",
      "description": "Container Port: 4100",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
