{
  "name": "defguard - Gateway",
  "repo": "ghcr.io/defguard/gateway:latest",
  "category": [
    "Network",
    "Security",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/defguard/gateway",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--cap-add=NET_ADMIN",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/defguard-icon.png",
  "project": "https://defguard.net/",
  "support": "https://docs.defguard.net/",
  "description": "defguard is a true Zero-Trust WireGuard® VPN with 2FA/Multi-Factor Authentication, as each connection requires MFA (and not only when logging in into the client application like other solutions). \r\n        [br]\n        This is the gateway component of defguard.",
  "requires": "Requires a defguard - Core container to be running.",
  "paths": [],
  "ports": [
    {
      "name": "WireGuard Port",
      "host": "50051",
      "container": "50051",
      "protocol": "udp",
      "description": "Container Port: 50051",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "defguard Core gRPC URL",
      "key": "DEFGUARD_GRPC_URL",
      "value": "http://IP_ADDRESS:50055",
      "description": "gRPC URL of defguard Core instance",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "defguard Token",
      "key": "DEFGUARD_TOKEN",
      "value": null,
      "description": "Token received on defguard after completing network wizard",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Stats Period",
      "key": "DEFGUARD_STATS_PERIOD",
      "value": "60",
      "description": "How often, in seconds, to send interface statistics to the defguard server",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Log Level",
      "key": "RUST_LOG",
      "value": "info|debug",
      "description": "Log level",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
