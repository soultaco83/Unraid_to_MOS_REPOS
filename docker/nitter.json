{
  "name": "Nitter",
  "repo": "zedeus/nitter:latest",
  "category": [
    "Hosting",
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/zedeus/nitter",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--cap-drop ALL",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/nitter-icon.png",
  "project": "https://nitter.net",
  "support": "https://github.com/zedeus/nitter/issues",
  "description": "A free and open source alternative Twitter front-end focused on privacy and performance.",
  "requires": "Requires a separate Redis server. See documentation: https://github.com/zedeus/nitter?tab=readme-ov-file#docker \r\n        [br]\n        Requires a config file to be mounted at the Nitter Configuration path: https://github.com/zedeus/nitter/blob/master/nitter.example.conf",
  "paths": [
    {
      "name": "Nitter Configuration",
      "host": null,
      "container": "/src/nitter.conf",
      "mode": "ro",
      "description": "Path to Nitter configuration file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
