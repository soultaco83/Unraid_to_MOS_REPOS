{
  "name": "Nutify",
  "repo": "dartsteven/nutify:amd64-latest",
  "category": [
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/dartsteven/nutify",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--cap-add=SYS_ADMIN --cap-add=SYS_RAWIO --cap-add=MKNOD --device-cgroup-rule='c 189:* rwm' --restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5050]",
  "readme_url": "https://github.com/DartSteven/Nutify/wiki",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/nutify-logo.png",
  "project": "https://github.com/DartSteven/Nutify",
  "support": "https://forums.unraid.net/topic/197147-support-devzwf-nutify/",
  "description": "Nutify is a comprehensive monitoring system designed to track the health and performance of your Uninterruptible Power Supply (UPS) devices. It provides real-time insights into critical UPS metrics, allowing you to ensure the continuous operation and protection of your valuable equipment. Nutify collects data, generates detailed reports, and visualizes key parameters through interactive charts, all accessible via a user-friendly web interface.\r\n\r\n**** WARNING ****\r\nthis is a priviledge container\r\nto grants extended privileges to the container for hardware access\r\nif you dont need to use the usb , you can run it unpriledge",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Dev Directory",
      "host": "/dev",
      "container": "/dev",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Logs Directory",
      "host": "/mnt/user/appdata/nutify/logs",
      "container": "/app/nutify/logs",
      "mode": "rw",
      "description": "Logs directory",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Instance directory",
      "host": "/mnt/user/appdata/nutify/instance",
      "container": "/app/nutify/instance",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "SSL directory",
      "host": "/mnt/user/appdata/nutify/ssl",
      "container": "/app/ssl",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Nut Config directory",
      "host": "/mnt/user/appdata/nutify/etc/nut",
      "container": "/etc/nut",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "UDEV",
      "host": "/run/udev",
      "container": "/run/udev",
      "mode": "ro",
      "description": "",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Dev Directory",
      "host": "/dev",
      "container": "/dev",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "HTTPS port",
      "host": "9443",
      "container": "443",
      "protocol": "tcp",
      "description": "HTTPS port (when SSL_ENABLED=true)",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WEB UI",
      "host": "5050",
      "container": "5050",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "NUT server port",
      "host": "3493",
      "container": "3493",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "UDEV",
      "key": "UDEV",
      "value": "1",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Secret Key",
      "key": "SECRET_KEY",
      "value": null,
      "description": "for password encryption and decryption in the database",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [
    {
      "name": "USB",
      "host": "/dev/bus/usb",
      "container": "/dev/bus/usb",
      "description": "",
      "required": true,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": [],
  "author": "devzwf"
}
