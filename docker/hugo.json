{
  "name": "Hugo",
  "repo": "klakegg/hugo:latest",
  "category": [
    "Network",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/klakegg/hugo",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "server",
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1313]",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/hugo-icon.png",
  "project": "https://gohugo.io/",
  "support": "https://github.com/klakegg/docker-hugo/issues",
  "description": "Run a Hugo open-source static site generator.",
  "requires": "This container expects Hugo configuration files to be present in the \"Site Content\" path; otherwise, the container will not start. See documentation: https://gohugo.io/getting-started/configuration/",
  "paths": [
    {
      "name": "Site Content",
      "host": "/mnt/cache/appdata/hugo/site",
      "container": "/src",
      "mode": "rw",
      "description": "Site content to be served by Hugo",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "1313",
      "container": "1313",
      "protocol": "tcp",
      "description": "Container Port: 1313",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
