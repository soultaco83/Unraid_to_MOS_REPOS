{
  "name": "fossflow (selfhosters)",
  "repo": "stnsmith/fossflow",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/stnsmith/fossflow/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:80]",
  "icon": null,
  "project": "https://github.com/stan-smith/FossFLOW",
  "support": "https://github.com/stan-smith/FossFLOW/issues",
  "description": "FossFLOW is a powerful, open-source Progressive Web App (PWA) for creating beautiful isometric diagrams. Built with React and the Isoflow (Now forked and published to NPM as fossflow) library, it runs entirely in your browser with offline support.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/cache/appdata/fossflow",
      "container": "/data/diagrams",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "80",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "ENABLE_SERVER_STORAGE",
      "key": "ENABLE_SERVER_STORAGE",
      "value": "true|false",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
