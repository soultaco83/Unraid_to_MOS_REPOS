{
  "name": "Nginx",
  "repo": "linuxserver/nginx:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/linuxserver/nginx/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1511]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Nginx_E.png",
  "project": "https://www.nginx.com/",
  "support": "https://forums.unraid.net/topic/42784-support-linuxserverio-nginx/",
  "description": "Nginx is a web server with a strong focus on high concurrency, performance and low memory usage. It can also act as a reverse proxy server for HTTP, HTTPS, SMTP, POP3, and IMAP protocols, as well as a load balancer and an HTTP cache.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/Nginx/www/",
      "container": "/config",
      "mode": "rw",
      "description": "Data Path",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Default Web Port",
      "host": "1511",
      "container": "80",
      "protocol": "tcp",
      "description": "Default Web Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Default Web SSL Port",
      "host": "1513",
      "container": "443",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Web Port 1",
      "host": "1512",
      "container": "1512",
      "protocol": "tcp",
      "description": "Custom Web Port 1",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Web Port 2",
      "host": "1515",
      "container": "1515",
      "protocol": "tcp",
      "description": "Custom Web Port 2",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Web Port 3",
      "host": "1516",
      "container": "1516",
      "protocol": "tcp",
      "description": "Custom Web Port 3",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Web Port 4",
      "host": "1518",
      "container": "1518",
      "protocol": "tcp",
      "description": "Custom Web Port 4",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Web Port 5",
      "host": "1519",
      "container": "1519",
      "protocol": "tcp",
      "description": "Custom Web Port 5",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Web Port 6",
      "host": "1520",
      "container": "1520",
      "protocol": "tcp",
      "description": "Custom Web Port 6",
      "required": false,
