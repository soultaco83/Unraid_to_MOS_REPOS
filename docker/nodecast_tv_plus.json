{
  "name": "NodeCast TV Plus",
  "repo": "ghcr.io/mikaelkw/nodecast-tv-plus:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/mikaelkw/nodecast-tv-plus.",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/nodecast-tv-icon.png",
  "project": "https://github.com/MikaelKW/nodecast-tv-plus",
  "support": "https://github.com/MikaelKW/nodecast-tv-plus/issues",
  "description": "A modern, web-based IPTV player featuring Live TV, EPG, Movies (VOD), and Series support. An enhanced fork of NodeCast TV.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/nodecast_tv_plus/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the app data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "JWT Secret",
      "key": "JWT_SECRET",
      "value": null,
      "description": "JWT secret, at least 32 random characters",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Session Secret",
      "key": "SESSION_SECRET",
      "value": null,
      "description": "Session secret, at least 32 random characters",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
