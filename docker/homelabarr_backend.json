{
  "name": "Homelabarr - Backend",
  "repo": "smashingtags/homelabarr-backend:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/smashingtags/homelabarr-backend",
  "network": "homelabarr",
  "custom_ip": null,
  "default_shell": null,
  "privileged": true,
  "extra_parameters": "--group-add 999",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/homelabarr-icon.png",
  "project": "https://demo.homelabarr.com/",
  "support": "https://homelabarr.com",
  "description": "A beautiful, modern web interface for managing your home lab Docker containers. Homelabarr makes it easy to deploy and manage self-hosted applications with just a few clicks. \r\n        [br]\n        This is the backend component of the Homelabarr stack. It is designed to be used in conjunction with the Homelabarr frontend.",
  "requires": "Requires a separate Homelabarr frontend container.",
  "paths": [
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Container Port: 3001",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Node Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Node environment. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "CORS Origin",
      "key": "CORS_ORIGIN",
      "value": "*",
      "description": "CORS origin.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal API Port",
      "key": "PORT",
      "value": "3001",
      "description": "Internal API port. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Docker Socket Path",
      "key": "DOCKER_SOCKET",
      "value": "/var/run/docker.sock",
      "description": "Path to the internal Docker socket. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
