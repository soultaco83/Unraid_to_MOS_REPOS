{
  "name": "Musikat",
  "repo": "ghcr.io/soggy8/musikat:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/soggy8/musikat",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/music-downloader-icon.png",
  "project": "https://github.com/soggy8/musikat",
  "support": "https://github.com/soggy8/musikat/issues",
  "description": "A modern web application that allows users to search for songs on Spotify and automatically download them from YouTube, then seamlessly add them to your Navidrome music server. Perfect for building your personal music library with proper metadata, album art, and organized file structure.",
  "requires": "Requires a `config.json` file to be mounted at `/app/config.json` before starting the container. See configuration details: https://github.com/soggy8/music-downloader/blob/main/config.json \r\n        [br]\n        Requires a number of JSON files to be created on the host system BEFORE the container is started. These files can be created with the `touch` command.",
  "paths": [
    {
      "name": "Navidrome Music Path",
      "host": null,
      "container": "/music",
      "mode": "rw",
      "description": "Path to your Navidrome music folder",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Temp Downloads Path",
      "host": "/mnt/user/appdata/music-downloader/downloads",
      "container": "/app/downloads",
      "mode": "rw",
      "description": "Path to temporary downloads folder",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "YouTube Cookies Path",
      "host": "/mnt/user/appdata/music-downloader/youtube_cookies.txt",
      "container": "/app/youtube_cookies.txt",
      "mode": "ro",
      "description": "Path to your YouTube cookies file",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Navidrome - URL",
      "key": "NAVIDROME_API_URL",
      "value": "http://IP_ADDRESS:4533",
      "description": "URL to your Navidrome server",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Navidrome - Admin Username",
      "key": "NAVIDROME_USERNAME",
      "value": null,
      "description": "Your Navidrome admin username",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Navidrome - Admin Password",
      "key": "NAVIDROME_PASSWORD",
      "value": null,
      "description": "Your Navidrome admin password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Navidrome - Enable Sync",
      "key": "NAVIDROME_SYNC_ENABLED",
      "value": "false|true",
      "description": "Periodically scan Navidrome path and mark matching catalog tracks as downloaded",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Spotify - Client ID",
      "key": "SPOTIFY_CLIENT_ID",
      "value": null,
      "description": "Your Spotify Client ID",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Spotify - Client Secret",
      "key": "SPOTIFY_CLIENT_SECRET",
      "value": null,
      "description": "Your Spotify Client Secret",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Spotify - Redirect URI",
      "key": "SPOTIFY_REDIRECT_URI",
      "value": "http://localhost:8000/callback",
      "description": "Your Spotify Redirect URI",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Music Format",
      "key": "OUTPUT_FORMAT",
      "value": "mp3",
      "description": "Desired music format for downloads",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Music Quality",
      "key": "AUDIO_QUALITY",
      "value": "128",
      "description": "Desired audio quality in kbps",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Navidrome - Sync Interval (Hours)",
      "key": "NAVIDROME_SYNC_INTERVAL_HOURS",
      "value": "4",
      "description": "Interval in hours for syncing with Navidrome",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Navidrome - Sync Initial Delay (Seconds)",
      "key": "NAVIDROME_SYNC_INITIAL_DELAY_SEC",
      "value": "120",
      "description": "Initial delay in seconds before first sync with Navidrome",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Navidrome - Sync API Delay (Seconds)",
      "key": "NAVIDROME_SYNC_API_DELAY_SEC",
      "value": "0.12",
      "description": "Delay in seconds between API calls during Navidrome sync",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Host",
      "key": "API_HOST",
      "value": "0.0.0.0",
      "description": "Internal host for the web server. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "API_PORT",
      "value": "8000",
      "description": "Internal port for the web server. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Music Path",
      "key": "NAVIDROME_MUSIC_PATH",
      "value": "/music",
      "description": "Internal path to your Navidrome music folder. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal YouTube Cookies Path",
      "key": "YOUTUBE_COOKIES_PATH",
      "value": "/app/youtube_cookies.txt",
      "description": "Internal path to your YouTube cookies file. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "CORS Origins",
      "key": "CORS_ORIGINS",
      "value": "http://localhost:3000,http://127.0.0.1:3000",
      "description": "Comma-separated list of allowed CORS origins",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
