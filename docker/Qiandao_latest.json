{
  "name": "Qiandao",
  "repo": "asdaragon/qiandao:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/asdaragon/qiandao",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3111]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Qiandao_A.png",
  "project": "https://github.com/qd-today/qd",
  "support": "https://qd-today.github.io/qd",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Qiandao",
      "container": "/usr/src/app/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "3111",
      "container": "80",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "MAIL SMTP Address",
      "key": "MAIL_SMTP",
      "value": "smtp.163.com",
      "description": "MAIL SMTP Address",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MAIL PORT",
      "key": "MAIL_PORT",
      "value": "25",
      "description": "MAIL PORT",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MAIL USER",
      "key": "MAIL_USER",
      "value": "MAIL USER",
      "description": "MAIL USER",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "MAIL PASSWORD",
      "key": "MAIL_PASSWORD",
      "value": "MAIL PASSWORD",
      "description": "MAIL PASSWORD",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "ACCESS DOMAIN",
      "key": "DOMAIN",
      "value": "163.com",
      "description": "ACCESS DOMAIN",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
