{
  "name": "librewolf",
  "repo": "lscr.io/linuxserver/librewolf",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/librewolf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--shm-size=1gb",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "https://[IP]:[PORT:3001]",
  "readme_url": "https://github.com/linuxserver/docker-librewolf#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/librewolf-logo.png",
  "project": "https://librewolf.net/",
  "support": "https://github.com/linuxserver/docker-librewolf/issues/new/choose",
  "description": "LibreWolf(https://librewolf.net/) is a custom and independent version of Firefox, with the primary goals of privacy, security and user freedom. LibreWolf also aims to remove all the telemetry, data collection and annoyances, as well as disabling anti-freedom features like DRM.",
  "donate": "https://www.linuxserver.io/donate",
  "requires": "This image is unprotected by default __**do not**__ expose it to the internet.\n        Please read https://github.com/linuxserver/docker-librewolf#security for more information.",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Users home directory in the container, stores local files and settings",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "LibreWolf desktop gui HTTP, must be proxied.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "3001",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "LibreWolf desktop gui HTTPS.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "LIBREWOLF_CLI",
      "key": "LIBREWOLF_CLI",
      "value": "https://www.linuxserver.io/",
      "description": "Specify one or multiple LibreWolf CLI flags, this string will be passed to the application in full.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
