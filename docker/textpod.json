{
  "name": "Textpod",
  "repo": "freetonik/textpod:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/freetonik/textpod",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/textpod-icon.png",
  "project": "https://github.com/freetonik/textpod",
  "support": "https://github.com/freetonik/textpod/issues",
  "description": "Local, web-based note-taking app inspired by \"One Big Text File\" idea.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/textpod/data",
      "container": "/app",
      "mode": "rw",
      "description": "Data path",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
