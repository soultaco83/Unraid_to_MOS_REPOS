{
  "name": "Reubah",
  "repo": "ghcr.io/dendianugerah/reubah:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/dendianugerah/reubah",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8081]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/reubah-icon.png",
  "project": "https://github.com/dendianugerah/reubah",
  "support": "https://github.com/dendianugerah/reubah/issues",
  "description": "A simple web-based tool for processing images and converting documents with a simple interface.",
  "paths": [
    {
      "name": "Temp Directory",
      "host": "/mnt/user/appdata/reubah/tmp",
      "container": "/app/tmp",
      "mode": "rw",
      "description": "Path to temporary files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Doc Temp Directory",
      "host": "/mnt/user/appdata/reubah/doc_tmp",
      "container": "/tmp",
      "mode": "rw",
      "description": "Path to temporary files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "8081",
      "description": "Internal Port",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
