{
  "name": "cal.com",
  "repo": "calcom/cal.com:latest",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/calcom/cal.com",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
