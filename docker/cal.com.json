  "support": "https://github.com/calcom/docker/issues",
  "description": "The open source Calendly alternative. You are in charge of your own data, workflow and appearance.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/user/appdata/cal.com/",
      "container": "/cal",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
