{
  "name": "BitPlay",
  "repo": "ghcr.io/aculix/bitplay:main",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/aculix/bitplay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3347]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/bitplay-icon.png",
  "project": "https://bitplay.to/",
  "support": "https://github.com/aculix/bitplay/issues",
  "description": "BitPlay is a web application built with Go that allows you to stream video content directly from torrents in your browser. It features a clean web UI, support for SOCKS5 proxies, and integration with Prowlarr and Jackett for seamless torrent searching.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/bitplay/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3347",
      "container": "3347",
      "protocol": "tcp",
      "description": "Container Port: 3347",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
