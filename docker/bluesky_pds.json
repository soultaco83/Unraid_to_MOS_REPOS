{
  "name": "Bluesky PDS",
  "repo": "gravityfargo/bluesky-pds:v0.4.107",
  "category": [
    "Hosting",
    "Media",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/gravityfargo/bluesky-pds",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--hostname example.com --add-host example.com:0.0.0.0",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/bluesky-icon.png",
  "project": "https://atproto.com/guides/self-hosting",
  "support": "https://docs.modernleft.org/Docker-Images/bluesky-pds",
  "description": "A Bluesky PDS (Personal Data Server) allows you to run your own server that is capable of federating with the wider Bluesky social network.",
  "requires": "This image does not have a static `latest` tag. You will need to update the image tag manually to update.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/bluesky_pds/data",
      "container": "/pds",
      "mode": "rw",
      "description": "Path to store data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "Container Port: 3000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "JWT Secret",
      "key": "PDS_JWT_SECRET",
      "value": null,
      "description": "Secret key for JWT tokens. Run 'openssl rand --hex 16'",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin Password",
      "key": "PDS_ADMIN_PASSWORD",
      "value": null,
      "description": "Password for the admin user",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PLC Rotation Key",
      "key": "PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX",
      "value": null,
      "description": "Private key for PLC rotation. Run 'openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32'",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Domain Name",
      "key": "PDS_HOSTNAME",
      "value": "example.com",
      "description": "Domain name for the PDS. Edit Extra Params accordingly (via Advanced View)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Email - SMTP URL",
      "key": "PDS_EMAIL_SMTP_URL",
      "value": "smtps://resend:API_KEY_HERE@smtp.resend.com:465/",
      "description": "SMTP URL for sending emails",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Email - From Address",
      "key": "PDS_EMAIL_FROM_ADDRESS",
      "value": "admin@example.com",
      "description": "Email address to send emails from",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "1000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "1001",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
