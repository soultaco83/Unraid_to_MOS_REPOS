{
  "name": "Mousehole",
  "repo": "tmmrtn/mousehole:latest",
  "category": [
    "Downloader",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/tmmrtn/mousehole",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:5010]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/mousehole-icon.png",
  "project": "https://github.com/t-mart/mousehole",
  "support": "https://github.com/t-mart/mousehole/issues",
  "description": "A background service to update a seedbox IP for MAM and an HTTP server to manage it.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/mousehole/data",
      "container": "/var/lib/mousehole",
      "mode": "rw",
      "description": "Path to the data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "5010",
      "container": "5010",
      "protocol": "tcp",
      "description": "Container Port: 5010",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Auth Password",
      "key": "MOUSEHOLE_AUTH_PASSWORD",
      "value": null,
      "description": "Password for Mousehole web UI, API, and WebSocket authentication",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Allowed Hosts",
      "key": "MOUSEHOLE_ALLOWED_HOSTS",
      "value": null,
      "description": "Comma-separated hostnames or IP addresses allowed to access Mousehole, such as your Unraid server IP or hostname. Set this when opening the WebUI through http://[IP]:5010.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
