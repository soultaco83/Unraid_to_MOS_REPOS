{
  "name": "Onedev",
  "repo": "1dev/server",
  "category": [
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/1dev/server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart always",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6610]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/onedev-logo.png",
  "project": "https://code.onedev.io/projects/160",
  "support": "https://forums.unraid.net/topic/130848-support-devzwf-onedev",
  "description": "OneDev is an all-in-one DevOps platform that features Git repository management with language-aware code search, issue management with custom states and fields, and a docker-first Kubernetes native build/CI engine. An alternative to GitLab, it is easier to use and maintain, with lots of unique features\r\n\r\nOneDev by default uses an embedded database to store data. You may use environment variables  to connect to external database if desired.\r\nSee Documentation\r\nhttps://code.onedev.io/projects/162/files",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Data Dir",
      "host": null,
      "container": "/opt/onedev",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Docker Sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "6610",
      "container": "6610",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "SSH Port",
      "host": "6611",
      "container": "6611",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
