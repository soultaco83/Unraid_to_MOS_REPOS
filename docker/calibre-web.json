{
  "name": "calibre-web (linuxserver)",
  "repo": "lscr.io/linuxserver/calibre-web",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/calibre-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8083]",
  "readme_url": "https://github.com/linuxserver/docker-calibre-web#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/calibre-web-logo.png",
  "project": "https://github.com/janeczku/calibre-web",
  "support": "https://github.com/linuxserver/docker-calibre-web/issues/new/choose",
  "description": "Calibre-web(https://github.com/janeczku/calibre-web) is a web app providing a clean interface for browsing, reading and downloading eBooks using an existing Calibre database.   It is also possible to integrate google drive and edit metadata and your calibre library through the app itself.\n\nThis software is a fork of library and licensed under the GPL v3 License.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "Where calibre-web stores the internal database and config.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/books",
      "host": null,
      "container": "/books",
      "mode": "rw",
      "description": "Where your preexisting calibre database is located.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8083",
      "container": "8083",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "DOCKER_MODS",
      "key": "DOCKER_MODS",
      "value": "linuxserver/mods:universal-calibre",
      "description": "#optional and **x86-64 only** Adds the ability to perform ebook conversion",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "OAUTHLIB_RELAX_TOKEN_SCOPE",
      "key": "OAUTHLIB_RELAX_TOKEN_SCOPE",
      "value": "1",
      "description": "Optionally set this to allow Google OAUTH to work",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
