{
  "name": "Plex Randomizer",
  "repo": "pierredurrr/plex-randomizer:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/pierredurrr/plex-randomizer",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/plex-randomizer-icon.png",
  "project": "https://github.com/PierreDurrr/plex-randomizer",
  "support": "https://github.com/PierreDurrr/plex-randomizer/issues",
  "description": "Copy a set number of random files from a source Plex library to a destination library.",
  "paths": [
    {
      "name": "Source Path",
      "host": null,
      "container": "/files/source",
      "mode": "rw",
      "description": "Source library path",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Destination Path",
      "host": null,
      "container": "/files/destination",
      "mode": "rw",
      "description": "Destination library path",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Plex - Server URL",
      "key": "PLEX_SERVER_ADDRESS",
      "value": "http://plex",
      "description": "Plex server URL (include protocol, exclude port)",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Plex - Server Port",
      "key": "PLEX_SERVER_PORT",
      "value": "32400",
      "description": "Plex server port",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Plex - Username",
      "key": "PLEX_LOGIN",
      "value": null,
      "description": "Plex username",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Plex - Password",
      "key": "PLEX_PASSWORD",
      "value": null,
      "description": "Plex password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Plex - Library Section ID",
      "key": "PLEX_LIBRARY_SECTION_ID",
      "value": null,
      "description": "Plex library section ID",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Number of Movies",
      "key": "AMOUNT_OF_WANTED_MOVIES",
      "value": "3",
      "description": "Number of random movies to copy",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Action Type",
      "key": "ACTION_TYPE",
      "value": "symlink|copy",
      "description": "Action to perform to move files from source to destination",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Source Path",
      "key": "SOURCE_FOLDER",
      "value": "/files/source",
      "description": "Internal path to the source folder. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Destination Path",
      "key": "DESTINATION_FOLDER",
      "value": "/files/destination",
      "description": "Internal path to the destination folder. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
