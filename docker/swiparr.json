{
  "name": "Swiparr",
  "repo": "ghcr.io/m3sserstudi0s/swiparr:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/m3sserstudi0s/swiparr:",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:4321]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/swiparr-icon.png",
  "project": "https://github.com/m3sserstudi0s/swiparr",
  "support": "https://github.com/m3sserstudi0s/swiparr/issues",
  "description": "Swiparr is a fun way to discover and decide what to watch next from your Jellyfin media library. Think \"Tinder for Movies\" – swipe through your library, match with friends in a session, and find something everyone wants to watch.",
  "requires": "Requires a separate Jellyfin instance.",
  "paths": [
    {
      "name": "App Data",
      "host": "/mnt/user/appdata/swiparr/data",
      "container": "/app/data",
      "mode": "rw",
      "description": "Path to the application data folder",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "4321",
      "container": "4321",
      "protocol": "tcp",
      "description": "Container Port: 4321",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Jellyfin - URL",
      "key": "JELLYFIN_URL",
      "value": "http://IP_ADDRESS:8096",
      "description": "Internal URL to your Jellyfin server.",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Jellyfin - Public URL",
      "key": "JELLYFIN_PUBLIC_URL",
      "value": null,
      "description": "(Optional) Public URL to your Jellyfin server. Defaults to the internal URL if not set.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Jellyfin - Use Watchlist",
      "key": "JELLYFIN_USE_WATCHLIST",
      "value": "false|true",
      "description": "Set to true to use Watchlist instead of Favorites",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Use Secure Cookies",
      "key": "USE_SECURE_COOKIES",
      "value": "false|true",
      "description": "Set to true if accessing Swiparr over HTTPS",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Admin Username",
      "key": "ADMIN_USERNAME",
      "value": null,
      "description": "(Optional) A Jellyfin username that will always have admin privileges.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Auth Secret",
      "key": "AUTH_SECRET",
      "value": null,
      "description": "Random string (min 32 chars). Generated automatically if not set.",
      "required": false,
      "mask": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "DATABASE_URL",
      "value": "file:/app/data/swiparr.db",
      "description": "Internal path to database. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Port",
      "key": "PORT",
      "value": "4321",
      "description": "Internal port Swiparr listens on. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Host",
      "key": "HOSTNAME",
      "value": "0.0.0.0",
      "description": "Internal host Swiparr binds to. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "X-Frame Options",
      "key": "X_FRAME_OPTIONS",
      "value": "DENY",
      "description": "X-Frame-Options header. Set to DISABLED to remove.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "CSP Frame Ancestors",
      "key": "CSP_FRAME_ANCESTORS",
      "value": "none",
      "description": "Content-Security-Policy frame-ancestors directive.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "099",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
