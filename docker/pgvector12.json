{
  "name": "pgvector-12",
  "repo": "pgvector/pgvector:pg12",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/pgvector/pgvector",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/pgvector-icon.png",
  "project": "https://github.com/pgvector/pgvector",
  "support": "https://github.com/pgvector/pgvector/issues",
  "description": "Open-source vector similarity search for Postgres.",
  "paths": [
    {
      "name": "Database Storage Path",
      "host": "/mnt/cache/appdata/pgvector12",
      "container": "/var/lib/postgresql",
      "mode": "rw",
      "description": "Path to store database files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "5432",
      "container": "5432",
      "protocol": "tcp",
      "description": "Container Port: 5432",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Username",
      "key": "POSTGRES_USER",
      "value": null,
      "description": "PostgreSQL superuser name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Password",
      "key": "POSTGRES_PASSWORD",
      "value": null,
      "description": "PostgreSQL superuser password",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Database Name",
      "key": "POSTGRES_DB",
      "value": null,
      "description": "Initial database name",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
