{
  "name": "Reticulum MeshChat",
  "repo": "ghcr.io/liamcottle/reticulum-meshchat:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/liamcottle/reticulum-meshchat",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]/",
  "icon": "https://raw.githubusercontent.com/liamcottle/reticulum-meshchat/master/logo/logo-chat-bubble.png",
  "project": "https://meshchat.app/",
  "support": "https://github.com/liamcottle/reticulum-meshchat/issues",
  "description": "A simple mesh network communications app powered by the Reticulum Network Stack.",
  "paths": [
    {
      "name": "Config Data",
      "host": "/mnt/user/appdata/reticulum_meshchat/config",
      "container": "/config",
      "mode": "rw",
      "description": "Path to the config data",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "Container Port: 8000",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
