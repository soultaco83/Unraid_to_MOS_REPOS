{
  "name": "StirlingPDF",
  "repo": "frooodle/s-pdf:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/frooodle/s-pdf",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:6520]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Stirlingpdf_A.png",
  "project": "https://github.com/Frooodle/Stirling-PDF",
  "support": "https://github.com/Frooodle/Stirling-PDF",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "OCR Language Packs Path",
      "host": "/mnt/user/appdata/StirlingPDF/data",
      "container": "/usr/share/tesseract-ocr/4.00/tessdata",
      "mode": "rw",
      "description": "OCR Language Packs Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/StirlingPDF/configs",
      "container": "/configs",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "6520",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "App Name",
      "key": "UI_APPNAME",
      "value": "小迪 PDF",
      "description": "Home Name",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Home Description",
      "key": "UI_HOMEDESCRIPTION",
      "value": "小迪的 PDF 工坊",
      "description": "Home Description",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Navbar Name",
      "key": "UI_APPNAMENAVBAR",
      "value": "小迪 PDF",
      "description": "Navbar Name",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Google Visibility",
      "key": "SYSTEM_GOOGLEVISIBILITY",
      "value": "false",
      "description": "Google Visibility",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Custom Static File Path",
      "key": "SYSTEM_CUSTOMSTATICFILEPATH",
      "value": "/customFiles/static",
      "description": "Custom Static File Path",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Default Locale",
      "key": "SYSTEM_DEFAULTLOCALE",
      "value": "zh_CN",
      "description": "Locale. zh_CN、en_GB、fr_FR,etc.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Enable Login",
      "key": "SECURITY_ENABLELOGIN",
      "value": "true",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "CSRF Disabled",
      "key": "SECURITY_CSRFDISABLED",
      "value": "true",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Docker Enable Security",
      "key": "DOCKER_ENABLE_SECURITY",
      "value": "false",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "System Connection Timeout Minutes",
      "key": "SYSTEM_CONNECTIONTIMEOUTMINUTES",
      "value": "1",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "System Root URI Path",
      "key": "SYSTEM_ROOTURIPATH",
      "value": "/",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Metrics",
      "key": "METRICS_ENABLED",
      "value": "true",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Endpoints To Remove",
      "key": "ENDPOINTS_TOREMOVE",
      "value": "[]",
      "description": "e.g. ['img-to-pdf', 'remove-pages']",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Endpoints Groups To Remove",
      "key": "ENDPOINTS_GROUPSTOREMOVE",
      "value": "[]",
      "description": "e.g. ['LibreOffice']",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "xushier"
}
