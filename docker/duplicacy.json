{
  "name": "Duplicacy (selfhosters)",
  "repo": "saspus/duplicacy-web",
  "category": [
    "Backup",
    "Hosting",
    "Network",
    "Misc",
    "Productivity",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/saspus/duplicacy-web",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": "--hostname=duplicacy-unraid",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3875]/",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/duplicacy.png",
  "project": "https://duplicacy.com",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "Web GUI for Duplicacy. Duplicacy backs up your files to many cloud storages with client-side encryption and the highest level of deduplication\r\n    http://duplicacy.com [br]\n    Note: [br]\n    - It's imporatant to pass hostname (Advanced View > Extra Parameters > --hostname=), as duplicacy license is requested based on hostname and machine-id provided by dbus. [br]\n    - Machine-id will be persisted in the /config directory. [br]\n    - Default hostname set to 'duplicacy-unraid'. [br]\n    - If you want to backup the unRAID FLASH drive then you will have to run Duplicacy as root i.e. USR_ID=0 and GRP_ID=0 [br]\n    - /config -- is where configuration data will be stored. Should be backed up. [br]\n    - /logs -- logs will go there. [br]\n    - /cache -- transient and temporary files will be stored here. Can be safely deleted. [br]\n    - Readme: https://hub.docker.com/r/saspus/duplicacy-web",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/Duplicacy/config",
      "container": "/config",
      "mode": "rw",
      "description": "Container Path: /config",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Cache",
      "host": "/mnt/cache/appdata/Duplicacy/cache",
      "container": "/cache",
      "mode": "rw",
      "description": "Container Path: /cache",
      "required": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "User Data",
      "host": null,
      "container": "/backuproot",
      "mode": "rw",
      "description": "Container Path: /backuproot",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Logs",
      "host": "/mnt/cache/appdata/Duplicacy/logs",
      "container": "/logs",
      "mode": "rw",
      "description": "Container Path: /logs",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Port",
      "host": "3875",
      "container": "3875",
      "protocol": "tcp",
      "description": "Container Port: 3875",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "User ID",
      "key": "USR_ID",
      "value": "99",
      "description": "Container Variable: USR_ID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Group ID",
      "key": "GRP_ID",
      "value": "100",
      "description": "Container Variable: GRP_ID",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
