{
  "name": "Flixor - Backend",
  "repo": "flixorui/flixor_backend:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/flixorui/flixor_backend",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/flixor-icon.png",
  "project": "https://github.com/Flixorui/flixor",
  "support": "https://github.com/Flixorui/flixor/issues",
  "description": "A fast, Netflix‑style web app, Android, iOS, and MacOS for your Plex library. Browse beautiful rows, see rich details (IMDb/Rotten Tomatoes), and play instantly in your browser with built‑in DASH/HLS playback. Works on any modern desktop or mobile browser. \r\n        \r\n        This is the backend component.",
  "requires": "Requires a separate Flixor - Frontend container or Flixor app.",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/flixor_backend/config",
      "container": "/app/config",
      "mode": "rw",
      "description": "Path to the config files",
      "required": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Cache Path",
      "host": "/mnt/user/appdata/flixor_backend/cache",
      "container": "/app/cache",
      "mode": "rw",
      "description": "Path to the cache files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "API Port",
      "host": "3001",
      "container": "3001",
      "protocol": "tcp",
      "description": "Container Port: 3001",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Frontend URL",
      "key": "FRONTEND_URL",
      "value": null,
      "description": "The URL where the frontend is hosted (e.g., http://localhost:8080). Required if using the frontend app.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Session Secret",
      "key": "SESSION_SECRET",
      "value": null,
      "description": "A long, random string used to sign session cookies.",
      "required": false,
      "mask": true,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Node Environment",
      "key": "NODE_ENV",
      "value": "production",
      "description": "Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal API Port",
      "key": "PORT",
      "value": "3001",
      "description": "Internal API port. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Host",
      "key": "HOST",
      "value": "0.0.0.0",
      "description": "Internal host. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Config Path",
      "key": "CONFIG_DIRECTORY",
      "value": "/app/config",
      "description": "Internal path to the config files. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Database Path",
      "key": "DATABASE_PATH",
      "value": "/app/config/db/app.sqlite",
      "description": "Internal path to the database file. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Internal Image Cache Path",
      "key": "IMAGE_CACHE_DIR",
      "value": "/app/cache/images",
      "description": "Internal path to the image cache. Not recommended to change.",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
