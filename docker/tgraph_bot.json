{
  "name": "TGraph Bot",
  "repo": "ghcr.io/engels74/tgraph-bot:nightly",
  "category": [
    "Utilities",
    "Media",
    "Misc"
  ],
  "registry": "https://github.com/engels74/tgraph-bot/pkgs/container/tgraph-bot",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/tgraph-bot-icon.png",
  "project": "https://engels74.net/containers/tgraph-bot/",
  "support": "https://github.com/engels74/tgraph-bot",
  "description": "TGraph Bot is a bot for posting Tautulli graphs to a Discord channel.",
  "requires": "Users must configure a configuration file in the \"Config Path\". See documentation: https://github.com/engels74/tgraph-bot-source?tab=readme-ov-file#configuration",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/cache/appdata/tgraph_bot/config",
      "container": "/config",
      "mode": "rw",
      "description": "Where config file will be stored",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "002",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
