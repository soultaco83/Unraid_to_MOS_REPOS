{
  "name": "monitorss-web (selfhosters)",
  "repo": "synzen/monitorss",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/synzen/monitorss",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8081]",
  "icon": "https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/monitorss.png",
  "project": "https://github.com/synzen/MonitoRSS",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository/",
  "description": "WebUI for the Discord RSS bot (formerly known as Discord.RSS) with customizable feeds.\n\n  More configuration options available on [monitorss.xyz](https://docs.monitorss.xyz/configuration/web-interface)",
  "requires": "Monitorss-bot container\n  Redis container installed\n  MongoDB database container",
  "paths": [],
  "ports": [
    {
      "name": "WebUI",
      "host": "8081",
      "container": "8081",
      "protocol": "tcp",
      "description": "Container Port: 8081",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "CLIENTID",
      "key": "DRSSWEB_BOT_CLIENTID",
      "value": "1111111111111",
      "description": "Information here https://docs.monitorss.xyz/configuration/web-interface#bot",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "CLIENTSECRET",
      "key": "DRSSWEB_BOT_CLIENTSECRET",
      "value": "1111111111111",
      "description": "Information here https://docs.monitorss.xyz/configuration/web-interface#bot",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "REDIRECTURI",
      "key": "DRSSWEB_BOT_REDIRECTURI",
      "value": "https://domain.com/authorize",
      "description": "Does not have to be a public domain. Information here https://docs.monitorss.xyz/configuration/web-interface#bot",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "TOKEN",
      "key": "DRSSWEB_BOT_TOKEN",
      "value": "22222222222",
      "description": "Information here https://docs.monitorss.xyz/configuration/web-interface#bot",
      "required": true,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "DATABASE_REDIS",
      "key": "DRSSWEB_DATABASE_REDIS",
      "value": "redis://[REPLACE-WITH-IP]:6379",
      "description": "Information here https://docs.monitorss.xyz/configuration/web-interface#database",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "DATABASE_URI",
      "key": "DRSSWEB_DATABASE_URI",
      "value": "mongodb://[REPLACE-WITH-IP]:27017/drss",
      "description": "Information here https://docs.monitorss.xyz/configuration/web-interface#database",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Component",
      "key": "DRSS_START",
      "value": "web",
      "description": "Do not change",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "selfhosters"
}
