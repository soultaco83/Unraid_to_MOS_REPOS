{
  "name": "Qbittorrent_CB",
  "repo": "chisbread/qbittorrent:v4.3.9",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/chisbread/qbittorrent/",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": true,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1912]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Qbittorrent_B.png",
  "project": "https://hub.docker.com/r/chisbread/qbittorrent/",
  "support": "https://hub.docker.com/r/chisbread/qbittorrent/",
  "description": "为pt下载定制的“快速hash校验”版qbittorrent, 相关修改见 https://github.com/ChisBread/libtorrent\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Qbittorrent_CB",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Download Path",
      "host": "Your Download Path",
      "container": "/downloads",
      "mode": "rw",
      "description": "Download Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "TCP Port",
      "host": "56689",
      "container": "56689",
      "protocol": "tcp",
      "description": "TCP Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "UDP Port",
      "host": "56689",
      "container": "56689",
      "protocol": "udp",
      "description": "UDP Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Web Port",
      "host": "1912",
      "container": "1912",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Listen Web Port",
      "key": "WEBUI_PORT",
      "value": "1912",
      "description": "Listen Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Asia/Shanghai",
      "description": "Timezone",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "99",
      "description": "PUID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "PGID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
