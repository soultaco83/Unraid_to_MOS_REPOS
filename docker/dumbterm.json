{
  "name": "DumbTerm",
  "repo": "dumbwareio/dumbterm:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/dumbwareio/dumbterm",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3000]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/dumbterm-logo.png",
  "project": "https://github.com/DumbWareio/DumbTerm",
  "support": "https://forums.unraid.net/topic/185964-support-devzwf-dumbwareio-suite/",
  "description": "A stupidly simple web-based terminal emulator, with common tools and Starship enabled! 🚀",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/user/appdata/dumbterm/config",
      "container": "/root/.config",
      "mode": "rw",
      "description": "Config Dir",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Data",
      "host": "/mnt/user/appdata/dumbterm/data",
      "container": "/root/data",
      "mode": "rw",
      "description": "Data Dir",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "3000",
      "container": "3000",
      "protocol": "tcp",
      "description": "The port on which the application will run.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PIN",
      "key": "DUMBTERM_PIN",
      "value": "12345",
      "description": "PIN protection",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Starship",
      "key": "ENABLE_STARSHIP",
      "value": "True",
      "description": "Enable Starship prompt",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "merica/New_York",
      "description": "Set the timezone (e.g., 'America/New_York')",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
