{
  "name": "Crontab",
  "repo": "willfarrell/crontab:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/willfarrell/crontab",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/crontab-icon.png",
  "project": "https://github.com/willfarrell/docker-crontab",
  "support": "https://github.com/willfarrell/docker-crontab/issues",
  "description": "A simple wrapper over the Docker CLI to all complex cron job to be run in other containers.",
  "requires": "Expects a config file in the Config Path. See documentation: https://github.com/willfarrell/docker-crontab#config-file",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/crontab/config",
      "container": "/opt/crontab",
      "mode": "rw",
      "description": "Path to config files",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Logs Path",
      "host": "/mnt/user/appdata/crontab/logs",
      "container": "/var/log/crontab",
      "mode": "rw",
      "description": "Path to logs",
      "required": true,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Docker socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Path to the Docker socket",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
