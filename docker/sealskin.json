{
  "name": "sealskin (linuxserver)",
  "repo": "lscr.io/linuxserver/sealskin",
  "category": [
    "Misc"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/sealskin",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8000]",
  "readme_url": "https://github.com/linuxserver/docker-sealskin#readme",
  "icon": "https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/linuxserver-ls-logo.png",
  "project": "https://github.com/selkies-project/sealskin/",
  "support": "https://github.com/linuxserver/docker-sealskin/issues/new/choose",
  "description": "Sealskin(https://github.com/selkies-project/sealskin/) is a self-hosted, client-server platform that enables users to run powerful, containerized desktop applications streamed directly to a web browser. It uses a browser extension to intercept user actions—such as clicking a link or downloading a file and redirects them to a secure, isolated application environment running on a remote server.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Appdata",
      "host": null,
      "container": "/config",
      "mode": "rw",
      "description": "All configuration files and metadata for the application.",
      "required": true,
      "display": "advanced",
      "default": null
    },
    {
      "name": "/storage",
      "host": null,
      "container": "/storage",
      "mode": "rw",
      "description": "All file storage for home directories and ephemeral mounts.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "/var/run/docker.sock",
      "host": null,
      "container": "/var/run/docker.sock",
      "mode": "rw",
      "description": "Docker socket, required to spin up application containers.",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8443",
      "container": "8443",
      "protocol": "tcp",
      "description": "HTTPS Sessions and API communication port.",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "8000",
      "host": "8000",
      "container": "8000",
      "protocol": "tcp",
      "description": "HTTP Fallback API communication port.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "HOST_URL",
      "key": "HOST_URL",
      "value": "IP or subdomain.doman.com",
      "description": "On initial setup this will be used to fill in the default admin configuration file in the `/config` directory, if unset the string HOST_URL will need to be replaced.",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "500",
      "description": "Container Variable: PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "500",
      "description": "Container Variable: PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "Container Variable: UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "linuxserver"
}
