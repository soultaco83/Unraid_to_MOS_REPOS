{
  "name": "ASCII Telnet Server",
  "repo": "rohan/ascii-telnet-server:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/rohan/ascii-telnet-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": "--standalone -i 0.0.0.0 -p 23 -f /video.txt",
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/ascii-telnet-server-icon.png",
  "project": "https://github.com/nitram509/ascii-telnet-server",
  "support": "https://github.com/nitram509/ascii-telnet-server/issues",
  "description": "Host ASCII movies that can be streamed over telnet. Run `telnet [IP] [PORT]` to connect.",
  "requires": "Expects a `video.txt` file to be present in the specified path before starting the container: https://github.com/nitram509/ascii-telnet-server/tree/master/sample_movies",
  "paths": [
    {
      "name": "Video File",
      "host": "/mnt/cache/appdata/ascii_telnet/video.txt",
      "container": "/video.txt",
      "mode": "rw",
      "description": "Path to video file to stream",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Telnet Port",
      "host": "23",
      "container": "23",
      "protocol": "tcp",
      "description": "Container Port: 23",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
