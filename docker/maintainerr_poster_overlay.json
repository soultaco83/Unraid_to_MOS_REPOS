{
  "name": "Maintainerr Poster Overlay",
  "repo": "jakec207/maintainerr-overlay:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "https://hub.docker.com/r/jakec207/maintainerr-overlay",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/jorenn92/Maintainerr/refs/heads/main/ui/public/logo.png",
  "project": "https://gitlab.com/jakeC207/maintainerr-poster-overlay",
  "support": "https://gitlab.com/jakeC207/maintainerr-poster-overlay",
  "description": "A basic photo sharing site, allowing anyone to upload and view shared albums.",
  "requires": "Expects a `config.yaml` file in the Data Path. See documentation: https://gitlab.com/jakeC207/maintainerr-poster-overlay/-/blob/main/config.yaml",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/cache/appdata/maintainerr-overlay",
      "container": "/maintainerr-overlay",
      "mode": "rw",
      "description": "Path to the maintainerr overlay data (images, fonts, config files)",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Schedule",
      "key": "CRON",
      "value": "0 */8 * * *",
      "description": "Cron schedule for the system to run",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Action",
      "key": "ACTION",
      "value": "add|reset|test",
      "description": "Action to perform",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Run On Creation",
      "key": "RUN_ON_CREATION",
      "value": "false|true",
      "description": "Run the action on creation",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
