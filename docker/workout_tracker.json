{
  "name": "Workout Tracker",
  "repo": "ghcr.io/jovandeginste/workout-tracker:latest",
  "category": [
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/jovandeginste/workout-tracker",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/workout-tracker-icon.png",
  "project": "https://github.com/jovandeginste/workout-tracker",
  "support": "https://github.com/jovandeginste/workout-tracker/issues",
  "description": "A workout tracking web application for personal use (or family, friends), geared towards running and other GPX-based activities.",
  "requires": "Expects a `workout-tracker.yaml` file to be present in the Data Path before starting the container. See documentation for more details: https://github.com/jovandeginste/workout-tracker#configuration",
  "paths": [
    {
      "name": "Data path",
      "host": "/mnt/user/appdata/workout_tracker/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to data files",
      "required": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web UI Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Container Port: 8080",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
