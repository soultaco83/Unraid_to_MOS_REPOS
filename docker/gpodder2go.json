{
  "name": "gpodder2go",
  "repo": "ghcr.io/oxtyped/gpodder2go:latest",
  "category": [
    "Media",
    "Productivity",
    "Utilities",
    "Misc"
  ],
  "registry": "ghcr.io/oxtyped/gpodder2go",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": null,
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/nwithan8/unraid_templates/master/images/gpodder2go-icon.png",
  "project": "https://github.com/oxtyped/gpodder2go",
  "support": "https://github.com/oxtyped/gpodder2go/issues",
  "description": "gpodder2go is a simple self-hosted, golang, drop-in replacement for gpodder/mygpo server to handle podcast subscriptions management for gpodder clients. \r\n        [br]\n        Enter the console of the container to run commands like `/gpodder2go --help` to see available commands.",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/gpodder2go/data",
      "container": "/data",
      "mode": "rw",
      "description": "Path to data storage",
      "required": true,
      "display": "advanced-hide",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Server Port",
      "host": "3005",
      "container": "3005",
      "protocol": "tcp",
      "description": "Container Port: 3005",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Skip Authentication",
      "key": "NO_AUTH",
      "value": "false|true",
      "description": "Skip authentication",
      "required": true,
      "mask": false,
      "display": "always-hide",
      "default": null
    },
    {
      "name": "Verifier Secret Key",
      "key": "VERIFIER_SECRET_KEY",
      "value": null,
      "description": "Secret key for verifying requests",
      "required": true,
      "mask": true,
      "display": "always-hide",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": [],
  "author": "nwithan8"
}
