{
  "name": "dockersocket",
  "repo": "ghcr.io/tecnativa/docker-socket-proxy:latest",
  "category": [
    "Security",
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/tecnativa/docker-socket-proxy",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://raw.githubusercontent.com/ibracorp/app-logos/main/docker/docker-logo.png",
  "project": "https://github.com/Tecnativa/docker-socket-proxy",
  "support": "https://discord.com/invite/VWAG7rZ",
  "description": "This is a security-enhanced proxy for the Docker Socket.",
  "donate": "https://paypal.me/ibracorp",
  "paths": [
    {
      "name": "docker.sock",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "docker.sock",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Containers",
      "key": "CONTAINERS",
      "value": "1",
      "description": "Allow access to running containers",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Post",
      "key": "POST",
      "value": "0",
      "description": "Disable access to",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
