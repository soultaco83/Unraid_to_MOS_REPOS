{
  "name": "Scrutiny",
  "repo": "ghcr.io/analogj/scrutiny:master-omnibus",
  "category": [
    "Home Automation",
    "Utilities"
  ],
  "registry": "https://github.com/AnalogJ/scrutiny/pkgs/container/scrutiny",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--cap-add=SYS_RAWIO --cap-add=SYS_ADMIN",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Scrutiny_A.png",
  "project": "https://github.com/AnalogJ/scrutiny",
  "support": "https://forums.unraid.net/topic/87798-support-selfhostersnets-template-repository",
  "description": "Hard Drive S.M.A.R.T Monitoring, Historical Trends and Real World Failure Thresholds\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Udev Path",
      "host": "/run/udev",
      "container": "/run/udev",
      "mode": "ro",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Disk Path",
      "host": "/dev/disk",
      "container": "/dev/disk",
      "mode": "ro",
      "description": "",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Scrutiny/config",
      "container": "/opt/scrutiny/config",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Database Path",
      "host": "/mnt/user/appdata/Scrutiny/influxdb",
      "container": "/opt/scrutiny/influxdb",
      "mode": "rw",
      "description": "",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
