{
  "name": "SubConverter",
  "repo": "tindy2013/subconverter",
  "category": [
    "Utilities",
    "Network"
  ],
  "registry": "https://hub.docker.com/r/tindy2013/subconverter/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2556]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Subconverter_A.png",
  "project": "https://github.com/tindy2013/subconverter",
  "support": "https://github.com/tindy2013/subconverter",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/SubConverter",
      "container": "/mnt",
      "mode": "rw",
      "description": "Data Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web PORT",
      "host": "2556",
      "container": "25500",
      "protocol": "tcp",
      "description": "Web PORT",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
