{
  "name": "Clash",
  "repo": "dreamacro/clash:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/dreamacro/clash",
  "network": "host",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Clash_A.png",
  "project": "https://github.com/Dreamacro/clash",
  "support": "https://github.com/Dreamacro/clash",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Clash/Your-Config-File.yml",
      "container": "/root/.config/clash/config.yaml",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "HTTP Port",
      "host": "7890",
      "container": "7890",
      "protocol": "tcp",
      "description": "HTTP Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Socks Port",
      "host": "7891",
      "container": "7891",
      "protocol": "tcp",
      "description": "Socks Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Controller Port",
      "host": "9090",
      "container": "9090",
      "protocol": "tcp",
      "description": "Controller Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
