{
  "name": "BaiduNetDisk",
  "repo": "johngong/baidunetdisk",
  "category": [
    "Hosting"
  ],
  "registry": "https://hub.docker.com/r/johngong/baidunetdisk/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:7888]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Baidudrive_A.png",
  "project": "https://hub.docker.com/r/johngong/baidunetdisk/",
  "support": "https://hub.docker.com/r/johngong/baidunetdisk/",
  "description": "官方百度网盘客户端VNC版:(baidunetdisk:4.10.5)\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/BaiduNetDisk",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Download Path",
      "host": "Your Download Path",
      "container": "/mnt",
      "mode": "rw",
      "description": "Download Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "7888",
      "container": "5800",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VNC Port",
      "host": "7889",
      "container": "5900",
      "protocol": "tcp",
      "description": "VNC Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "PUID",
      "key": "USER_ID",
      "value": "0",
      "description": "PUID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PGID",
      "key": "GROUP_ID",
      "value": "0",
      "description": "PGID",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VNC Display Width",
      "key": "DISPLAY_WIDTH",
      "value": "1366",
      "description": "VNC Display Width",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VNC Display Height",
      "key": "DISPLAY_HEIGHT",
      "value": "768",
      "description": "VNC Display Height",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Password",
      "key": "VNC_PASSWORD",
      "value": "Your Password",
      "description": "Password",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
