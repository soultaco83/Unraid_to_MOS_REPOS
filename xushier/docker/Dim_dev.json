{
  "name": "Dim",
  "repo": "ghcr.io/dusk-labs/dim:dev",
  "category": [
    "Media"
  ],
  "registry": "https://github.com/Dusk-Labs/dim/pkgs/container/dim",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8003]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Dim_B.png",
  "project": "https://github.com/Dusk-Labs/dim",
  "support": "https://github.com/Dusk-Labs/dim",
  "description": "Dim is a self-hosted media manager. With minimal setup, Dim will organize and beautify your media collections, letting you access and play them anytime from anywhere.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Media Path",
      "host": "Your Media Path",
      "container": "/mnt",
      "mode": "rw",
      "description": "Media Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Dim",
      "container": "/opt/dim/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8003",
      "container": "8000",
      "protocol": "tcp",
      "description": "Web Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [
    {
      "name": "GPU",
      "host": "/dev/dri",
      "container": "/dev/dri",
      "description": "GPU",
      "required": false,
      "display": "always"
    }
  ],
  "labels": [],
  "gpus": []
}
