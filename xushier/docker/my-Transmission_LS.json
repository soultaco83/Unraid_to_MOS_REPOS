{
  "name": "Transmission_LS",
  "repo": "linuxserver/transmission",
  "category": [
    "Downloader"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/transmission",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:9095]",
  "icon": "https://ghproxy.com/raw.githubusercontent.com/xushier/HD-Icons/main/border-radius/Transmission_A.png",
  "project": "https://www.transmissionbt.com/",
  "support": "https://github.com/linuxserver/docker-transmission/issues/new/choose",
  "description": "Transmission(https://www.transmissionbt.com/) is designed for easy, powerful use. Transmission has the features you want from a BitTorrent client: encryption, a web interface, peer exchange, magnet links, DHT, µTP, UPnP and NAT-PMP port forwarding, webseed support, watch directories, tracker editing, global and per-torrent speed limits, and more.",
  "donate": "https://www.linuxserver.io/donate",
  "paths": [
    {
      "name": "Path: /downloads",
      "host": "/mnt/user/XiaZai",
      "container": "/downloads",
      "mode": "rw",
      "description": "Local path for downloads.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Path: /watch",
      "host": "/mnt/user/appdata/Transmission_LS/watch",
      "container": "/watch",
      "mode": "rw",
      "description": "Watch folder for torrent files.",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Appdata",
      "host": "/mnt/user/appdata/Transmission_LS",
      "container": "/config",
      "mode": "rw",
      "description": "Where transmission should store config files and logs.",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "9095",
      "container": "9091",
      "protocol": "tcp",
      "description": "WebUI",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Port: 51413",
      "host": "51415",
      "container": "51413",
      "protocol": "tcp",
      "description": "Torrent Port TCP",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Port: 51413",
      "host": "51415",
      "container": "51413",
      "protocol": "udp",
      "description": "Torrent Port UDP",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "TRANSMISSION_WEB_HOME",
      "key": "TRANSMISSION_WEB_HOME",
      "value": "/transmission-web-control/",
      "description": "Specify an alternative UI options are `/combustion-release/`(https://github.com/Secretmapper/combustion), `/transmission-web-control/`(https://github.com/ronggang/transmission-web-control), `/kettu/`(https://github.com/endor/kettu), `/flood-for-transmission/`(https://github.com/johman10/flood-for-transmission), and `/transmissionic/`(https://github.com/6c65726f79/Transmissionic).",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "USER",
      "key": "USER",
      "value": "username",
      "description": "Specify an optional username for the interface",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PASS",
      "key": "PASS",
      "value": "password",
      "description": "Specify an optional password for the interface",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "0",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "0",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
