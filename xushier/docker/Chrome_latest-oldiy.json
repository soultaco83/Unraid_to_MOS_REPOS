{
  "name": "Chrome-oldiy",
  "repo": "oldiy/chrome-novnc:latest",
  "category": [
    "Utilities",
    "Network"
  ],
  "registry": "https://hub.docker.com/r/oldiy/chrome-novnc/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3811]/vnc.html",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Chrome_A.png",
  "project": "https://hub.docker.com/r/oldiy/chrome-novnc/",
  "support": "https://hub.docker.com/r/oldiy/chrome-novnc/",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Chrome/cfg",
      "container": "/cfg",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Download Path",
      "host": "/mnt/user/appdata/Chrome/downloads",
      "container": "/root/Downloads",
      "mode": "rw",
      "description": "Download Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "3811",
      "container": "8083",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "VNC Port",
      "host": "3822",
      "container": "5900",
      "protocol": "tcp",
      "description": "VNC Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Enable CJK Font",
      "key": "ENABLE_CJK_FONT",
      "value": "1",
      "description": "Enable CJK Font",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Screen Resolution",
      "key": "SCREEN_RESOLUTION",
      "value": "1366x768",
      "description": "Screen Resolution",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Asia/Shanghai",
      "description": "Timezone",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
