{
  "name": "IYUU-Plus",
  "repo": "iyuucn/iyuuplus:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/iyuucn/iyuuplus",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:2911]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Iyuu_A.png",
  "project": "http://iyuu.cn",
  "support": "https://github.com/ledccn/IYUUPlus",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/IYUU-Plus",
      "container": "/IYUU/db",
      "mode": "rw",
      "description": "Data Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Qbittorrent BT_backup Path",
      "host": "Your Qbittorrent BT_backup Path",
      "container": "/BT_backup_80x86",
      "mode": "rw",
      "description": "Qbittorrent BT_backup Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Transmission torrents Path",
      "host": "Your Transmission torrents Path",
      "container": "/torrents",
      "mode": "rw",
      "description": "Transmission torrents Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "2911",
      "container": "8787",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
