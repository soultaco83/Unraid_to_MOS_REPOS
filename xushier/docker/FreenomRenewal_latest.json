{
  "name": "Freenom",
  "repo": "luolongfei/freenom",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/luolongfei/freenom/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Freenom_A.png",
  "project": "https://github.com/luolongfei/freenom",
  "support": "https://github.com/luolongfei/freenom",
  "description": "Freenom 域名自动续期（Docker 版本）。Automatically renew your freenom domain.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Logs Path",
      "host": "/mnt/user/appdata/Freenom/logs",
      "container": "/app/logs",
      "mode": "rw",
      "description": "Logs Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Freenom/conf",
      "container": "/conf",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
