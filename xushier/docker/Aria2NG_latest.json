{
  "name": "Aria2NG",
  "repo": "oldiy/aria2-ui-ng:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/oldiy/aria2-ui-ng/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:3611]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Aria2_A.png",
  "project": "https://github.com/oldiy/Docker-Aria2NG",
  "support": "https://github.com/oldiy/Docker-Aria2NG",
  "description": "群晖可用的Aria2+WebUI+AriaNG+FilesWeb，中文安装说明——支持群晖，威联通等一切X86系统docker部署\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Download Path",
      "host": "Your Download Path",
      "container": "/data",
      "mode": "rw",
      "description": "Download Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/Aria2NG",
      "container": "/conf",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port 1",
      "host": "3611",
      "container": "80",
      "protocol": "tcp",
      "description": "Web Port 1",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Filebrowser Port",
      "host": "3622",
      "container": "8080",
      "protocol": "tcp",
      "description": "Filebrowser Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Web Port 2",
      "host": "3655",
      "container": "81",
      "protocol": "tcp",
      "description": "Web Port 2",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "RPC Port",
      "host": "3666",
      "container": "6800",
      "protocol": "tcp",
      "description": "RPC Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "SECRET TOKEN",
      "key": "SECRET",
      "value": "Your SECRET TOKEN",
      "description": "SECRET TOKEN",
      "required": false,
      "mask": true,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
