{
  "name": "SwingMusic",
  "repo": "xiaodid/swingmusic",
  "category": [
    "Media"
  ],
  "registry": "https://hub.docker.com/r/xiaodid/swingmusic",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:1972]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons@master/border-radius/Swingmusic_A.png",
  "project": "https://swingmusic.vercel.app",
  "support": "https://github.com/swing-opensource/swingmusic",
  "description": "YouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Music Media Path",
      "host": "Your Music Media Path",
      "container": "/music",
      "mode": "rw",
      "description": "Music Media Path",
      "required": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Config Path",
      "host": "/mnt/user/appdata/SwingMusic",
      "container": "/config",
      "mode": "rw",
      "description": "Config Path",
      "required": false,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "1972",
      "container": "1970",
      "protocol": "tcp",
      "description": "Web Port",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
