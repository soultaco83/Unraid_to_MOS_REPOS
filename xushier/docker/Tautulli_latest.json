{
  "name": "Tautulli",
  "repo": "linuxserver/tautulli:latest",
  "category": [
    "Media",
    "Misc",
    "Utilities"
  ],
  "registry": "https://github.com/orgs/linuxserver/packages/container/package/tautulli",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8181]",
  "icon": "https://cdn.jsdelivr.net/gh/xushier/HD-Icons/border-radius/Tautulli_A.png",
  "project": "http://tautulli.com",
  "support": "https://github.com/linuxserver/docker-tautulli/issues/new/choose",
  "description": "Tautulli(http://tautulli.com) is a python based web application for monitoring, analytics and notifications for Plex Media Server.\r\n\r\nYouTube: https://www.youtube.com/@xiaoditx\r\nTemplates: https://github.com/xushier/Unraid-Docker-Templates\r\nIcons: https://github.com/xushier/HD-Icons\r\nBiliBili: https://space.bilibili.com/32313260\r\nBlog: https://www.xdtx.cc\r\nQQ Group: 647605169\r\nWeChat: 小迪同学",
  "paths": [
    {
      "name": "Data Path",
      "host": "/mnt/user/appdata/Tautulli",
      "container": "/config",
      "mode": "rw",
      "description": "Contains tautulli config and database.",
      "required": true,
      "display": "advanced",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "Web Port",
      "host": "8181",
      "container": "8181",
      "protocol": "tcp",
      "description": "Web Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Timezone",
      "key": "TZ",
      "value": "Asia/Shanghai",
      "description": "Timezone",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "PUID",
      "key": "PUID",
      "value": "99",
      "description": "PUID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "PGID",
      "key": "PGID",
      "value": "100",
      "description": "PGID",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "description": "UMASK",
      "required": false,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
