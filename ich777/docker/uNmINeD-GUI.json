{
  "name": "uNmINeD-GUI",
  "repo": "ghcr.io/ich777/unmined",
  "category": [
    "Backup"
  ],
  "registry": "https://hub.docker.com/r/ich777/unmined/",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/vnc.html?autoconnect=true",
  "icon": "https://raw.githubusercontent.com/ich777/docker-templates/master/ich777/images/unmined.png",
  "project": "https://unmined.net/",
  "support": "https://forums.unraid.net/topic/79530-support-ich777-gameserver-dockers/",
  "description": "uNmINeD-GUI is an easy to use and fast Minecraft world viewer and mapper tool. It can read Minecraft Java and Bedrock Edition world files and renders a browseable 2D overview map that you can export.\r\n\r\n**ATTENTION:** Please always mount your world files as read only and it is strongly recommended to mount your worlds to the path /unmined/worlds/... in the container.",
  "donate": "https://www.patreon.com/bePatron?u=543858&redirect_uri=https%3A%2F%2Funmined.net%2Fdownloads%2F&utm_medium=widget",
  "paths": [
    {
      "name": "Data Dir",
      "host": "/mnt/cache/appdata/unmined/",
      "container": "/unmined",
      "mode": "rw",
      "description": "Main Data directory",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Minecraft World",
      "host": null,
      "container": "/unmined/worlds",
      "mode": "ro",
      "description": "Path to your Minecraft world folder (You can also create multiple mappings but it is strongly recommended to mount it as Read Only and to the path /unmined/worlds/...)",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WebGUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "WebGUI http Port",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Data Permissions",
      "key": "DATA_PERM",
      "value": "770",
      "description": "Data Permissions for config directory",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Umask Value",
      "key": "UMASK",
      "value": "0000",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "UID",
      "key": "UID",
      "value": "99",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "GID",
      "key": "GID",
      "value": "100",
      "description": "",
      "required": true,
      "mask": false,
      "display": "advanced-hide",
      "default": null
    },
    {
      "name": "Custom Screen Width",
      "key": "CUSTOM_RES_W",
      "value": "1280",
      "description": "Minimum screen width 1280 pixels",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    },
    {
      "name": "Custom Screen Height",
      "key": "CUSTOM_RES_H",
      "value": "850",
      "description": "Minimum screen hight 850 pixels",
      "required": true,
      "mask": false,
      "display": "advanced",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
