{
  "name": "lightnvr",
  "repo": "ghcr.io/opensensor/lightnvr",
  "category": [
    "Security"
  ],
  "registry": "https://github.com/opensensor/lightNVR",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://raw.githubusercontent.com/devzwf/unraid-docker-templates/main/images/lightnvr-logo.png",
  "project": "https://github.com/opensensor/lightNVR",
  "support": "https://forums.unraid.net/topic/195746-support-devzwf-lightnvr/",
  "description": "LightNVR is a tiny, memory-optimized Network Video Recorder software written in C. While originally designed for resource-constrained devices like the Ingenic A1 SoC with only 256MB of RAM, it can run on any Linux system.\r\nLightNVR provides a lightweight yet powerful solution for recording and managing IP camera streams. It's designed to run efficiently on low-power, memory-constrained devices while still providing essential NVR functionality with a modern, responsive web interface.",
  "donate": "https://ko-fi.com/devzwf",
  "paths": [
    {
      "name": "Configuration files",
      "host": "/mnt/user/appdata/lightnvr/config",
      "container": "/etc/lightnvr",
      "mode": "rw",
      "description": "-  lightnvr.ini - Main configuration\r\n-  go2rtc/go2rtc.yaml - go2rtc WebRTC/RTSP configuration",
      "required": true,
      "display": "always",
      "default": null
    },
    {
      "name": "Data Dir - Persistent data",
      "host": null,
      "container": "/var/lib/lightnvr/data",
      "mode": "rw",
      "description": "- database/ - SQLite database\r\n- recordings/ - Video recordings (HLS and MP4)\r\n- models/ - Object detection models\r\nNote : recommend a share on your array for this",
      "required": true,
      "display": "always",
      "default": null
    }
  ],
  "ports": [
    {
      "name": "WEBUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "RTSP",
      "host": "8554",
      "container": "8554",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WebRTC TCP",
      "host": "8555",
      "container": "8555",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "WebRTC UDP",
      "host": "8555",
      "container": "8555",
      "protocol": "udp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "go2rtc API",
      "host": "1984",
      "container": "1984",
      "protocol": "tcp",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "variables": [
    {
      "name": "Time Zone",
      "key": "TZ",
      "value": "America/New_York",
      "description": "",
      "required": true,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "go2rtc configuration persistence",
      "key": "GO2RTC_CONFIG_PERSIST",
      "value": "True",
      "description": "Set to 'false' to let go2rtc regenerate config on each restart",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    },
    {
      "name": "Auto-initialize configuration files on first run",
      "key": "LIGHTNVR_AUTO_INIT",
      "value": "True",
      "description": "",
      "required": false,
      "mask": false,
      "display": "always",
      "default": null
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
